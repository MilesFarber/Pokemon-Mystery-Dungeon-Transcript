
def 0 {
    sound_Stop();
    back_SetGround(LEVEL_D16P11A);
    supervision_StationCommon(0);
    supervision_Acting(0);
    camera_SetMyself<performer 0>();
    screen_FadeIn(1, 30);
    bgm_PlayFadeIn(BGM_CRYSTAL_CAVE, 0, 256);
    MovePositionMark<actor ACTOR_PLAYER>(1, Position<'m0', 39.5, 17.5>);
    Move2PositionMark<actor ACTOR_ATTENDANT1>(1, Position<'m1', 35.5, 17.5>);
    WaitExecuteLives(ACTOR_ATTENDANT1);
    WaitExecuteLives(ACTOR_PLAYER);
    Turn2DirectionLives<actor ACTOR_ATTENDANT1>(4, 10, ACTOR_PLAYER);
    Wait(10);
    Turn2DirectionLives<actor ACTOR_PLAYER>(4, 10, ACTOR_ATTENDANT1);
    WaitExecuteLives(ACTOR_ATTENDANT1);
    message_SetFace(ACTOR_ATTENDANT1, FACE_NORMAL, FACE_POS_STANDARD);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     We'll find the path to [CS:N]Azelf[CR]'s
                    lake this time!
                """,
            }
        case 2:
            {
                english="""
                     We'll find the path to [CS:N]Azelf[CR]'s
                    lake this time!
                """,
            }
        default:
            {
                english="""
                     We'll find the way to [CS:N]Azelf[CR]'s
                    lake this time!
                """,
            }
    }
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     Let's give it our best,
                    [hero]!
                """,
            }
        case 2:
            {
                english="""
                     Let's do our best,
                    [hero]!
                """,
            }
        default:
            {
                english=" Let's try our best, [hero]!",
            }
    }
    message_Close();
    Move2PositionMark<actor ACTOR_ATTENDANT1>(1, Position<'m2', 35.5, 9.5>);
    Wait(10);
    MovePositionMark<actor ACTOR_PLAYER>(1, Position<'m3', 39.5, 9.5>);
    Wait(30);
    screen_FadeOut(1, 30);
    main_EnterDungeon(24, 0);
    switch ( message_Menu(MENU_DUNGEON_INITIALIZE_TEAM) ) { }
    main_EnterDungeon(-1, 0);
    hold;
    end;
}
