
def 0 {
    switch ( ProcessSpecial(PROCESS_SPECIAL_SET_TEAM_SETUP_HERO_AND_PARTNER_ONLY, 0, 0) ) { }
    $PERFORMANCE_PROGRESS_LIST[5] = 0;
    bgm_PlayFadeIn(BGM_WIGGLYTUFFS_GUILD, 0, 256);
    message_SetFace(ACTOR_NPC_PERAPPU, FACE_HAPPY, FACE_POS_STANDARD);
    message_Talk({
        english="""
             Good. ♪ You appear to be in full
            readiness. ♪
        """,
    });
    message_Talk({
        english="""
             When the other apprentices
            assemble, I shall commence the briefing.
            Until then, just wait. ♪
        """,
    });
    message_Close();
    bgm_FadeOut(60);
    screen_FadeOut(1, 30);
    back_SetGround(LEVEL_G01P04A);
    supervision_Acting(0);
    supervision_Acting(1);
    camera_SetMyself<performer 0>();
    Wait(30);
    SetPositionInitial<actor ACTOR_NPC_PERAPPU>();
    SetAnimation<actor ACTOR_NPC_PERAPPU>(2);
    screen_FadeIn(1, 30);
    bgm_PlayFadeIn(BGM_WIGGLYTUFFS_GUILD_REMIX, 0, 256);
    Wait(30);
    message_SetFace(ACTOR_NPC_PERAPPU, FACE_NORMAL, FACE_POS_TOP_R_FACEINW);
    message_Talk({
        english=" All accounted for, it appears.",
    });
    message_Talk({
        english="""
             Well then. Let me explain 
            about this expedition. ♪
        """,
    });
    message_Talk({
        english="""
             First, the objective: exploration
            of [CS:P]Fogbound Lake[CR].
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    se_Play(8962);
    SetEffect<actor ACTOR_ATTENDANT1>(EFFECT_QUESTION_MARK, 3);
    WaitEffect<actor ACTOR_ATTENDANT1>();
    WaitExecuteLives(ACTOR_ATTENDANT1);
    message_SetFace(ACTOR_ATTENDANT1, FACE_WORRIED, FACE_POS_BOTTOM_R_FACEINW);
    message_FacePositionOffset(1, 0);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" [CS:P]Fogbound Lake[CR]?",
            }
        case 2:
            {
                english=" [CS:P]Fogbound Lake[CR]?",
            }
        default:
            {
                english=" [CS:P]Fogbound Lake[CR]?",
            }
    }
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2Direction<actor ACTOR_NPC_PERAPPU>(4, 10, DIR_DOWNRIGHT);
    WaitExecuteLives(ACTOR_NPC_PERAPPU);
    message_SetFace(ACTOR_NPC_PERAPPU, FACE_NORMAL, FACE_POS_TOP_RC_FACER);
    message_Talk({
        english="""
             Correct. It is a lake that is said
            to be located far to the east.
        """,
    });
    message_Talk({
        english="""
             However, it is perpetually
            enshrouded by a dense fog. As such, its actual
            existence has never been confirmed...
        """,
    });
    message_Talk({
        english="""
             It is merely the foggy mirage of
            a spot that lives to this day on rumor alone.
        """,
    });
    message_Talk({
        english=" It is also rumored...",
    });
    message_Talk({
        english="""
             A treasure of exquisite beauty
            is hidden there! ♪
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    ExecuteCommon<actor ACTOR_ATTENDANT1>(CORO_JUMP_HAPPY_FUNC_SERIES, 0);
    WaitExecuteLives(ACTOR_ATTENDANT1);
    message_SetFace(ACTOR_ATTENDANT1, FACE_INSPIRED, FACE_POS_BOTTOM_R_FACEINW);
    message_FacePositionOffset(1, 0);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     Wow! Treasure?! We're going
                    on a treasure hunt!
                """,
            }
        case 2:
            {
                english="""
                     Wow! Treasure?! We're going
                    on a treasure hunt!
                """,
            }
        default:
            {
                english="""
                     Wow! Treasure?! We're going
                    on a treasure hunt!
                """,
            }
    }
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" This is so exciting!",
            }
        case 2:
            {
                english=" This is so exciting!",
            }
        default:
            {
                english=" This is so exciting!",
            }
    }
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    SetEffect<actor ACTOR_NPC_PUKURIN>(EFFECT_LAUGHING, 3);
    message_SetFace(ACTOR_NPC_PUKURIN, FACE_HAPPY, FACE_POS_TOP_L_CENTER);
    message_Talk({
        english=" Yup! It will be fun, fun, fun! ♪",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    SetEffect<actor ACTOR_NPC_PUKURIN>(EFFECT_NONE, 3);
    Turn2Direction<actor ACTOR_NPC_PERAPPU>(4, 10, DIR_DOWN);
    WaitExecuteLives(ACTOR_NPC_PERAPPU);
    message_SetFace(ACTOR_NPC_SUKATANKU, FACE_NORMAL, FACE_POS_TOP_L_FACEINW);
    message_FacePositionOffset(0, -3);
    message_Talk({
        english=" (Chaw-haw-haw.)",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_PERAPPU, FACE_NORMAL, FACE_POS_TOP_R_FACEINW);
    message_Talk({
        english="""
             Everyone, open your Wonder
            Maps, please.
        """,
    });
    message_Close();
    se_Play(6667);
    screen_FadeOut(1, 15);
    end;
}
