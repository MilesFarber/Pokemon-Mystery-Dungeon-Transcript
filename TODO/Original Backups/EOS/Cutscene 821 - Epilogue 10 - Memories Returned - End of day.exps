
def 0 {
    sound_Stop();
    back_SetGround(LEVEL_H01P99A);
    supervision_StationCommon(0);
    supervision_Acting(0);
    camera_SetMyself<performer 0>();
    bgm_PlayFadeIn(BGM_OCEAN1, 90, 256);
    screen_FadeIn(1, 30);
    Wait(30);
    message_SetFace(ACTOR_ATTENDANT1, FACE_NORMAL, FACE_POS_STANDARD);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" I'm beat! It was a long day!",
            }
        case 2:
            {
                english="""
                     We put in a full day today.
                    I'm exhausted.
                """,
            }
        default:
            {
                english="""
                     We worked hard all day long.
                    I'm tired!
                """,
            }
    }
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" We should get some rest now.",
            }
        case 2:
            {
                english=" We should get some sleep now.",
            }
        default:
            {
                english=" We should get some sleep now.",
            }
    }
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     That way, we can put in another
                    good effort tomorrow.
                """,
            }
        case 2:
            {
                english="""
                     We can be rested up for another
                    good day tomorrow.
                """,
            }
        default:
            {
                english="""
                     We'll need it for another full
                    day tomorrow.
                """,
            }
    }
    message_Close();
    bgm_FadeOut(120);
    screen_FadeOut(1, 60);
    WaitBgm(BGM_OCEAN1);
    Wait(30);
    end;
}
