def 1 for actor ACTOR_NPC_GURAADON {
    SetAnimation(24);
    WaitAnimation();
    Unlock(3);
    @label_0;
    forever {
        SetAnimation(2);
        SetOutputAttribute(32);
        WaitRandom(150, 240);
        SetAnimation(24);
        WaitAnimation();
        continue;  // may be redundant
    }
}
