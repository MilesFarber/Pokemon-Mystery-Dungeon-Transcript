    Wait(90);
    message_Mail({
        english="""
            [CN]The Special Episode
            [CN]"In the Future of Darkness"
            [CN]stars [CS:Y]Grovyle[CR] as the main character.
        """,
    });
    message_Mail({
        english="""
            [CN]You will progress through the story with
            [CN][CS:Y]Grovyle[CR] as the playable character.
        """,
    });
    message_Close();
    main_EnterDungeon(133, 30);
    switch ( message_Menu(MENU_DUNGEON_INITIALIZE_TEAM) ) { }
    main_EnterDungeon(-1, 30);
    hold;
    end;
}
