    WaitExecuteLives(ACTOR_PLAYER);
    message_SetFace(ACTOR_ATTENDANT1, FACE_WORRIED, FACE_POS_STANDARD);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" That![K] Did you hear that?!",
            }
        case 2:
            {
                english=" Just now...[K] Did you hear that?",
            }
        default:
            {
                english=" Just now...[K] Did you hear that?",
            }
    }
