
def 0 {
    bgm_PlayFadeIn(BGM_OCEAN1, 0, 256);
    back_SetGround(LEVEL_P10P01A);
    supervision_Acting(0);
    camera_SetMyself<performer 0>();
    Wait(1);
    ResetOutputAttribute<actor ACTOR_NPC_RAPURASU>(256);
    SetEffect<actor ACTOR_NPC_RAPURASU>(646, 4);
    screen_FadeIn(1, 30);
    MovePositionMark<actor ACTOR_NPC_RAPURASU>(0.5, Position<'m0', 20.5, 15.5>);
    WaitExecuteLives(ACTOR_NPC_RAPURASU);
    Wait(30);
    message_SetFace(ACTOR_NPC_PUKURIN, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english=" [CS:N]Lapras[CR]![K] Long time no see! ♪",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_RAPURASU, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english="""
             It's been too long, [CS:N]Wigglytuff[CR].[K]
            You look well.
        """,
    });
    message_Talk({
        english=" Is [CS:N]Chatot[CR] doing well too?",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_PUKURIN, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english=" Yes![K] Very well! ♪",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_RAPURASU, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english=" I'm glad to hear that!",
    });
    message_Talk({
        english=" I've always meant to thank you.",
    });
    message_Talk({
        english="""
             I deeply appreciate the promise
            you made...and upheld for all this time.
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_PUKURIN, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english=" No problem! ♪ No big deal! ♪",
    });
    message_Talk({
        english="""
             But today...[K] I am here to see
            you about that promise.
        """,
    });
    message_Talk({
        english="""
             We find ourselves in a situation
            where we can't afford to uphold that promise.
            I suspect that you know why.
        """,
    });
    message_Talk({
        english=" So please tell me...",
    });
    message_Talk({
        english="""
             about that...[K]strange pattern we
            once saw.
        """,
    });
    message_Close();
    bgm_FadeOut(120);
    screen_FadeOut(1, 90);
    Wait(60);
    $SCENARIO_MAIN = scn[24, 0];
    end;
}
