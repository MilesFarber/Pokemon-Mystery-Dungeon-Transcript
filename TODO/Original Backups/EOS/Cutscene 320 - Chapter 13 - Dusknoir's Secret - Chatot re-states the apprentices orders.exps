
def 0 {
    sound_Stop();
    back_SetGround(LEVEL_G01P04A);
    supervision_LoadStation(LEVEL_G01P04A, 'UM16');
    supervision_Station(1);
    supervision_Acting(0);
    supervision_Acting(1);
    supervision_Acting(2);
    SetPositionInitial<actor ACTOR_NPC_PERAPPU>();
    SetPositionInitial<actor ACTOR_NPC_DOGOOMU>();
    SetAnimation<actor ACTOR_NPC_PERAPPU>(2);
    SetAnimation<actor ACTOR_NPC_DOGOOMU>(2);
    camera_SetMyself<performer 0>();
    screen_FadeIn(1, 30);
    bgm_PlayFadeIn(BGM_WIGGLYTUFFS_GUILD, 0, 256);
    Wait(30);
    message_SetFace(ACTOR_NPC_PERAPPU, FACE_NORMAL, FACE_POS_TOP_R_FACEINW);
    message_Talk({
        english=" ...That's the current situation!",
    });
    message_Talk({
        english="""
             Until everything is resolved, we
            ask that you go about your regular duties.
        """,
    });
    message_Talk({
        english="""
             Yes, we would like you to spread
            the rumor as much as possible...
        """,
    });
    message_Talk({
        english="""
             But not so much that it would
            make [CS:N]Grovyle[CR] suspicious.
        """,
    });
    message_Talk({
        english=" Try to be natural! ♪",
    });
    message_Talk({
        english="""
             Go about your jobs in the usual
            manner.[K] And, when possible, spread the rumor.
        """,
    });
    message_Talk({
        english="""
             That is what we would like you
            to do for at least the next few days.
        """,
    });
    message_Talk({
        english=" That is all!",
    });
    message_Talk({
        english="""
             All right, everyone! Let's have
            another good day of work! ♪
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    SetEffect<actor ACTOR_NPC_DAGUTORIO>(EFFECT_JOYOUS, 3);
