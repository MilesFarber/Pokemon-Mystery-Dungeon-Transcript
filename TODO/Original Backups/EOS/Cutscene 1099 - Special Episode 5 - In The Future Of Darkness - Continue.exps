
def 0 {
    Turn2Direction<actor ACTOR_PLAYER_FUTURE>(4, 10, DIR_UP);
    WaitExecuteLives(ACTOR_PLAYER_FUTURE);
    message_ResetActor();
    message_Mail({
        english="[CN]Would you like to go on?",
    });
    switch ( message_SwitchMenu(0, 1) ) {
        case menu({
            english="Yes",
        }):
        default:
            @label_0;
            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
            if ( scn($SCENARIO_SIDE) >= [48, 8] ) {
                @label_2;
                main_EnterDungeon(147, 30);
                main_EnterDungeon(-1, 30);
                hold;
            } else {
                $SCENARIO_SIDE = scn[48, 8];
                jump @label_2;
            }
            break;
        case menu({
            english="No",
        }):
            message_Close();
            end;
    }
}
