
def 0 {
    bgm_PlayFadeIn(BGM_TIME_GEAR_REMIX, 0, 256);
    back_SetGround(LEVEL_V05P02A);
    supervision_Acting(0);
    camera_SetMyself<performer 0>();
    screen_FadeIn(1, 30);
    Wait(60);
    message_SetActor(ACTOR_NPC_PERAPPU);
    message_Talk({
        english="""
             Dewdrops on leaves won't fall...
            They just hang there, suspended.
        """,
    });
    message_Talk({
        english="""
             In [CS:P]Treeshroud Forest[CR], time itself
            has truly stopped.
        """,
    });
    message_Close();
    screen_FadeOut(1, 30);
    end;
}
