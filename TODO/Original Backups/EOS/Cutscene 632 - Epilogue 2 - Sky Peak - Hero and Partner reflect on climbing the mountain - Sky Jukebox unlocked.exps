                        """,
                    }
            }
            message_Close();
            SetAnimation<actor ACTOR_PLAYER>(71);
            WaitAnimation<actor ACTOR_PLAYER>();
            WaitExecuteLives(ACTOR_PLAYER);
            SetAnimation<actor ACTOR_PLAYER>(71);
            WaitAnimation<actor ACTOR_PLAYER>();
            WaitExecuteLives(ACTOR_PLAYER);
            SetAnimation<actor ACTOR_PLAYER>(2);
            Wait(30);
            Turn2Direction<actor ACTOR_PLAYER>(4, 10, DIR_DOWN);
            Turn2Direction<actor ACTOR_ATTENDANT1>(4, 10, DIR_DOWN);
            WaitExecuteLives(ACTOR_PLAYER);
            WaitExecuteLives(ACTOR_ATTENDANT1);
            Wait(20);
            SetAnimation<actor ACTOR_PLAYER>(66);
            SetAnimation<actor ACTOR_ATTENDANT1>(66);
            WaitAnimation<actor ACTOR_PLAYER>();
            WaitAnimation<actor ACTOR_ATTENDANT1>();
            Wait(80);
            SetAnimation<actor ACTOR_PLAYER>(2);
            SetAnimation<actor ACTOR_ATTENDANT1>(2);
            Wait(45);
            bgm_FadeOut(120);
            screen2_FadeOut(0, 30);
            screen_FadeOut(1, 30);
            back2_SetMode(0);
            Wait(90);
            me_Play(7);
            message_Explanation({
                english="""
                    [CN]A message has arrived from the
                    [CN]Exploration Team Federation...[W:30]
                """,
            });
            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
            message_Explanation({
                english="[CN]If you want to hear that song again...",
            });
            message_KeyWait();
            me_Play(1);
            message_Explanation({
                english="""
                    [CN]There's now a machine available for you to
                    [CN]listen to the game music anytime!
                    [CN]The Sky Jukebox is now available![W:100]
                """,
            });
            message_Explanation({
                english="""
                    [CN]To access the Sky Jukebox, select
                    [CN]Other from the Top Menu.
                """,
            });
            message_Explanation({
                english="""
                    [CN]To use the Sky Jukebox, save your adventure
                    [CN]and return to the Top Menu.
                """,
            });
            message_Close();
            Wait(30);
            camera_SetDefault();
            screen2_FadeIn(0, 30);
            screen_FadeIn(1, 30);
            bgm_PlayFadeIn(BGM_DO_YOUR_BEST_AS_ALWAYS, 0, 256);
            end;
        case menu({
            english="Nope...",
        }):
        default:
            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
            SetEffect<actor ACTOR_ATTENDANT1>(EFFECT_LAUGHING, 3);
            message_SetFace(ACTOR_ATTENDANT1, FACE_JOYOUS, FACE_POS_STANDARD);
            message_SwitchTalk ($PARTNER_TALK_KIND) {
                case 1:
                    {
                        english="""
                             Ah ha ha ha ha ha!
                            Stayed up too late. Still half asleep!
                        """,
                    }
                case 2:
                    {
                        english="""
                             Ah ha ha ha ha ha!
                            Stayed up too late. Still half asleep!
                        """,
                    }
                default:
                    {
                        english="""
                             Ah ha ha ha ha ha!
                            Stayed up too late. Still half asleep!
                        """,
                    }
            }
            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
            SetEffect<actor ACTOR_ATTENDANT1>(EFFECT_NONE, 3);
            jump @label_2;
