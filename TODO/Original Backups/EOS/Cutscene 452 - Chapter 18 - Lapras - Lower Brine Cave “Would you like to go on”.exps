
def 0 {
    bgm_PlayFadeIn(BGM_LOWER_BRINE_CAVE, 0, 256);
    SetAnimation<actor ACTOR_PLAYER>(2);
    SetAnimation<actor ACTOR_ATTENDANT1>(2);
    WaitExecuteLives(ACTOR_ATTENDANT1);
    Turn2Direction<actor ACTOR_PLAYER>(4, 10, DIR_UP);
    Turn2Direction<actor ACTOR_ATTENDANT1>(4, 10, DIR_UP);
    WaitExecuteLives(ACTOR_ATTENDANT1);
    message_Mail({
        english="[CN]Would you like to go on?",
    });
    switch ( message_SwitchMenu(0, 1) ) {
        case menu({
            english="Yes",
        }):
        default:
            @label_0;
            message_Close();
            MovePositionMark<actor ACTOR_PLAYER>(1, Position<'m0', 28.5, 3.5>);
            Wait(10);
            MovePositionMark<actor ACTOR_ATTENDANT1>(1, Position<'m1', 28.5, 3.5>);
            Wait(30);
            screen_FadeOut(1, 30);
            main_EnterDungeon(36, 0);
            main_EnterDungeon(-1, 0);
            hold;
            end;
        case menu({
            english="No",
        }):
            message_Close();
            end;
    }
}
