
def 0 {
    sound_Stop();
    back_SetGround(LEVEL_V05P01A);
    supervision_Acting(0);
    camera_SetMyself<performer 0>();
    screen_FadeIn(1, 30);
    bgm_PlayFadeIn(BGM_TIME_GEAR_REMIX, 0, 256);
    Wait(30);
    message_SetActor(ACTOR_NPC_PERAPPU);
    message_Talk({
        english="""
             Time has come to a standstill in
            [CS:P]Treeshroud Forest[CR]...[K] The wind has stopped...
            The clouds are motionless...
        """,
    });
    message_Close();
    screen_FadeOut(1, 30);
    end;
}
