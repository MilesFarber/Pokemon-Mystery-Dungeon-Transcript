    Lock(7);
    Turn2Direction(4, 10, DIR_RIGHT);
    Lock(8);
    Turn2Direction(4, 10, DIR_DOWNRIGHT);
    Lock(9);
    Turn2Direction(32, 10, DIR_DOWN);
    Wait(32);
    SetEffect(EFFECT_JOYOUS, 3);
    CallCommon(CORO_JUMP_ANGRY_FUNC);
    Lock(10);
    hold;
}

