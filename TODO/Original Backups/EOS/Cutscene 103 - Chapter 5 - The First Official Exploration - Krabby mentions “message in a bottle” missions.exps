    Turn2DirectionLives<actor ACTOR_PLAYER>(4, 10, ACTOR_ATTENDANT1);
    message_SetFace(ACTOR_ATTENDANT1, FACE_NORMAL, FACE_POS_STANDARD);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     Sounds like they're only washing
                    up now and then...
                """,
            }
        case 2:
            {
                english="""
                     Sounds like they're only washing
                    up now and then...
                """,
            }
        default:
            {
                english="""
                     Sounds like they're only washing
                    up now and then...
                """,
            }
    }
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     Whenever we head to the beach,
