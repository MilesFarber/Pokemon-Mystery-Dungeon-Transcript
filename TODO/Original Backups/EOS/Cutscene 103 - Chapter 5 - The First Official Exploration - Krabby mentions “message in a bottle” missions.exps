    Move2PositionMark<actor ACTOR_NPC_KURABU>(1.1992, Position<'m3', 27, 21.5>);
    WaitExecuteLives(ACTOR_NPC_KURABU);
    SetAnimation<actor ACTOR_NPC_KURABU>(3);
