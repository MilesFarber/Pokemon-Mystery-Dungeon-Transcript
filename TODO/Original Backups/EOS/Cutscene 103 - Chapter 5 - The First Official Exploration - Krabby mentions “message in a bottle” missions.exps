    SetEffect<actor ACTOR_NPC_KURABU>(EFFECT_EXCLAMATION_MARK, 3);
    SetEffect<actor ACTOR_PLAYER>(EFFECT_EXCLAMATION_MARK, 3);
    SetEffect<actor ACTOR_ATTENDANT1>(EFFECT_EXCLAMATION_MARK, 3);
