    WaitExecuteLives(ACTOR_NPC_KURABU);
    message_SetFace(ACTOR_NPC_KURABU, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english="""
             Ahoy![K]
            Are you headed to the beach?
        """,
    });
    message_Talk({
        english=" Well...",
    });
    message_Talk({
        english="""
             Would you keep an eye out for
            something, if you could?
        """,
    });
    message_Talk({
        english="""
             Recently...[K]there have been
            Bottles washing up on the beach...
        """,
    });
    message_Talk({
        english="""
             It looks as though there's
            something inside those Bottles...
        """,
    });
    message_Talk({
        english="""
             If that sounds interesting, you
            might want to look for Bottles on the beach.
        """,
    });
    message_Close();
    SetAnimation<actor ACTOR_NPC_KURABU>(5);
    MovePositionOffset<actor ACTOR_NPC_KURABU>(1, 0, -200);
    Wait(20);
    Turn2Direction<actor ACTOR_ATTENDANT1>(16, 2, DIR_UP);
    Turn2Direction<actor ACTOR_PLAYER>(16, 10, DIR_UP);
    WaitExecuteLives(ACTOR_NPC_KURABU);
    supervision_RemoveActing(1);
    message_SetFace(ACTOR_ATTENDANT1, FACE_NORMAL, FACE_POS_STANDARD);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     Bottles washing up on
                    the beach...
                """,
            }
        case 2:
            {
                english="""
                     Bottles washing up on
                    the beach...
                """,
            }
        default:
            {
                english="""
                     Bottles washing up on
                    the beach...
                """,
            }
    }
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     Bottles with something
                    in them...
                """,
            }
        case 2:
            {
                english="""
                     Bottles with something
                    in them...
                """,
            }
        default:
            {
                english="""
                     Bottles with something
                    in them...
                """,
            }
    }
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" I'm sold. Let's check it out.",
            }
        case 2:
            {
                english=" I'm interested...",
            }
        default:
            {
                english=" Sounds interesting...",
            }
    }
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2DirectionLives<actor ACTOR_ATTENDANT1>(4, 10, ACTOR_PLAYER);
