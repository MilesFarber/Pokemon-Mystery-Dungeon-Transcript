
def 0 {
    bgm_PlayFadeIn(BGM_HIDDEN_LAND, 0, 256);
    SetAnimation<actor ACTOR_PLAYER>(2);
    SetAnimation<actor ACTOR_ATTENDANT1>(2);
    SetAnimation<actor ACTOR_NPC_JUPUTORU>(2);
    Turn2DirectionLives<actor ACTOR_PLAYER>(4, 10, ACTOR_ATTENDANT1);
    Turn2DirectionLives<actor ACTOR_ATTENDANT1>(4, 10, ACTOR_PLAYER);
    message_SetFace(ACTOR_ATTENDANT1, FACE_NORMAL, FACE_POS_STANDARD);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     Hey, [hero]. Are you all
                    ready?
                """,
            }
        case 2:
            {
                english="""
                     Hi, [hero]. Are you
                    ready?
                """,
            }
        default:
            {
                english="""
                     Hi, [hero]. Are you
                    ready?
                """,
            }
    }
    switch ( message_SwitchMenu(0, 1) ) {
        case menu({
            english="Yes",
        }):
        default:
            @label_0;
            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
            message_SwitchTalk ($PARTNER_TALK_KIND) {
                case 1:
                    {
                        english=" Yup! Looks like we're all set.",
                    }
                case 2:
                    {
                        english=" Yes. Looks like we're ready.",
                    }
                default:
                    {
                        english=" Yep! I guess we're ready to go.",
                    }
            }
            message_Close();
            SetPositionMark<actor ACTOR_NPC_JUPUTORU>(Position<'m0', 28.5, 37.5>);
            Turn2DirectionLives<actor ACTOR_PLAYER>(4, 10, ACTOR_NPC_JUPUTORU);
            Turn2DirectionLives<actor ACTOR_ATTENDANT1>(4, 10, ACTOR_NPC_JUPUTORU);
            MovePositionMark<actor ACTOR_NPC_JUPUTORU>(1.1992, Position<'m1', 28.5, 27>);
            WaitExecuteLives(ACTOR_NPC_JUPUTORU);
            message_SwitchTalk ($PARTNER_TALK_KIND) {
                case 1:
                    {
                        english=" All right! Let's roll out!",
                    }
                case 2:
                    {
                        english=" OK! Let's go!",
                    }
                default:
                    {
                        english=" OK! Let's go!",
                    }
            }
            message_Close();
            MovePositionMark<actor ACTOR_PLAYER>(1, Position<'m2', 28.5, 8.5>);
            Wait(10);
            MovePositionMark<actor ACTOR_ATTENDANT1>(1, Position<'m3', 28.5, 8.5>);
            Wait(10);
            MovePositionMark<actor ACTOR_NPC_JUPUTORU>(1, Position<'m4', 28.5, 8.5>);
            if ( scn($SCENARIO_MAIN) >= [25, 2] ) {
                @label_2;
                main_EnterDungeon(38, 30);
                switch ( message_Menu(MENU_DUNGEON_INITIALIZE_TEAM) ) { }
                main_EnterDungeon(-1, 30);
                hold;
                end;
            } else {
                $SCENARIO_MAIN = scn[25, 2];
                jump @label_2;
            }
            break;
        case menu({
            english="Not yet",
        }):
            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
            message_SwitchTalk ($PARTNER_TALK_KIND) {
                case 1:
                    {
                        english=" All right.",
                    }
                case 2:
                    {
                        english=" OK.",
                    }
                default:
                    {
                        english=" OK.",
                    }
            }
            message_SwitchTalk ($PARTNER_TALK_KIND) {
                case 1:
                    {
                        english=" We'll go when you're ready.",
                    }
                case 2:
                    {
                        english=" Let's go when you're ready.",
                    }
                default:
                    {
                        english=" Let's go when you're ready.",
                    }
            }
            message_Close();
            end;
    }
}
