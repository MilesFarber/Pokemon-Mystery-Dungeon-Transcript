        case 1:
            {
                english=" [CS:N]Wigglytuff[CR]...",
            }
        case 2:
            {
                english=" [CS:N]Wigglytuff[CR]...",
            }
        default:
            {
                english=" [CS:N]Wigglytuff[CR]...",
            }
    }
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    SetEffect<actor ACTOR_NPC_CHIRIIN>(EFFECT_JOYOUS, 3);
    Turn2Direction<actor ACTOR_ATTENDANT1>(4, 10, DIR_LEFT);
    Turn2Direction<actor ACTOR_PLAYER>(4, 10, DIR_LEFT);
    message_SetFace(ACTOR_NPC_CHIRIIN, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english="""
             Congratulations, [partner]
            and [hero]!
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    SetEffect<actor ACTOR_NPC_CHIRIIN>(EFFECT_NONE, 3);
    ExecuteCommon<actor ACTOR_NPC_KIMAWARI>(CORO_JUMP_HAPPY_FUNC_SERIES, 0);
    WaitExecuteLives(ACTOR_NPC_KIMAWARI);
    Turn2Direction<actor ACTOR_PLAYER>(4, 10, DIR_DOWNRIGHT);
    Turn2Direction<actor ACTOR_ATTENDANT1>(4, 10, DIR_DOWNRIGHT);
    message_SetFace(ACTOR_NPC_KIMAWARI, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english=" Oh my gosh! How wonderful!",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    ExecuteCommon<actor ACTOR_NPC_HEIGANI>(CORO_JUMP_ANGRY_FUNC_SERIES, 0);
    WaitExecuteLives(ACTOR_NPC_HEIGANI);
    Turn2Direction<actor ACTOR_PLAYER>(4, 10, DIR_UPRIGHT);
    Turn2Direction<actor ACTOR_ATTENDANT1>(4, 10, DIR_UPRIGHT);
    message_SetFace(ACTOR_NPC_HEIGANI, FACE_NORMAL, FACE_POS_TOP_R_FACEINW);
    message_Talk({
        english=" Hey, hey, hey!",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    se_Play(8972);
    SetEffect<actor ACTOR_NPC_BIPPA>(EFFECT_SWEAT_DROPS_FROM_BOTH_SIDES_MEDIUM, 3);
    WaitEffect<actor ACTOR_NPC_BIPPA>();
    WaitExecuteLives(ACTOR_NPC_BIPPA);
    Turn2Direction<actor ACTOR_PLAYER>(4, 10, DIR_DOWN);
    Turn2Direction<actor ACTOR_ATTENDANT1>(4, 10, DIR_DOWNRIGHT);
    message_SetFace(ACTOR_NPC_BIPPA, FACE_TEARY_EYED, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english="""
             Sniff...! I'm so happy for you
            all...[K] I'm...[K] I'm...
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    ExecuteCommon<actor ACTOR_NPC_DOGOOMU>(CORO_JUMP_ANGRY_FUNC_SERIES, 0);
    WaitExecuteLives(ACTOR_NPC_DOGOOMU);
    Turn2Direction<actor ACTOR_ATTENDANT1>(4, 10, DIR_UPLEFT);
    Turn2Direction<actor ACTOR_PLAYER>(4, 10, DIR_UPLEFT);
    message_SetFace(ACTOR_NPC_DOGOOMU, FACE_HAPPY, FACE_POS_TOP_L_FACEINW);
    message_Talk({
        english="""
             Drop in on your old friends now
            and then!
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_ATTENDANT1, FACE_TEARY_EYED, FACE_POS_STANDARD);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" E-everyone...",
            }
        case 2:
            {
                english=" E-everyone...",
            }
        default:
            {
                english=" E-everyone...",
            }
    }
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_PUKURIN, FACE_HAPPY, FACE_POS_TOP_R_CENTER);
    message_Talk({
        english="""
             Congratulations,
            Team [team:]! ♪
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2Direction<actor ACTOR_PLAYER>(4, 10, DIR_UP);
    Wait(5);
    Turn2Direction<actor ACTOR_ATTENDANT1>(4, 10, DIR_UP);
    WaitExecuteLives(ACTOR_ATTENDANT1);
    SetEffect<actor ACTOR_NPC_PUKURIN>(EFFECT_JOYOUS, 3);
    SetEffect<actor ACTOR_NPC_PERAPPU>(EFFECT_JOYOUS, 3);
    SetEffect<actor ACTOR_NPC_CHIRIIN>(EFFECT_JOYOUS, 3);
    SetEffect<actor ACTOR_NPC_KIMAWARI>(EFFECT_JOYOUS, 3);
    SetEffect<actor ACTOR_NPC_HEIGANI>(EFFECT_JOYOUS, 3);
    SetEffect<actor ACTOR_NPC_GUREGGURU>(EFFECT_JOYOUS, 3);
    SetAnimation<actor ACTOR_NPC_DAGUTORIO>(4);
    SetAnimation<actor ACTOR_NPC_CHIRIIN>(4);
    SetAnimation<actor ACTOR_NPC_KIMAWARI>(4);
    SetAnimation<actor ACTOR_NPC_HEIGANI>(4);
    SetAnimation<actor ACTOR_NPC_DIGUDA>(4);
    SetAnimation<actor ACTOR_NPC_DOGOOMU>(4);
    SetAnimation<actor ACTOR_NPC_BIPPA>(4);
    se_Play(7944);
    SetEffect<performer 4>(EFFECT_CONFETTI, 0);
    Wait(10);
    SetEffect<performer 5>(EFFECT_CONFETTI, 0);
    Wait(5);
    SetEffect<performer 6>(EFFECT_CONFETTI, 0);
    Wait(15);
    SetEffect<performer 7>(EFFECT_CONFETTI, 0);
    SetEffect<actor ACTOR_ATTENDANT1>(EFFECT_SWEAT_DROPS_FROM_BOTH_SIDES_MEDIUM, 3);
    WaitEffect<actor ACTOR_ATTENDANT1>();
    WaitExecuteLives(ACTOR_ATTENDANT1);
    message_SetFace(ACTOR_ATTENDANT1, FACE_TEARY_EYED, FACE_POS_STANDARD);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     Oh...[K] E-e-everyone...[K] Thank you,
                    everyone!
                """,
            }
        case 2:
            {
                english="""
                     Oh...[K] E-e-everyone...[K] Thank you,
                    everyone!
                """,
            }
        default:
            {
                english="""
                     Oh...[K] E-e-everyone...[K] Thank you,
                    everyone!
                """,
            }
    }
    message_Close();
    Wait(30);
    se_FadeOut(7944, 120);
    bgm_FadeOut(120);
    screen_FadeOut(1, 90);
    Wait(90);
    me_Play(7);
    message_Explanation({
        english="""
            [CN]The Exploration Team Federation
            [CN]has sent a message...[W:30]
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    me_Play(1);
    message_Explanation({
        english="""
            [CN][hero]'s team was rewarded
            [CN]with an enlarged Treasure Bag![W:100]
        """,
    });
    message_Explanation({
        english="""
            [CN]You can now carry more
            [CN]items than you could before!
        """,
    });
    message_Close();
    Wait(20);
    message_Explanation({
        english="""
            [CN]Also, as start-up funds for
            [CN]the newly affiliated team...
        """,
    });
    message_Explanation({
        english="""
            [CN]Team [team:] received
            [CN][CS:G]10[MP]000[CR][M:S0]!
        """,
    });
    message_Explanation({
        english="[CN]One more thing...",
    });
    message_Close();
    back_SetGround(LEVEL_V17P03A);
    supervision_Acting(10);
    camera_SetMyself<performer 0>();
    screen_FadeIn(1, 15);
    Wait(30);
    me_Play(5);
    message_Mail({
        english="""
            [CN]The Special Episode
            [CN]"In the Future of Darkness"
            [CN]has been unlocked![W:90]
        """,
    });
    message_Mail({
        english="""
            [CN]To play a Special Episode,
            [CN]select it from the Episode List
            [CN]on the Top Menu.
        """,
    });
    message_Mail({
        english="""
            [CN]If you would like to play the Special Episode,
            [CN]save your adventure progress, and
            [CN]return to the Top Menu.
        """,
    });
    message_Close();
    screen_FadeOut(1, 30);
    Wait(60);
    bgm_PlayFadeIn(BGM_PERFECT_SENTRY_DUTY, 0, 256);
    message_Explanation({
        english="""
            [CN]Congratulations, Team [team:]!
            [CN]You graduated![W:240]
        """,
    });
    message_Close();
    $CARRY_GOLD += 10000;
    Wait(60);
    end;
}
