
def 0 {
    bgm_PlayFadeIn(BGM_IN_THE_DEPTHS_OF_THE_PIT, 0, 256);
    SetAnimation<actor ACTOR_ATTENDANT1>(2);
    SetAnimation<actor ACTOR_UNIT_NPC1>(2);
    SetAnimation<actor ACTOR_UNIT_NPC2>(2);
    Turn2DirectionLives<actor ACTOR_ATTENDANT1>(4, 10, ACTOR_PLAYER);
    WaitExecuteLives(ACTOR_ATTENDANT1);
    message_SetFace(ACTOR_ATTENDANT1, FACE_NORMAL, FACE_POS_STANDARD);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     I guess you really are onto
                    something.
                """,
            }
        case 2:
            {
                english="""
                     I guess you really have an idea
                    about what to do.
                """,
            }
        default:
            {
                english="""
                     I guess you're really
                    convinced now.
                """,
            }
    }
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     All right. This is your call,
                    [hero].
                """,
            }
        case 2:
            {
                english="""
                     OK. I'll leave it up to you,
                    [hero].
                """,
            }
        default:
            {
                english="""
                     OK. You should do whatever you
                    need to, [hero].
                """,
            }
    }
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     Go on and solve the secret of
                    the three crystals!
                """,
            }
        case 2:
            {
                english="""
                     See if you can solve the secret
                    of the three crystals!
                """,
            }
        default:
            {
                english="""
                     Try solving the secret of the
                    three crystals!
                """,
            }
    }
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_PLAYER, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_SwitchMonologue ($HERO_TALK_KIND) {
        case 4:
            {
                english="""
                    (Each of these three crystals changes color
                    every time it's touched.)
                """,
            }
        default:
            {
                english="""
                    (Each of these three crystals changes color
                    every time it's touched.)
                """,
            }
    }
    message_SwitchMonologue ($HERO_TALK_KIND) {
        case 4:
            {
                english="""
                    (These three crystals should be changed to the
                    same color.)
                """,
            }
        default:
            {
                english="""
                    (These three crystals should be changed to the
                    same color.)
                """,
            }
    }
    message_SwitchMonologue ($HERO_TALK_KIND) {
        case 4:
            {
                english="(And that color is...?)",
            }
        default:
            {
                english="(And that color is...?)",
            }
    }
    message_SwitchMonologue ($HERO_TALK_KIND) {
        case 4:
            {
                english="(Let's give it a try!)",
            }
        default:
            {
                english="(Let's give it a try!)",
            }
    }
    message_Close();
    end;
}
