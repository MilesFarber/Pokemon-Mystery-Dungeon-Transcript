
def 0 {
    bgm_PlayFadeIn(BGM_HEARTWARMING, 0, 256);
    supervision_Acting(0);
    SetAnimation<actor ACTOR_NPC_PUKURIN_PAPA>(2);
    SetAnimation<actor ACTOR_NPC_PUKURIN_MAMA>(2);
    MovePositionMark<actor ACTOR_PLAYER_PUPURIN>(1, Position<'m0', 31.5, 35.5>);
    WaitExecuteLives(ACTOR_PLAYER_PUPURIN);
    SetAnimation<actor ACTOR_PLAYER_PUPURIN>(2);
    Turn2Direction<actor ACTOR_PLAYER_PUPURIN>(4, 10, DIR_UP);
    WaitExecuteLives(ACTOR_PLAYER_PUPURIN);
    SetEffect<actor ACTOR_PLAYER_PUPURIN>(EFFECT_LAUGHING, 3);
    message_SetFace(ACTOR_PLAYER_PUPURIN, FACE_HAPPY, FACE_POS_STANDARD);
    message_Talk({
        english=" OK, I'm off! ♪",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Wait(15);
    SetEffect<actor ACTOR_PLAYER_PUPURIN>(EFFECT_NONE, 3);
    SetPositionLives<performer 0>(6);
    camera_SetMyself<performer 0>();
    MovePositionMark<performer 0>(1, Position<'m1', 31.5, 35.5>);
    WaitExecutePerformer(0);
    MovePositionMark<performer 0>(1, Position<'m2', 31.5, 28>);
    Wait(15);
    Turn2Direction<actor ACTOR_NPC_PUKURIN_PAPA>(4, 10, DIR_DOWN);
    Wait(4);
    Turn2Direction<actor ACTOR_NPC_PUKURIN_MAMA>(4, 10, DIR_DOWN);
    WaitExecuteLives(ACTOR_NPC_PUKURIN_MAMA);
    WaitExecutePerformer(0);
    Wait(15);
    SetEffect<actor ACTOR_NPC_PUKURIN_PAPA>(EFFECT_LAUGHING, 3);
    message_SetFace(ACTOR_NPC_PUKURIN_PAPA, FACE_HAPPY, FACE_POS_TOP_R_FACEINW);
    message_FacePositionOffset(-1, -3);
    message_Talk({
        english=" See you later!",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Wait(15);
    SetEffect<actor ACTOR_NPC_PUKURIN_PAPA>(EFFECT_NONE, 3);
    SetEffect<actor ACTOR_NPC_PUKURIN_MAMA>(EFFECT_LAUGHING, 3);
    message_SetFace(ACTOR_NPC_PUKURIN_MAMA, FACE_HAPPY, FACE_POS_TOP_L_CENTER);
    message_FacePositionOffset(3, -1);
    message_Talk({
        english=" Take care!",
    });
    message_Close();
    MovePositionOffset<actor ACTOR_PLAYER_PUPURIN>(1, 0, 48);
    Wait(15);
    SetEffect<actor ACTOR_NPC_PUKURIN_MAMA>(EFFECT_NONE, 3);
    if ( scn($SCENARIO_SIDE) == [41, 3] ) {
        @label_0;
        bgm_FadeOut(60);
        screen_FadeOut(1, 60);
        Wait(30);
        @label_3;
        end;
    } elseif ( scn($SCENARIO_SIDE) == [42, 0] ) {
        screen_FadeOut(1, 30);
        jump @label_3;
    } else {
        @label_2;
        bgm_FadeOut(30);
        screen_FadeOut(1, 30);
        jump @label_3;
    }
}
