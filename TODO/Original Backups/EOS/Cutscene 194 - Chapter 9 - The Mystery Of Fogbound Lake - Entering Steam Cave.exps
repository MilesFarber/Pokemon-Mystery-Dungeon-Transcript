
def 0 {
    bgm_PlayFadeIn(BGM_STEAM_CAVE, 0, 256);
    SetAnimation<actor ACTOR_PLAYER>(2);
    SetAnimation<actor ACTOR_ATTENDANT1>(2);
    WaitExecuteLives(ACTOR_ATTENDANT1);
    Turn2DirectionLives<actor ACTOR_ATTENDANT1>(4, 10, ACTOR_PLAYER);
    WaitExecuteLives(ACTOR_ATTENDANT1);
    Turn2DirectionLives<actor ACTOR_PLAYER>(4, 10, ACTOR_ATTENDANT1);
    message_SetFace(ACTOR_ATTENDANT1, FACE_NORMAL, FACE_POS_STANDARD);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" Ready to head in, [hero]?",
            }
        case 2:
            {
                english=" Ready to go in, [hero]?",
            }
        default:
            {
                english=" Ready to go in, [hero]?",
            }
    }
    switch ( message_SwitchMenu(0, 1) ) {
        case menu({
            english="Yes",
        }):
            @label_0;
            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
            message_SwitchTalk ($PARTNER_TALK_KIND) {
                case 1:
                    {
                        english=" Let's do our best, [hero]!",
                    }
                case 2:
                    {
                        english=" Let's try our best, [hero]!",
                    }
                default:
                    {
                        english="""
                             OK, let's give it our very best,
                            [hero]!
                        """,
                    }
            }
            message_Close();
            Turn2Direction<actor ACTOR_PLAYER>(4, 10, DIR_UP);
            Turn2Direction<actor ACTOR_ATTENDANT1>(4, 10, DIR_UP);
            if ( scn($SCENARIO_MAIN) == [11, 1] ) {
                screen_FadeOut(1, 30);
                supervision_ExecuteCommon(CORO_EVENT_M10_03);
                hold;
            } else {
                main_EnterDungeon(14, 30);
                switch ( message_Menu(MENU_DUNGEON_INITIALIZE_TEAM) ) { }
                main_EnterDungeon(-1, 30);
                hold;
            }
            break;
        case menu({
            english="Not yet",
        }):
            @label_1;
            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
            message_SwitchTalk ($PARTNER_TALK_KIND) {
                case 1:
                    {
                        english=" All right, then!",
                    }
                case 2:
                    {
                        english=" OK, then!",
                    }
                default:
                    {
                        english=" OK, then!",
                    }
            }
            message_SwitchTalk ($PARTNER_TALK_KIND) {
                case 1:
                    {
                        english=" Let's go as soon as you're ready!",
                    }
                case 2:
                    {
                        english=" We'll go when you're ready.",
                    }
                default:
                    {
                        english=" Let's go when you're ready.",
                    }
            }
            message_Close();
            end;
        default:
            jump @label_1;
    }
}
