    Turn2DirectionLives<actor ACTOR_NPC_DAGUTORIO>(4, 10, ACTOR_ATTENDANT1);
    Turn2DirectionLives<actor ACTOR_NPC_DIGUDA>(4, 10, ACTOR_ATTENDANT1);
    WaitExecuteLives(ACTOR_NPC_DIGUDA);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     So everyone's back from their
