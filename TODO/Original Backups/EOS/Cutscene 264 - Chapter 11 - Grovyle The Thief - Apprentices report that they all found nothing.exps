                """,
            }
        case 2:
            {
                english="""
                     So everyone's back from their
                    searches...
                """,
            }
        default:
            {
                english="""
                     So everyone's back from their
                    searches...
                """,
            }
    }
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" But nobody found anything?",
            }
        case 2:
            {
                english=" But nobody found anything?",
            }
        default:
            {
                english=" But nobody found anything?",
            }
    }
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    se_Play(8972);
    SetEffect<actor ACTOR_NPC_DAGUTORIO>(EFFECT_SWEAT_DROPS_FROM_BOTH_SIDES_MEDIUM, 3);
    WaitEffect<actor ACTOR_NPC_DAGUTORIO>();
    WaitExecuteLives(ACTOR_NPC_DAGUTORIO);
    message_SetFace(ACTOR_NPC_DAGUTORIO, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
