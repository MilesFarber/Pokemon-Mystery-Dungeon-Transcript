    Turn2Direction<actor ACTOR_NPC_PUKURIN>(4, 10, DIR_LEFT);
    Turn2Direction<actor ACTOR_PLAYER>(4, 10, DIR_UPRIGHT);
    Turn2Direction<actor ACTOR_ATTENDANT1>(4, 10, DIR_UPRIGHT);
    Turn2Direction<actor ACTOR_NPC_KIMAWARI>(4, 10, DIR_UP);
    Turn2Direction<actor ACTOR_NPC_DIGUDA>(4, 10, DIR_UPRIGHT);
    Turn2Direction<actor ACTOR_NPC_BIPPA>(4, 10, DIR_UPLEFT);
    Turn2Direction<actor ACTOR_NPC_DOGOOMU>(4, 10, DIR_UPRIGHT);
