                """,
            }
        case 2:
            {
                english="""
                     Haven't you heard? The grand
                    master of all things bad is supposed to
                    be there.
                """,
            }
        default:
            {
                english="""
                     Haven't you heard? The grand
                    master of all things bad is supposed to
                    be there.
                """,
            }
