    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2DirectionLives<actor ACTOR_NPC_RINGUMA>(4, 10, ACTOR_NPC_HIMEGUMA);
    WaitExecuteLives(ACTOR_NPC_RINGUMA);
