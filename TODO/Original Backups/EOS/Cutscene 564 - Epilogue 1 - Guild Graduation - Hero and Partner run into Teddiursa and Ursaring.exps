    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2Direction<actor ACTOR_NPC_RINGUMA>(4, 10, DIR_RIGHT);
    WaitExecuteLives(ACTOR_NPC_RINGUMA);
    Turn2Direction<actor ACTOR_NPC_HIMEGUMA>(4, 10, DIR_RIGHT);
