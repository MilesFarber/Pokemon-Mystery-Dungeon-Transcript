        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    se_Play(8968);
    SetEffect<actor ACTOR_PLAYER>(EFFECT_SHOCKED, 3);
    ExecuteCommon<actor ACTOR_ATTENDANT1>(CORO_JUMP_SURPRISE_FUNC_SERIES, 0);
    WaitExecuteLives(ACTOR_ATTENDANT1);
    message_SetFace(ACTOR_ATTENDANT1, FACE_SURPRISED, FACE_POS_BOTTOM_R_FACEINW);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" What?![K] [CS:P]Mystifying Forest[CR]?!",
            }
        case 2:
            {
                english=" What?![K] [CS:P]Mystifying Forest[CR]?!",
            }
        default:
            {
                english=" Pardon?![K] [CS:P]Mystifying Forest[CR]?!",
            }
    }
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" But isn't it dangerous there?",
            }
        case 2:
            {
                english=" But isn't it dangerous there?",
            }
        default:
            {
                english=" But isn't it dangerous there?",
            }
    }
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     Didn't you know? The grand
                    master of all things bad is supposed to
