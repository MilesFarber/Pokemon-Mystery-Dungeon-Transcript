
def 0 {
    bgm_PlayFadeIn(BGM_TREASURE_TOWN, 0, 256);
    CallCommon(CORO_FADE_OUT_ALL_BEFORE);
    $SCENARIO_MAIN = scn[29, 2];
    back_SetGround(LEVEL_T01P01A);
    supervision_LoadStation(LEVEL_T01P01A, 'US01');
    supervision_Station(8);
    supervision_StationCommon(0);
    supervision_StationCommon(99);
    supervision_Acting(0);
    camera_SetMyself<performer 0>();
    Wait(1);
    MovePositionMark<performer 0>(1, Position<'m0', 52, 27.5>);
    MovePositionMark<actor ACTOR_PLAYER>(1, Position<'m1', 55, 25.5>);
    MovePositionMark<actor ACTOR_ATTENDANT1>(1, Position<'m2', 55, 28.5>);
    MovePositionMark<actor ACTOR_NPC_RINGUMA>(1, Position<'m3', 49, 25.5>);
    MovePositionMark<actor ACTOR_NPC_HIMEGUMA>(1, Position<'m4', 49, 28.5>);
    screen_FadeInAll(1, 30);
    WaitExecuteLives(ACTOR_NPC_HIMEGUMA);
    se_Play(8978);
    SetEffect<actor ACTOR_NPC_HIMEGUMA>(EFFECT_EXCLAMATION_MARK, 3);
    WaitEffect<actor ACTOR_NPC_HIMEGUMA>();
    WaitExecuteLives(ACTOR_NPC_HIMEGUMA);
    message_SetFace(ACTOR_NPC_HIMEGUMA, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english="""
             Oh, [partner] and
