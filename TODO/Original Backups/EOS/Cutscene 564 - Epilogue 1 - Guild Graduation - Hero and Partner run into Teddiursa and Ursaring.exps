    WaitExecuteLives(ACTOR_ATTENDANT1);
    message_SetFace(ACTOR_ATTENDANT1, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" Hey, [CS:N]Teddiursa[CR] and [CS:N]Ursaring[CR]!",
            }
        case 2:
            {
                english=" Hey, [CS:N]Teddiursa[CR] and [CS:N]Ursaring[CR]!",
            }
        default:
            {
                english=" Hi, [CS:N]Teddiursa[CR] and [CS:N]Ursaring[CR]!",
            }
    }
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     What's up? Are you two going
                    out somewhere?
                """,
            }
        case 2:
            {
                english="""
                     What's going on? Are you going
                    out somewhere?
                """,
            }
        default:
            {
                english="""
                     What's happening? Are you going
                    out somewhere?
                """,
            }
    }
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_HIMEGUMA, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english="""
             Yup.[K] We're going off to
