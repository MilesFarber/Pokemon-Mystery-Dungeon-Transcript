                """,
            }
        case 2:
            {
                english="""
                     I didn't give up when we were
                    trying to escape from the future.
                """,
            }
        default:
            {
                english="""
                     I didn't give up when we were
                    trying to escape from the future.
                """,
            }
    }
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     I guess [CS:N]Grovyle[CR] thought that
