                """,
            }
        default:
            {
                english="""
                     I guess [CS:N]Grovyle[CR] thought that
                    was strange.
                """,
            }
    }
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     That's why [CS:N]Grovyle[CR] asked me
