
def 0 {
    sound_Stop();
    $SCENARIO_MAIN = scn[20, 4];
    back_SetGround(LEVEL_S04P01A);
    screen_FadeIn(1, 0);
    message_SetFace(ACTOR_ATTENDANT1, FACE_PAIN, FACE_POS_STANDARD);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" Ugh...[K] We blew that attempt.",
            }
        case 2:
            {
                english=" Ugh...[K] That wasn't very good.",
            }
        default:
            {
                english=" Ugh...[K] We didn't make it.",
            }
    }
    message_KeyWait();
    screen_FadeOutAll(1, 60);
    message_CloseEnforce();
    CallCommon(CORO_FADE_OUT_ALL_AFTER);
    back_SetGround(LEVEL_D23P11A);
    supervision_StationCommon(0);
    supervision_LoadStation(LEVEL_D23P11A, 'UM19');
    supervision_Station(3);
    supervision_Acting(0);
    Wait(1);
    camera_SetMyself<performer 0>();
    screen_FadeIn(1, 30);
    bgm_PlayFadeIn(BGM_DEEP_DUSK_FOREST, 0, 256);
    Wait(30);
    WaitLockLives(5, ACTOR_PLAYER);
    Unlock(5);
    Wait(5);
    Unlock(11);
    Unlock(9);
    Wait(5);
    Unlock(7);
    Lock(3);
    Wait(15);
    Turn2Direction<actor ACTOR_PLAYER>(4, 10, DIR_UPLEFT);
    Turn2Direction<actor ACTOR_ATTENDANT1>(4, 10, DIR_UPRIGHT);
    Turn2Direction<actor ACTOR_NPC_JUPUTORU>(4, 10, DIR_DOWNRIGHT);
    Turn2Direction<actor ACTOR_NPC_SEREBII>(4, 10, DIR_DOWNLEFT);
    Wait(15);
    SetEffect<actor ACTOR_ATTENDANT1>(EFFECT_SWEAT_DROPS_FROM_BOTH_SIDES_MEDIUM, 3);
    WaitEffect<actor ACTOR_ATTENDANT1>();
    message_SetFace(ACTOR_ATTENDANT1, FACE_PAIN, FACE_POS_STANDARD);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     Urk... This is pretty tough
                    going...
                """,
            }
        case 2:
            {
                english=" Urk... This isn't easy at all...",
            }
        default:
            {
                english="""
                     Urk... This is kind of
                    challenging...
                """,
            }
    }
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_JUPUTORU, FACE_NORMAL, FACE_POS_TOP_L_CENTER);
    message_Talk({
        english="""
             We don't have far to go to the
            Passage of Time.
        """,
    });
    message_Talk({
        english="""
             We must reach it, no matter
            what.
        """,
    });
    message_Talk({
        english="""
             We'll leave as soon as you're
            ready.
        """,
    });
    message_Close();
    SetAnimation<actor ACTOR_NPC_JUPUTORU>(4);
    SetAnimation<actor ACTOR_NPC_SEREBII>(4);
    end;
}

def 1 for actor ACTOR_PLAYER {
    SetDirection(DIR_RIGHT);
    SetAnimation(76);
    Lock(5);
    CallCommon(CORO_WAKEUP_FUNC);
    CallCommon(CORO_LOOK_AROUND_DOWN_FUNC);
    Lock(6);
    hold;
}

def 2 for actor ACTOR_ATTENDANT1 {
    SetDirection(DIR_LEFT);
    SetAnimation(76);
    Lock(7);
    CallCommon(CORO_WAKEUP_FUNC);
    CallCommon(CORO_LOOK_AROUND_FUNC);
    Unlock(3);
    Lock(8);
    hold;
}

def 3 for actor ACTOR_NPC_JUPUTORU {
    SetPositionInitial();
    SetAnimation(29);
    Lock(9);
    Wait(30);
    SetAnimation(31);
    WaitAnimation();
    SetAnimation(2);
    Wait(15);
    Turn2Direction(4, 10, DIR_UPLEFT);
    CallCommon(CORO_LOOK_AROUND_FUNC);
    Lock(10);
    hold;
}

def 4 for actor ACTOR_NPC_SEREBII {
    SetPositionInitial();
    SetAnimation(2);
    Lock(11);
    Lock(12);
    hold;
}
