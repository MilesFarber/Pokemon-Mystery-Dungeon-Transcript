    camera_SetMyself<performer 0>();
    screen2_FadeIn(0, 60);
    bgm_FadeOut(210);
    screen_FadeIn(1, 60);
    Wait(30);
    Wait(45);
    supervision_Acting(1);
    MovePositionMark<actor ACTOR_NPC_BIPPA>(0.7969, Position<'m0', 27.5, 34.5>);
    Wait(20);
    MovePositionMark<performer 0>(0.7969, Position<'m1', 29.5, 37.5>);
    MovePositionMark<actor ACTOR_ATTENDANT1>(0.7969, Position<'m2', 30, 38>);
    WaitExecuteLives(ACTOR_NPC_BIPPA);
    se_Play(8964);
    SetEffect<actor ACTOR_NPC_BIPPA>(EFFECT_EXCLAMATION_MARK, 3);
    WaitEffect<actor ACTOR_NPC_BIPPA>();
    Turn2Direction<actor ACTOR_NPC_BIPPA>(8, 10, DIR_DOWNRIGHT);
    message_SetFace(ACTOR_NPC_BIPPA, FACE_NORMAL, FACE_POS_TOP_L_CENTER);
    message_Talk({
        english="""
             Huh?[K] Howdy, [partner].
            Going out?
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    WaitExecuteLives(ACTOR_ATTENDANT1);
    Turn2Direction<actor ACTOR_ATTENDANT1>(4, 10, DIR_UPLEFT);
    WaitExecuteLives(ACTOR_ATTENDANT1);
    message_SetFace(ACTOR_ATTENDANT1, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" Yup.[K] Out for a walk.",
            }
        case 2:
            {
                english=" Yes.[K] Out for a walk.",
            }
        default:
            {
                english=" Yep.[K] Out for a walk.",
            }
    }
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_BIPPA, FACE_NORMAL, FACE_POS_TOP_L_CENTER);
    message_Talk({
        english=" Sounds nice, yup yup!",
    });
    message_Talk({
        english="""
             It'll be dinnertime soon, though.
            You don't want to be late for that!
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_ATTENDANT1, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" Yep.[K] I hear you.",
            }
        case 2:
            {
                english=" OK.[K] Understood.",
            }
        default:
            {
                english=" Yep.[K] I hear you.",
            }
    }
    message_Close();
    MovePositionOffset<actor ACTOR_ATTENDANT1>(0.7969, 0, 80);
    Turn2Direction<actor ACTOR_NPC_BIPPA>(8, 10, DIR_DOWN);
    Wait(80);
