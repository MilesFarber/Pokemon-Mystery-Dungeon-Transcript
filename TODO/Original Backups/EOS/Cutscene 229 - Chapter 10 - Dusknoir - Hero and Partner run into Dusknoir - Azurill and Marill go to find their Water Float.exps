                """,
            }
    }
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2DirectionLives<actor ACTOR_NPC_KAKUREON1>(4, 10, ACTOR_NPC_YONOWAARU);
    WaitExecuteLives(ACTOR_NPC_KAKUREON1);
    message_SetFace(ACTOR_NPC_KAKUREON1, FACE_NORMAL, FACE_POS_TOP_L_CENTER);
    message_Talk({
        english="""
             I've never heard of a
            [CS:Z]Water Float[CR].
        """,
    });
    message_Talk({
        english=" What purpose does it serve?",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2DirectionLives<actor ACTOR_NPC_YONOWAARU>(4, 10, ACTOR_NPC_KAKUREON1);
    Turn2Direction<actor ACTOR_NPC_KAKUREON2>(4, 10, DIR_DOWNLEFT);
    Turn2DirectionLives<actor ACTOR_PLAYER>(4, 10, ACTOR_NPC_YONOWAARU);
    Turn2DirectionLives<actor ACTOR_ATTENDANT1>(4, 10, ACTOR_NPC_KAKUREON1);
    WaitExecuteLives(ACTOR_NPC_YONOWAARU);
    message_SetFace(ACTOR_NPC_YONOWAARU, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english="""
             A [CS:Z]Water Float[CR] is an item
            specifically for [CS:N]Azurill[CR].
        """,
    });
    message_Talk({
        english="""
             It can be obtained only by
            trading precious treasures again and again.
        """,
    });
    message_Talk({
        english="""
             As such, it is said to be an
            exceedingly rare item.
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    se_Play(8974);
    ExecuteCommon<actor ACTOR_NPC_KAKUREON1>(CORO_JUMP_SURPRISE_FUNC_SERIES, 0);
    WaitExecuteLives(ACTOR_NPC_KAKUREON1);
    message_SetFace(ACTOR_NPC_KAKUREON1, FACE_NORMAL, FACE_POS_TOP_L_CENTER);
    message_Talk({
        english=" Gah! Is that so?",
    });
    message_Talk({
        english="""
             Our line of work is buying and
            selling! But we have never heard of it.[K] It must
            be exceedingly rare!
        """,
    });
    message_Talk({
        english="""
             To sell such a rare item![K]
            I'm afraid such a day will never come.
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    bgm_FadeOut(10);
    se_Play(8967);
    SetEffect<actor ACTOR_ATTENDANT1>(EFFECT_EXCLAMATION_MARK, 3);
    WaitEffect<actor ACTOR_ATTENDANT1>();
    WaitExecuteLives(ACTOR_ATTENDANT1);
    message_SetFace(ACTOR_ATTENDANT1, FACE_SURPRISED, FACE_POS_BOTTOM_R_FACEINW);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     To sell...?[K] Hey, I just
                    remembered!
                """,
            }
        case 2:
            {
                english="""
                     To sell...?[K] Oh, I just
                    remembered!
                """,
            }
        default:
            {
                english="""
                     To sell...?[K] Oh, no! I just
                    remembered!
                """,
            }
    }
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2DirectionLives<actor ACTOR_NPC_KAKUREON1>(4, 10, ACTOR_ATTENDANT1);
    Turn2Direction<actor ACTOR_NPC_KAKUREON2>(4, 10, DIR_DOWN);
    Turn2DirectionLives<actor ACTOR_NPC_YONOWAARU>(4, 10, ACTOR_ATTENDANT1);
    Turn2DirectionLives<actor ACTOR_ATTENDANT1>(4, 10, ACTOR_PLAYER);
    WaitExecuteLives(ACTOR_ATTENDANT1);
    Turn2DirectionLives<actor ACTOR_PLAYER>(4, 10, ACTOR_ATTENDANT1);
    ExecuteCommon<actor ACTOR_ATTENDANT1>(CORO_JUMP_ANGRY_FUNC_SERIES, 0);
    WaitExecuteLives(ACTOR_ATTENDANT1);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     We have to report back to
                    [CS:N]Chatot[CR] about the Perfect Apples!
                """,
            }
        case 2:
            {
                english="""
                     We have to report back to
                    [CS:N]Chatot[CR] about the Perfect Apples!
                """,
            }
        default:
            {
                english="""
                     We have to report back to
                    [CS:N]Chatot[CR] about the Perfect Apples!
                """,
            }
    }
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" Let's race back to the guild!",
            }
        case 2:
            {
                english=" Let's go back to the guild!",
            }
        default:
            {
                english=" Hurry! Back to the guild!",
            }
    }
    message_Close();
    screen_FadeOutAll(1, 60);
    CallCommon(CORO_FADE_OUT_ALL_AFTER);
    Wait(45);
