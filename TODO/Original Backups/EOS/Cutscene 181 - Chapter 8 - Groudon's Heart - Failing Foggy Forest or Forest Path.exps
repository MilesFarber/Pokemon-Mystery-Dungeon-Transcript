    se_Play(8964);
    Unlock(7);
    message_SetFace(ACTOR_ATTENDANT1, FACE_SURPRISED, FACE_POS_TOP_L_CENTER);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" ...Huh?!",
            }
        case 2:
            {
                english=" ...Huh?!",
            }
        default:
            {
                english=" ...Huh?!",
            }
    }
    Lock(3);
    message_Close();
    Unlock(5);
    Wait(15);
    Unlock(8);
    Lock(3);
    Wait(15);
    se_Play(8963);
    SetEffect<actor ACTOR_ATTENDANT1>(EFFECT_QUESTION_MARK, 3);
    WaitEffect<actor ACTOR_ATTENDANT1>();
    WaitExecuteLives(ACTOR_ATTENDANT1);
    message_SetFace(ACTOR_ATTENDANT1, FACE_NORMAL, FACE_POS_TOP_L_CENTER);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
