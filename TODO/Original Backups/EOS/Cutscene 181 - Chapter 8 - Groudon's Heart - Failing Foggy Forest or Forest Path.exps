def 1 for actor ACTOR_PLAYER {
    SetDirection(DIR_RIGHT);
    SetAnimation(76);
    Lock(5);
    SetAnimation(63);
    WaitAnimation();
    Wait(10);
    SetAnimation(2);
    SetDirection(DIR_DOWN);
    Wait(40);
    CallCommon(CORO_LOOK_AROUND_LEFT_FUNC);
    Turn2Direction(4, 10, DIR_DOWN);
    Lock(6);
    hold;
}

def 2 for actor ACTOR_ATTENDANT1 {
    SetDirection(DIR_LEFT);
    SetAnimation(76);
    Lock(7);
    SetEffect(EFFECT_EXCLAMATION_MARK, 3);
    WaitEffect();
    Unlock(3);
    Lock(8);
    SetAnimation(63);
    WaitAnimation();
    Wait(10);
    SetAnimation(2);
    SetDirection(DIR_DOWN);
    Wait(40);
    CallCommon(CORO_LOOK_AROUND_FUNC);
    Unlock(3);
    Lock(9);
    hold;
}
