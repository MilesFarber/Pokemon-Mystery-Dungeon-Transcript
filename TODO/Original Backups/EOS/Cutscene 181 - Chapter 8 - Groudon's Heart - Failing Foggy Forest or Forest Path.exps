            {
                english=" Wh-where is this?",
            }
        default:
            {
                english=" Wh-where is this?",
            }
    }
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_PERAPPU, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english="""
             This is the base camp. It
