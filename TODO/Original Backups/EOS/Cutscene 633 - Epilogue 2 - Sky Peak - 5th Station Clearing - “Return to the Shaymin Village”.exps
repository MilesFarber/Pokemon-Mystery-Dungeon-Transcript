
def 0 {
    Turn2Direction<actor ACTOR_PLAYER_APPOINT>(4, 10, DIR_DOWN);
    WaitExecuteLives(ACTOR_PLAYER_APPOINT);
    message_Mail({
        english="""
            [CN]Return to the
            [CN][CS:P]Shaymin Village[CR]?
        """,
    });
    switch ( message_SwitchMenu(0, 1) ) {
        case menu({
            english="Yes",
        }):
            @label_0;
            if ( scn($SCENARIO_MAIN) >= [29, 21] ) {
                @label_2;
                message_Close();
                bgm_FadeOut(60);
                switch ( message_Menu(MENU_DUNGEON_TEAM_RETURNS_FROM_MAP) ) { }
                main_EnterGround(LEVEL_D73P11A, 30);
                hold;
                end;
            } else {
                $SCENARIO_MAIN = scn[29, 21];
                jump @label_2;
            }
            break;
        case menu({
            english="No",
        }):
        default:
            message_Close();
            end;
    }
}
