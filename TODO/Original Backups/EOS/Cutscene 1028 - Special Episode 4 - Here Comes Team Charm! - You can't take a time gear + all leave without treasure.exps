
def 0 {
    bgm_PlayFadeIn(BGM_TIME_GEAR_REMIX, 0, 256);
    back_SetGround(LEVEL_P28P01A);
    supervision_Acting(1);
    supervision_Acting(0);
    Wait(1);
    camera_SetMyself<performer 0>();
    SetAnimation<object OBJECT_V03P06A2_200>(3);
    SetAnimation<object OBJECT_V03P06A1_196>(3);
    screen_FadeIn(1, 30);
    Wait(30);
    bgm_FadeOut(150);
    message_SetFace(ACTOR_NPC_MANYUURA, FACE_NORMAL, FACE_POS_BOTTOM_R_CENTER);
    message_Talk({
        english=" ...[K]A Time Gear, huh...?",
    });
    bgm2_PlayFadeIn(BGM_CAVE_AMBIANCE, 120, 256);
    message_Talk({
        english="""
             Tsk.[K] I guess we don't have
            any choice.
        """,
    });
    message_Talk({
        english="""
             [CS:N]Arbok[CR]! [CS:N]Drapion[CR]![K]
            We're going home!
        """,
    });
    message_Close();
    Turn2DirectionLives<actor ACTOR_NPC_CHAAREMU>(4, 10, ACTOR_NPC_MANYUURA);
    Wait(6);
    Turn2DirectionLives<actor ACTOR_NPC_AABOKKU>(4, 10, ACTOR_NPC_MANYUURA);
    Wait(4);
    Turn2DirectionLives<actor ACTOR_PLAYER_CHARMS>(4, 10, ACTOR_NPC_MANYUURA);
    Wait(6);
    Turn2DirectionLives<actor ACTOR_NPC_DORAPION>(4, 10, ACTOR_NPC_MANYUURA);
    Wait(9);
    Turn2DirectionLives<actor ACTOR_NPC_SAANAITO>(4, 10, ACTOR_NPC_MANYUURA);
    Wait(4);
    Turn2DirectionLives<actor ACTOR_NPC_PUKURIN>(4, 10, ACTOR_NPC_MANYUURA);
    WaitExecuteLives(ACTOR_NPC_PUKURIN);
    se_Play(8967);
    SetEffect<actor ACTOR_NPC_CHAAREMU>(EFFECT_EXCLAMATION_MARK, 3);
    WaitEffect<actor ACTOR_NPC_CHAAREMU>();
    WaitExecuteLives(ACTOR_NPC_CHAAREMU);
    message_SetFace(ACTOR_NPC_CHAAREMU, FACE_SURPRISED, FACE_POS_TOP_L_CENTER);
    message_Talk({
        english=" Huh?![K] W-wait up, you!",
    });
    message_Close();
    Turn2DirectionLives<actor ACTOR_NPC_MANYUURA>(4, 10, ACTOR_NPC_CHAAREMU);
    Wait(6);
    Turn2Direction<actor ACTOR_PLAYER_CHARMS>(4, 10, DIR_DOWNLEFT);
    Wait(6);
    Turn2Direction<actor ACTOR_NPC_AABOKKU>(4, 10, DIR_UPRIGHT);
    WaitExecuteLives(ACTOR_NPC_AABOKKU);
    message_SetFace(ACTOR_NPC_MANYUURA, FACE_NORMAL, FACE_POS_BOTTOM_R_CENTER);
    message_Talk({
        english=" What?",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_CHAAREMU, FACE_ANGRY, FACE_POS_TOP_L_CENTER);
    message_Talk({
        english="""
             You're a band of thieves that
            does bad things, aren't you?
        """,
    });
    message_Talk({
        english="""
             So you're just going to go home
            without stealing anything?
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_MANYUURA, FACE_NORMAL, FACE_POS_BOTTOM_R_CENTER);
    message_Talk({
        english="""
             Humph![K] If it were some other
            treasure, it'd be fine...
        """,
    });
    message_Talk({
        english="""
             But you can't just steal a
            Time Gear and take it with you.
        """,
    });
    message_Talk({
        english="""
             Even though we're scoundrels,
            we at least know that much.
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_CHAAREMU, FACE_WORRIED, FACE_POS_TOP_L_CENTER);
    message_Talk({
        english=" I-is that so?",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_MANYUURA, FACE_NORMAL, FACE_POS_BOTTOM_R_CENTER);
    message_Talk({
        english=" Yeah...",
    });
    message_Talk({
        english="""
             There are some things you just
            can't take.
        """,
    });
    message_Talk({
        english=" Like a Time Gear...",
    });
    message_Close();
    bgm2_FadeOut(150);
    screen_FadeOut(1, 90);
    Wait(60);
    end;
}
