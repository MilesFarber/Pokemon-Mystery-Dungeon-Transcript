
def 0 {
    sound_Stop();
    if ( scn($SCENARIO_MAIN) >= [29, 82] ) {
        @label_0;
        back_SetGround(LEVEL_S04P01A);
        screen_FadeIn(1, 0);
        message_SetFace(ACTOR_ATTENDANT1, FACE_PAIN, FACE_POS_STANDARD);
        message_SwitchTalk ($PARTNER_TALK_KIND) {
            case 1:
                {
                    english=" Urggh...[K] We couldn't do it...",
                }
            case 2:
                {
                    english=" Urggh...[K] We came up short...",
                }
            default:
                {
                    english=" Urggh...[K] We couldn't do it...",
                }
        }
        message_KeyWait();
        screen_FadeOutAll(1, 60);
        message_CloseEnforce();
        CallCommon(CORO_FADE_OUT_ALL_AFTER);
        back_SetGround(LEVEL_D38P12A);
        supervision_StationCommon(0);
        supervision_Acting(0);
        camera_SetMyself<performer 0>();
        screen_FadeIn(1, 30);
        bgm_PlayFadeIn(BGM_CHASM_CAVE, 0, 256);
        Wait(30);
        WaitLockLives(5, ACTOR_PLAYER);
        Unlock(5);
        Wait(15);
        Unlock(7);
        Lock(3);
        Wait(15);
        Turn2DirectionLives<actor ACTOR_PLAYER>(4, 10, ACTOR_ATTENDANT1);
        Turn2DirectionLives<actor ACTOR_ATTENDANT1>(4, 10, ACTOR_PLAYER);
        Wait(15);
        SetEffect<actor ACTOR_ATTENDANT1>(EFFECT_SWEAT_DROPS_FROM_BOTH_SIDES_MEDIUM, 3);
        message_SetFace(ACTOR_ATTENDANT1, FACE_PAIN, FACE_POS_STANDARD);
        message_SwitchTalk ($PARTNER_TALK_KIND) {
            case 1:
                {
                    english=" Urk![K] This is rough...",
                }
            case 2:
                {
                    english=" Urk![K] This is so hard...",
                }
            default:
                {
                    english=" Urk![K] This is difficult...",
                }
        }
        CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
        Turn2Direction<actor ACTOR_ATTENDANT1>(4, 10, DIR_UP);
        Wait(60);
        message_SetFace(ACTOR_ATTENDANT1, FACE_SAD, FACE_POS_STANDARD);
        message_SwitchTalk ($PARTNER_TALK_KIND) {
            case 1:
                {
                    english="""
                         But we have to keep struggling
                        to the very end...
                    """,
                }
            case 2:
                {
                    english="""
                         But we have no choice. We have
                        to keep struggling to the end.
                    """,
                }
            default:
                {
                    english="""
                         But we have no other choice.
                        We have to keep struggling to the end.
                    """,
                }
        }
        message_SwitchTalk ($PARTNER_TALK_KIND) {
            case 1:
                {
                    english="""
                         We have to force [CS:N]Palkia[CR] to tell
                        us what we need to know!
                    """,
                }
            case 2:
                {
                    english="""
                         We have to force [CS:N]Palkia[CR] to tell
                        us what we need to know!
                    """,
                }
            default:
                {
                    english="""
                         We have to force [CS:N]Palkia[CR] to tell
                        us what we need to know!
                    """,
                }
        }
        CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
        Turn2DirectionLives<actor ACTOR_ATTENDANT1>(4, 10, ACTOR_PLAYER);
        WaitExecuteLives(ACTOR_ATTENDANT1);
        message_SwitchTalk ($PARTNER_TALK_KIND) {
            case 1:
                {
                    english="""
                         We really have to find a way
                        out of here!
                    """,
                }
            case 2:
                {
                    english="""
                         We really have to find a way
                        out of here!
                    """,
                }
            default:
                {
                    english="""
                         We really have to find a way
                        out of here!
                    """,
                }
        }
        message_SwitchTalk ($PARTNER_TALK_KIND) {
            case 1:
                {
                    english=" Let's roll, [hero]!",
                }
            case 2:
                {
                    english=" Let's go, [hero]!",
                }
            default:
                {
                    english=" Let's go, [hero]!",
                }
        }
        message_Close();
        end;
    } else {
        $SCENARIO_MAIN = scn[29, 82];
        jump @label_0;
    }
}

def 1 for actor ACTOR_PLAYER {
    SetDirection(DIR_RIGHT);
    SetAnimation(76);
    Lock(5);
    CallCommon(CORO_WAKEUP_FUNC);
    CallCommon(CORO_LOOK_AROUND_DOWN_FUNC);
    Lock(6);
    hold;
}

def 2 for actor ACTOR_ATTENDANT1 {
    SetDirection(DIR_RIGHT);
    SetAnimation(76);
    Lock(7);
    CallCommon(CORO_WAKEUP_FUNC);
    CallCommon(CORO_LOOK_AROUND_FUNC);
    Unlock(3);
    Lock(8);
    hold;
}
