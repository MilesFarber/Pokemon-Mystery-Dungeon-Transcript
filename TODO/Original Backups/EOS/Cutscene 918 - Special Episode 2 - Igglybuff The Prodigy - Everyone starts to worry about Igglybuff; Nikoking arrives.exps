    Turn2Direction<actor ACTOR_NPC_NIDOKINGU>(4, 10, DIR_UP);
    message_SetFaceOnly(ACTOR_NPC_NIDOKINGU, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english=" My apologies for not introducing myself.",
    });
    message_Talk({
        english=" I am [CS:N]Nidoking[CR].[K] I'm an explorer.",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_PUKURIN_PAPA, FACE_NORMAL, FACE_POS_TOP_L_CENTER);
    message_FacePositionOffset(1, -1);
    message_Talk({
        english=" An explorer?",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_NIDOKINGU, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english=" Yes.",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2Direction<actor ACTOR_NPC_NIDOKINGU>(4, 10, DIR_UPLEFT);
    Wait(40);
    Turn2Direction<actor ACTOR_NPC_NIDOKINGU>(8, 10, DIR_UPRIGHT);
    Wait(40);
    Turn2Direction<actor ACTOR_NPC_NIDOKINGU>(4, 10, DIR_UP);
    Wait(20);
    message_SetFace(ACTOR_NPC_NIDOKINGU, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english="""
             I should introduce
            myself properly.
        """,
    });
    message_Talk({
        english=" The truth is, I am...",
    });
    message_Close();
    screen2_FadeOut(0, 30);
    screen_FadeOut(1, 30);
    Wait(110);
    screen2_FadeIn(0, 30);
    screen_FadeIn(1, 30);
    Wait(30);
    Wait(20);
    se_Play(8968);
    ExecuteCommon<actor ACTOR_NPC_UPAA>(CORO_JUMP_SURPRISE_FUNC_SERIES, 0);
    ExecuteCommon<actor ACTOR_NPC_PUKURIN_PAPA>(CORO_JUMP_SURPRISE_FUNC_SERIES, 0);
    SetEffect<actor ACTOR_NPC_SUBOMII>(EFFECT_SHOCKED_MIRRORED, 3);
    SetEffect<actor ACTOR_NPC_PUKURIN_MAMA>(EFFECT_EXCLAMATION_MARK, 3);
    SetEffect<actor ACTOR_NPC_MUCHUURU>(EFFECT_SHOCKED_MIRRORED, 3);
    ExecuteCommon<actor ACTOR_NPC_SUKORUPI>(CORO_JUMP_SURPRISE_FUNC_SERIES, 0);
    SetEffect<actor ACTOR_NPC_JUPETTA>(EFFECT_EXCLAMATION_MARK, 3);
    WaitEffect<actor ACTOR_NPC_JUPETTA>();
    WaitExecuteLives(ACTOR_NPC_JUPETTA);
    message_EmptyActor();
    message_Talk({
        english="[CS:N]Everyone[CR]: WHAAAAAAAAAAAAAAAAAT?!",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    se_Play(8972);
    SetEffect<actor ACTOR_NPC_UPAA>(EFFECT_SWEAT_DROPS_FROM_BOTH_SIDES_MEDIUM, 3);
    WaitEffect<actor ACTOR_NPC_UPAA>();
    message_SetFace(ACTOR_NPC_UPAA, FACE_SURPRISED, FACE_POS_TOP_L_FACEINW);
    message_Talk({
