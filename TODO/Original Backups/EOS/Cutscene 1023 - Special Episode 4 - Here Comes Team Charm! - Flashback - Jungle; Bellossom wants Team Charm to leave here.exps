
def 0 {
    bgm_PlayFadeIn(BGM_ILLUSION_STONE_CHAMBER, 0, 256);
    back_SetGround(LEVEL_D54P11A);
    supervision_StationCommon(0);
    supervision_StationCommon(1);
    supervision_Acting(0);
    SetPositionInitial<actor ACTOR_NPC_CHAAREMU>();
    SetPositionInitial<actor ACTOR_NPC_SAANAITO>();
    SetPositionInitial<actor ACTOR_NPC_METAMON_KIREIHANA>();
    SetAnimation<actor ACTOR_NPC_CHAAREMU>(2);
    SetAnimation<actor ACTOR_NPC_SAANAITO>(2);
    SetAnimation<actor ACTOR_NPC_METAMON_KIREIHANA>(2);
    camera_SetMyself<performer 0>();
    SetPositionMark<actor ACTOR_PLAYER_CHARMS>(Position<'m0', 31.5, 28.5>);
    SetPositionMark<actor ACTOR_NPC_SAANAITO>(Position<'m1', 35.5, 30.5>);
    SetPositionMark<actor ACTOR_NPC_CHAAREMU>(Position<'m2', 27.5, 30.5>);
    SetDirection<actor ACTOR_PLAYER_CHARMS>(DIR_DOWNRIGHT);
    SetDirection<actor ACTOR_NPC_SAANAITO>(DIR_UPLEFT);
    SetDirection<actor ACTOR_NPC_CHAAREMU>(DIR_RIGHT);
    SetEffect<actor ACTOR_PLAYER_CHARMS>(EFFECT_LAUGHING, 3);
    SetEffect<actor ACTOR_NPC_SAANAITO>(EFFECT_LAUGHING, 3);
    screen_FlushOut(1, 0, 8, 0, 0, 0);
    screen_FadeIn(1, 30);
    Wait(30);
    message_SetFace(ACTOR_NPC_CHAAREMU, FACE_HAPPY, FACE_POS_STANDARD);
    message_Talk({
        english="""
             All right, let's do our best and
            get through this jungle! ♪
        """,
    });
    message_Close();
    SetEffect<actor ACTOR_NPC_CHAAREMU>(EFFECT_LAUGHING, 3);
    Wait(90);
    SetEffect<actor ACTOR_PLAYER_CHARMS>(EFFECT_NONE, 3);
    SetEffect<actor ACTOR_NPC_SAANAITO>(EFFECT_NONE, 3);
    SetEffect<actor ACTOR_NPC_CHAAREMU>(EFFECT_NONE, 3);
    message_ResetActor();
    message_Talk({
        english=" U-um...",
    });
    SetEffect<actor ACTOR_PLAYER_CHARMS>(EFFECT_EXCLAMATION_MARK, 3);
    Wait(4);
    SetEffect<actor ACTOR_NPC_CHAAREMU>(EFFECT_EXCLAMATION_MARK, 3);
    Wait(6);
    SetEffect<actor ACTOR_NPC_SAANAITO>(EFFECT_EXCLAMATION_MARK, 3);
    Wait(4);
    Turn2Direction<actor ACTOR_PLAYER_CHARMS>(4, 10, DIR_UP);
    Wait(4);
    Turn2Direction<actor ACTOR_NPC_CHAAREMU>(4, 10, DIR_UP);
    Wait(6);
    Turn2Direction<actor ACTOR_NPC_SAANAITO>(4, 10, DIR_UP);
    WaitExecuteLives(ACTOR_NPC_SAANAITO);
    message_Close();
    MovePositionMark<actor ACTOR_NPC_METAMON_KIREIHANA>(1, Position<'m3', 31.5, 24.5>);
    WaitExecuteLives(ACTOR_NPC_METAMON_KIREIHANA);
    message_SetFace(ACTOR_NPC_SAANAITO, FACE_WORRIED, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english=" Wh-who are you?",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFaceOnly(ACTOR_NPC_METAMON_KIREIHANA, FACE_NORMAL, FACE_POS_TOP_C_FACER);
    message_Talk({
        english="""
             I'm [CS:N]Bellossom[CR].[K]
            I live in this jungle.
        """,
    });
    message_SetFace(ACTOR_NPC_METAMON_KIREIHANA, FACE_NORMAL, FACE_POS_TOP_C_FACER);
    message_Talk({
        english="""
             If you're talking about the
            treasure in [CS:P]Boulder Quarry[CR]...
        """,
    });
    message_Talk({
        english=" You really should give up.",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Wait(20);
    message_Mail({
        english="[CN]Was it back then...",
    });
    message_Mail({
        english="""
            [CN]When we were warned earlier in
            [CN][CS:P]Southern Jungle[CR]...
        """,
    });
    message_Mail({
        english="[CN]That [CS:N]Bellossom[CR] and...",
    });
    message_Close();
    screen_WhiteOut(1, 30);
    screen_FlushIn(1, 0, 1, 0, 0, 0);
    end;
}
