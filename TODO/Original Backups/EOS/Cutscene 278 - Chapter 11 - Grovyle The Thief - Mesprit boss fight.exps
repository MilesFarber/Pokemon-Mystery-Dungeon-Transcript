    supervision_Acting(0);
    camera_SetMyself<performer 0>();
    screen_FadeIn(1, 30);
    bgm_PlayFadeIn(BGM_IN_THE_DEPTHS_OF_THE_PIT, 0, 256);
    Wait(30);
    message_SetFace(ACTOR_NPC_EMURITTO, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
    message_Talk({
        english=" You're back?!",
    });
    message_Talk({
        english="""
             You can come back all you like,
            but you'll never get the Time Gear from me!
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    se_Play(8972);
    SetEffect<actor ACTOR_ATTENDANT1>(EFFECT_SWEAT_DROPS_FROM_BOTH_SIDES_MEDIUM, 3);
    WaitEffect<actor ACTOR_ATTENDANT1>();
    WaitExecuteLives(ACTOR_ATTENDANT1);
    message_SetFace(ACTOR_ATTENDANT1, FACE_SAD, FACE_POS_STANDARD);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     You're wrong! We didn't come
                    here to steal the Time Gear!
                """,
            }
        case 2:
            {
                english="""
                     You're wrong! We didn't come
                    here to steal the Time Gear!
                """,
            }
        default:
            {
                english="""
                     You're mistaken! We didn't come
                    here to steal the Time Gear!
                """,
            }
    }
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_EMURITTO, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
    message_Talk({
        english="""
             You say that...[K] But you can't be
