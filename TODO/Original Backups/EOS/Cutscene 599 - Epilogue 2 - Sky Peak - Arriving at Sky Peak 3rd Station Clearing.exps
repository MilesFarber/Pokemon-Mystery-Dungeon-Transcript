
def 0 {
    sound_Stop();
    $SCENARIO_MAIN = scn[29, 16];
    message_SetFace(ACTOR_NPC_SHEIMI, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english="""
             We're almost to the
            3rd Station Clearing! Keep going!
        """,
    });
    message_Close();
    back_SetGround(LEVEL_D73P23A);
    supervision_LoadStation(LEVEL_D73P23A, 'US31');
    supervision_Station(40);
    supervision_Station(41);
    supervision_Station(42);
    supervision_Station(7);
    supervision_StationCommon(9);
    supervision_StationCommon(10);
    supervision_Acting(0);
    camera_SetMyself<performer 0>();
    SetPositionInitial<actor ACTOR_NPC_SHEIMI>();
    SetPositionInitial<actor ACTOR_ADVENTURE_NPC1>();
    SetPositionInitial<actor ACTOR_ADVENTURE_NPC2>();
    SetAnimation<actor ACTOR_NPC_SHEIMI>(2);
    SetAnimation<actor ACTOR_ADVENTURE_NPC1>(2);
    SetAnimation<actor ACTOR_ADVENTURE_NPC2>(2);
    screen_FadeIn(1, 30);
    bgm_PlayFadeIn(BGM_SKY_PEAK_PRAIRIE, 0, 256);
    Wait(30);
    MovePositionMark<actor ACTOR_NPC_SHEIMI>(1, Position<'m0', 28.5, 35.5>);
    MovePositionMark<actor ACTOR_PLAYER_APPOINT>(1, Position<'m1', 28.5, 40.5>);
    MovePositionMark<actor ACTOR_ADVENTURE_NPC1>(1, Position<'m2', 31.5, 39.5>);
    MovePositionMark<actor ACTOR_ADVENTURE_NPC2>(1, Position<'m3', 25.5, 39.5>);
    WaitExecuteLives(ACTOR_NPC_SHEIMI);
    Wait(10);
    message_SetFace(ACTOR_NPC_SHEIMI, FACE_NORMAL, FACE_POS_TOP_C_FACER);
    message_Talk({
        english=" Phew! The 3rd Station Clearing.",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2DirectionLives<actor ACTOR_NPC_SHEIMI>(4, 10, ACTOR_PLAYER_APPOINT);
    WaitExecuteLives(ACTOR_NPC_SHEIMI);
    message_SetFace(ACTOR_NPC_SHEIMI, FACE_NORMAL, FACE_POS_TOP_C_FACER);
    message_Talk({
        english="""
             By the way, [player].
            Did you happen to find any treasures called 
            [CS:I]Sky Gift[CR]s while we were climbing?
        """,
    });
    message_Talk({
        english="""
             A [CS:I]Sky Gift[CR] is a special kind of
            treasure that can only be found on [CS:P]Sky Peak[CR].
        """,
    });
    message_Talk({
        english="""
             As its name indicates, it's a
            gift that should be given to others...
        """,
    });
    message_Talk({
        english="""
             You never know what's in it until
            it's opened. It's a mysterious treasure!
        """,
    });
    message_SetFace(ACTOR_NPC_SHEIMI, FACE_HAPPY, FACE_POS_TOP_C_FACER);
    message_Talk({
        english="""
             But...if it's opened by the one
            who found it, then it's completely empty, so be
            careful! Hee hee! ♪
        """,
    });
    SetEffect<actor ACTOR_NPC_SHEIMI>(EFFECT_LAUGHING, 3);
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Wait(10);
    SetEffect<actor ACTOR_NPC_SHEIMI>(EFFECT_NONE, 3);
    Wait(25);
    message_SetFace(ACTOR_NPC_SHEIMI, FACE_NORMAL, FACE_POS_TOP_C_FACER);
    message_Talk({
        english="""
             It's said that if you send a
            [CS:I]Sky Gift[CR] as a token of thanks, whoever
            receives it will be very happy.
        """,
    });
    message_Talk({
        english="""
             [player], why don't you send
            a [CS:I]Sky Gift[CR] to those who have helped you?
        """,
    });
    message_Close();
    MovePositionMark<actor ACTOR_ADVENTURE_NPC1>(1, Position<'m4', 34.5, 39.5>);
    MovePositionMark<actor ACTOR_ADVENTURE_NPC2>(1, Position<'m5', 22.5, 39.5>);
    Turn2Direction<actor ACTOR_ADVENTURE_NPC1>(4, 10, DIR_UPLEFT);
    Turn2Direction<actor ACTOR_ADVENTURE_NPC2>(4, 10, DIR_UPRIGHT);
    WaitExecuteLives(ACTOR_ADVENTURE_NPC1);
    WaitExecuteLives(ACTOR_ADVENTURE_NPC2);
    end;
}
