
def 0 {
    bgm_PlayFadeIn(BGM_WIGGLYTUFFS_GUILD_REMIX, 0, 256);
    worldmap_SetMode(4);
    worldmap_SetLevel(2);
    back2_SetMode(3);
    WaitSubScreen();
    worldmap_SetCamera(21);
    Wait(30);
    worldmap_SetMark(21);
    worldmap_SetArrow(21);
    message_SetFace(ACTOR_NPC_PERAPPU, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english=" See? This area.",
    });
    message_Talk({
        english="""
             The area on the map is obscured
            by clouds...
        """,
    });
    message_Talk({
        english="""
             But the dry terrain starts in this
            area here.
        """,
    });
    message_Talk({
        english="""
             That's why it's rumored that a
            vast desert extends from that point onward.
        """,
    });
    message_Talk({
        english="""
             We suspect that a Time Gear is
            hidden in the depths of the desert.
        """,
    });
    message_Talk({
        english="""
             That is where we're sending you
            to investigate.
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_ATTENDANT1, FACE_NORMAL, FACE_POS_STANDARD);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" Yep! Gotcha!",
            }
        case 2:
            {
                english=" OK! We understand!",
            }
        default:
            {
                english=" OK! We understand!",
            }
    }
    message_Close();
    se_Play(6667);
    screen2_FadeOut(1, 15);
    back2_SetMode(0);
    end;
}
