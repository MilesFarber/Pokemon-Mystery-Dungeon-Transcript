    SetEffect<actor ACTOR_NPC_KOIRU>(EFFECT_NONE, 3);
    SetEffect<actor ACTOR_NPC_KIMAWARI>(EFFECT_NONE, 3);
    SetEffect<actor ACTOR_NPC_CHIRIIN>(EFFECT_NONE, 3);
    SetEffect<actor ACTOR_NPC_MARIRU>(EFFECT_NONE, 3);
    SetEffect<actor ACTOR_NPC_BIPPA>(EFFECT_NONE, 3);
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2DirectionLives<actor ACTOR_NPC_PUKURIN>(4, 10, ACTOR_ATTENDANT1);
    WaitExecuteLives(ACTOR_NPC_PUKURIN);
    Turn2DirectionLives<actor ACTOR_NPC_PERAPPU>(4, 10, ACTOR_ATTENDANT1);
    message_SetFace(ACTOR_NPC_PUKURIN, FACE_NORMAL, FACE_POS_TOP_L_CENTER);
    message_FacePositionOffset(-2, 0);
    message_Talk({
        english="""
             You're in charge of finding
            [CS:N]Drowzee[CR].[K] Don't fail us! ♪
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2DirectionLives<actor ACTOR_ATTENDANT1>(4, 10, ACTOR_PLAYER);
    WaitExecuteLives(ACTOR_ATTENDANT1);
    Turn2DirectionLives<actor ACTOR_PLAYER>(4, 10, ACTOR_ATTENDANT1);
    Wait(10);
    ExecuteCommon<actor ACTOR_ATTENDANT1>(CORO_JUMP_HAPPY_FUNC_SERIES, 0);
    WaitExecuteLives(ACTOR_ATTENDANT1);
    message_SetFace(ACTOR_ATTENDANT1, FACE_NORMAL, FACE_POS_BOTTOM_L_CENTER);
    message_FacePositionOffset(-1, -3);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" All right! Let's move!",
            }
        case 2:
            {
                english=" OK! Let's move it!",
            }
        default:
            {
                english=" OK! Let's go!",
            }
    }
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     We're heading for [CS:P]Mt. Travail[CR] to
                    find [CS:N]Drowzee[CR]!
                """,
            }
        case 2:
            {
                english="""
                     We're off to [CS:P]Mt. Travail[CR]!
                    Let's find that [CS:N]Drowzee[CR]!
                """,
            }
        default:
            {
                english="""
                     We're heading for [CS:P]Mt. Travail[CR] to
                    find [CS:N]Drowzee[CR]!
                """,
            }
    }
    message_Close();
    screen_FadeOut(1, 30);
    supervision_RemoveActing(1);
    SetPositionMark<actor ACTOR_PLAYER>(Position<'m0', 22, 23.5>);
    SetPositionMark<actor ACTOR_ATTENDANT1>(Position<'m1', 19, 23.5>);
    SetPositionMark<actor ACTOR_NPC_KOIRU>(Position<'m2', 21, 26.5>);
    SetPositionMark<actor ACTOR_NPC_PUKURIN>(Position<'m3', 18, 20.5>);
    SetPositionMark<actor ACTOR_NPC_PERAPPU>(Position<'m4', 21, 19.5>);
    camera_SetDefault();
    SetDirection<actor ACTOR_NPC_KOIRU>(DIR_UP);
    SetDirection<actor ACTOR_NPC_MARIRU>(DIR_DOWN);
    SetDirection<actor ACTOR_NPC_PUKURIN>(DIR_DOWNRIGHT);
    SetDirection<actor ACTOR_NPC_PERAPPU>(DIR_DOWNRIGHT);
    Wait(45);
    screen_FadeIn(1, 30);
    dungeon_mode(62) = DMODE_OPEN;
    end;
}
