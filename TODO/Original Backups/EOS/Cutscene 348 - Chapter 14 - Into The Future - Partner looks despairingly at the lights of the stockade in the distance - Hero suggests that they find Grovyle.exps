            }
            message_Close();
            ExecuteCommon<actor ACTOR_PLAYER>(CORO_EXPLANATION_FUNC_SERIES, 0);
            WaitExecuteLives(ACTOR_PLAYER);
            se_Play(8962);
            SetEffect<actor ACTOR_ATTENDANT1>(EFFECT_QUESTION_MARK, 3);
