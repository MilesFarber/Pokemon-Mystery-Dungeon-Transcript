    Turn2DirectionLives<actor ACTOR_NPC_BIPPA>(4, 10, ACTOR_NPC_KURESERIA);
    Turn2DirectionLives<actor ACTOR_NPC_CHIRIIN>(4, 10, ACTOR_NPC_KURESERIA);
    Turn2DirectionLives<actor ACTOR_NPC_KIMAWARI>(4, 10, ACTOR_NPC_KURESERIA);
    Wait(5);
    Turn2DirectionLives<actor ACTOR_NPC_RURIRI>(4, 10, ACTOR_NPC_KURESERIA);
    Turn2DirectionLives<actor ACTOR_NPC_MARIRU>(4, 10, ACTOR_NPC_KURESERIA);
    Turn2DirectionLives<actor ACTOR_NPC_SURIIPU>(4, 10, ACTOR_NPC_KURESERIA);
    Turn2DirectionLives<actor ACTOR_NPC_HEIGANI>(4, 10, ACTOR_NPC_KURESERIA);
    WaitExecuteLives(ACTOR_NPC_HEIGANI);
    Wait(10);
    message_Talk({
        english="""
             If you confront him, he will
            always flee...
        """,
    });
    message_Talk({
        english="""
             That is how [CS:N]Darkrai[CR] has always
            done things.
        """,
    });
    message_Talk({
        english="""
             But [CS:N]Darkrai[CR] is doing something
            so unlike him right now...
        """,
    });
    message_Talk({
        english="""
             He has invited [partner] and
            [hero] to confront him...
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_PLAYER, FACE_NORMAL, FACE_POS_BOTTOM_L_CENTER);
    message_FacePositionOffset(-1, 0);
    message_SwitchMonologue ($HERO_TALK_KIND) {
        case 4:
            {
                english="(...It's true.)",
            }
        default:
            {
                english="(...It's true.)",
            }
    }
    message_SwitchMonologue ($HERO_TALK_KIND) {
        case 4:
            {
                english="([CS:N]Darkrai[CR] left these parting words...)",
            }
        default:
            {
                english="([CS:N]Darkrai[CR] left these parting words...)",
            }
    }
    message_Close();
    screen_FadeOutAll(1, 30);
    CallCommon(CORO_FADE_OUT_ALL_AFTER);
    end;
}
