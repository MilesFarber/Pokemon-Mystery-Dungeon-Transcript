
def 0 {
    sound_Stop();
    $SCENARIO_SIDE = scn[47, 4];
    switch ( ProcessSpecial(PROCESS_SPECIAL_SET_TEAM_SETUP_HERO_AND_PARTNER_ONLY, 0, 0) ) { }
    switch ( ProcessSpecial(3, 0, 0) ) { }
