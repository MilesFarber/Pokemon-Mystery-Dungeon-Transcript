        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    se_Play(8973);
    Turn2Direction<actor ACTOR_PLAYER_FUTURE>(4, 10, DIR_DOWNRIGHT);
    WaitExecuteLives(ACTOR_PLAYER_FUTURE);
    SetEffect<actor ACTOR_PLAYER_FUTURE>(EFFECT_SHOCKED_MIRRORED, 3);
