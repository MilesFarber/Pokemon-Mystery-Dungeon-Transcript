        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_PLAYER_FUTURE, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english="""
             Don't you think maybe [CS:N]Dialga[CR]
            gave them that order?
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    se_Play(8968);
    SetEffect<actor ACTOR_NPC_YONOWAARU_N8>(EFFECT_SHOCKED, 3);
    WaitEffect<actor ACTOR_NPC_YONOWAARU_N8>();
    WaitExecuteLives(ACTOR_NPC_YONOWAARU_N8);
    message_SetFace(ACTOR_NPC_YONOWAARU, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english=" Wh...[K] What are you implying?!",
    });
    message_Talk({
        english="""
             N-not possible![K] Absolutely
