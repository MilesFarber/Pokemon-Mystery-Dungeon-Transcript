        """,
    });
    message_Talk({
        english="""
             Your little family spats are
            fine with me. Keep it up.
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_YONOWAARU, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english=" .........",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_PLAYER_FUTURE, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english="""
             I've got to hurry on ahead.[K]
            See you.
        """,
    });
    message_Close();
    Turn2Direction<actor ACTOR_NPC_YONOWAARU_N8>(32, 10, DIR_UPLEFT);
    MovePositionMark<actor ACTOR_PLAYER_FUTURE>(0.7969, Position<'m0', 25.5, 30.5>);
    Wait(20);
    bgm_FadeOut(90);
    WaitExecuteLives(ACTOR_PLAYER_FUTURE);
    message_SetFace(ACTOR_NPC_YONOWAARU, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english=" ...[K]Wait!",
    });
    message_Talk({
        english="""
             Why don't we call a temporary
