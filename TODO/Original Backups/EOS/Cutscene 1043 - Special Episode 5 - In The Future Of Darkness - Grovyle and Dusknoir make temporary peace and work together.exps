    });
    message_Talk({
        english=" Why are you still surprised?",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2DirectionLives<actor ACTOR_NPC_YONOWAARU_N8>(4, 10, ACTOR_PLAYER_FUTURE);
    WaitExecuteLives(ACTOR_NPC_YONOWAARU_N8);
    message_SetFace(ACTOR_NPC_YONOWAARU, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english=" Even so!",
    });
    message_Talk({
        english="""
             The [CS:N]Sableye[CR] follow any orders
