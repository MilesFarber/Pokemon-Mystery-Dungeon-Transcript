    Turn2Direction<actor ACTOR_PLAYER_APPOINT>(4, 10, DIR_RIGHT);
    Wait(3);
    Turn2Direction<actor ACTOR_ADVENTURE_NPC1>(4, 2, DIR_DOWN);
    Turn2Direction<actor ACTOR_ADVENTURE_NPC2>(4, 10, DIR_DOWN);
    Wait(3);
    Turn2Direction<actor ACTOR_PLAYER_APPOINT>(4, 10, DIR_DOWN);
    Wait(2);
    MovePositionMark<actor ACTOR_NPC_SHEIMI>(1, Position<'m14', 28.5, 34>);
    Turn2Direction<actor ACTOR_NPC_SHEIMI>(4, 10, DIR_DOWN);
