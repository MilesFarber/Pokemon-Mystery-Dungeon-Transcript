    MovePositionMark<actor ACTOR_ADVENTURE_NPC1>(1.1992, Position<'m3', 31.5, 42.5>);
    MovePositionMark<actor ACTOR_ADVENTURE_NPC2>(1.1992, Position<'m4', 25.5, 42.5>);
    Wait(10);
    SetAnimation<actor ACTOR_NPC_DENRYUU>(5);
    Wait(40);
    SetAnimation<actor ACTOR_NPC_DENRYUU>(2);
    Wait(20);
    MovePositionMark<actor ACTOR_NPC_DENRYUU>(0.5, Position<'m5', 23.5, 28.5>);
    WaitExecuteLives(ACTOR_NPC_SHEIMI);
    message_SetFace(ACTOR_NPC_SHEIMI, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english=" [CS:N]Ampharos[CR]!",
    });
    WaitExecuteLives(ACTOR_NPC_DENRYUU);
    se_Play(8964);
    SetEffect<actor ACTOR_NPC_DENRYUU>(EFFECT_TWO_ARROWS_AT_SIDE_RIGHT, 3);
    WaitEffect<actor ACTOR_NPC_DENRYUU>();
    WaitExecuteLives(ACTOR_NPC_DENRYUU);
    Turn2Direction<actor ACTOR_NPC_DENRYUU>(1, 10, DIR_DOWNRIGHT);
    WaitExecuteLives(ACTOR_NPC_DENRYUU);
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    MovePositionMark<actor ACTOR_NPC_SHEIMI>(1, Position<'m6', 28.5, 34>);
    MovePositionMark<actor ACTOR_PLAYER_APPOINT>(1, Position<'m7', 28.5, 39>);
    MovePositionMark<actor ACTOR_ADVENTURE_NPC1>(1, Position<'m8', 31.5, 37.5>);
    MovePositionMark<actor ACTOR_ADVENTURE_NPC2>(1, Position<'m9', 25.5, 37.5>);
    Wait(6);
    MovePositionMark<actor ACTOR_NPC_DENRYUU>(1, Position<'m10', 28.5, 29.5>);
    Turn2Direction<actor ACTOR_NPC_DENRYUU>(1, 10, DIR_DOWN);
    WaitExecuteLives(ACTOR_NPC_DENRYUU);
    message_SetFace(ACTOR_NPC_DENRYUU, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
    message_FacePositionOffset(0, -1);
    message_Talk({
        english="""
             Oh! It's [CS:N]Shaymin[CR] from the
            village! I was wondering who it was.
        """,
    });
    message_KeyWait();
    SetEffect<actor ACTOR_NPC_DENRYUU>(EFFECT_LAUGHING, 3);
    message_SetFace(ACTOR_NPC_DENRYUU, FACE_HAPPY, FACE_POS_TOP_R_CENTER);
    message_FacePositionOffset(0, -1);
    message_Talk({
        english="""
             It's been a long time!
            How have you been?
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    SetEffect<actor ACTOR_NPC_DENRYUU>(EFFECT_NONE, 3);
    message_SetFace(ACTOR_NPC_SHEIMI, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english="""
             It has been a long time,
            [CS:N]Ampharos[CR].
        """,
    });
    message_Talk({
        english="""
             But we don't have time to chat.
            We're in a hurry!
        """,
    });
    se_Play(8972);
    SetEffect<actor ACTOR_NPC_SHEIMI>(EFFECT_SWEAT_DROPS_FROM_BOTH_SIDES_MEDIUM, 3);
    WaitEffect<actor ACTOR_NPC_SHEIMI>();
    WaitExecuteLives(ACTOR_NPC_SHEIMI);
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    se_Play(8962);
    SetEffect<actor ACTOR_NPC_DENRYUU>(EFFECT_QUESTION_MARK, 0);
    WaitEffect<actor ACTOR_NPC_DENRYUU>();
    WaitExecuteLives(ACTOR_NPC_DENRYUU);
    message_SetFace(ACTOR_NPC_DENRYUU, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
    message_FacePositionOffset(0, -1);
    message_Talk({
        english=" Indeed? Did something happen?",
