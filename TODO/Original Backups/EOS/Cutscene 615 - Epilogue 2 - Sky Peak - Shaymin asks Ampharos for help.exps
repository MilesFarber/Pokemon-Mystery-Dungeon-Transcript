    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_SHEIMI, FACE_DETERMINED, FACE_POS_STANDARD);
    message_Talk({
        english=" At the 7th Station Clearing!",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    se_Play(8967);
    SetEffect<actor ACTOR_NPC_DENRYUU>(EFFECT_EXCLAMATION_MARK, 0);
    WaitEffect<actor ACTOR_NPC_DENRYUU>();
    WaitExecuteLives(ACTOR_NPC_DENRYUU);
    message_SetFace(ACTOR_NPC_DENRYUU, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
    message_FacePositionOffset(0, -1);
    message_Talk({
        english="""
             Ah... Here I thought I was going
            to have my first guests in a long time, but it
            sounds like that will have to wait.
        """,
    });
    message_Talk({
        english="""
             I hear you. I'm on my way.
            The 7th Station Clearing, you said?
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_SHEIMI, FACE_DETERMINED, FACE_POS_STANDARD);
    message_Talk({
        english=" Yes!",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_DENRYUU, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
    message_FacePositionOffset(0, -1);
    message_Talk({
        english=" You wait for me here.",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_SHEIMI, FACE_DETERMINED, FACE_POS_STANDARD);
    message_Talk({
        english=" We're counting on you!",
    });
    message_Close();
    MovePositionMark<actor ACTOR_NPC_DENRYUU>(1.5, Position<'m11', 28.5, 52.5>);
    Wait(3);
    MovePositionMark<actor ACTOR_NPC_SHEIMI>(1, Position<'m12', 30.5, 34>);
    Wait(2);
    Turn2Direction<actor ACTOR_NPC_SHEIMI>(4, 10, DIR_LEFT);
    Wait(3);
    bgm_FadeOut(60);
    screen_FadeOut(0, 30);
    MovePositionMark<actor ACTOR_PLAYER_APPOINT>(1, Position<'m13', 26.5, 39>);
