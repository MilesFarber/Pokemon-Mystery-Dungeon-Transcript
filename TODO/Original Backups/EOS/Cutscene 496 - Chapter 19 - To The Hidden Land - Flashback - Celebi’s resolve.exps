
def 0 {
    back_SetGround(LEVEL_P08P01A);
    supervision_Acting(0);
    camera_SetMyself<performer 0>();
    screen_FlushOut(1, 0, 8, 0, 0, 0);
    screen_FadeIn(1, 30);
    Wait(30);
    message_SetFace(ACTOR_NPC_SEREBII, FACE_NORMAL, FACE_POS_TOP_L_CENTER);
    message_Talk({
        english="""
             Besides, if you would be so kind
            as to prevent the planet's paralysis...
        """,
    });
    message_Talk({
        english="""
             We'll finally be spared the agony
            of this world of darkness.
        """,
    });
    message_Talk({
        english="""
             My dear [CS:N]Grovyle[CR], I will devote
            my whole life to achieve that end!
        """,
    });
    message_Close();
    screen_FadeOut(1, 30);
    screen_FlushIn(1, 0, 1, 0, 0, 0);
