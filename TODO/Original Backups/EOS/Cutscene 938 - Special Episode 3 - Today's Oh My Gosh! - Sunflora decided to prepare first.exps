
def 0 {
    sound_Stop();
    back_SetGround(LEVEL_G01P04A);
    supervision_Acting(0);
    camera_SetMyself<performer 0>();
    screen_FadeIn(1, 30);
    bgm_PlayFadeIn(BGM_WIGGLYTUFFS_GUILD, 0, 256);
    Wait(30);
    message_SetFace(ACTOR_PLAYER_KIMAWARI, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english=" Phew...",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    se_Play(8972);
    SetEffect<actor ACTOR_PLAYER_KIMAWARI>(EFFECT_SWEAT_DROPS_FROM_BOTH_SIDES_MEDIUM, 3);
    WaitEffect<actor ACTOR_PLAYER_KIMAWARI>();
    WaitExecuteLives(ACTOR_PLAYER_KIMAWARI);
    message_SetFace(ACTOR_PLAYER_KIMAWARI, FACE_SIGH, FACE_POS_STANDARD);
    message_Talk({
        english="""
             I was nervous, having been
            called in out of the blue like that!
        """,
    });
    message_Talk({
        english="""
             But it was a request from the
            Guildmaster. (Oh my gosh, I'm so happy!)
        """,
    });
    message_SetFace(ACTOR_PLAYER_KIMAWARI, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english="""
             I'm representing the guild on
            this...[K] So I have to do my best!
        """,
    });
    message_Talk({
        english="""
             I have to do my best and
            apprehend [CS:N]Haunter[CR]!
        """,
    });
    message_Talk({
        english="""
             I should hurry and prepare so I
            can head out!
        """,
    });
    ExecuteCommon<actor ACTOR_PLAYER_KIMAWARI>(CORO_JUMP_ANGRY_FUNC_SERIES, 0);
    WaitExecuteLives(ACTOR_PLAYER_KIMAWARI);
    message_Close();
    Wait(30);
    message_Mail({
        english="""
            [CN]The Special Episode
            [CN]"Today's 'Oh My Gosh'"
            [CN]stars [CS:Y]Sunflora[CR] as the main character.
        """,
    });
    message_Mail({
        english="""
            [CN]You will progress through the story with
            [CN][CS:Y]Sunflora[CR] as the playable character.
        """,
    });
    message_Close();
    end;
}
