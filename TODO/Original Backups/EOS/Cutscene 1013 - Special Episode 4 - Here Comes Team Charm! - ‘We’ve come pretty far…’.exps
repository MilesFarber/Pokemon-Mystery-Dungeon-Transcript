
def 0 {
    sound_Stop();
    $SCENARIO_SIDE = scn[45, 11];
    back_SetGround(LEVEL_D56P21A);
    supervision_StationCommon(0);
    supervision_Acting(0);
    SetPositionInitial<actor ACTOR_NPC_CHAAREMU>();
    SetPositionInitial<actor ACTOR_NPC_SAANAITO>();
    SetAnimation<actor ACTOR_PLAYER_CHARMS>(2);
    SetAnimation<actor ACTOR_NPC_CHAAREMU>(2);
    SetAnimation<actor ACTOR_NPC_SAANAITO>(2);
    camera_SetMyself<performer 0>();
    screen_FadeIn(1, 30);
    bgm_PlayFadeIn(BGM_DEEP_LIMESTONE_CAVERN, 0, 256);
    MovePositionMark<actor ACTOR_PLAYER_CHARMS>(1, Position<'m0', 28.5, 34.5>);
    Wait(9);
    MovePositionMark<actor ACTOR_NPC_CHAAREMU>(1, Position<'m1', 25.5, 38.5>, Position<'m2', 24.5, 36.5>);
    Wait(12);
    MovePositionMark<actor ACTOR_NPC_SAANAITO>(1, Position<'m3', 31.5, 38.5>, Position<'m4', 32.5, 36.5>);
    WaitExecuteLives(ACTOR_NPC_CHAAREMU);
    ExecuteCommon<actor ACTOR_PLAYER_CHARMS>(CORO_LOOK_AROUND_FUNC_SERIES, 0);
    Wait(6);
    ExecuteCommon<actor ACTOR_NPC_CHAAREMU>(CORO_LOOK_AROUND_RIGHT_FUNC_SERIES, 0);
    Wait(4);
    ExecuteCommon<actor ACTOR_NPC_SAANAITO>(CORO_LOOK_AROUND_LEFT_FUNC_SERIES, 0);
    WaitExecuteLives(ACTOR_PLAYER_CHARMS);
    Turn2Direction<actor ACTOR_PLAYER_CHARMS>(4, 10, DIR_DOWN);
    Wait(6);
    Turn2DirectionLives<actor ACTOR_NPC_CHAAREMU>(4, 10, ACTOR_PLAYER_CHARMS);
    Wait(9);
    Turn2DirectionLives<actor ACTOR_NPC_SAANAITO>(4, 10, ACTOR_PLAYER_CHARMS);
    WaitExecuteLives(ACTOR_NPC_SAANAITO);
    Wait(3);
    message_SetFace(ACTOR_PLAYER_CHARMS, FACE_NORMAL, FACE_POS_TOP_C_FACER);
    message_Talk({
        english="""
             We've come pretty far, haven't
            we?
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2Direction<actor ACTOR_NPC_CHAAREMU>(4, 10, DIR_UPLEFT);
    Wait(4);
    Turn2DirectionLives<actor ACTOR_PLAYER_CHARMS>(4, 10, ACTOR_NPC_CHAAREMU);
    Wait(6);
    Turn2DirectionLives<actor ACTOR_NPC_SAANAITO>(4, 10, ACTOR_NPC_CHAAREMU);
    WaitExecuteLives(ACTOR_NPC_CHAAREMU);
    ExecuteCommon<actor ACTOR_NPC_CHAAREMU>(CORO_LOOK_AROUND_LEFT_FUNC_SERIES, 0);
    WaitExecuteLives(ACTOR_NPC_SAANAITO);
    WaitExecuteLives(ACTOR_NPC_CHAAREMU);
    se_Play(8962);
    SetEffect<actor ACTOR_NPC_CHAAREMU>(EFFECT_QUESTION_MARK, 3);
    WaitEffect<actor ACTOR_NPC_CHAAREMU>();
    WaitExecuteLives(ACTOR_NPC_CHAAREMU);
    message_SetFace(ACTOR_NPC_CHAAREMU, FACE_NORMAL, FACE_POS_BOTTOM_L_FACEOUTW);
    message_Talk({
        english="""
             I wonder where
            [CS:N]Wigglytuff[CR] went.
        """,
    });
    message_Close();
    Turn2DirectionLives<actor ACTOR_NPC_CHAAREMU>(4, 10, ACTOR_NPC_SAANAITO);
    WaitExecuteLives(ACTOR_NPC_CHAAREMU);
    message_SetFace(ACTOR_NPC_CHAAREMU, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english=" Maybe farther ahead?",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2DirectionLives<actor ACTOR_PLAYER_CHARMS>(8, 10, ACTOR_NPC_SAANAITO);
    message_SetFace(ACTOR_NPC_SAANAITO, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english=" Yeah.[K] Maybe...",
    });
    message_Talk({
        english="""
             Or maybe we're already
            ahead of him.
        """,
    });
    message_Talk({
        english="""
             Whatever.[K] I feel like the
            treasure is really close...
        """,
    });
    message_Talk({
        english="""
             Everyone, be extra careful
            from here on.
        """,
    });
    message_Close();
    end;
}
