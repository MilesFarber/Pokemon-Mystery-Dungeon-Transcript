                """,
            }
        default:
            {
                english="""
                     If we plan to explore a dungeon
                    where our current team will suffer type-based
                    disadvantages...
                """,
            }
    }
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     We can build a totally different
                    team, even changing the team leader, so that
