
def 0 {
    bgm_PlayFadeIn(BGM_SEALED_RUIN, 0, 256);
    SetAnimation<actor ACTOR_PLAYER>(2);
    SetAnimation<actor ACTOR_ATTENDANT1>(2);
    WaitExecuteLives(ACTOR_ATTENDANT1);
    Turn2DirectionLives<actor ACTOR_ATTENDANT1>(4, 10, ACTOR_PLAYER);
    WaitExecuteLives(ACTOR_ATTENDANT1);
    Turn2DirectionLives<actor ACTOR_PLAYER>(4, 10, ACTOR_ATTENDANT1);
    message_SetFace(ACTOR_ATTENDANT1, FACE_NORMAL, FACE_POS_STANDARD);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" Are you all ready, [hero]?",
            }
        case 2:
            {
                english=" Are you ready, [hero]?",
            }
        default:
            {
                english=" Are you ready, [hero]?",
            }
    }
    switch ( message_SwitchMenu(0, 1) ) {
        case menu({
            english="All set!",
        }):
        default:
            @label_0;
            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
            message_SwitchTalk ($PARTNER_TALK_KIND) {
                case 1:
                    {
                        english=" All right! Let's roll out!",
                    }
                case 2:
                    {
                        english=" OK! Let's go!",
                    }
                default:
                    {
                        english=" OK! Let's go!",
                    }
            }
            message_Close();
            Turn2Direction<actor ACTOR_PLAYER>(4, 10, DIR_UP);
            Turn2Direction<actor ACTOR_ATTENDANT1>(4, 10, DIR_UP);
            screen_FadeOut(1, 30);
            main_EnterDungeon(29, 0);
            switch ( message_Menu(MENU_DUNGEON_INITIALIZE_TEAM) ) { }
            main_EnterDungeon(-1, 0);
            hold;
            end;
        case menu({
            english="Not yet...",
        }):
            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
            message_SwitchTalk ($PARTNER_TALK_KIND) {
                case 1:
                    {
                        english=" We'll go when you're ready.",
                    }
                case 2:
                    {
                        english=" Let's go when you're ready.",
                    }
                default:
                    {
                        english=" Let's go when you're ready.",
                    }
            }
            message_SwitchTalk ($PARTNER_TALK_KIND) {
                case 1:
                    {
                        english=" Let's hurry after [CS:N]Grovyle[CR]!",
                    }
                case 2:
                    {
                        english="""
                             Let's hurry and catch up to
                            [CS:N]Grovyle[CR]!
                        """,
                    }
                default:
                    {
                        english="""
                             Let's hurry and catch up to
                            [CS:N]Grovyle[CR]!
                        """,
                    }
            }
            message_Close();
            end;
    }
}
