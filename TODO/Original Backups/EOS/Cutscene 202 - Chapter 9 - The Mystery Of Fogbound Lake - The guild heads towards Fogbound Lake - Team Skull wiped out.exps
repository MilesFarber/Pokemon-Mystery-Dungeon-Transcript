    Wait(2);
    SlidePositionOffset<actor ACTOR_NPC_DOGAASU>(1, -1, 0);
    message_SetFace(ACTOR_NPC_DOGAASU, FACE_NORMAL, FACE_POS_BOTTOM_L_CENTER);
