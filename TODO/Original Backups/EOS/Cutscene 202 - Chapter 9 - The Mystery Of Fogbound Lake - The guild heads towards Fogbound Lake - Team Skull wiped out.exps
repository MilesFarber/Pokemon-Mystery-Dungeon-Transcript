    SetEffect<actor ACTOR_NPC_DAGUTORIO>(EFFECT_EXCLAMATION_MARK, 3);
    SetEffect<actor ACTOR_NPC_BIPPA>(EFFECT_EXCLAMATION_MARK, 3);
