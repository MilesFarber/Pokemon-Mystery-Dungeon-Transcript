
def 0 {
    sound_Stop();
    back_SetGround(LEVEL_D22P11A);
    supervision_StationCommon(0);
    supervision_LoadStation(LEVEL_D22P11A, 'UN08');
    supervision_Station(0);
    supervision_Acting(0);
    camera_SetMyself<performer 0>();
    SetPositionInitial<actor ACTOR_NPC_YONOWAARU_N8>();
    SetAnimation<actor ACTOR_NPC_YONOWAARU_N8>(2);
    screen_FadeIn(1, 30);
    bgm_PlayFadeIn(BGM_DUSK_FOREST, 0, 256);
    Wait(30);
    message_SetFace(ACTOR_NPC_YONOWAARU, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english=" That was close.",
    });
    message_Talk({
        english="""
             However...[K] If the [CS:N]Sableye[CR]
            set a trap over there...
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_PLAYER_FUTURE, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english="""
             I know.[K] [CS:N]Celebi[CR] isn't
            there anymore.
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2Direction<actor ACTOR_NPC_YONOWAARU_N8>(4, 10, DIR_UP);
    WaitExecuteLives(ACTOR_NPC_YONOWAARU_N8);
    message_SetFace(ACTOR_NPC_YONOWAARU, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english="""
             But you're still going,
            aren't you?[K] On from here.
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2Direction<actor ACTOR_PLAYER_FUTURE>(4, 10, DIR_UP);
    WaitExecuteLives(ACTOR_PLAYER_FUTURE);
    message_SetFace(ACTOR_PLAYER_FUTURE, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english=" Yeah.",
    });
    message_Talk({
        english="""
             Knock out the [CS:N]Sableye[CR]...[K]
            Or get some information out of them!
        """,
    });
    message_Talk({
        english=" To find [CS:N]Celebi[CR] and [CS:N]Dialga[CR]!",
    });
    message_Close();
    end;
}
