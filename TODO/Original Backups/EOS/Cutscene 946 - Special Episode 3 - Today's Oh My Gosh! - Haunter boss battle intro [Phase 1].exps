    message_SetFace(ACTOR_NPC_GOOSUTO, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
    message_Talk({
        english=" I told you already!",
    });
    message_Talk({
        english=" No one has ever caught me!",
    });
    message_Talk({
        english="""
             The explorers who have tried to
            catch me...
        """,
    });
    message_Talk({
        english="""
             All became discouraged...[K]
            Lost their confidence...
        """,
    });
    message_Talk({
        english=" That kind of disappointment...",
    });
    message_Close();
    bgm_FadeOut(30);
    se_Play(5143);
