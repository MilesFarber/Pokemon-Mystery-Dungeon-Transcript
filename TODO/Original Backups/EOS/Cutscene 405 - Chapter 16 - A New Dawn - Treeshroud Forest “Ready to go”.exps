
def 0 {
    bgm_PlayFadeIn(BGM_TREESHROUD_FOREST, 0, 256);
    SetAnimation<actor ACTOR_PLAYER>(2);
    SetAnimation<actor ACTOR_ATTENDANT1>(2);
    SetAnimation<actor ACTOR_NPC_JUPUTORU>(2);
    Turn2DirectionLives<actor ACTOR_ATTENDANT1>(4, 10, ACTOR_PLAYER);
    WaitExecuteLives(ACTOR_ATTENDANT1);
    Turn2DirectionLives<actor ACTOR_PLAYER>(4, 10, ACTOR_ATTENDANT1);
    Turn2DirectionLives<actor ACTOR_NPC_JUPUTORU>(4, 10, ACTOR_PLAYER);
    message_SetFace(ACTOR_ATTENDANT1, FACE_NORMAL, FACE_POS_STANDARD);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" Are you all ready, [hero]?",
            }
        case 2:
            {
                english=" Are you ready, [hero]?",
            }
        default:
            {
                english=" Are you ready, [hero]?",
            }
    }
    switch ( message_SwitchMenu(0, 1) ) {
        case menu({
            english="Yes",
        }):
        default:
            @label_0;
            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
            MovePositionOffset<actor ACTOR_NPC_JUPUTORU>(1, 0, -24);
            WaitExecuteLives(ACTOR_NPC_JUPUTORU);
            message_SwitchTalk ($PARTNER_TALK_KIND) {
                case 1:
                    {
                        english=" All right. We're good to go!",
                    }
                case 2:
                    {
                        english=" OK. We're good to go!",
                    }
                default:
                    {
                        english=" OK. We're all set to go!",
                    }
            }
            message_SwitchTalk ($PARTNER_TALK_KIND) {
                case 1:
                    {
                        english=" Let's get moving!",
                    }
                case 2:
                    {
                        english=" Let's set off!",
                    }
                default:
                    {
                        english=" Let's get moving!",
                    }
            }
            message_Close();
            MovePositionMark<actor ACTOR_PLAYER>(1, Position<'m0', 32, 9.5>);
            Wait(15);
            MovePositionMark<actor ACTOR_ATTENDANT1>(1, Position<'m1', 32, 9.5>);
            Wait(5);
            MovePositionMark<actor ACTOR_NPC_JUPUTORU>(1, Position<'m2', 32, 9.5>);
            $SCENARIO_MAIN = scn[21, 2];
            main_EnterDungeon(34, 30);
            switch ( message_Menu(MENU_DUNGEON_INITIALIZE_TEAM) ) { }
            main_EnterDungeon(-1, 30);
            hold;
        case menu({
            english="No",
        }):
            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
            message_SwitchTalk ($PARTNER_TALK_KIND) {
                case 1:
                    {
                        english=" All right.",
                    }
                case 2:
                    {
                        english=" OK.",
                    }
                default:
                    {
                        english=" OK.",
                    }
            }
            message_SwitchTalk ($PARTNER_TALK_KIND) {
                case 1:
                    {
                        english="""
                             We'll be on our way when
                            you're ready.
                        """,
                    }
                case 2:
                    {
                        english=" Let's go as soon as you're ready.",
                    }
                default:
                    {
                        english=" Let's leave when you're ready.",
                    }
            }
            message_Close();
            end;
    }
}
