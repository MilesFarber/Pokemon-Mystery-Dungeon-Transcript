                """,
            }
    }
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" That's our graduation exam.",
            }
        case 2:
            {
                english=" That's our graduation exam.",
            }
        default:
            {
                english=" That's our graduation exam.",
            }
    }
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     Let's pass this exam and
