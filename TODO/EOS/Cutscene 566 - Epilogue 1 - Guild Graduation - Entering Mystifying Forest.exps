                """,
            }
        default:
            {
                english="""
                     I don't know what we're
                    up against...
                """,
            }
    }
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     But this is our mission.[K] Get to
