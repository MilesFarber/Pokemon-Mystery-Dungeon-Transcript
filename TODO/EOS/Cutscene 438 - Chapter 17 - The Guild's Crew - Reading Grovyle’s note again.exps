
def 0 {
    bgm_PlayFadeIn(BGM_OCEAN1, 0, 256);
    SetAnimation<actor ACTOR_ATTENDANT1>(2);
    SetAnimation<actor ACTOR_PLAYER>(2);
    message_Mail({
        english="""
            [CN]It's [CS:N]Grovyle[CR]'s letter.[K]
            [CN]Would you like to read it?
        """,
    });
    switch ( message_SwitchMenu(0, 1) ) {
        case menu({
            english="Yes",
        }):
        default:
            @label_0;
            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
            message_Mail({
                english="""
                    [CN][partner] began reading
                    [CN]the letter from [CS:N]Grovyle[CR].
                """,
            });
            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
            message_Mail({
                english="""
                    "To [hero] and [partner]:[K]
                    How are you doing?"
                """,
            });
            message_Mail({
                english="\"How goes your search for the [CS:P]Hidden Land[CR]?\"",
            });
            message_Mail({
                english="""
                    "Things are going well on my end. I've already
                    collected three Time Gears."
                """,
            });
            message_Mail({
                english="\"I have to find only two more Time Gears.\"",
            });
            message_Mail({
                english="\"I plan to join you when I've collected all five.\"",
            });
            message_Mail({
                english="""
                    "Plans have proceeded smoothly. [CS:N]Azelf[CR] and his
                    friends understood the situation. And they have
                    fully cooperated."
                """,
            });
            message_Mail({
                english="""
                    "[CS:N]Azelf[CR] told me that members of your guild let
                    them know I was coming. Thank you."
                """,
            });
            message_Mail({
                english="""
                    "It's heartening to know that more and more
                    Pokémon are coming to trust us."
                """,
            });
            message_Mail({
                english="""
                    "However, I will continue to stay away from
                    Treasure Town and the guild."
                """,
            });
            message_Mail({
                english="""
                    "First, I'm not certain if the Pokémon in this
                    world trust me entirely or not."
                """,
            });
            message_Mail({
                english="""
                    "But there's something more troubling
                    than that."
                """,
            });
            message_Mail({
                english="""
                    "[CS:N]Dusknoir[CR] is liable to return from the future
                    at any time."
                """,
            });
            message_Mail({
                english="""
                    "Since [CS:N]Dusknoir[CR] will be coming, we should keep
                    a low profile."
                """,
            });
            message_Mail({
                english="""
                    "This is another reason I should stay away
                    from Treasure Town and the guild."
                """,
            });
            message_Mail({
                english="""
                    "I may instead come back to Sharpedo Bluff or
                    the beach."
                """,
            });
            message_Mail({
                english="""
                    "If we should meet, we can then exchange
                    information."
                """,
            });
            message_Mail({
                english="\"Good luck on your end.\"",
            });
            message_Mail({
                english="""
                    "Together, we shall stop the planet's paralysis."
                                              - From [CS:N]Grovyle[CR]
                """,
            });
            message_Close();
            end;
        case menu({
            english="No",
        }):
            message_Close();
            end;
    }
}
