
def 0 {
    sound_Stop();
    message_SetFace(ACTOR_PLAYER_PUPURIN, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english="""
             Hmm...[K] I think that's as far as
            I can go.
        """,
    });
    message_Talk({
        english=" Master told me to come today...",
    });
    message_Talk({
        english="""
             But I think it's all right. ♪[K]
            Time to head home for the day. ♪
        """,
    });
    message_KeyWait();
    screen_FadeOutAll(1, 60);
    message_CloseEnforce();
    CallCommon(CORO_FADE_OUT_ALL_AFTER);
    end;
}
