    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" This is pretty rough going...",
            }
        case 2:
            {
                english=" This isn't quite so easy...",
            }
        default:
            {
                english=" It's harder than I thought...",
            }
