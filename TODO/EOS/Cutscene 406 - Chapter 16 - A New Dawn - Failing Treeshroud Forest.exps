    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" Ugh! We blew that attempt!",
            }
        case 2:
            {
                english=" Ugh! We didn't make it.",
            }
        default:
            {
                english=" Ugh! That ended badly.",
            }
