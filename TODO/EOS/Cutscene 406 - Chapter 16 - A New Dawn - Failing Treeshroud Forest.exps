        case 1:
            {
                english=" Ugh...we were careless.",
            }
        case 2:
            {
                english="""
                     Ugh...we were caught being
                    careless.
                """,
            }
        default:
            {
                english="""
                     Ugh...we should have been
                    more careful.
                """,
            }
