
def 0 {
    sound_Stop();
    message_SetFace(ACTOR_NPC_CHAAREMU, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english="""
             Hmm...[K] Looks like we didn't do
            so well.
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_PLAYER_CHARMS, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english="""
             We'll do better
            next time. [M:H8]
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_SAANAITO, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english="""
             Anyway, let's head back for a
            little while.
        """,
    });
    message_KeyWait();
    screen_FadeOutAll(1, 60);
    message_CloseEnforce();
    CallCommon(CORO_FADE_OUT_ALL_AFTER);
    back_SetGround(LEVEL_D55P11A);
    supervision_StationCommon(0);
    supervision_Acting(0);
    SetPositionInitial<actor ACTOR_NPC_CHAAREMU>();
    SetPositionInitial<actor ACTOR_NPC_SAANAITO>();
    camera_SetMyself<performer 0>();
    SetDirection<actor ACTOR_PLAYER_CHARMS>(DIR_DOWNLEFT);
    SetDirection<actor ACTOR_NPC_CHAAREMU>(DIR_DOWN);
    SetDirection<actor ACTOR_NPC_SAANAITO>(DIR_RIGHT);
    SetAnimation<actor ACTOR_PLAYER_CHARMS>(2);
    SetAnimation<actor ACTOR_NPC_CHAAREMU>(2);
    SetAnimation<actor ACTOR_NPC_SAANAITO>(2);
    SetAnimation<actor ACTOR_NPC_SAANAITO>(22);
    SetAnimation<actor ACTOR_NPC_CHAAREMU>(22);
    SetAnimation<actor ACTOR_PLAYER_CHARMS>(22);
    screen_FadeIn(1, 30);
    bgm_PlayFadeIn(BGM_BOULDER_QUARRY, 0, 256);
    Wait(30);
    SetAnimation<actor ACTOR_NPC_CHAAREMU>(23);
    Wait(10);
    SetAnimation<actor ACTOR_PLAYER_CHARMS>(23);
    Wait(7);
    SetAnimation<actor ACTOR_NPC_SAANAITO>(23);
    WaitAnimation<actor ACTOR_NPC_SAANAITO>();
    WaitExecuteLives(ACTOR_NPC_SAANAITO);
    SetAnimation<actor ACTOR_NPC_SAANAITO>(2);
    SetAnimation<actor ACTOR_NPC_CHAAREMU>(2);
    Turn2Direction<actor ACTOR_NPC_CHAAREMU>(4, 10, DIR_RIGHT);
    SetAnimation<actor ACTOR_PLAYER_CHARMS>(2);
    Turn2DirectionLives<actor ACTOR_PLAYER_CHARMS>(8, 10, ACTOR_NPC_CHAAREMU);
    Wait(10);
    Turn2DirectionLives<actor ACTOR_NPC_CHAAREMU>(4, 10, ACTOR_PLAYER_CHARMS);
    Wait(6);
    Turn2DirectionLives<actor ACTOR_NPC_SAANAITO>(4, 10, ACTOR_NPC_CHAAREMU);
    WaitExecuteLives(ACTOR_NPC_SAANAITO);
    Wait(9);
    message_SetFace(ACTOR_NPC_CHAAREMU, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english="""
             ...[K]Looks like we're right back
            here again...
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_SAANAITO, FACE_WORRIED, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english="""
             I said we shouldn't be
            impatient earlier...
        """,
    });
    Turn2DirectionLives<actor ACTOR_PLAYER_CHARMS>(4, 10, ACTOR_NPC_SAANAITO);
    Wait(3);
    Turn2DirectionLives<actor ACTOR_NPC_CHAAREMU>(4, 10, ACTOR_NPC_SAANAITO);
    message_Talk({
        english="""
             But we just can't take our
            time, either.
        """,
    });
    message_Talk({
        english="""
             I'm worried about how far
            Team [CS:X]AWD[CR] has gotten...
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_PLAYER_CHARMS, FACE_NORMAL, FACE_POS_TOP_C_FACER);
    message_Talk({
        english="""
             That's true.[K] We should hurry up
            a little.
        """,
    });
    message_Talk({
        english=" Once you're ready, let's head out.",
    });
    message_Close();
    end;
}
