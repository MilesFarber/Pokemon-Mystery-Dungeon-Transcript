
def 0 {
    sound_Stop();
    message_SetFace(ACTOR_PLAYER_FUTURE, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english=" Argh...[K] We didn't do so well...",
    });
    message_Talk({
        english=" We should turn back for now.",
    });
    message_KeyWait();
    screen_FadeOutAll(1, 60);
    message_CloseEnforce();
    CallCommon(CORO_FADE_OUT_ALL_AFTER);
    back_SetGround(LEVEL_D51P21A);
    supervision_StationCommon(0);
    supervision_Acting(0);
    camera_SetMyself<performer 0>();
    SetPositionInitial<actor ACTOR_NPC_YONOWAARU_N9>();
    SetAnimation<actor ACTOR_NPC_YONOWAARU_N9>(2);
    screen_FadeIn(1, 30);
    bgm_PlayFadeIn(BGM_DARK_ICE_MOUNTAIN, 0, 256);
    Wait(30);
    message_SetFace(ACTOR_PLAYER_FUTURE, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english="""
             ... (Argh.[K] It's bad to
            not make any progress in a place like this!)
        """,
    });
    message_Talk({
        english=" (Next time, definitely!)",
    });
    message_Close();
    end;
}
