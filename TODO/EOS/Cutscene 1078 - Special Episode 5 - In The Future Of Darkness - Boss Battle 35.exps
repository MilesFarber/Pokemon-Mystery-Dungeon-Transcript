    message_SetFace(ACTOR_NPC_ONIGOORI, FACE_NORMAL, FACE_POS_TOP_R_FACEINW);
    message_Talk({
        english=" GOGIGIGIGI!",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_YONOWAARU, FACE_NORMAL, FACE_POS_BOTTOM_R_CENTER);
