
def 0 {
    screen_WhiteOutAll(1, 0);
    Wait(1);
    bgm2_PlayFadeIn(BGM_ANOTHER_GLOWING_NOISE, 120, 256);
    screen_FadeIn(1, 0);
    back_SetGround(LEVEL_P12P01A);
    supervision_StationCommon(0);
    supervision_Acting(0);
    camera_SetMyself<performer 0>();
    Wait(1);
    back_SetBackScrollSpeed(-2.0, -2.0);
    SetOutputAttribute<actor ACTOR_ATTENDANT1>(8);
    SetOutputAttribute<actor ACTOR_PLAYER>(8);
    SetOutputAttribute<object OBJECT_D28P33A3_68>(8);
    SetOutputAttribute<object OBJECT_D28P33A3_68>(2);
    screen_FadeInAll(1, 60);
    ExecuteCommon<actor ACTOR_ATTENDANT1>(CORO_LOOK_AROUND_FUNC_SERIES, 0);
    Wait(10);
    ExecuteCommon<actor ACTOR_PLAYER>(CORO_LOOK_AROUND_RIGHT_FUNC_SERIES, 0);
    WaitExecuteLives(ACTOR_ATTENDANT1);
    Wait(30);
    se_Play(8967);
    SetEffect<actor ACTOR_ATTENDANT1>(EFFECT_EXCLAMATION_MARK, 3);
    WaitEffect<actor ACTOR_ATTENDANT1>();
    WaitExecuteLives(ACTOR_ATTENDANT1);
    message_SetFace(ACTOR_ATTENDANT1, FACE_SURPRISED, FACE_POS_BOTTOM_L_FACEOUTW);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" Hey!",
            }
        case 2:
            {
                english=" Hey!",
            }
        default:
            {
                english=" Oh!",
            }
    }
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" Look at that!",
            }
        case 2:
            {
                english=" Look at that!",
            }
        default:
            {
                english=" Look at that!",
            }
    }
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    bgm2_FadeOut(180);
    Turn2Direction<actor ACTOR_PLAYER>(4, 10, DIR_UPLEFT);
    WaitExecuteLives(ACTOR_PLAYER);
    back2_SetMode(4);
    back2_SetGround(LEVEL_V25P01A);
    camera2_SetPositionMark(Position<'m0', 22.5, 18.5>);
    screen2_FadeIn(1, 30);
    Wait(30);
    bgm_PlayFadeIn(BGM_TIME_GEAR_REMIX, 0, 256);
    Wait(5);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" It's [CS:P]Temporal Tower[CR]!",
            }
        case 2:
            {
                english=" [CS:P]Temporal Tower[CR]!",
            }
        default:
            {
                english=" [CS:P]Temporal Tower[CR]!",
            }
    }
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Wait(45);
    message_SetFace(ACTOR_ATTENDANT1, FACE_NORMAL, FACE_POS_BOTTOM_L_FACEOUTW);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" Finally...[K] We're on our way...",
            }
        case 2:
            {
                english=" Finally...[K] We're on our way...",
            }
        default:
            {
                english=" Finally...[K] We're on our way...",
            }
    }
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" We're going there...",
            }
        case 2:
            {
                english=" We're going there...",
            }
        default:
            {
                english=" We're going there...",
            }
    }
    message_Close();
    screen2_FadeOut(0, 30);
    screen_FadeOutAll(1, 30);
    back2_SetMode(0);
    CallCommon(CORO_FADE_OUT_ALL_AFTER);
    end;
}

