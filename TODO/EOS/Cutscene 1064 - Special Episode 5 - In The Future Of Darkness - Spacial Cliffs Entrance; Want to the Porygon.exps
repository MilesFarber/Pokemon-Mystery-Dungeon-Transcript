
def 0 {
    sound_Stop();
    back_SetGround(LEVEL_D50P11A);
    supervision_StationCommon(0);
    supervision_Acting(0);
    camera_SetMyself<performer 0>();
    SetPositionInitial<actor ACTOR_NPC_YONOWAARU_N8>();
    SetAnimation<actor ACTOR_NPC_YONOWAARU_N8>(2);
    screen_FadeIn(1, 30);
    bgm_PlayFadeIn(BGM_SPACIAL_CLIFFS, 0, 256);
    Wait(30);
    MovePositionMark<actor ACTOR_PLAYER_FUTURE>(1, Position<'m0', 36.5, 29.5>);
    MovePositionMark<actor ACTOR_NPC_YONOWAARU_N8>(1, Position<'m1', 36.5, 26.5>);
    WaitExecuteLives(ACTOR_NPC_YONOWAARU_N8);
    message_SetFace(ACTOR_NPC_YONOWAARU, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
    message_Talk({
        english="""
             This is the entrance to
            [CS:P]Spacial Cliffs[CR].
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2Direction<actor ACTOR_NPC_YONOWAARU_N8>(4, 2, DIR_DOWN);
    WaitExecuteLives(ACTOR_NPC_YONOWAARU_N8);
    message_SetFace(ACTOR_NPC_YONOWAARU, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
    message_Talk({
        english="""
             Once we pass through here,
            we'll come to the place where the
            [CS:N]Porygon[CR] live.
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2Direction<actor ACTOR_PLAYER_FUTURE>(4, 1, DIR_UP);
    WaitExecuteLives(ACTOR_PLAYER_FUTURE);
    message_SetFace(ACTOR_PLAYER_FUTURE, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english="""
             [CS:N]Celebi[CR] and [CS:N]Dialga[CR] have already
            gone to [CS:P]Frozen Island[CR].
        """,
    });
    message_Talk({
        english=" Let's hurry.",
    });
    message_Close();
    end;
}
