
def 0 {
    SetAnimation<actor ACTOR_PLAYER>(2);
    SetAnimation<actor ACTOR_ATTENDANT1>(2);
    Turn2DirectionLives<actor ACTOR_ATTENDANT1>(4, 10, ACTOR_PLAYER);
    WaitExecuteLives(ACTOR_ATTENDANT1);
    Turn2DirectionLives<actor ACTOR_PLAYER>(4, 10, ACTOR_ATTENDANT1);
    message_SetFace(ACTOR_ATTENDANT1, FACE_NORMAL, FACE_POS_STANDARD);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     Hey, [hero]. Are you
                    all ready?
                """,
            }
        case 2:
            {
                english="""
                     Hey, [hero].
                    Are you ready?
                """,
            }
        default:
            {
                english="""
                     Hey, [hero].
                    Are you ready?
                """,
            }
    }
    switch ( message_SwitchMenu(0, 1) ) {
        case menu({
            english="I'm ready!",
        }):
        default:
            @label_0;
            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
            message_SwitchTalk ($PARTNER_TALK_KIND) {
                case 1:
                    {
                        english=" All right![K] Let's roll on out!",
                    }
                case 2:
                    {
                        english=" OK![K] Let's go!",
                    }
                default:
                    {
                        english=" OK![K] Let's go!",
                    }
            }
            message_Close();
            MovePositionOffset<actor ACTOR_PLAYER>(1, 80, 0);
            Wait(10);
            MovePositionOffset<actor ACTOR_ATTENDANT1>(1, 80, 0);
            Wait(15);
            screen_FadeOut(1, 30);
            main_EnterDungeon(28, 0);
            switch ( message_Menu(MENU_DUNGEON_INITIALIZE_TEAM) ) { }
            main_EnterDungeon(-1, 0);
            hold;
            end;
        case menu({
            english="Not yet...",
        }):
            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
            message_SwitchTalk ($PARTNER_TALK_KIND) {
                case 1:
                    {
                        english=" We'll go when you're ready.",
                    }
                case 2:
                    {
                        english=" Let's go when you're ready.",
                    }
                default:
                    {
                        english=" Let's go when you're ready.",
                    }
            }
            message_SwitchTalk ($PARTNER_TALK_KIND) {
                case 1:
                    {
                        english="""
                             Let's go before those [CS:N]Sableye[CR]
                            catch up.
                        """,
                    }
                case 2:
                    {
                        english="""
                             We need to go before those
                            [CS:N]Sableye[CR] catch up.
                        """,
                    }
                default:
                    {
                        english="""
                             Let's go before those [CS:N]Sableye[CR]
                            catch up.
                        """,
                    }
            }
            message_Close();
            end;
    }
}
