    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    MovePositionOffset<actor ACTOR_NPC_SEREBII>(1, 0, -160);
    Wait(10);
    MovePositionOffset<actor ACTOR_NPC_JUPUTORU>(1, 0, -160);
    Wait(15);
    MovePositionOffset<actor ACTOR_ATTENDANT1>(1, 0, -160);
    Wait(5);
    MovePositionOffset<actor ACTOR_PLAYER>(1, 0, -160);
    Wait(30);
    screen_FadeOut(1, 60);
    Wait(80);
    end;
}
