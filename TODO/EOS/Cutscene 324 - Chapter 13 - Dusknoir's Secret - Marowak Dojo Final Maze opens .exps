
def 0 {
    $SCENARIO_MAIN_BIT_FLAG[12] = 1;
    $SCENARIO_MAIN_BIT_FLAG[13] = 1;
    SetAnimation<actor ACTOR_PLAYER>(2);
    SetAnimation<actor ACTOR_ATTENDANT1>(2);
    bgm_FadeOut(10);
    bgm2_PlayFadeIn(BGM_EARTHQUAKE3, 0, 256);
    camera_SetEffect(2, 1, 1.0);
    Wait(30);
    se_Play(8967);
    SetEffect<actor ACTOR_ATTENDANT1>(EFFECT_SHOCKED, 3);
    ExecuteCommon<actor ACTOR_ATTENDANT1>(CORO_JUMP_SURPRISE_FUNC_SERIES, 0);
    WaitExecuteLives(ACTOR_ATTENDANT1);
    Wait(30);
    bgm2_FadeOut(60);
    camera_SetEffect(0, 0, 0);
    Wait(60);
    message_SetFace(ACTOR_ATTENDANT1, FACE_SURPRISED, FACE_POS_STANDARD);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" What was that? That tremor...",
            }
        case 2:
            {
                english=" What was that? That tremor...",
            }
        default:
            {
                english=" What was that? That tremor...",
            }
    }
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2DirectionLives<actor ACTOR_ATTENDANT1>(4, 10, ACTOR_PLAYER);
    WaitExecuteLives(ACTOR_ATTENDANT1);
    Turn2DirectionLives<actor ACTOR_PLAYER>(4, 10, ACTOR_ATTENDANT1);
    WaitExecuteLives(ACTOR_PLAYER);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     It sounded like...[K]it came from
                    inside the dojo?
                """,
            }
        case 2:
            {
                english="""
                     It sounded as if...[K]it came from
                    inside the dojo.
                """,
            }
        default:
            {
                english="""
                     Did it...[K]sound like it came from
                    inside the dojo?
                """,
            }
    }
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     Let's go in and check it out,
                    [hero]!
                """,
            }
        case 2:
            {
                english=" Let's go in, [hero]!",
            }
        default:
            {
                english=" Let's go in, [hero]!",
            }
    }
    message_Close();
    Turn2Direction<actor ACTOR_ATTENDANT1>(4, 10, DIR_UP);
    WaitExecuteLives(ACTOR_ATTENDANT1);
    Turn2Direction<actor ACTOR_PLAYER>(4, 10, DIR_UP);
    screen_FadeOutAll(1, 30);
    CallCommon(CORO_FADE_OUT_ALL_AFTER);
    end;
}
