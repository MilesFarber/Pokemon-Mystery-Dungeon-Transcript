def 1 for actor ACTOR_PLAYER {
    SetAnimation(2);
    Lock(5);
    MovePositionMark(1, Position<'m12', 42, 27.5>);
    Lock(6);
    @label_12;
    forever {
        Turn2Direction(4, 10, DIR_DOWNRIGHT);
        Wait(30);
        Turn2Direction(4, 2, DIR_RIGHT);
        Wait(60);
        Turn2Direction(4, 10, DIR_DOWNLEFT);
        Wait(50);
        Turn2Direction(4, 10, DIR_UPLEFT);
        Wait(50);
        continue;  // may be redundant
    }
}

def 2 for actor ACTOR_ATTENDANT1 {
    SetAnimation(2);
    Lock(8);
    MovePositionMark(1, Position<'m13', 34, 25.5>);
    Unlock(3);
    Lock(9);
