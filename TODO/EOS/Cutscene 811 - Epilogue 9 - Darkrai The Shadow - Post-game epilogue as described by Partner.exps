    Unlock(3);
    Lock(10);
    @label_13;
    forever {
        Wait(12);
        Turn2Direction(4, 10, DIR_DOWNRIGHT);
        WaitRandom(30, 60);
        Turn2Direction(4, 2, DIR_UPRIGHT);
        WaitRandom(60, 80);
        Turn2Direction(4, 10, DIR_DOWN);
        WaitRandom(50, 70);
        Turn2Direction(4, 10, DIR_LEFT);
        Wait(50);
        continue;  // may be redundant
    }
}
