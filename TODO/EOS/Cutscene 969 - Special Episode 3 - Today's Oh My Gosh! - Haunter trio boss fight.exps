
def 0 {
    sound_Stop();
    back_SetDungeonBanner(164, 0);
    screen_FadeIn(1, 16);
    Wait(60);
    screen_FadeOut(1, 16);
    Wait(15);
    back_SetGround(LEVEL_D57P44A);
    supervision_Acting(0);
    camera_SetMyself<performer 0>();
    WaitLockLives(5, ACTOR_PLAYER_KIMAWARI);
    SetOutputAttribute<object OBJECT_D57P44A1_438>(8);
    Wait(1);
    SetEffect<actor ACTOR_NPC_DOGOOMU>(692, 0);
    screen_FadeIn(1, 30);
    bgm_PlayFadeIn(BGM_OH_NO, 0, 256);
    Unlock(5);
    WaitLockLives(6, ACTOR_PLAYER_KIMAWARI);
    message_SetFace(ACTOR_PLAYER_KIMAWARI, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english=" [CS:N]Loudred[CR]! Are you all right?!",
    });
    message_Close();
    Turn2Direction<actor ACTOR_NPC_DOGOOMU>(4, 10, DIR_DOWN);
    WaitExecuteLives(ACTOR_NPC_DOGOOMU);
    Unlock(6);
    WaitLockLives(7, ACTOR_PLAYER_KIMAWARI);
    message_SetFace(ACTOR_PLAYER_KIMAWARI, FACE_SURPRISED, FACE_POS_STANDARD);
    message_Talk({
        english=" ...Ow! Hot hot hot hot hot!",
    });
    clear $EVENT_LOCAL;
    Unlock(7);
    message_Close();
    se_Play(8972);
    SetEffect<actor ACTOR_NPC_DOGOOMU>(EFFECT_NONE, 0);
    SetEffect<actor ACTOR_NPC_DOGOOMU>(EFFECT_SWEAT_DROPS_FROM_BOTH_SIDES_MEDIUM, 3);
    WaitEffect<actor ACTOR_NPC_DOGOOMU>();
    WaitExecuteLives(ACTOR_NPC_DOGOOMU);
    SetEffect<actor ACTOR_NPC_DOGOOMU>(692, 0);
    message_SetFace(ACTOR_NPC_DOGOOMU, FACE_PAIN, FACE_POS_BOTTOM_R_CENTER);
    message_FacePositionOffset(-1, -2);
    message_Talk({
        english=" Y-you're LATE, [CS:Y]SUNFLORA[CR]!",
    });
    message_Talk({
        english="""
             While I was WAITING for you
            to ARRIVE...
        """,
    });
    message_Talk({
        english="""
             I've been FIGHTING here ALL by
            MYSELF this WHOLE time!
        """,
    });
    $EVENT_LOCAL = 1;
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    WaitLockLives(8, ACTOR_PLAYER_KIMAWARI);
    se_Play(8972);
    SetEffect<actor ACTOR_PLAYER_KIMAWARI>(EFFECT_NONE, 0);
    SetEffect<actor ACTOR_PLAYER_KIMAWARI>(EFFECT_SWEAT_DROPS_FROM_BOTH_SIDES_MEDIUM, 3);
    WaitEffect<actor ACTOR_PLAYER_KIMAWARI>();
    WaitExecuteLives(ACTOR_PLAYER_KIMAWARI);
    SetEffect<actor ACTOR_PLAYER_KIMAWARI>(692, 0);
    message_SetFace(ACTOR_NPC_GOOSUTO, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
    message_Talk({
        english="""
             Heh heh![K] The one who doesn't
            learn has come back for another lesson!
        """,
    });
    message_Close();
    Turn2Direction<actor ACTOR_NPC_DOGOOMU>(4, 2, DIR_UP);
    WaitExecuteLives(ACTOR_NPC_DOGOOMU);
    message_SetFace(ACTOR_NPC_GOOSUTO, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
    message_Talk({
        english=" All right!",
    });
    message_Talk({
        english="""
             You asked for it! We'll defeat
            you again, and this time...
        """,
    });
    message_Close();
    se_Play(5143);
    screen_WhiteOut(1, 2);
    Wait(2);
    screen_FadeIn(1, 2);
    Wait(10);
    message_SetFace(ACTOR_NPC_GOOSUTO, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
    message_Talk({
        english=" We'll defeat you so thoroughly...",
    });
    message_Talk({
        english="""
             That you'll be scared to ever
            come after us again!
        """,
    });
    message_Close();
    bgm_FadeOut(30);
    se_Play(5143);
    screen_WhiteOut(1, 2);
    Wait(2);
    screen_FadeIn(1, 2);
    Wait(5);
    se_Play(5143);
    screen_WhiteOut(1, 2);
    Wait(2);
    screen_FadeIn(1, 2);
    WaitSe(5143);
    message_SetFace(ACTOR_NPC_DOGOOMU, FACE_PAIN, FACE_POS_BOTTOM_R_CENTER);
    message_FacePositionOffset(-1, -2);
    message_Talk({
        english=" Here they COME, [CS:Y]SUNFLORA[CR]!",
    });
    message_Close();
    CallCommon(CORO_BOSS_WIPE_FUNC);
    main_EnterDungeon(164, 30);
    main_EnterDungeon(-1, 30);
    hold;
    end;
}

def 1 for actor ACTOR_PLAYER_KIMAWARI {
    SetAnimation(2);
    Lock(5);
    MovePositionMark(2, Position<'m0', 29.5, 32.5>);
    se_Play(9993);
    SetEffect(692, 0);
    Lock(6);
    CallCommon(CORO_JUMP_SURPRISE_FUNC);
    SetAnimation(5);
    Lock(7);
    CallCommon(CORO_JUMP_ANGRY_FUNC);
    @label_1;
    forever {
        MovePositionMark(2.5, Position<'m1', 26, 32.5>);
        switch ( $EVENT_LOCAL ) {
            case 1:
                break_loop;
                break;
            default:
                MovePositionMark(2.5, Position<'m2', 33, 32.5>);
                switch ( $EVENT_LOCAL ) {
                    case 1:
                        break_loop;
                        break;
                    default:
                        continue;  // may be redundant
                }
                break;
        }
    }
    @label_0;
    MovePositionMark(2.5, Position<'m3', 29.5, 32.5>);
    Turn2DirectionLives(4, 10, ACTOR_NPC_GOOSUTO);
    Lock(8);
    hold;
}
