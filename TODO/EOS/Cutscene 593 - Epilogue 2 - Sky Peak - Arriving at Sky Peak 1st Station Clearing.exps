
def 0 {
    sound_Stop();
    $SCENARIO_MAIN = scn[29, 12];
    message_SetFace(ACTOR_NPC_SHEIMI, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english="""
             We're almost to the
            1st Station Clearing. [K]You can do it!
        """,
    });
    message_Close();
    back_SetGround(LEVEL_D73P21A);
    supervision_LoadStation(LEVEL_D73P21A, 'US31');
    supervision_Station(40);
    supervision_Station(42);
    supervision_Station(43);
    supervision_Station(44);
    supervision_Station(45);
    supervision_Station(3);
    supervision_StationCommon(9);
    supervision_StationCommon(10);
    supervision_Acting(0);
    camera_SetMyself<performer 0>();
    SetPositionInitial<actor ACTOR_NPC_SHEIMI>();
    SetPositionInitial<actor ACTOR_ADVENTURE_NPC1>();
    SetPositionInitial<actor ACTOR_ADVENTURE_NPC2>();
    SetAnimation<actor ACTOR_NPC_SHEIMI>(2);
    SetAnimation<actor ACTOR_ADVENTURE_NPC1>(2);
    SetAnimation<actor ACTOR_ADVENTURE_NPC2>(2);
    screen_FadeIn(1, 30);
    bgm_PlayFadeIn(BGM_SKY_PEAK_FOREST, 0, 256);
    Wait(30);
    MovePositionMark<actor ACTOR_NPC_SHEIMI>(1, Position<'m0', 28.5, 35.5>);
    MovePositionMark<actor ACTOR_PLAYER_APPOINT>(1, Position<'m1', 28.5, 40.5>);
    MovePositionMark<actor ACTOR_ADVENTURE_NPC1>(1, Position<'m2', 31.5, 39.5>);
    MovePositionMark<actor ACTOR_ADVENTURE_NPC2>(1, Position<'m3', 25.5, 39.5>);
    WaitExecuteLives(ACTOR_NPC_SHEIMI);
    Wait(10);
    Turn2DirectionLives<actor ACTOR_NPC_SHEIMI>(4, 10, ACTOR_PLAYER_APPOINT);
    WaitExecuteLives(ACTOR_NPC_SHEIMI);
    message_SetFace(ACTOR_NPC_SHEIMI, FACE_NORMAL, FACE_POS_TOP_C_FACER);
    message_Talk({
        english=" This is the 1st Station Clearing.",
    });
    message_Talk({
        english="""
             [CS:P]Sky Peak[CR] has resting areas,
            labeled 1st Station through 9th Station.
        """,
    });
    message_Talk({
        english="""
             The 10th Station is, of course,
            the summit.
        """,
    });
    message_Talk({
        english="""
             The road ahead is long, so let's
            take it in stages.
        """,
    });
    message_Close();
    MovePositionMark<actor ACTOR_ADVENTURE_NPC1>(1, Position<'m4', 34.5, 39.5>);
    MovePositionMark<actor ACTOR_ADVENTURE_NPC2>(1, Position<'m5', 22.5, 39.5>);
    Turn2Direction<actor ACTOR_ADVENTURE_NPC1>(4, 10, DIR_UPLEFT);
    Turn2Direction<actor ACTOR_ADVENTURE_NPC2>(4, 10, DIR_UPRIGHT);
    WaitExecuteLives(ACTOR_ADVENTURE_NPC1);
    WaitExecuteLives(ACTOR_ADVENTURE_NPC2);
    end;
}
