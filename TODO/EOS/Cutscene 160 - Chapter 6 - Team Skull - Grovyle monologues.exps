
def 0 {
    bgm_PlayFadeIn(BGM_TIME_GEAR_REMIX, 0, 256);
    back_SetGround(LEVEL_V03P12A);
    supervision_Acting(0);
    camera_SetMyself<performer 0>();
    screen_FadeIn(1, 15);
    Wait(30);
    message_ResetActor();
    message_Talk({
        english="""
             Three more Time Gears remain. I must
            have them...
        """,
    });
    message_Close();
    bgm_FadeOut(190);
    Wait(45);
    screen_FadeOut(1, 90);
    Wait(60);
    Wait(60);
    end;
}
