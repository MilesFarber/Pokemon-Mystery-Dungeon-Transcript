
def 0 {
    sound_Stop();
    back_SetGround(LEVEL_V03P11A);
    supervision_Acting(0);
    supervision_Acting(1);
    supervision_Acting(2);
    camera_SetMyself<performer 0>();
    SetEffect<performer 3>(EFFECT_VERY_HEAVY_RAIN, 3);
    SetOutputAttribute<actor ACTOR_NPC_DAAKURAI>(2);
    SetAnimation<actor ACTOR_NPC_DAAKURAI>(4);
    SetAnimation<actor ACTOR_NPC_SHADOW_DAAKURAI>(4);
    bgm_PlayFadeIn(BGM_STORM, 90, 256);
    screen_FadeChange(1, 30, 0, 192);
    Wait(60);
    se_Play(6401);
    screen_WhiteChange(1, 2, 256, 64);
    Destroy<actor ACTOR_NPC_SHADOW_DAAKURAI>();
    Wait(2);
    screen_WhiteChange(1, 2, 64, 256);
    supervision_Acting(2);
    screen_WhiteChange(1, 2, 256, 64);
    Destroy<actor ACTOR_NPC_SHADOW_DAAKURAI>();
    Wait(5);
    screen_FadeChange(1, 2, 0, 192);
    supervision_Acting(2);
    Destroy<actor ACTOR_NPC_DAAKURAI>();
    SetAnimation<actor ACTOR_NPC_SHADOW_DAAKURAI>(4);
    Wait(80);
    screen_FlushOut(1, 3, 2, 0, 0, 0);
    SetEffect<performer 3>(EFFECT_NONE, 3);
    Wait(30);
    message_ResetActor();
    message_Talk({
        english=" ...[K]This is proceeding nicely.",
    });
    message_Talk({
        english="""
             This forest's distortion in the very fabric
            of space itself is growing.
        """,
    });
    message_Talk({
        english="""
             Ah, the distortion of space and dimension
            itself![K] If it expands further...
        """,
    });
    message_Talk({
        english=" My own power will be amplified!",
    });
    message_Talk({
        english="""
             I failed to destroy time...[K] But things will
            be different now...
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_Talk({
        english=" Hm?![K] Someone's coming!",
    });
    message_Talk({
        english=" It's [CS:N]Cresselia[CR]...[K] That persistent pest!",
    });
    message_Talk({
        english=" I must not be caught...",
    });
    message_Talk({
        english=" Not ever!",
    });
    message_Close();
    se_Play(6401);
    screen_FadeIn(1, 0);
    screen_WhiteOut(1, 2);
    Wait(3);
    screen_FadeIn(1, 2);
    Wait(5);
    screen_WhiteOut(1, 2);
    Wait(5);
    screen_FadeIn(1, 2);
    Wait(60);
    supervision_RemoveActing(1);
    supervision_RemoveActing(2);
    supervision_Acting(3);
    screen_FlushIn(0, 0, 2, 0, 0, 0);
    SetEffect<performer 3>(EFFECT_VERY_HEAVY_RAIN, 3);
    screen_FadeChange(1, 30, 0, 192);
    MovePositionMark<actor ACTOR_NPC_KURESERIA>(1, Position<'m0', 31, 29.5>);
    WaitExecuteLives(ACTOR_NPC_KURESERIA);
    Wait(45);
    se_Play(6401);
    screen_WhiteChange(1, 2, 256, 64);
    Wait(3);
    screen_WhiteChange(1, 2, 64, 256);
    screen_WhiteChange(1, 2, 256, 64);
    Wait(5);
    screen_FadeChange(1, 2, 0, 192);
    Wait(60);
    ExecuteCommon<actor ACTOR_NPC_KURESERIA>(CORO_LOOK_AROUND_FUNC_SERIES, 0);
    WaitExecuteLives(ACTOR_NPC_KURESERIA);
    Wait(30);
    message_SetFace(ACTOR_NPC_KURESERIA, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english=" ...[K]He got away again...",
    });
    message_Talk({
        english="""
             This is the closest that I've
            ever gotten...
        """,
    });
    message_Talk({
        english=" But he always slips away.",
    });
    message_Talk({
        english="""
             It may be difficult, perhaps
            impossible, to catch him.
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Wait(30);
    message_Talk({
        english="""
             No.[K] I can't give up. He has to
            be caught.
        """,
    });
    message_Talk({
        english="""
             And the fabric of space being
            distorted like this must stop! Before it
            accelerates further!
        """,
    });
    message_Talk({
        english="""
             Before the world is thrown back
            into turmoil!
        """,
    });
    message_Talk({
        english=" I've got to do whatever it takes.",
    });
    message_Talk({
        english=" I must stop [CS:N]Darkrai[CR]!",
    });
    message_Close();
    se_Play(6401);
    screen_WhiteChange(1, 2, 256, 64);
    Wait(3);
    screen_WhiteChange(1, 2, 64, 256);
    screen_WhiteChange(1, 2, 256, 64);
    Wait(5);
    screen_FadeChange(1, 2, 0, 192);
    Wait(60);
    bgm_FadeOut(180);
    screen_FadeOut(1, 60);
    SetEffect<performer 3>(EFFECT_NONE, 3);
    WaitBgm(BGM_STORM);
    Wait(30);
    end;
}
