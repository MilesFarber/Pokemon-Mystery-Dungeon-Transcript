
def 0 {
    bgm_PlayFadeIn(BGM_WIGGLYTUFFS_GUILD, 0, 256);
    SetAnimation<actor ACTOR_PLAYER>(2);
    SetAnimation<actor ACTOR_ATTENDANT1>(2);
    message_SetFace(ACTOR_NPC_PERAPPU, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english="""
             Oh? Are you all ready for the
            expedition?
        """,
    });
    message_Talk({
        english="""
             The expedition will be a long
            journey. You should be stocked up on items.
            Are you all ready to go?
        """,
    });
    switch ( message_SwitchMenu(0, 1) ) {
        case menu({
            english="Yes",
        }):
        default:
            @label_0;
            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
            message_Talk({
                english=" Incidentally...",
            });
            message_Talk({
                english="""
                     You may not bring members of
                    your team that aren't members of the guild.
                    Understood?
                """,
            });
            switch ( message_SwitchMenu(0, 1) ) {
                case menu({
                    english="I know!",
                }):
                default:
                    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                    supervision_ExecuteCommon(CORO_EVENT_M08_05_06);
                    @label_1;
                    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                    message_Talk({
                        english="""
                             What, not yet?[K] Get moving and
                            get ready.
                        """,
                    });
                    message_Talk({
                        english="""
                             The other apprentices should be
                            getting their stocks of items ready too.
                        """,
                    });
                    message_Talk({
                        english="""
                             When you're done preparing for
                            the expedition, report to me. ♪
                        """,
                    });
                    message_Close();
                    @label_4;
                    end;
                case menu({
                    english="I didn't know...",
                }):
                    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                    message_SetFace(ACTOR_NPC_PERAPPU, FACE_PAIN, FACE_POS_STANDARD);
                    message_Talk({
                        english="""
                             It's quite apparent that someone
                            failed to pay attention to me...
                        """,
                    });
                    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                    message_SetFace(ACTOR_NPC_PERAPPU, FACE_NORMAL, FACE_POS_STANDARD);
                    message_Talk({
                        english="""
                             The situation being what it is,
                            I shall explain again.
                        """,
                    });
                    message_Talk({
                        english="""
                             You may not bring members of
                            your team that are not members of the guild.
                        """,
                    });
                    message_Talk({
                        english="""
                             Keeping that in mind, you should
                            complete your preparations.
                        """,
                    });
                    message_Talk({
                        english=" Understood. ♪",
                    });
                    message_Close();
                    jump @label_4;
            }
            break;
        case menu({
            english="No",
        }):
            jump @label_1;
    }
}
