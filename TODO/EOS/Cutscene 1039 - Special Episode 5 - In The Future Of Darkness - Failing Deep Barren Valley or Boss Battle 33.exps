
def 0 {
    sound_Stop();
    switch ( ProcessSpecial(PROCESS_SPECIAL_SET_TEAM_SETUP_HERO_ONLY, 0, 0) ) { }
    $SIDE08_BOSS2ND[0] = 1;
    message_SetFace(ACTOR_PLAYER_FUTURE, FACE_PAIN, FACE_POS_STANDARD);
    message_Talk({
        english=" Ooogh...",
    });
    message_Talk({
        english=" Argh...[K] That didn't go well...",
    });
    message_KeyWait();
    screen_FadeOutAll(1, 60);
    message_CloseEnforce();
    CallCommon(CORO_FADE_OUT_ALL_AFTER);
