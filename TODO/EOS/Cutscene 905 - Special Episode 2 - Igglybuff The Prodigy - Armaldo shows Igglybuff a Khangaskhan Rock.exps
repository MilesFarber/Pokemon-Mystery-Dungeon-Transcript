    message_SetFace(ACTOR_NPC_AAMARUDO, FACE_NORMAL, FACE_POS_TOP_R_FACEINW);
    message_Talk({
        english=" No need to be impatient.",
    });
    message_Talk({
        english="""
             Before exploring, you have to
