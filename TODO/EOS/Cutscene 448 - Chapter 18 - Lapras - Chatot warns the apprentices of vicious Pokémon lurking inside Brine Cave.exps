    MovePositionMark<actor ACTOR_NPC_DOGOOMU>(1, Position<'m7', 31.5, 19.5>);
    Wait(10);
    MovePositionMark<actor ACTOR_NPC_CHIRIIN>(1, Position<'m8', 31.5, 19.5>);
    Wait(5);
    MovePositionMark<actor ACTOR_NPC_DIGUDA>(1, Position<'m9', 31.5, 19.5>);
    MovePositionMark<actor ACTOR_NPC_DAGUTORIO>(1, Position<'m10', 31.5, 19.5>);
    Destroy<actor ACTOR_NPC_PERAPPU>();
    Destroy<actor ACTOR_ATTENDANT1>();
    se_FadeOut(6916, 90);
    bgm_FadeOut(180);
    screen_FadeOut(1, 30);
    Wait(60);
    WaitBgm(BGM_WIGGLYTUFFS_GUILD_REMIX);
    message_SetFace(ACTOR_NPC_ZUBATTO, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english="""
             Heh-heh-heh, Chief![K] Looks like
            those louts from the guild are already inside.
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_DOGAASU, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english="""
             Whoa-ho-ho![K] Should we
            follow them?
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_SUKATANKU, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english="""
             Chaw-haw-haw! Sounds good.[K]
            We'll track them, but let's keep out of sight.
        """,
    });
    message_Talk({
        english="""
             When the right time comes along
            somewhere in the cave...
        """,
    });
    message_Talk({
        english="""
             that's when we'll grab that
            wimpy [partner]'s Relic Fragment!
        """,
    });
    message_Talk({
        english="""
             Then we'll hightail it to the
            deepest part of the cave.[K] We'll grab all the
            glory of solving this mystery.
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_ZUBATTO, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english="""
             Heh-heh! Brilliant, Chief![K]
            Your plan's perfect!
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_SUKATANKU, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english=" Chaw-haw-haw! Naturally!",
    });
    message_Talk({
        english=" Anyway...",
    });
    message_Talk({
        english="""
             It will be us! Team [CS:X]Skull[CR]! We'll
            be the ones going to the [CS:P]Hidden Land[CR]!
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_ZUBATTO, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english=" Heh-heh-heh!",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_DOGAASU, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english=" Whoa-ho-ho!",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_SUKATANKU, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english=" Chaw-haw!",
    });
    message_KeyWait();
    screen_FadeOutAll(1, 60);
    message_CloseEnforce();
    CallCommon(CORO_FADE_OUT_ALL_AFTER);
    main_EnterDungeon(35, 30);
    switch ( message_Menu(MENU_DUNGEON_INITIALIZE_TEAM) ) { }
    main_EnterDungeon(-1, 30);
    hold;
    end;
}
