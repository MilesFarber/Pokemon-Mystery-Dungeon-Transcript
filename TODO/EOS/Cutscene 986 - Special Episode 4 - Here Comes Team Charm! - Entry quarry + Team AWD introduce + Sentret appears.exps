    MovePositionOffset<actor ACTOR_NPC_CHAAREMU>(1, 0, -16);
    WaitExecuteLives(ACTOR_NPC_CHAAREMU);
    se_Play(8971);
    ExecuteCommon<actor ACTOR_NPC_CHAAREMU>(CORO_JUMP_ANGRY_FUNC_SERIES, 0);
    WaitExecuteLives(ACTOR_NPC_CHAAREMU);
    SetEffect<actor ACTOR_NPC_CHAAREMU>(EFFECT_ANGRY, 3);
    message_SetFace(ACTOR_NPC_CHAAREMU, FACE_ANGRY, FACE_POS_STANDARD);
    message_Talk({
        english="""
             Humph![K] You think you can just
            walk away like that!?
        """,
    });
    message_KeyWait();
    SetEffect<actor ACTOR_NPC_CHAAREMU>(EFFECT_NONE, 3);
    message_Talk({
        english="""
             We've always gotten
            every treasure so far, so we won't
            miss it this time!
        """,
    });
    message_Talk({
        english=" We won't lose!",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2Direction<actor ACTOR_NPC_CHAAREMU>(4, 10, DIR_DOWNRIGHT);
    WaitExecuteLives(ACTOR_NPC_CHAAREMU);
    Turn2Direction<actor ACTOR_PLAYER_CHARMS>(4, 10, DIR_UPLEFT);
    Turn2Direction<actor ACTOR_NPC_SAANAITO>(4, 10, DIR_UPLEFT);
    message_SetFace(ACTOR_NPC_CHAAREMU, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english=" [CS:Y]Lopunny[CR]! [CS:N]Gardevoir[CR]! Let's hurry!",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    SetAnimation<actor ACTOR_NPC_METAMON_OTACHI>(2);
    SetPositionMark<actor ACTOR_NPC_METAMON_OTACHI>(Position<'m16', 34.5, 45.5>);
    message_SetActor(ACTOR_NPC_METAMON_OTACHI);
    message_Talk({
        english=" Excuse me...",
    });
    message_Close();
    se_Play(8978);
    SetEffect<actor ACTOR_NPC_CHAAREMU>(EFFECT_EXCLAMATION_MARK, 3);
    Wait(5);
    SetEffect<actor ACTOR_NPC_SAANAITO>(EFFECT_EXCLAMATION_MARK, 3);
    Wait(3);
    SetEffect<actor ACTOR_PLAYER_CHARMS>(EFFECT_TWO_ARROWS_AT_SIDE_LEFT, 3);
    WaitEffect<actor ACTOR_PLAYER_CHARMS>();
    WaitExecuteLives(ACTOR_PLAYER_CHARMS);
    MovePositionMark<performer 0>(1, Position<'m17', 34.5, 36.5>);
    MovePositionMark<actor ACTOR_NPC_METAMON_OTACHI>(1, Position<'m18', 34.5, 37.5>);
    Turn2Direction<actor ACTOR_NPC_CHAAREMU>(4, 10, DIR_DOWN);
    WaitExecuteLives(ACTOR_NPC_CHAAREMU);
    Turn2Direction<actor ACTOR_NPC_SAANAITO>(4, 2, DIR_DOWN);
    Turn2Direction<actor ACTOR_PLAYER_CHARMS>(4, 10, DIR_DOWN);
    WaitExecutePerformer(0);
    WaitExecuteLives(ACTOR_NPC_METAMON_OTACHI);
    bgm_PlayFadeIn(BGM_IN_THE_DEPTHS_OF_THE_PIT, 0, 256);
    message_SetFace(ACTOR_PLAYER_CHARMS, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
    message_Talk({
        english=" Y-you're...",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_SAANAITO, FACE_NORMAL, FACE_POS_TOP_R_FACEINW);
    message_Talk({
        english=" Earlier...",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    MovePositionOffset<actor ACTOR_NPC_CHAAREMU>(1, 0, 16);
    WaitExecuteLives(ACTOR_NPC_CHAAREMU);
    message_SetFace(ACTOR_NPC_CHAAREMU, FACE_NORMAL, FACE_POS_TOP_L_FACEINW);
    message_Talk({
        english=" You...[K] Didn't you run away?",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    se_Play(8972);
    SetEffect<actor ACTOR_NPC_METAMON_OTACHI>(EFFECT_SWEAT_DROPS_FROM_BOTH_SIDES_MEDIUM, 3);
    WaitEffect<actor ACTOR_NPC_METAMON_OTACHI>();
    WaitExecuteLives(ACTOR_NPC_METAMON_OTACHI);
    message_SetFace(ACTOR_NPC_METAMON_OTACHI, FACE_SAD, FACE_POS_STANDARD);
    message_Talk({
        english=" Y-yes, that's right...",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2Direction<actor ACTOR_NPC_METAMON_OTACHI>(8, 10, DIR_UPLEFT);
    Wait(30);
    Turn2Direction<actor ACTOR_NPC_METAMON_OTACHI>(8, 10, DIR_UPRIGHT);
    Wait(30);
    Turn2Direction<actor ACTOR_NPC_METAMON_OTACHI>(8, 10, DIR_UP);
    WaitExecuteLives(ACTOR_NPC_METAMON_OTACHI);
    Wait(10);
    message_SetFace(ACTOR_NPC_METAMON_OTACHI, FACE_SAD, FACE_POS_STANDARD);
    message_Talk({
        english="""
             I should have said this sooner.[K]
            My name is [CS:N]Sentret[CR]...
        """,
    });
    message_Talk({
        english="""
             Truth is, I was watching you
            and Team [CS:X]AWD[CR] from the shadows over there...
        """,
    });
    message_Talk({
        english="""
             That argument going back
            and forth...
        """,
    });
    message_Talk({
        english="""
             I've never seen anyone stand up
            to Team [CS:X]AWD[CR] like that without flinching...[K]
            It was amazing...
        """,
    });
    message_Talk({
        english="""
             After watching you...[K]
            I feel like I can trust you, so...
        """,
    });
    message_Talk({
        english=" I have a request.",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    se_Play(8962);
    SetEffect<actor ACTOR_PLAYER_CHARMS>(EFFECT_QUESTION_MARK, 3);
    WaitEffect<actor ACTOR_PLAYER_CHARMS>();
    WaitExecuteLives(ACTOR_PLAYER_CHARMS);
    message_SetFace(ACTOR_PLAYER_CHARMS, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
    message_Talk({
        english=" A request?",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_METAMON_OTACHI, FACE_SAD, FACE_POS_STANDARD);
    message_Talk({
        english=" Yes.[K] Team [CS:X]AWD[CR]...",
    });
    message_Talk({
        english=" Team [CS:X]AWD[CR] needs to be punished.",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_SAANAITO, FACE_NORMAL, FACE_POS_TOP_R_FACEINW);
    message_Talk({
        english=" Why Team [CS:X]AWD[CR]?",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_METAMON_OTACHI, FACE_SAD, FACE_POS_STANDARD);
    message_Talk({
        english="""
             The truth is...[K]I used to be in an
            exploration team with some friends a
            while ago...
        """,
    });
    message_Talk({
        english="""
             My friends...[K]were attacked by
            Team [CS:X]AWD[CR] during an adventure...
        """,
    });
    message_Talk({
        english=" They were hurt very badly...",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    se_Play(8968);
    SetEffect<actor ACTOR_NPC_CHAAREMU>(EFFECT_SHOCKED, 3);
    WaitEffect<actor ACTOR_NPC_CHAAREMU>();
    WaitExecuteLives(ACTOR_NPC_CHAAREMU);
    message_SetFace(ACTOR_NPC_CHAAREMU, FACE_SURPRISED, FACE_POS_TOP_L_FACEINW);
    message_Talk({
        english=" Wh-whaaat?!",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_METAMON_OTACHI, FACE_SAD, FACE_POS_STANDARD);
    message_Talk({
        english="""
             And since then, my friends...[K]
            Have been too scared to go out
            exploring again...
        """,
    });
    message_Talk({
        english="""
             They spend their days
            shaking in fear...
        """,
    });
    message_SetFace(ACTOR_NPC_METAMON_OTACHI, FACE_TEARY_EYED, FACE_POS_STANDARD);
    message_Talk({
        english="""
             And so...[K]going out exploring
            with me...
        """,
    });
    message_Talk({
        english="""
             Is completely out of the question
            for them...
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    se_Play(8975);
    ExecuteCommon<actor ACTOR_NPC_CHAAREMU>(CORO_JUMP_ANGRY_FUNC_SERIES, 0);
    WaitExecuteLives(ACTOR_NPC_CHAAREMU);
    SetEffect<actor ACTOR_NPC_CHAAREMU>(EFFECT_ANGRY, 3);
    message_SetFace(ACTOR_NPC_CHAAREMU, FACE_ANGRY, FACE_POS_TOP_L_FACEINW);
    message_Talk({
        english=" That's terrible!",
    });
    message_Talk({
        english="""
             You know, they're real
            scoundrels, just like the rumors say!
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    SetEffect<actor ACTOR_NPC_CHAAREMU>(EFFECT_NONE, 3);
    message_SetFace(ACTOR_PLAYER_CHARMS, FACE_ANGRY, FACE_POS_TOP_R_CENTER);
    message_Talk({
        english="""
             To do something so terrible that
            your friends don't want to explore anymore...
        """,
    });
    message_Talk({
        english="""
             As explorers...[K]we just can't
            forgive those bullies!
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    bgm_FadeOut(30);
    Wait(30);
    message_SetFace(ACTOR_NPC_SAANAITO, FACE_NORMAL, FACE_POS_TOP_R_FACEINW);
    message_Talk({
        english=" We understand, [CS:N]Sentret[CR].",
    });
    message_Talk({
        english="""
             If we run into Team [CS:X]AWD[CR] again,
            we'll definitely punish them.
        """,
    });
    message_Talk({
        english=" In honor of your friends...",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    se_Play(8972);
    SetEffect<actor ACTOR_NPC_METAMON_OTACHI>(EFFECT_SWEAT_DROPS_FROM_BOTH_SIDES_MEDIUM, 3);
    WaitEffect<actor ACTOR_NPC_METAMON_OTACHI>();
    WaitExecuteLives(ACTOR_NPC_METAMON_OTACHI);
    message_SetFace(ACTOR_NPC_METAMON_OTACHI, FACE_TEARY_EYED, FACE_POS_STANDARD);
    message_Talk({
        english=" Th-thank you so much!",
    });
    message_Close();
    Turn2DirectionLives<actor ACTOR_NPC_CHAAREMU>(4, 10, ACTOR_PLAYER_CHARMS);
    WaitExecuteLives(ACTOR_NPC_CHAAREMU);
    Turn2DirectionLives<actor ACTOR_PLAYER_CHARMS>(4, 10, ACTOR_NPC_CHAAREMU);
    Turn2DirectionLives<actor ACTOR_NPC_SAANAITO>(4, 10, ACTOR_NPC_CHAAREMU);
    WaitExecuteLives(ACTOR_NPC_SAANAITO);
    message_SetFace(ACTOR_NPC_CHAAREMU, FACE_NORMAL, FACE_POS_TOP_L_FACEINW);
    message_Talk({
        english="""
             All right! We should get ready
            and get moving![K] Into the quarry!
        """,
    });
    message_Close();
    bgm_PlayFadeIn(BGM_BOULDER_QUARRY, 0, 256);
    end;
}
