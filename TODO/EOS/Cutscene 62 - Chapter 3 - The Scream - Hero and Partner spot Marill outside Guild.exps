    Turn2Direction<actor ACTOR_PLAYER>(4, 10, DIR_RIGHT);
    WaitExecutePerformer(0);
    message_SetFace(ACTOR_ATTENDANT1, FACE_NORMAL, FACE_POS_STANDARD);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" [CS:N]Marill[CR], what's wrong?",
            }
        case 2:
            {
                english=" [CS:N]Marill[CR], what's the matter?",
            }
        default:
            {
                english=" [CS:N]Marill[CR], what's the matter?",
            }
    }
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" Where are [CS:N]Azurill[CR] and [CS:N]Drowzee[CR]?",
            }
        case 2:
            {
                english=" Where are [CS:N]Azurill[CR] and [CS:N]Drowzee[CR]?",
            }
        default:
            {
                english=" Where are [CS:N]Azurill[CR] and [CS:N]Drowzee[CR]?",
            }
    }
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    ExecuteCommon<actor ACTOR_NPC_MARIRU>(CORO_JUMP_HAPPY_FUNC_SERIES, 0);
