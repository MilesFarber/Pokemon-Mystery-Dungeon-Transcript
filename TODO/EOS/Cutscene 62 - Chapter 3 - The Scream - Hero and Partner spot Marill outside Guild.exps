    SetEffect<actor ACTOR_NPC_MARIRU>(EFFECT_SWEAT_DROPS_FROM_BOTH_SIDES_MEDIUM, 3);
    message_SetFace(ACTOR_NPC_MARIRU, FACE_SIGH, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english=" Yes...about them...!",
    });
    message_Talk({
        english="""
             After we all left, we went
            looking for our lost item together...
        """,
    });
    message_Talk({
        english="""
             But I wound up all alone when
            Mr. [CS:N]Drowzee[CR] went somewhere with [CS:N]Azurill[CR].
        """,
    });
    message_Talk({
        english="""
             I called and called! But they
            didn't come back.[K] I got scared...
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_ATTENDANT1, FACE_SURPRISED, FACE_POS_STANDARD);
