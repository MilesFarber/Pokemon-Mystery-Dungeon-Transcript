        case 1:
            {
                english=" So which way did they go?!",
            }
        case 2:
            {
                english=" So which way did they go?!",
            }
        default:
            {
                english=" So which way did they go?!",
            }
    }
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_MARIRU, FACE_SIGH, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
