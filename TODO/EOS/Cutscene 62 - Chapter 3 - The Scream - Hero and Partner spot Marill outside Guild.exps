    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" Hey! There's [CS:N]Marill[CR]!",
            }
        case 2:
            {
                english=" Look! There's [CS:N]Marill[CR]!",
            }
        default:
            {
                english=" Oh! [CS:N]Marill[CR]'s over there!",
            }
