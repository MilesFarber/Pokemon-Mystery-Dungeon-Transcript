
def 0 {
    bgm_PlayFadeIn(BGM_TEMPORAL_TOWER, 0, 256);
    if ( scn($SCENARIO_MAIN) >= [26, 3] ) {
        @label_0;
        SetAnimation<actor ACTOR_PLAYER>(2);
        SetAnimation<actor ACTOR_ATTENDANT1>(2);
        Turn2DirectionLives<actor ACTOR_ATTENDANT1>(4, 10, ACTOR_PLAYER);
        WaitExecuteLives(ACTOR_ATTENDANT1);
        Turn2DirectionLives<actor ACTOR_PLAYER>(4, 10, ACTOR_ATTENDANT1);
        message_SetFace(ACTOR_ATTENDANT1, FACE_NORMAL, FACE_POS_STANDARD);
        message_SwitchTalk ($PARTNER_TALK_KIND) {
            case 1:
                {
                    english=" You ready, [hero]?",
                }
            case 2:
                {
                    english=" Are you ready, [hero]?",
                }
            default:
                {
                    english=" Ready, [hero]?",
                }
        }
        switch ( message_SwitchMenu(0, 1) ) {
            case menu({
                english="Yes",
            }):
            default:
                CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                message_SwitchTalk ($PARTNER_TALK_KIND) {
                    case 1:
                        {
                            english=" Yup. We're all geared up!",
                        }
                    case 2:
                        {
                            english=" OK! We're all set to go!",
                        }
                    default:
                        {
                            english=" OK. I guess we're ready!",
                        }
                }
                message_SwitchTalk ($PARTNER_TALK_KIND) {
                    case 1:
                        {
                            english=" All right! Let's roll!",
                        }
                    case 2:
                        {
                            english=" OK! Off we go!",
                        }
                    default:
                        {
                            english=" OK! Let's go!",
                        }
                }
                message_Close();
                Turn2Direction<actor ACTOR_PLAYER>(4, 10, DIR_UP);
                Turn2Direction<actor ACTOR_ATTENDANT1>(4, 10, DIR_UP);
                WaitExecuteLives(ACTOR_ATTENDANT1);
                screen_FadeOut(1, 30);
                main_EnterDungeon(41, 0);
                switch ( message_Menu(MENU_DUNGEON_INITIALIZE_TEAM) ) { }
                main_EnterDungeon(-1, 0);
                hold;
                end;
            case menu({
                english="No",
            }):
                CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                message_SwitchTalk ($PARTNER_TALK_KIND) {
                    case 1:
                        {
                            english=" Oh, all right.",
                        }
                    case 2:
                        {
                            english=" Oh, OK.",
                        }
                    default:
                        {
                            english=" Oh, OK.",
                        }
                }
                message_SwitchTalk ($PARTNER_TALK_KIND) {
                    case 1:
                        {
                            english=" We'll go when you're ready.",
                        }
                    case 2:
                        {
                            english=" We'll go when you're ready.",
                        }
                    default:
                        {
                            english=" We'll go when you're ready.",
                        }
                }
                message_Close();
                end;
        }
    } else {
        $SCENARIO_MAIN = scn[26, 3];
        jump @label_0;
    }
}
