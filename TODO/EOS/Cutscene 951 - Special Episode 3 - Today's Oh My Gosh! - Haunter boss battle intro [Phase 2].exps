
def 0 {
    sound_Stop();
    $SCENARIO_SIDE = scn[43, 5];
    back_SetDungeonBanner(161, 0);
    screen_FadeIn(1, 16);
    Wait(60);
    screen_FadeOut(1, 16);
    Wait(15);
    back_SetGround(LEVEL_D57P42A);
    supervision_Acting(0);
    camera_SetMyself<performer 0>();
    SetAnimation<object OBJECT_D57P41A1_425>(3);
    SetAnimation<object OBJECT_D57P41A1_426>(2);
    SetAnimation<object OBJECT_D57P41A1_427>(1);
    MovePositionMark<actor ACTOR_NPC_GOOSUTO>(1, Position<'m0', 28.5, 23.5>);
    bgm_PlayFadeIn(BGM_GROWING_ANXIETY, 0, 256);
    screen_FadeIn(1, 30);
    WaitExecuteLives(ACTOR_NPC_GOOSUTO);
    se_Play(8964);
    SetEffect<actor ACTOR_NPC_GOOSUTO>(EFFECT_EXCLAMATION_MARK, 3);
    message_SetActor(ACTOR_PLAYER_KIMAWARI);
    message_Talk({
        english=" Wait! [CS:N]Haunter[CR]!",
    });
    message_Close();
    Turn2Direction<actor ACTOR_NPC_GOOSUTO>(4, 10, DIR_DOWN);
    WaitExecuteLives(ACTOR_NPC_GOOSUTO);
    MovePositionMark<actor ACTOR_PLAYER_KIMAWARI>(2, Position<'m1', 28.5, 29.5>);
    WaitExecuteLives(ACTOR_PLAYER_KIMAWARI);
    se_Play(8971);
    ExecuteCommon<actor ACTOR_PLAYER_KIMAWARI>(CORO_JUMP_ANGRY_FUNC_SERIES, 0);
    WaitExecuteLives(ACTOR_PLAYER_KIMAWARI);
    message_SetFace(ACTOR_PLAYER_KIMAWARI, FACE_DETERMINED, FACE_POS_STANDARD);
    message_Talk({
        english="""
             I'm going to apprehend you
            this time![K] Believe me!
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_GOOSUTO, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
    message_Talk({
        english=" Ugh![K] You again?!",
    });
    message_Talk({
        english="""
             You're persistent![K] Have you
            forgotten that I'm invincible?!
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_PLAYER_KIMAWARI, FACE_DETERMINED, FACE_POS_STANDARD);
    message_Talk({
        english="""
             Invincible or not,
            it doesn't matter!
        """,
    });
    message_Talk({
        english="""
             I am...[K] I am going to arrest you.
            It's that simple!
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_GOOSUTO, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
    message_Talk({
        english=" Humph!",
    });
    message_Talk({
        english="""
             I've seen explorers like
            you before!
        """,
    });
    message_Talk({
        english="""
             The persistent explorers who
            tried to challenge me over and over again!
        """,
    });
    message_Talk({
        english="""
             Big deal![K] It might be a huge
            shock, even for you, but--
        """,
    });
    message_Talk({
        english="""
             It doesn't matter how
            hard you try...
        """,
    });
    message_Close();
    bgm_FadeOut(30);
    se_Play(5143);
    screen_WhiteOut(1, 2);
    Wait(2);
    screen_FadeIn(1, 2);
    Wait(10);
    message_SetFace(ACTOR_NPC_GOOSUTO, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
    message_Talk({
        english="""
             There is no way you can
            succeed![K] No possible way!
        """,
    });
    message_Close();
    se_Play(5143);
    screen_WhiteOut(1, 2);
    Wait(2);
    screen_FadeIn(1, 2);
    Wait(5);
    se_Play(5143);
    screen_WhiteOut(1, 2);
    Wait(2);
    screen_FadeIn(1, 2);
    WaitSe(5143);
    message_SetFace(ACTOR_NPC_GOOSUTO, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
    message_Talk({
        english=" So let's go!",
    });
    message_Close();
    CallCommon(CORO_BOSS_WIPE_FUNC);
    main_EnterDungeon(161, 30);
    main_EnterDungeon(-1, 30);
    hold;
