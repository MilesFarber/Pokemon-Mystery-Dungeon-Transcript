
def 0 {
    bgm_PlayFadeIn(BGM_CRYSTAL_CAVE, 0, 256);
    back_SetGround(LEVEL_G01P04A);
    supervision_Acting(0);
    camera_SetMyself<performer 0>();
    screen_FlushOut(1, 0, 8, 0, 0, 0);
    screen_FadeIn(1, 30);
    Wait(30);
    SetEffect<actor ACTOR_ATTENDANT1>(EFFECT_QUESTION_MARK, 3);
    WaitEffect<actor ACTOR_ATTENDANT1>();
    WaitExecuteLives(ACTOR_ATTENDANT1);
    message_SetFace(ACTOR_ATTENDANT1, FACE_WORRIED, FACE_POS_BOTTOM_R_FACEINW);
    message_FacePositionOffset(1, 0);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" [CS:P]Luminous Spring[CR]?",
            }
        case 2:
            {
                english=" [CS:P]Luminous Spring[CR]?",
            }
        default:
            {
                english=" [CS:P]Luminous Spring[CR]?",
            }
    }
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_PUKURIN, FACE_NORMAL, FACE_POS_TOP_C_FACER);
    message_Talk({
        english="""
             Yup! ♪[K] It was where Pokémon
            once went to evolve.
        """,
    });
    message_Talk({
        english="""
             But maybe because of the time
            troubles we had...[K]no sunlight shines on the
            spring now.
        """,
    });
    message_Talk({
        english=" Now nothing can evolve there.",
    });
    message_Close();
    screen_FadeOut(1, 30);
    screen_FlushIn(1, 0, 1, 0, 0, 0);
    end;
