            SetEffect<actor ACTOR_NPC_DIGUDA>(EFFECT_NONE, 3);
            SetEffect<actor ACTOR_NPC_CHIRIIN>(EFFECT_NONE, 3);
            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
            Turn2Direction<actor ACTOR_PLAYER>(4, 10, DIR_RIGHT);
            Turn2Direction<actor ACTOR_NPC_MIMIROPPU>(8, 10, DIR_RIGHT);
            WaitExecuteLives(ACTOR_NPC_MIMIROPPU);
            Turn2Direction<actor ACTOR_NPC_SAANAITO>(4, 10, DIR_RIGHT);
            Wait(60);
            Turn2Direction<actor ACTOR_NPC_MIMIROPPU>(8, 10, DIR_DOWN);
            WaitExecuteLives(ACTOR_NPC_MIMIROPPU);
            Turn2Direction<actor ACTOR_NPC_SAANAITO>(4, 10, DIR_DOWNLEFT);
            Wait(45);
            SetEffect<actor ACTOR_NPC_MIMIROPPU>(EFFECT_LAUGHING, 3);
