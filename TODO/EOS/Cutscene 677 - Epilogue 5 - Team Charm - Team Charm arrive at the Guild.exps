            Wait(15);
            SetEffect<actor ACTOR_NPC_DAGUTORIO>(EFFECT_NONE, 3);
            SetEffect<actor ACTOR_NPC_KIMAWARI>(EFFECT_NONE, 3);
            SetEffect<actor ACTOR_NPC_BIPPA>(EFFECT_NONE, 3);
