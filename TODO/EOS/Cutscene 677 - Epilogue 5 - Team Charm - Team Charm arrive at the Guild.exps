            SetEffect<actor ACTOR_NPC_MIMIROPPU>(EFFECT_NONE, 3);
            message_SetFace(ACTOR_NPC_MIMIROPPU, FACE_NORMAL, FACE_POS_BOTTOM_C_FACEL);
            message_Talk({
                english=" Of course you may!",
            });
            SetAnimation<actor ACTOR_NPC_MIMIROPPU>(24);
            WaitAnimation<actor ACTOR_NPC_MIMIROPPU>();
            WaitExecuteLives(ACTOR_NPC_MIMIROPPU);
            se_Play(5127);
            screen_WhiteOut(1, 2);
            Wait(2);
            screen_FadeIn(1, 2);
            Wait(10);
            se_Play(5127);
            screen_WhiteOut(1, 2);
            Wait(2);
            screen_FadeIn(1, 2);
            WaitSe(5127);
            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
            bgm_PlayFadeIn(BGM_WIGGLYTUFFS_GUILD, 0, 256);
            SetEffect<actor ACTOR_NPC_DAGUTORIO>(EFFECT_JOYOUS, 3);
            SetEffect<actor ACTOR_NPC_KIMAWARI>(EFFECT_JOYOUS, 3);
            SetEffect<actor ACTOR_NPC_BIPPA>(EFFECT_JOYOUS, 3);
            SetEffect<actor ACTOR_NPC_HEIGANI>(EFFECT_JOYOUS, 3);
            SetAnimation<actor ACTOR_NPC_KIMAWARI>(4);
            SetAnimation<actor ACTOR_NPC_BIPPA>(4);
            SetAnimation<actor ACTOR_NPC_DOGOOMU>(4);
            SetAnimation<actor ACTOR_NPC_CHIRIIN>(4);
            SetAnimation<actor ACTOR_NPC_DAGUTORIO>(4);
            SetAnimation<actor ACTOR_NPC_DIGUDA>(4);
            SetAnimation<actor ACTOR_NPC_PERAPPU>(4);
            SetAnimation<actor ACTOR_NPC_GUREGGURU>(4);
            SetAnimation<actor ACTOR_NPC_HEIGANI>(4);
            ExecuteCommon<actor ACTOR_ATTENDANT1>(CORO_JUMP_ANGRY_FUNC_SERIES, 0);
            WaitExecuteLives(ACTOR_ATTENDANT1);
            SetEffect<actor ACTOR_ATTENDANT1>(EFFECT_LAUGHING, 3);
            message_SetFace(ACTOR_ATTENDANT1, FACE_JOYOUS, FACE_POS_STANDARD);
            message_SwitchTalk ($PARTNER_TALK_KIND) {
                case 1:
                    {
                        english=" Wa-hah! Yes! Thank you!",
                    }
                case 2:
                    {
                        english=" Yay! Yes! Thank you!",
                    }
                default:
                    {
                        english=" Yay! Yes! Thank you!",
                    }
            }
            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
            SetEffect<actor ACTOR_ATTENDANT1>(EFFECT_NONE, 3);
            SetEffect<actor ACTOR_NPC_DAGUTORIO>(EFFECT_NONE, 3);
            SetEffect<actor ACTOR_NPC_KIMAWARI>(EFFECT_NONE, 3);
            SetEffect<actor ACTOR_NPC_BIPPA>(EFFECT_NONE, 3);
            SetEffect<actor ACTOR_NPC_HEIGANI>(EFFECT_NONE, 3);
            SetAnimation<actor ACTOR_NPC_KIMAWARI>(2);
            SetAnimation<actor ACTOR_NPC_BIPPA>(2);
            SetAnimation<actor ACTOR_NPC_DOGOOMU>(2);
            SetAnimation<actor ACTOR_NPC_CHIRIIN>(2);
            SetAnimation<actor ACTOR_NPC_DAGUTORIO>(2);
            SetAnimation<actor ACTOR_NPC_DIGUDA>(2);
            SetAnimation<actor ACTOR_NPC_PERAPPU>(2);
            SetAnimation<actor ACTOR_NPC_GUREGGURU>(2);
            SetAnimation<actor ACTOR_NPC_HEIGANI>(2);
            SetAnimation<actor ACTOR_NPC_MIMIROPPU>(2);
            message_SetFace(ACTOR_NPC_MIMIROPPU, FACE_NORMAL, FACE_POS_BOTTOM_C_FACEL);
            message_Talk({
                english="""
                     OK, sweeties. We'll go ahead and
                    open the entrance. You can go in after we do.
                """,
            });
            message_Talk({
                english="""
                     The cave is located southeast
                    of here.
                """,
            });
            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
            MovePositionMark<actor ACTOR_NPC_CHAAREMU>(0.7969, Position<'m23', 40.5, 15.5>);
            MovePositionMark<actor ACTOR_NPC_MIMIROPPU>(0.7969, Position<'m24', 40.5, 15.5>);
            MovePositionMark<actor ACTOR_NPC_SAANAITO>(0.7969, Position<'m25', 40.5, 30.5>);
            Turn2Direction<actor ACTOR_PLAYER>(8, 10, DIR_UP);
            Turn2Direction<actor ACTOR_NPC_PERAPPU>(8, 10, DIR_UPLEFT);
            Turn2Direction<actor ACTOR_NPC_BIPPA>(8, 10, DIR_UPLEFT);
            Turn2Direction<actor ACTOR_NPC_HEIGANI>(8, 10, DIR_UPLEFT);
            Turn2Direction<actor ACTOR_NPC_DOGOOMU>(8, 10, DIR_UPLEFT);
            Turn2Direction<actor ACTOR_NPC_KIMAWARI>(8, 10, DIR_UPLEFT);
            Turn2Direction<actor ACTOR_NPC_DIGUDA>(8, 10, DIR_LEFT);
            Turn2Direction<actor ACTOR_NPC_CHIRIIN>(8, 10, DIR_UPLEFT);
            MovePositionMark<actor ACTOR_NPC_SAANAITO>(0.7969, Position<'m26', 40.5, 15.5>);
            WaitExecuteLives(ACTOR_NPC_SAANAITO);
            Wait(30);
            SetEffect<actor ACTOR_NPC_DAGUTORIO>(EFFECT_JOYOUS, 3);
            SetEffect<actor ACTOR_NPC_KIMAWARI>(EFFECT_JOYOUS, 3);
            SetEffect<actor ACTOR_NPC_BIPPA>(EFFECT_JOYOUS, 3);
            SetEffect<actor ACTOR_NPC_HEIGANI>(EFFECT_JOYOUS, 3);
            SetAnimation<actor ACTOR_NPC_KIMAWARI>(4);
            SetAnimation<actor ACTOR_NPC_BIPPA>(4);
            SetAnimation<actor ACTOR_NPC_DOGOOMU>(4);
            SetAnimation<actor ACTOR_NPC_CHIRIIN>(4);
            SetAnimation<actor ACTOR_NPC_DAGUTORIO>(4);
            SetAnimation<actor ACTOR_NPC_DIGUDA>(4);
            SetAnimation<actor ACTOR_NPC_PERAPPU>(4);
            SetAnimation<actor ACTOR_NPC_GUREGGURU>(4);
            SetAnimation<actor ACTOR_NPC_HEIGANI>(4);
            Turn2DirectionLives<actor ACTOR_ATTENDANT1>(4, 10, ACTOR_PLAYER);
            WaitExecuteLives(ACTOR_ATTENDANT1);
            Turn2DirectionLives<actor ACTOR_PLAYER>(4, 10, ACTOR_ATTENDANT1);
            WaitExecuteLives(ACTOR_PLAYER);
            ExecuteCommon<actor ACTOR_ATTENDANT1>(CORO_JUMP_ANGRY_FUNC_SERIES, 0);
            message_SetFace(ACTOR_ATTENDANT1, FACE_HAPPY, FACE_POS_BOTTOM_C_FACEL);
            message_FacePositionOffset(1, 5);
            message_SwitchTalk ($PARTNER_TALK_KIND) {
                case 1:
                    {
                        english=" All right, [hero]!",
                    }
                case 2:
                    {
                        english=" This is great, [hero]!",
                    }
                default:
                    {
                        english="""
                             This will be great,
                            [hero]!
                        """,
                    }
            }
            message_SwitchTalk ($PARTNER_TALK_KIND) {
                case 1:
                    {
                        english="""
                             Let's get ready now! We should
                            leave right away!
                        """,
                    }
                case 2:
                    {
                        english="""
                             Let's get ready in a hurry so we
                            can join in the exploration!
                        """,
                    }
                default:
                    {
                        english="""
                             Let's get ready right away!
                            We should be exploring with them!
                        """,
                    }
            }
            message_Close();
            screen_FadeOut(1, 30);
            worldmap_SetMode(4);
            worldmap_SetLevel(8);
            back2_SetMode(3);
            WaitSubScreen();
            worldmap_SetCamera(55);
            worldmap_SetArrow(55);
            worldmap_BlinkMark(55);
            Wait(30);
            me_Play(6);
            message_Mail({
                english="""
                    [CN]You can now go to
                    [CN][CS:P]Aegis Cave[CR]!
                """,
            });
            WaitMe(6);
            message_Close();
            screen2_FadeOut(1, 15);
            back2_SetMode(0);
            dungeon_mode(54) = DMODE_OPEN;
            supervision_RemoveActing(3);
            SetPositionMark<actor ACTOR_NPC_GUREGGURU>(Position<'m27', 28.5, 27.5>);
            SetPositionMark<actor ACTOR_PLAYER>(Position<'m28', 42.5, 25.5>);
            SetPositionMark<actor ACTOR_ATTENDANT1>(Position<'m29', 38.5, 25.5>);
            SetPositionMark<actor ACTOR_NPC_DOGOOMU>(Position<'m30', 28.5, 35.5>);
            SetPositionMark<actor ACTOR_NPC_DIGUDA>(Position<'m31', 25.5, 35.5>);
            SetPositionMark<actor ACTOR_NPC_PUKURIN>(Position<'m32', 56.5, 24.5>);
            SetPositionMark<actor ACTOR_NPC_KIMAWARI>(Position<'m33', 44.5, 35.5>);
            SetPositionMark<actor ACTOR_NPC_HEIGANI>(Position<'m34', 41.5, 37.5>);
            SetPositionMark<actor ACTOR_NPC_BIPPA>(Position<'m35', 41.5, 34.5>);
            SetPositionMark<actor ACTOR_NPC_PERAPPU>(Position<'m36', 56.5, 27.5>);
            SetDirection<actor ACTOR_NPC_GUREGGURU>(DIR_DOWN);
            SetDirection<actor ACTOR_PLAYER>(DIR_DOWN);
            SetDirection<actor ACTOR_ATTENDANT1>(DIR_DOWN);
            SetDirection<actor ACTOR_NPC_DOGOOMU>(DIR_LEFT);
            SetDirection<actor ACTOR_NPC_DIGUDA>(DIR_RIGHT);
            SetDirection<actor ACTOR_NPC_PUKURIN>(DIR_DOWN);
            SetDirection<actor ACTOR_NPC_KIMAWARI>(DIR_DOWNLEFT);
            SetDirection<actor ACTOR_NPC_HEIGANI>(DIR_UPRIGHT);
            SetDirection<actor ACTOR_NPC_BIPPA>(DIR_DOWN);
            SetDirection<actor ACTOR_NPC_PERAPPU>(DIR_UP);
            SetEffect<actor ACTOR_NPC_DAGUTORIO>(EFFECT_NONE, 3);
            SetEffect<actor ACTOR_NPC_KIMAWARI>(EFFECT_NONE, 3);
            SetEffect<actor ACTOR_NPC_BIPPA>(EFFECT_NONE, 3);
            SetEffect<actor ACTOR_NPC_HEIGANI>(EFFECT_NONE, 3);
            SetEffect<actor ACTOR_NPC_PUKURIN>(EFFECT_NONE, 3);
            camera_SetDefault();
            screen_FadeIn(1, 30);
            end;
        case menu({
            english="No",
        }):
        default:
            @label_1;
            forever {
                CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                se_Play(8968);
                SetEffect<actor ACTOR_ATTENDANT1>(EFFECT_SHOCKED, 3);
                WaitEffect<actor ACTOR_ATTENDANT1>();
                WaitExecuteLives(ACTOR_ATTENDANT1);
                message_SetFace(ACTOR_ATTENDANT1, FACE_SURPRISED, FACE_POS_BOTTOM_C_FACEL);
                message_FacePositionOffset(1, 5);
                message_SwitchTalk ($PARTNER_TALK_KIND) {
                    case 1:
                        {
                            english="""
                                 Huh? Why?[K] It's a chance at
                                finding awesome treasure!
                            """,
                        }
                    case 2:
                        {
                            english="""
                                 What? Why?[K] It's a new dungeon
                                where we might find some amazing treasure!
                            """,
                        }
                    default:
                        {
                            english="""
                                 What? Why?[K] We may be able
                                to discover incredible treasure!
                            """,
                        }
                }
                message_KeyWait();
                ExecuteCommon<actor ACTOR_ATTENDANT1>(CORO_JUMP_ANGRY_FUNC_SERIES, 0);
                message_SwitchTalk ($PARTNER_TALK_KIND) {
                    case 1:
                        {
                            english="""
                                 Don't be that way! Let's go
                                exploring with them!
                            """,
                        }
                    case 2:
                        {
                            english="""
                                 Don't be so negative! Let's go
                                exploring with them!
                            """,
                        }
                    default:
                        {
                            english="""
                                 Oh, don't be that way! Let's go
                                exploring with them!
                            """,
                        }
                }
                switch ( message_SwitchMenu(0, 1) ) {
                    case menu({
                        english="Yes",
                    }):
                    default:
                        break_loop;
                        break;
                    case menu({
                        english="No",
                    }):
                        continue;  // may be redundant
                        break;
                }
            }
            jump @label_0;
    }
}
