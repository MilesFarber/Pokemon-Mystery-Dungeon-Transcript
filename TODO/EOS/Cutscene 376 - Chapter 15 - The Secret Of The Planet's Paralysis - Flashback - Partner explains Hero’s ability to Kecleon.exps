
def 0 {
    bgm_PlayFadeIn(BGM_HIDDEN_HIGHLAND, 0, 256);
    screen_WhiteOutAll(1, 0);
    Wait(1);
    screen_FadeIn(1, 0);
    back_SetGround(LEVEL_T01P02A);
    supervision_StationCommon(0);
    supervision_Acting(0);
    camera_SetMyself<performer 0>();
    back_SetWeather(9);
    screen_FlushOut(1, 0, 8, 0, 0, 0);
    screen_FadeInAll(1, 30);
    Wait(30);
    message_SetFace(ACTOR_ATTENDANT1, FACE_NORMAL, FACE_POS_TOP_L_FACEINW);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     My partner here just happened
                    to see it in a dream.
                """,
            }
        case 2:
            {
                english="""
                     My partner here just happened
                    to see it in a dream.
                """,
            }
        default:
            {
                english="""
                     My partner here just happened
                    to see it in a dream.
                """,
            }
    }
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    SetEffect<actor ACTOR_NPC_YONOWAARU>(EFFECT_TWO_ARROWS_AT_SIDE_LEFT, 3);
    WaitEffect<actor ACTOR_NPC_YONOWAARU>();
    WaitExecuteLives(ACTOR_NPC_YONOWAARU);
    message_SetFace(ACTOR_NPC_YONOWAARU, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english=" Excuse me?[K] A dream, you say?",
    });
    message_Talk({
        english=" By dream, what do you mean?",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    back_SetBackEffect(4);
    Wait(30);
    message_EmptyActor();
    message_Talk({
        english="""
            [CN]When they mentioned the Dimensional
            [CN]Scream, I was skeptical at first...
        """,
    });
    message_Talk({
        english="""
            [CN]But then an idea began to
            [CN]take shape in my mind...
        """,
    });
    message_Talk({
        english="[CN]And...",
    });
    message_Close();
    screen_WhiteOutAll(1, 30);
    screen_FlushIn(1, 0, 1, 0, 0, 0);
    screen_WhiteOut(1, 0);
    screen_FadeInAll(1, 0);
    end;
}
