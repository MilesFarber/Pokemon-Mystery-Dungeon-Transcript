
def 0 {
    sound_Stop();
    back_SetGround(LEVEL_D24P11A);
    supervision_StationCommon(0);
    supervision_Acting(0);
    Wait(1);
    supervision_LoadStation(LEVEL_D24P11A, 'UM20');
    supervision_Station(1);
    camera_SetMyself<performer 0>();
    SetAnimation<actor ACTOR_NPC_JUPUTORU>(2);
    WaitExecuteLives(ACTOR_NPC_JUPUTORU);
    screen_FadeIn(1, 30);
    bgm_PlayFadeIn(BGM_TREESHROUD_FOREST, 0, 256);
    MovePositionMark<actor ACTOR_NPC_JUPUTORU>(1, Position<'m0', 32.5, 23.5>);
    MovePositionMark<actor ACTOR_ATTENDANT1>(1, Position<'m1', 30.5, 27.5>);
    MovePositionMark<actor ACTOR_PLAYER>(1, Position<'m2', 34.5, 27.5>);
    WaitExecuteLives(ACTOR_PLAYER);
    Wait(15);
    message_SetFace(ACTOR_NPC_JUPUTORU, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
    message_Talk({
        english="""
             This is it.[K] This is the entrance
            to [CS:P]Treeshroud Forest[CR].
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    se_Play(8964);
    SetEffect<actor ACTOR_NPC_JUPUTORU>(EFFECT_EXCLAMATION_MARK, 3);
    WaitEffect<actor ACTOR_NPC_JUPUTORU>();
    WaitExecuteLives(ACTOR_NPC_JUPUTORU);
    message_Talk({
        english=" Oh?",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    se_Play(8962);
    SetEffect<actor ACTOR_ATTENDANT1>(EFFECT_QUESTION_MARK, 3);
    WaitEffect<actor ACTOR_ATTENDANT1>();
    WaitExecuteLives(ACTOR_ATTENDANT1);
    message_SetFace(ACTOR_ATTENDANT1, FACE_NORMAL, FACE_POS_STANDARD);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" What's up, [CS:N]Grovyle[CR]?",
            }
        case 2:
            {
                english=" What is it, [CS:N]Grovyle[CR]?",
            }
        default:
            {
                english=" Is something wrong, [CS:N]Grovyle[CR]?",
            }
    }
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_JUPUTORU, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
    message_Talk({
        english="""
             The atmosphere somehow feels
            different than last time.
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Wait(20);
    Turn2Direction<actor ACTOR_NPC_JUPUTORU>(4, 10, DIR_DOWN);
    WaitExecuteLives(ACTOR_NPC_JUPUTORU);
    message_Talk({
        english=" No.[K] I must be imagining it.",
    });
    message_Talk({
        english=" We'll go in when you're ready.",
    });
    message_Close();
    SetPositionInitial<actor ACTOR_NPC_JUPUTORU>();
    end;
}
