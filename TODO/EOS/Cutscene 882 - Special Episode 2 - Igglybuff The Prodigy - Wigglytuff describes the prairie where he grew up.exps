
def 0 {
    sound_Stop();
    message_Narration(30, {
        english="[CN]Way back when...",
    });
    message_Narration(30, {
        english="""
            [CN]Yep... That was back
            [CN]when I was still a small child...
        """,
    });
    message_Narration(30, {
        english="""
            [CN]I wasn't [CS:N]Wigglytuff[CR] yet...
            [CN]This was back when I was still an [CS:Y]Igglybuff[CR].
        """,
    });
    message_Close();
    back2_SetMode(4);
    back2_SetGround(LEVEL_V24P08A);
    back_SetGround(LEVEL_P16P01A);
    supervision_Acting(0);
    camera2_SetPositionMark(Position<'m0', 19, 15.5>);
    camera_SetMyself<performer 0>();
    MovePositionMark<performer 0>(0.3477, Position<'m1', 14, 20.5>);
    WaitLockLives(5, ACTOR_NPC_UPAA);
    Unlock(5);
    WaitLockLives(10, ACTOR_NPC_MUCHUURU);
    Unlock(10);
    WaitLockLives(15, ACTOR_NPC_SUBOMII);
    Unlock(15);
    bgm_PlayFadeIn(BGM_HEARTWARMING, 0, 256);
    screen2_FadeIn(0, 30);
    screen_FadeIn(1, 30);
    message_SetWaitMode(190, 80);
    message_Mail({
        english="[CN]There everyone lived an easy life...",
    });
    message_KeyWait();
    message_Mail({
        english="[CN]It was a very peaceful prairie...",
    });
    message_Close();
    screen_FadeOut(1, 30);
    message_SetWaitMode(-1, -1);
    end;
}

def 1 for actor ACTOR_NPC_UPAA {
    SetAnimation(2);
    Lock(5);
    SetEffect(EFFECT_JOYOUS, 3);
    SetAnimation(4);
    Wait(148);
    SetAnimation(2);
    SetEffect(EFFECT_NONE, 3);
    Wait(20);
    SetEffect(EFFECT_NONE, 3);
    SetEffect(EFFECT_LAUGHING, 3);
    SetAnimation(5);
    Wait(80);
    SetEffect(EFFECT_JOYOUS, 3);
    MovePositionMark(1.1992, Position<'m2', 0.5, 17>);
    Destroy();
}

def 2 for actor ACTOR_NPC_MUCHUURU {
    SetAnimation(2);
    Lock(10);
    SetEffect(EFFECT_JOYOUS, 3);
    Wait(4);
    SetAnimation(5);
    Wait(144);
    SetAnimation(2);
    SetEffect(EFFECT_NONE, 3);
    Wait(80);
    CallCommon(CORO_JUMP_HAPPY_FUNC);
    Turn2Direction(4, 10, DIR_RIGHT);
    Wait(150);
    Turn2Direction(4, 10, DIR_LEFT);
    Wait(15);
    CallCommon(CORO_JUMP_ANGRY_FUNC);
    Wait(15);
    MovePositionMark(1.1992, Position<'m3', 0, 19>);
    Destroy();
}

