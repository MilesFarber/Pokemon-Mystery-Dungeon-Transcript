
def 0 {
    sound_Stop();
    back_SetGround(LEVEL_D48P11A);
    supervision_StationCommon(0);
    supervision_Acting(0);
    camera_SetMyself<performer 0>();
    SetPositionInitial<actor ACTOR_NPC_YONOWAARU_N8>();
    SetAnimation<actor ACTOR_NPC_YONOWAARU_N8>(2);
    screen_FadeIn(1, 30);
    bgm_PlayFadeIn(BGM_TEMPORAL_TOWER, 0, 256);
    Wait(60);
    MovePositionMark<performer 0>(1, Position<'m0', 37.5, 35>);
    MovePositionMark<actor ACTOR_PLAYER_FUTURE>(1, Position<'m1', 35.5, 35.5>);
    MovePositionMark<actor ACTOR_NPC_YONOWAARU_N8>(1, Position<'m2', 39.5, 35.5>);
    WaitExecuteLives(ACTOR_NPC_YONOWAARU_N8);
    WaitExecutePerformer(0);
    Wait(30);
    message_SetFace(ACTOR_NPC_YONOWAARU, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english="""
             We're here.[K] This is the entrance
            to [CS:P]Temporal Tower[CR].
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_PLAYER_FUTURE, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english=" ... ([CS:P]Temporal Tower[CR], huh...)",
    });
    message_Talk({
        english="""
             ...! (Now that you mention it...[K]
            In the past, [c_name:NPC_HERO_FIRST] and [c_name:NPC_PARTNER_FIRST]
            are also...)
        """,
    });
    message_Talk({
        english="""
             (Climbing up [CS:P]Temporal Tower[CR],
            I expect...)
        """,
    });
    message_Talk({
        english="""
             ([c_name:NPC_HERO_FIRST]...[K][c_name:NPC_PARTNER_FIRST]...[K]
            Do your best...)
        """,
    });
    message_Talk({
        english="""
             (I believe in you...[K] The rest is
            up to you.)
        """,
    });
    message_Talk({
        english="""
             (In this world...[K] I'll do
            everything I can!)
        """,
    });
    message_Talk({
        english=" (Together...[K]for the future!)",
    });
    message_Close();
    end;
}
