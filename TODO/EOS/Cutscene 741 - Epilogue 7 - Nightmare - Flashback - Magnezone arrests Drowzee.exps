    Turn2Direction<actor ACTOR_ATTENDANT1>(16, 10, DIR_RIGHT);
    Turn2Direction<actor ACTOR_NPC_RURIRI>(16, 10, DIR_RIGHT);
    MovePositionOffset<actor ACTOR_NPC_KOIRU>(1, 200, 0);
