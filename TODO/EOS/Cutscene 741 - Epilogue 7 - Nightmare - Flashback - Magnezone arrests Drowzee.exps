        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2DirectionLives<actor ACTOR_NPC_JIBAKOIRU>(4, 10, ACTOR_NPC_SURIIPU);
