    message_SetFace(ACTOR_NPC_JIBAKOIRU, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
    message_Talk({
        english="""
             We have been able to arrest a
            wanted outlaw! ZZZT!
        """,
    });
    message_Talk({
        english="""
             ZZZT! We owe you great thanks
            for your cooperation! ZZZT!
        """,
    });
    message_Close();
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    SetEffect<actor ACTOR_NPC_JIBAKOIRU>(EFFECT_LAUGHING, 3);
    SetEffect<actor ACTOR_NPC_KOIRU>(EFFECT_LAUGHING, 3);
    SetEffect<actor ACTOR_NPC_KOIRU2>(EFFECT_LAUGHING, 3);
    SetAnimation<actor ACTOR_NPC_JIBAKOIRU>(22);
