    SetEffect<actor ACTOR_NPC_JIBAKOIRU>(EFFECT_NONE, 3);
    SetEffect<actor ACTOR_NPC_KOIRU>(EFFECT_NONE, 3);
    SetEffect<actor ACTOR_NPC_KOIRU2>(EFFECT_NONE, 3);
