    message_Talk({
        english=" ZZZT! Now come with us! ZZZT!",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    SetEffect<actor ACTOR_NPC_SURIIPU>(EFFECT_SWEAT_DROP, 3);
    WaitEffect<actor ACTOR_NPC_SURIIPU>();
    message_SetFace(ACTOR_NPC_SURIIPU, FACE_SIGH, FACE_POS_TOP_L_CENTER);
    message_Talk({
        english=" Awww...",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    MovePositionOffset<actor ACTOR_NPC_JIBAKOIRU>(1, 200, 0);
    Wait(15);
    ResetHitAttribute<actor ACTOR_NPC_KOIRU>(31);
    ResetHitAttribute<actor ACTOR_NPC_KOIRU2>(31);
    ResetHitAttribute<actor ACTOR_NPC_SURIIPU>(31);
    Turn2Direction<actor ACTOR_ATTENDANT1>(4, 10, DIR_UPRIGHT);
    Turn2Direction<actor ACTOR_NPC_RURIRI>(4, 10, DIR_UPRIGHT);
    Turn2Direction<actor ACTOR_NPC_KOIRU>(4, 10, DIR_RIGHT);
    MovePositionOffset<actor ACTOR_NPC_SURIIPU>(1, 16, 16);
