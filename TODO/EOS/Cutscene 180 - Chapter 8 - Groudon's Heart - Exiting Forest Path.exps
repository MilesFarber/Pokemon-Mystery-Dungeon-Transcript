            {
                english=" But this is the base camp!",
            }
        default:
            {
                english=" But this is the base camp!",
            }
    }
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_PERAPPU, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english="""
             Precisely! ♪ You're back at the
