
def 0 {
    sound_Stop();
    back_SetGround(LEVEL_D40P11A);
    supervision_Acting(0);
    camera_SetMyself<performer 0>();
    bgm_PlayFadeIn(BGM_ON_THE_CEILING, 90, 128);
    bgm_ChangeVolume(0, 128);
    screen_FadeIn(1, 30);
    MovePositionMark<actor ACTOR_NPC_KURESERIA>(1, Position<'m0', 22.5, 24.5>);
    MovePositionMark<actor ACTOR_ATTENDANT1>(1, Position<'m1', 20.5, 26.5>);
    MovePositionMark<actor ACTOR_PLAYER>(1, Position<'m2', 24.5, 26.5>);
    WaitExecuteLives(ACTOR_PLAYER);
    Wait(15);
    message_SetFace(ACTOR_ATTENDANT1, FACE_NORMAL, FACE_POS_STANDARD);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     So this is the entrance to the
                    [CS:P]Dark Crater[CR]...
                """,
            }
        case 2:
            {
                english="""
                     So this is the entrance to the
                    [CS:P]Dark Crater[CR]...
                """,
            }
        default:
            {
                english="""
                     So this is the entrance to the
                    [CS:P]Dark Crater[CR]...
                """,
            }
    }
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2Direction<actor ACTOR_NPC_KURESERIA>(4, 10, DIR_DOWN);
    WaitExecuteLives(ACTOR_NPC_KURESERIA);
    message_SetFace(ACTOR_NPC_KURESERIA, FACE_NORMAL, FACE_POS_TOP_C_FACER);
    message_Talk({
        english="""
             Here we face [CS:N]Darkrai[CR].[K] There is
            no telling what he has in store for us.
        """,
    });
    message_Talk({
        english="""
             We must proceed with the
            utmost care!
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    SetAnimation<actor ACTOR_PLAYER>(71);
    SetAnimation<actor ACTOR_ATTENDANT1>(71);
    WaitAnimation<actor ACTOR_PLAYER>();
    WaitAnimation<actor ACTOR_ATTENDANT1>();
    WaitExecuteLives(ACTOR_PLAYER);
    WaitExecuteLives(ACTOR_ATTENDANT1);
    SetAnimation<actor ACTOR_PLAYER>(2);
    SetAnimation<actor ACTOR_ATTENDANT1>(2);
    Wait(30);
    MovePositionMark<actor ACTOR_NPC_KURESERIA>(1, Position<'m3', 22.5, 15.5>);
    MovePositionMark<actor ACTOR_ATTENDANT1>(1, Position<'m4', 22.5, 15.5>);
    Wait(15);
    MovePositionMark<actor ACTOR_PLAYER>(1, Position<'m5', 22.5, 15.5>);
    Wait(30);
    bgm_FadeOut(60);
    screen_FadeOut(1, 30);
    WaitBgm(BGM_ON_THE_CEILING);
    main_EnterDungeon(67, 0);
    switch ( message_Menu(MENU_DUNGEON_INITIALIZE_TEAM) ) { }
    main_EnterDungeon(-1, 0);
    hold;
    end;
}
