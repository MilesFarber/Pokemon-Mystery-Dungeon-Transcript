
def 0 {
    sound_Stop();
    back_SetDungeonBanner(57, 0);
    screen_FadeIn(1, 16);
    Wait(60);
    screen_FadeOut(1, 16);
    Wait(15);
    if ( scn($SCENARIO_MAIN) >= [29, 62] ) {
        @label_0;
        back_SetGround(LEVEL_D32P32A);
        supervision_Acting(0);
        Wait(1);
        camera_SetMyself<performer 0>();
        MovePositionMark<actor ACTOR_PLAYER_APPOINT>(1, Position<'m0', 22.5, 31.5>);
        MovePositionMark<actor ACTOR_ADVENTURE_NPC1>(1, Position<'m1', 25.5, 33.5>);
        MovePositionMark<actor ACTOR_ADVENTURE_NPC2>(1, Position<'m2', 19.5, 33.5>);
        MovePositionMark<actor ACTOR_ADVENTURE_NPC3>(1, Position<'m3', 22.5, 35.5>);
        bgm_PlayFadeIn(BGM_SEALED_RUIN, 0, 256);
        screen_FadeIn(1, 30);
        WaitExecuteLives(ACTOR_PLAYER_APPOINT);
        Wait(30);
        message_SetFace(ACTOR_NPC_REJIROKKU, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
        message_Talk({
            english="""
                 IF YOU WANT TO GO ON, SHOW
                THAT YOU HAVE THE POWER.
            """,
        });
        message_Close();
        bgm_Stop();
        se_Play(5143);
        screen_WhiteOut(1, 2);
        Wait(2);
        screen_FadeIn(1, 2);
        Wait(10);
        se_Play(5143);
        screen_WhiteOut(1, 2);
        Wait(2);
        screen_FadeIn(1, 2);
        WaitSe(5143);
        se_Play(5136);
        CallCommon(CORO_BOSS_WIPE_FUNC);
        end;
    } else {
        $SCENARIO_MAIN = scn[29, 62];
        jump @label_0;
    }
