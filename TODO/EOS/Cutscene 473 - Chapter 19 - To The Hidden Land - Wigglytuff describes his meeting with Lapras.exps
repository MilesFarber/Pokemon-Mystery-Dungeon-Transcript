
def 0 {
    sound_Stop();
    back_SetGround(LEVEL_P10P01A);
    supervision_Acting(0);
    camera_SetMyself<performer 0>();
    Wait(1);
    ResetOutputAttribute<actor ACTOR_NPC_RAPURASU>(256);
    SetEffect<actor ACTOR_NPC_RAPURASU>(646, 4);
    screen_FlushOut(1, 0, 8, 0, 0, 0);
    bgm_PlayFadeIn(BGM_TIME_GEAR_REMIX, 0, 256);
    screen_FadeIn(1, 30);
    Wait(30);
    message_EmptyActor();
    message_Talk({
        english="""
            [CN]I met with [CS:N]Lapras[CR] and
            [CN]explained what was happening.
        """,
    });
    message_Talk({
        english="""
            [CN]How time was stopping all over
            [CN]and how the world was in peril...
        """,
    });
    message_Talk({
        english="""
            [CN]I also explained how the
            [CN]Time Gears needed to be
            [CN]taken to [CS:P]Temporal Tower[CR]...
        """,
    });
    message_Talk({
        english="""
            [CN]So I asked him to reveal
            [CN]how we could get to
            [CN]the [CS:P]Hidden Land[CR].
        """,
    });
    message_Close();
    screen_FadeOut(1, 30);
    screen_FlushIn(1, 0, 1, 0, 0, 0);
    end;
}
