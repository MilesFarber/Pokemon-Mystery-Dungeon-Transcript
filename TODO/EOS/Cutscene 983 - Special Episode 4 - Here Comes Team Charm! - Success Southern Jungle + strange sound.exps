    MovePositionMark<actor ACTOR_NPC_CHAAREMU>(2, Position<'m5', 59, 27.5>);
    Wait(2);
    MovePositionMark<actor ACTOR_PLAYER_CHARMS>(2, Position<'m6', 57, 29.5>);
