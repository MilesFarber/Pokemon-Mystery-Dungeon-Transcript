
def 0 {
    sound_Stop();
    $SCENARIO_SIDE = scn[45, 3];
    back_SetGround(LEVEL_D54P31A);
    supervision_Acting(0);
    camera_SetMyself<performer 0>();
    bgm2_PlayFadeIn(BGM_HEAVY_WIND4, 30, 256);
    screen_FadeIn(1, 30);
    MovePositionMark<actor ACTOR_NPC_CHAAREMU>(1.5, Position<'m0', 26, 27.5>);
    WaitExecuteLives(ACTOR_NPC_CHAAREMU);
    ExecuteCommon<actor ACTOR_NPC_CHAAREMU>(CORO_LOOK_AROUND_FUNC_SERIES, 0);
    WaitExecuteLives(ACTOR_NPC_CHAAREMU);
    Wait(10);
    se_Play(8964);
    SetEffect<actor ACTOR_NPC_CHAAREMU>(EFFECT_EXCLAMATION_MARK, 3);
    WaitEffect<actor ACTOR_NPC_CHAAREMU>();
    WaitExecuteLives(ACTOR_NPC_CHAAREMU);
    message_SetFace(ACTOR_NPC_CHAAREMU, FACE_NORMAL, FACE_POS_TOP_RC_FACEOUTW);
    message_Talk({
        english="""
             I think we've reached the other
            side of the jungle...
        """,
    });
    message_Close();
    MovePositionMark<actor ACTOR_NPC_SAANAITO>(1, Position<'m1', 26, 31.5>);
    Wait(36);
    MovePositionMark<actor ACTOR_PLAYER_CHARMS>(1, Position<'m2', 22, 29.5>);
    WaitExecuteLives(ACTOR_NPC_SAANAITO);
    ExecuteCommon<actor ACTOR_NPC_SAANAITO>(CORO_LOOK_AROUND_RIGHT_FUNC_SERIES, 0);
    WaitExecuteLives(ACTOR_NPC_SAANAITO);
    Turn2DirectionLives<actor ACTOR_NPC_SAANAITO>(4, 10, ACTOR_PLAYER_CHARMS);
    Wait(4);
    Turn2DirectionLives<actor ACTOR_PLAYER_CHARMS>(4, 10, ACTOR_NPC_SAANAITO);
    WaitExecuteLives(ACTOR_NPC_SAANAITO);
    message_SetFace(ACTOR_NPC_SAANAITO, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english=" I'm pretty sure of it.",
    });
    message_Talk({
        english="""
             Seems like we're out of
            [CS:P]Southern Jungle[CR].
        """,
    });
    message_Close();
    Turn2DirectionLives<actor ACTOR_NPC_CHAAREMU>(4, 10, ACTOR_PLAYER_CHARMS);
    WaitExecuteLives(ACTOR_NPC_CHAAREMU);
    message_SetFace(ACTOR_NPC_CHAAREMU, FACE_HAPPY, FACE_POS_TOP_R_CENTER);
    message_Talk({
        english="""
             So...[K] [CS:P]Boulder Quarry[CR] is just
            ahead, right?
        """,
    });
    message_Close();
    se_Play(10245);
    message_Mail({
        english="[CN]Guuuuuuuu!",
    });
    WaitSe(10245);
    message_CloseEnforce();
    se_Play(8978);
    SetEffect<actor ACTOR_NPC_CHAAREMU>(EFFECT_TWO_ARROWS_AT_SIDE_LEFT, 3);
    Wait(4);
    SetEffect<actor ACTOR_NPC_SAANAITO>(EFFECT_TWO_ARROWS_AT_SIDE_LEFT, 3);
    Wait(4);
    SetEffect<actor ACTOR_PLAYER_CHARMS>(EFFECT_EXCLAMATION_MARK, 3);
    WaitEffect<actor ACTOR_NPC_CHAAREMU>();
    Turn2Direction<actor ACTOR_NPC_CHAAREMU>(4, 10, DIR_RIGHT);
    Wait(4);
    Turn2Direction<actor ACTOR_NPC_SAANAITO>(4, 10, DIR_RIGHT);
    Wait(3);
    Turn2Direction<actor ACTOR_PLAYER_CHARMS>(4, 10, DIR_RIGHT);
    WaitExecuteLives(ACTOR_PLAYER_CHARMS);
    message_SetFace(ACTOR_NPC_CHAAREMU, FACE_NORMAL, FACE_POS_TOP_RC_FACEOUTW);
    message_Talk({
        english="""
             Huh?[K] I think I heard some kind
            of strange noise coming from over there...
        """,
    });
    message_Close();
    se_Play(10245);
    message_Mail({
        english="[CN]Guuuuuuuu!",
    });
    WaitSe(10245);
    message_CloseEnforce();
    Turn2DirectionLives<actor ACTOR_NPC_SAANAITO>(4, 10, ACTOR_PLAYER_CHARMS);
    Wait(4);
    Turn2DirectionLives<actor ACTOR_NPC_CHAAREMU>(4, 10, ACTOR_PLAYER_CHARMS);
    WaitExecuteLives(ACTOR_NPC_CHAAREMU);
    message_SetFace(ACTOR_PLAYER_CHARMS, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english=" I heard it again.",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_SAANAITO, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english=" Let's go check it out.",
