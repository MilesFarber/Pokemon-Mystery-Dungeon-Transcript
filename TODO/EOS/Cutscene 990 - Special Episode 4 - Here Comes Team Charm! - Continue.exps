
def 0 {
    SetAnimation<actor ACTOR_NPC_SAANAITO>(2);
    SetAnimation<actor ACTOR_NPC_CHAAREMU>(2);
    SetAnimation<actor ACTOR_PLAYER_CHARMS>(2);
    Turn2Direction<actor ACTOR_NPC_SAANAITO>(4, 10, DIR_UP);
    Turn2Direction<actor ACTOR_NPC_CHAAREMU>(4, 10, DIR_UP);
    Turn2Direction<actor ACTOR_PLAYER_CHARMS>(4, 10, DIR_UP);
    WaitExecuteLives(ACTOR_PLAYER_CHARMS);
    message_ResetActor();
    message_Mail({
        english="[CN]Would you like to go on?",
    });
    switch ( message_SwitchMenu(0, 1) ) {
        case menu({
            english="Yes",
        }):
        default:
            @label_0;
            message_Close();
            if ( scn($SCENARIO_SIDE) >= [45, 6] ) {
                @label_2;
                main_EnterDungeon(151, 30);
                main_EnterDungeon(-1, 30);
                hold;
            } else {
                $SCENARIO_SIDE = scn[45, 6];
                jump @label_2;
            }
            break;
        case menu({
            english="No",
        }):
            message_Close();
            end;
    }
}
