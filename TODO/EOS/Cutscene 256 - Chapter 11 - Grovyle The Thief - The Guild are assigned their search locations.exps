
def 0 {
    $SCENARIO_MAIN = scn[14, 2];
    back_SetGround(LEVEL_G01P03A);
    supervision_Acting(0);
    supervision_Acting(1);
    camera_SetMyself<performer 0>();
    screen_FadeIn(1, 30);
    bgm_PlayFadeIn(BGM_WIGGLYTUFFS_GUILD_REMIX, 0, 256);
    Wait(30);
    message_SetFace(ACTOR_NPC_PERAPPU, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
    message_FacePositionOffset(-2, -1);
    message_Talk({
        english=" Now, I see everyone's with us!",
    });
    message_Talk({
        english="""
             First and foremost![K] This should
            go without saying...
        """,
    });
    message_Talk({
        english="""
             [CS:N]Grovyle[CR] appears wherever
            Time Gears are located.
        """,
    });
    message_Talk({
        english=" But where are the Time Gears?",
    });
    message_Talk({
        english="""
             That is the question! But we
            have no answer.
        """,
    });
    message_Talk({
        english="""
             And, therefore, we have relied
            upon the great [CS:N]Dusknoir[CR] for ideas.
        """,
    });
    message_Talk({
        english="""
             Together, we've identified
            several locations where the Time Gears may
            be found.
        """,
    });
    message_Talk({
        english="""
             We ask that everyone split into
            groups and investigate each of these
            potential sites.
        """,
    });
    message_Talk({
        english="""
             First, [CS:N]Loudred[CR] and [CS:N]Corphish[CR]!
            I'm assigning you to the Eastern Forest.
        """,
    });
    message_Talk({
        english="""
             That's the huge forest far to the
            east, of course.
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    ExecuteCommon<actor ACTOR_NPC_DOGOOMU>(CORO_JUMP_HAPPY_FUNC_SERIES, 0);
    WaitExecuteLives(ACTOR_NPC_DOGOOMU);
    message_SetFace(ACTOR_NPC_DOGOOMU, FACE_NORMAL, FACE_POS_TOP_L_FACEINW);
    message_Talk({
        english=" Got it!",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    ExecuteCommon<actor ACTOR_NPC_HEIGANI>(CORO_JUMP_ANGRY_FUNC_SERIES, 0);
    WaitExecuteLives(ACTOR_NPC_HEIGANI);
    message_SetFace(ACTOR_NPC_HEIGANI, FACE_NORMAL, FACE_POS_BOTTOM_R_CENTER);
    message_Talk({
        english=" Hey, hey! We'll do our best!",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_PERAPPU, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
    message_FacePositionOffset(-2, -1);
    message_Talk({
        english="""
             Next, [CS:N]Bidoof[CR], [CS:N]Dugtrio[CR], and
            [CS:N]Sunflora[CR]! We'd like you to search
            [CS:P]Crystal Cave[CR].
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    ExecuteCommon<actor ACTOR_NPC_BIPPA>(CORO_JUMP_HAPPY_FUNC_SERIES, 0);
    WaitExecuteLives(ACTOR_NPC_BIPPA);
    message_SetFace(ACTOR_NPC_BIPPA, FACE_NORMAL, FACE_POS_BOTTOM_R_CENTER);
    message_Talk({
        english=" Yup yup! Will do!",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_DAGUTORIO, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english=" Understood.",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    ExecuteCommon<actor ACTOR_NPC_KIMAWARI>(CORO_JUMP_ANGRY_FUNC_SERIES, 0);
    WaitExecuteLives(ACTOR_NPC_KIMAWARI);
    message_SetFace(ACTOR_NPC_KIMAWARI, FACE_NORMAL, FACE_POS_BOTTOM_L_CENTER);
    message_Talk({
        english=" Oh my gosh! I'll search hard!",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_PERAPPU, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
    message_FacePositionOffset(-2, -1);
    message_Talk({
        english="""
             And, finally, [hero] and
            [partner]! You two are assigned to the
            [CS:P]Northern Desert[CR].
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    se_Play(8962);
    SetEffect<actor ACTOR_ATTENDANT1>(EFFECT_QUESTION_MARK, 3);
    WaitEffect<actor ACTOR_ATTENDANT1>();
    WaitExecuteLives(ACTOR_ATTENDANT1);
    Turn2Direction<actor ACTOR_NPC_YONOWAARU>(8, 10, DIR_DOWN);
    WaitExecuteLives(ACTOR_NPC_YONOWAARU);
    message_SetFace(ACTOR_ATTENDANT1, FACE_WORRIED, FACE_POS_STANDARD);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" The [CS:P]Northern Desert[CR]?",
            }
        case 2:
            {
                english=" The [CS:P]Northern Desert[CR]?",
            }
        default:
            {
                english=" The [CS:P]Northern Desert[CR]?",
            }
    }
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2Direction<actor ACTOR_NPC_PERAPPU>(4, 10, DIR_DOWNLEFT);
    WaitExecuteLives(ACTOR_NPC_PERAPPU);
    message_SetFace(ACTOR_NPC_PERAPPU, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
    message_FacePositionOffset(-2, -1);
    message_Talk({
        english=" Correct.[K] Open your Wonder Map.",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_ATTENDANT1, FACE_NORMAL, FACE_POS_STANDARD);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" OK.",
            }
        case 2:
            {
                english=" OK.",
            }
        default:
            {
                english=" OK.",
            }
    }
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_Mail({
        english="""
            [CN][partner] opened
            [CN]the Wonder Map.
        """,
    });
    message_Close();
    se_Play(6667);
    screen_FadeOut(1, 15);
    end;
}
