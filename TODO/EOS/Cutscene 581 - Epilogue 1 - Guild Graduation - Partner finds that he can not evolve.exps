    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     I don't get why we're not
                    allowed to evolve, though.
                """,
            }
        case 2:
            {
                english="""
                     I don't understand why we can't
                    evolve, though.
                """,
            }
        default:
            {
                english="""
                     I don't understand why we're not
                    allowed to evolve, though.
                """,
            }
    }
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     Anyway, we have the Perfect
                    Apple that was in the treasure box.
                """,
            }
        case 2:
            {
                english="""
                     Anyway, we have the Perfect
                    Apple that was in the treasure box.
                """,
            }
        default:
            {
                english="""
                     Anyway, we have the Perfect
                    Apple that was in the treasure box.
                """,
            }
    }
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" Let's take it back to the guild.",
            }
        case 2:
            {
                english="""
                     We should go back to the guild
                    with it.
                """,
            }
        default:
            {
                english=" Let's go back to the guild with it.",
            }
    }
    message_Close();
    bgm_FadeOut(120);
    screen_FadeOut(1, 60);
    Wait(90);
    WaitBgm(BGM_IN_THE_DEPTHS_OF_THE_PIT);
    end;
}
