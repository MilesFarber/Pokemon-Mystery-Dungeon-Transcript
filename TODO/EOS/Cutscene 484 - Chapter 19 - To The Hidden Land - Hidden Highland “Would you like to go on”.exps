
def 0 {
    bgm_PlayFadeIn(BGM_HIDDEN_HIGHLAND, 0, 256);
    SetAnimation<actor ACTOR_PLAYER>(2);
    SetAnimation<actor ACTOR_ATTENDANT1>(2);
    SetAnimation<actor ACTOR_NPC_JUPUTORU>(2);
    Turn2DirectionLives<actor ACTOR_ATTENDANT1>(4, 10, ACTOR_PLAYER);
    WaitExecuteLives(ACTOR_ATTENDANT1);
    Turn2DirectionLives<actor ACTOR_PLAYER>(4, 10, ACTOR_ATTENDANT1);
    Turn2DirectionLives<actor ACTOR_NPC_JUPUTORU>(4, 10, ACTOR_PLAYER);
    message_ResetActor();
    message_Mail({
        english="[CN]Would you like to go on?",
    });
    switch ( message_SwitchMenu(0, 1) ) {
        case menu({
            english="Yes",
        }):
        default:
            @label_0;
            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
            MovePositionMark<actor ACTOR_PLAYER>(1, Position<'m0', 28.5, 2.5>);
            Wait(10);
            MovePositionMark<actor ACTOR_ATTENDANT1>(1, Position<'m1', 28.5, 2.5>);
            MovePositionMark<actor ACTOR_NPC_JUPUTORU>(1, Position<'m2', 28.5, 2.5>);
            Wait(20);
            if ( scn($SCENARIO_MAIN) >= [25, 3] ) {
                @label_2;
                main_EnterDungeon(39, 30);
                main_EnterDungeon(-1, 30);
                hold;
                end;
            } else {
                $SCENARIO_MAIN = scn[25, 3];
                jump @label_2;
            }
            break;
        case menu({
            english="No",
        }):
            message_Close();
            end;
    }
}
