    Wait(10);
    SetAnimation<actor ACTOR_NPC_DENRYUU>(2);
    Wait(30);
    SetAnimation<actor ACTOR_NPC_DENRYUU>(5);
    MovePositionMark<actor ACTOR_PLAYER_APPOINT>(1, Position<'m0', 28.5, 33.5>);
    MovePositionMark<actor ACTOR_ADVENTURE_NPC1>(1, Position<'m1', 31.5, 36.5>, Position<'m2', 32.5, 35.5>);
    MovePositionMark<actor ACTOR_ADVENTURE_NPC2>(1, Position<'m3', 25.5, 36.5>, Position<'m4', 24.5, 35.5>);
    MovePositionMark<actor ACTOR_ADVENTURE_NPC3>(1, Position<'m5', 28.5, 37.5>);
    Wait(60);
    SetAnimation<actor ACTOR_NPC_DENRYUU>(2);
    Wait(20);
    Turn2Direction<actor ACTOR_NPC_DENRYUU>(4, 10, DIR_RIGHT);
    Wait(40);
    Turn2Direction<actor ACTOR_NPC_DENRYUU>(4, 10, DIR_DOWNLEFT);
    WaitExecuteLives(ACTOR_NPC_DENRYUU);
    se_Play(8978);
    SetEffect<actor ACTOR_NPC_DENRYUU>(EFFECT_EXCLAMATION_MARK, 3);
    WaitExecuteLives(ACTOR_PLAYER_APPOINT);
    Turn2Direction<actor ACTOR_PLAYER_APPOINT>(4, 10, DIR_UPRIGHT);
    Turn2Direction<actor ACTOR_ADVENTURE_NPC1>(4, 10, DIR_UP);
    Turn2Direction<actor ACTOR_ADVENTURE_NPC2>(4, 10, DIR_UPRIGHT);
    message_SetFace(ACTOR_NPC_DENRYUU, FACE_NORMAL, FACE_POS_TOP_R_FACEINW);
    message_Talk({
        english=" Oh! It's Team [team:]!",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Move2PositionMark<actor ACTOR_NPC_DENRYUU>(1, Position<'m6', 28.5, 30.5>);
    WaitExecuteLives(ACTOR_NPC_DENRYUU);
    Turn2Direction<actor ACTOR_PLAYER_APPOINT>(4, 10, DIR_UP);
    Turn2Direction<actor ACTOR_ADVENTURE_NPC2>(4, 10, DIR_UP);
    Turn2Direction<actor ACTOR_NPC_DENRYUU>(4, 10, DIR_DOWN);
    WaitExecuteLives(ACTOR_NPC_DENRYUU);
    message_SetFace(ACTOR_NPC_DENRYUU, FACE_HAPPY, FACE_POS_TOP_R_CENTER);
    message_Talk({
        english="""
             I heard from [CS:N]Shaymin[CR] you were
            finally able to reach the summit.
            Congratulations!
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    se_Play(8962);
    SetEffect<actor ACTOR_NPC_DENRYUU>(EFFECT_QUESTION_MARK, 3);
    WaitEffect<actor ACTOR_NPC_DENRYUU>();
    WaitExecuteLives(ACTOR_NPC_DENRYUU);
    message_SetFace(ACTOR_NPC_DENRYUU, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
    message_Talk({
        english="""
             Huh? How is that [CS:N]Sneasel[CR] you
            helped at the 7th Station Clearing doing?
        """,
    });
    message_Talk({
        english="""
             Oh, him. The next day, while I
            was out on my rounds patrolling the mountain,
            he snuck off...
        """,
    });
    message_Talk({
        english="""
             Well, it seems like he recovered
            his strength. You don't really need to worry.
        """,
    });
    message_Talk({
        english="""
             Oh, that reminds me. He left
            this behind...
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Move2PositionMark<actor ACTOR_NPC_DENRYUU>(1, Position<'m7', 33.5, 26.5>);
    Wait(10);
    Turn2Direction<actor ACTOR_PLAYER_APPOINT>(8, 10, DIR_UPRIGHT);
    Turn2Direction<actor ACTOR_ADVENTURE_NPC2>(8, 10, DIR_UPRIGHT);
    WaitExecuteLives(ACTOR_NPC_DENRYUU);
    Turn2Direction<actor ACTOR_NPC_DENRYUU>(4, 10, DIR_UPRIGHT);
    WaitExecuteLives(ACTOR_NPC_DENRYUU);
    Wait(15);
    SetAnimation<actor ACTOR_NPC_DENRYUU>(5);
    Wait(50);
    SetAnimation<actor ACTOR_NPC_DENRYUU>(2);
    se_Play(5124);
    Wait(20);
    Move2PositionMark<actor ACTOR_NPC_DENRYUU>(1, Position<'m8', 28.5, 30.5>);
    WaitExecuteLives(ACTOR_NPC_DENRYUU);
    Turn2Direction<actor ACTOR_PLAYER_APPOINT>(4, 10, DIR_UP);
    Turn2Direction<actor ACTOR_ADVENTURE_NPC2>(4, 10, DIR_UP);
    Turn2Direction<actor ACTOR_NPC_DENRYUU>(4, 10, DIR_DOWN);
    WaitExecuteLives(ACTOR_NPC_DENRYUU);
    message_SetFace(ACTOR_NPC_DENRYUU, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
    message_Talk({
        english="""
             I think it's a token of
            his appreciation...
        """,
    });
    message_Talk({
        english=" You should take it.",
    });
    message_Close();
    MovePositionOffset<actor ACTOR_PLAYER_APPOINT>(1, 0, -16);
    WaitExecuteLives(ACTOR_PLAYER_APPOINT);
    se_Play(8710);
    Wait(30);
    switch ( ProcessSpecial(PROCESS_SPECIAL_IS_BAG_FULL, 0, 0) ) {
        case 0:
            @label_0;
            $SCENARIO_MAIN_BIT_FLAG[48] = 1;
            item_SetTableData(0, 0);
            switch ( ProcessSpecial(PROCESS_SPECIAL_ADD_TABLE_ITEM_TO_BAG, 0, 0) ) { }
            SetAnimation<actor ACTOR_PLAYER_APPOINT>(5);
            SlidePositionOffset<actor ACTOR_PLAYER_APPOINT>(1, 0, 16);
            WaitExecuteLives(ACTOR_PLAYER_APPOINT);
            SetAnimation<actor ACTOR_PLAYER_APPOINT>(2);
            Wait(20);
            message_Mail({
                english="[CN]This is...",
            });
            message_Mail({
                english="""
                    [CN][player] received
                    [CN]a [CS:I]Sky Gift[CR]!
                """,
            });
            message_Mail({
                english="[CN]You gently open the lid...",
            });
            message_Close();
            se_Play(11021);
            WaitSe(11021);
            message_Mail({
                english="""
                    [CN]Inside was the
                    [CN][s_item:0]!
                """,
            });
            message_Mail({
                english="[CN]A warm and fuzzy feeling falls over you...",
            });
            message_Close();
            end;
        case 1:
        default:
            se_Play(8964);
            SetEffect<actor ACTOR_NPC_DENRYUU>(EFFECT_TWO_ARROWS_AT_SIDE_LEFT, 3);
            WaitEffect<actor ACTOR_NPC_DENRYUU>();
            WaitExecuteLives(ACTOR_NPC_DENRYUU);
            message_SetFace(ACTOR_NPC_DENRYUU, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
            message_Talk({
                english="""
                     Well, I thought so, but you
                    seem to have too much already.
                """,
            });
            message_Close();
            SetAnimation<actor ACTOR_PLAYER_APPOINT>(5);
            SlidePositionOffset<actor ACTOR_PLAYER_APPOINT>(1, 0, 16);
            WaitExecuteLives(ACTOR_PLAYER_APPOINT);
            SetAnimation<actor ACTOR_PLAYER_APPOINT>(2);
            Wait(20);
            message_Talk({
                english="""
                     All right, I'll hold on to this
