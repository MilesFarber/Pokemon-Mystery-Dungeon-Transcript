
def 0 {
    sound_Stop();
    back2_SetMode(4);
    back2_SetGround(LEVEL_V02P06A);
    camera2_SetPositionMark(Position<'m0', 19.5, 15.5>);
    screen2_FadeIn(1, 60);
    Wait(150);
    screen2_FadeOut(1, 60);
    back2_SetMode(0);
    Wait(60);
    message_SetFace(ACTOR_NPC_ZUBATTO, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english="""
             But, Chief... Why'd you bother
            helping out that chicken?
        """,
    });
    message_Talk({
        english="""
             Like giving away that Perfect
            Apple right then...
        """,
    });
    message_Talk({
        english="""
             We should've just watched
            what'd happen to them after.
        """,
    });
    message_Talk({
        english=" That would've been hilarious.",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_DOGAASU, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english=" Yeah, my thoughts exactly.",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_SUKATANKU, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english="""
             Chaw-haw-haw! You're not
            thinking strategically, you two.
        """,
    });
    message_Talk({
        english="""
             Why'd we come here in the
            first place?[K] The expedition, right?
        """,
    });
    message_Talk({
        english="""
             Right now, the trick is for us to
            win the trust of [CS:N]Wigglytuff[CR].
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_DOGAASU, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english=" I get it now.",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_SUKATANKU, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english=" But...",
    });
    message_Talk({
        english="""
             This being a famous guild and
            all, I was playing it cautious at first, but it's
            been ridiculously easy.
        """,
    });
    message_Talk({
        english="""
             [CS:N]Wigglytuff[CR]'s been nothing more
            than a big baby.
        """,
    });
    message_Talk({
        english=" He's no big deal.",
    });
    message_Talk({
        english="""
             Why everyone's so terrified of
            [CS:N]Wigglytuff[CR], I don't know. I'm clueless.
        """,
    });
    message_Talk({
        english="""
             Anyway, if we find a treasure
            while on the expedition...
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_DOGAASU, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english=" We knock out the guild's crew.",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_ZUBATTO, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english="""
             Then we snatch the treasure and
            skedaddle on out!
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_DOGAASU, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english="""
             Whoa-ho-ho! This plan is a
            sure thing.
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_ZUBATTO, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english=" Heh-heh.",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_SUKATANKU, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english=" Chaw-haw-haw.",
    });
    message_KeyWait();
    screen_FadeOutAll(1, 60);
    message_CloseEnforce();
    Wait(60);
    CallCommon(CORO_FADE_OUT_ALL_AFTER);
    end;
}
