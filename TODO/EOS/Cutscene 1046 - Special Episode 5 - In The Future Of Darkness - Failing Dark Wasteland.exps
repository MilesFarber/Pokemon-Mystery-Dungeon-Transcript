
def 0 {
    sound_Stop();
    message_SetFace(ACTOR_PLAYER_FUTURE, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english=" Argh...[K] We didn't do so well...",
    });
    message_Talk({
        english=" We should turn back for now.",
    });
    message_KeyWait();
    screen_FadeOutAll(1, 60);
    message_CloseEnforce();
    CallCommon(CORO_FADE_OUT_ALL_AFTER);
    back2_SetMode(4);
    back2_SetGround(LEVEL_V17P01A);
    back_SetGround(LEVEL_D47P11A);
    supervision_StationCommon(0);
    supervision_Acting(0);
    camera2_SetPositionMark(Position<'m0', 21.5, 17>);
    camera_SetMyself<performer 0>();
    SetPositionInitial<actor ACTOR_NPC_YONOWAARU_N8>();
    SetAnimation<actor ACTOR_NPC_YONOWAARU_N8>(2);
    screen2_FadeIn(0, 30);
    screen_FadeIn(1, 30);
    bgm_PlayFadeIn(BGM_DARK_WASTELAND, 0, 256);
    Wait(30);
    message_SetFace(ACTOR_NPC_YONOWAARU, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
    message_Talk({
        english="""
             You appear to be so wary of me
            that you can't focus properly on our enemies.
        """,
    });
    message_Talk({
        english=" That's it?[K] That's your strength?",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_PLAYER_FUTURE, FACE_NORMAL, FACE_POS_BOTTOM_L_FACEOUTW);
    message_Talk({
        english=" Humph.[K] Whatever.",
    });
    message_Close();
    screen2_FadeOut(1, 30);
    back2_SetMode(0);
    end;
}
