
def 0 {
    bgm_PlayFadeIn(BGM_MYSTIFYING_FOREST, 0, 256);
    SetAnimation<actor ACTOR_PLAYER>(2);
    SetAnimation<actor ACTOR_ATTENDANT1>(2);
    WaitExecuteLives(ACTOR_ATTENDANT1);
    Turn2DirectionLives<actor ACTOR_ATTENDANT1>(4, 10, ACTOR_PLAYER);
    WaitExecuteLives(ACTOR_ATTENDANT1);
    Turn2DirectionLives<actor ACTOR_PLAYER>(4, 10, ACTOR_ATTENDANT1);
    message_SetFace(ACTOR_ATTENDANT1, FACE_NORMAL, FACE_POS_STANDARD);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" You ready, [hero]?",
            }
        case 2:
            {
                english=" Are you ready, [hero]?",
            }
        default:
            {
                english=" Are you ready, [hero]?",
            }
    }
    switch ( message_SwitchMenu(0, 1) ) {
        case menu({
            english="Yes",
        }):
        default:
            @label_0;
            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
            message_SwitchTalk ($PARTNER_TALK_KIND) {
                case 1:
                    {
                        english=" Yup. Looks like we're all set!",
                    }
                case 2:
                    {
                        english=" Yes. We're all ready to go!",
                    }
                default:
                    {
                        english=" Yep. We're set to go!",
                    }
            }
            message_SwitchTalk ($PARTNER_TALK_KIND) {
                case 1:
                    {
                        english=" All right! Let's go!",
                    }
                case 2:
                    {
                        english=" OK! Let's go!",
                    }
                default:
                    {
                        english=" OK! Let's go!",
                    }
            }
            message_Close();
            MovePositionMark<actor ACTOR_PLAYER>(1, Position<'m0', 37.5, 3.5>);
            Wait(10);
            MovePositionMark<actor ACTOR_ATTENDANT1>(1, Position<'m1', 37.5, 3.5>);
            screen_FadeOut(1, 30);
            main_EnterDungeon(44, 0);
            switch ( message_Menu(MENU_DUNGEON_INITIALIZE_TEAM) ) { }
            main_EnterDungeon(-1, 0);
            hold;
            end;
        case menu({
            english="No",
        }):
            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
            message_SwitchTalk ($PARTNER_TALK_KIND) {
                case 1:
                    {
                        english=" All right.",
                    }
                case 2:
                    {
                        english=" OK.",
                    }
                default:
                    {
                        english=" OK.",
                    }
            }
            message_SwitchTalk ($PARTNER_TALK_KIND) {
                case 1:
                    {
                        english=" We'll go when you're ready.",
                    }
                case 2:
                    {
                        english=" We'll leave when you're ready.",
                    }
                default:
                    {
                        english=" Let's go when you're ready.",
                    }
            }
            message_Close();
            end;
    }
}
