            {
                english=" R-really?!",
            }
        default:
            {
                english=" R-really?!",
            }
    }
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    SetAnimation<actor ACTOR_NPC_PERAPPU>(44);
