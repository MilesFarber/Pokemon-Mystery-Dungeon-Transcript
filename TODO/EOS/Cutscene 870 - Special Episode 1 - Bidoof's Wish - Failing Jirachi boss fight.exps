
def 0 {
    sound_Stop();
    message_SetFace(ACTOR_PLAYER_BIPPA, FACE_PAIN, FACE_POS_STANDARD);
    message_Talk({
        english=" Sniff...[K] It's too tough...",
    });
    message_Talk({
        english=" I'll have to try again...",
    });
    message_KeyWait();
    screen_FadeOutAll(1, 60);
    message_CloseEnforce();
    CallCommon(CORO_FADE_OUT_ALL_AFTER);
    back_SetGround(LEVEL_D42P21A);
    supervision_Acting(0);
    supervision_StationCommon(0);
    SetAnimation<actor ACTOR_PLAYER_BIPPA>(27);
    screen_FadeIn(1, 30);
    bgm_PlayFadeIn(BGM_DEEP_STAR_CAVE, 0, 256);
    Wait(30);
    SetAnimation<actor ACTOR_PLAYER_BIPPA>(28);
    WaitAnimation<actor ACTOR_PLAYER_BIPPA>();
    WaitExecuteLives(ACTOR_PLAYER_BIPPA);
    SetAnimation<actor ACTOR_PLAYER_BIPPA>(2);
    Wait(15);
    Turn2Direction<actor ACTOR_PLAYER_BIPPA>(4, 10, DIR_DOWN);
    WaitExecuteLives(ACTOR_PLAYER_BIPPA);
    Wait(20);
    ExecuteCommon<actor ACTOR_PLAYER_BIPPA>(CORO_HEAD_SHAKE_FUNC_SERIES, 0);
    WaitExecuteLives(ACTOR_PLAYER_BIPPA);
    Wait(10);
    message_SetFace(ACTOR_PLAYER_BIPPA, FACE_SPECIAL2, FACE_POS_STANDARD);
    message_Talk({
        english="""
             Sniff...[K] [CS:N]Jirachi[CR] attacks in
            his sleep...
        """,
    });
    message_Talk({
        english=" However...",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2Direction<actor ACTOR_PLAYER_BIPPA>(4, 10, DIR_UP);
    WaitExecuteLives(ACTOR_PLAYER_BIPPA);
    Wait(10);
    se_Play(8972);
    SetEffect<actor ACTOR_PLAYER_BIPPA>(EFFECT_SWEAT_DROPS_FROM_BOTH_SIDES_MEDIUM, 3);
    WaitEffect<actor ACTOR_PLAYER_BIPPA>();
    WaitExecuteLives(ACTOR_PLAYER_BIPPA);
    message_SetFace(ACTOR_PLAYER_BIPPA, FACE_SAD, FACE_POS_STANDARD);
    message_Talk({
        english="""
             He said he tosses and turns in
            his sleep...[K] Sniff...
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    ExecuteCommon<actor ACTOR_PLAYER_BIPPA>(CORO_JUMP_ANGRY_FUNC_SERIES, 0);
    WaitExecuteLives(ACTOR_PLAYER_BIPPA);
    Wait(10);
    message_SetFace(ACTOR_PLAYER_BIPPA, FACE_DETERMINED, FACE_POS_STANDARD);
    message_Talk({
        english=" But anyway![K] I've found him!",
    });
    message_Talk({
        english=" I should go find [CS:N]Jirachi[CR] again!",
    });
    message_Close();
