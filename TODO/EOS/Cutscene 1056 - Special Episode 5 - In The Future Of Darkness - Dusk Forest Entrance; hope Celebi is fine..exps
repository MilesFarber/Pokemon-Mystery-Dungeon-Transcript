
def 0 {
    sound_Stop();
    back_SetGround(LEVEL_D22P11A);
    supervision_StationCommon(0);
    supervision_LoadStation(LEVEL_D22P11A, 'UN08');
    supervision_Station(0);
    supervision_Acting(0);
    camera_SetMyself<performer 0>();
    SetPositionInitial<actor ACTOR_NPC_YONOWAARU_N8>();
    SetAnimation<actor ACTOR_NPC_YONOWAARU_N8>(2);
    screen_FadeIn(1, 30);
    bgm_PlayFadeIn(BGM_DUSK_FOREST, 0, 256);
    Wait(30);
    MovePositionMark<actor ACTOR_PLAYER_FUTURE>(1, Position<'m0', 31.5, 33>);
    MovePositionMark<actor ACTOR_NPC_YONOWAARU_N8>(1, Position<'m1', 37, 33>);
    WaitExecuteLives(ACTOR_NPC_YONOWAARU_N8);
    Wait(15);
    message_SetFace(ACTOR_PLAYER_FUTURE, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english=" ... ([CS:N]Celebi[CR]...)",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2Direction<actor ACTOR_NPC_YONOWAARU_N8>(4, 10, DIR_LEFT);
    message_SetFace(ACTOR_NPC_YONOWAARU, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english=" [CS:Y]Grovyle[CR].",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2Direction<actor ACTOR_PLAYER_FUTURE>(4, 10, DIR_RIGHT);
    WaitExecuteLives(ACTOR_PLAYER_FUTURE);
    message_SetFace(ACTOR_NPC_YONOWAARU, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english="""
             No matter what, she's up against
            [CS:N]Dialga[CR].
        """,
    });
    message_Talk({
        english="""
             But we're most likely already
            too late.
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_PLAYER_FUTURE, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english=" Shut up, [CS:N]Dusknoir[CR]!",
    });
    message_Talk({
        english="""
             She wouldn't be caught
            that easily!
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2Direction<actor ACTOR_PLAYER_FUTURE>(4, 2, DIR_LEFT);
    WaitExecuteLives(ACTOR_PLAYER_FUTURE);
    message_SetFace(ACTOR_PLAYER_FUTURE, FACE_NORMAL, FACE_POS_BOTTOM_L_FACEOUTW);
    message_Talk({
        english="""
             ... (That's right![K] [CS:N]Celebi[CR]'s
            not weak!)
        """,
    });
    message_Talk({
        english=" (But!)",
    });
    message_Talk({
        english="""
             (As [CS:N]Dusknoir[CR] said...[K]
            She's up against Primal [CS:N]Dialga[CR]!)
        """,
    });
    message_Talk({
        english="""
             (And the resourceful new
            henchman too!)
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2Direction<actor ACTOR_PLAYER_FUTURE>(4, 1, DIR_UP);
    WaitExecuteLives(ACTOR_PLAYER_FUTURE);
    message_SetFace(ACTOR_PLAYER_FUTURE, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english="""
             (The last time I fought [CS:N]Dusknoir[CR]
            in [CS:P]Deep Dusk Forest[CR], we weren't too far
            from here.)
        """,
    });
    message_Talk({
        english="""
             (I think [CS:N]Celebi[CR] would be on the
            lookout and would have left there by now...)
        """,
    });
    message_Talk({
        english="""
             ([CS:N]Celebi[CR]...[K] [CS:N]Celebi[CR]...[K]
            I'm begging you...)
        """,
    });
    message_Talk({
        english=" (Keep yourself safe!)",
    });
    message_Close();
    end;
}
