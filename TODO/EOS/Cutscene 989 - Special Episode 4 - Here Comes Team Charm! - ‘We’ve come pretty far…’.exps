
def 0 {
    bgm_PlayFadeIn(BGM_BOULDER_QUARRY, 0, 256);
    $SCENARIO_SIDE = scn[45, 5];
    back_SetGround(LEVEL_D55P21A);
    supervision_StationCommon(0);
    supervision_Acting(0);
    SetPositionInitial<actor ACTOR_NPC_CHAAREMU>();
    SetPositionInitial<actor ACTOR_NPC_SAANAITO>();
    SetAnimation<actor ACTOR_PLAYER_CHARMS>(2);
    SetAnimation<actor ACTOR_NPC_CHAAREMU>(2);
    SetAnimation<actor ACTOR_NPC_SAANAITO>(2);
    camera_SetMyself<performer 0>();
    screen_FadeIn(1, 30);
    MovePositionMark<actor ACTOR_PLAYER_CHARMS>(1, Position<'m0', 28.5, 34.5>);
    Wait(9);
    MovePositionMark<actor ACTOR_NPC_CHAAREMU>(1, Position<'m1', 25.5, 38.5>, Position<'m2', 24.5, 36.5>);
    Wait(12);
    MovePositionMark<actor ACTOR_NPC_SAANAITO>(1, Position<'m3', 31.5, 38.5>, Position<'m4', 32.5, 36.5>);
    WaitExecuteLives(ACTOR_NPC_CHAAREMU);
    ExecuteCommon<actor ACTOR_PLAYER_CHARMS>(CORO_LOOK_AROUND_FUNC_SERIES, 0);
    Wait(6);
    ExecuteCommon<actor ACTOR_NPC_CHAAREMU>(CORO_LOOK_AROUND_RIGHT_FUNC_SERIES, 0);
    Wait(4);
    ExecuteCommon<actor ACTOR_NPC_SAANAITO>(CORO_LOOK_AROUND_LEFT_FUNC_SERIES, 0);
    WaitExecuteLives(ACTOR_PLAYER_CHARMS);
    Turn2DirectionLives<actor ACTOR_PLAYER_CHARMS>(4, 10, ACTOR_NPC_CHAAREMU);
    Wait(6);
    Turn2DirectionLives<actor ACTOR_NPC_CHAAREMU>(4, 10, ACTOR_PLAYER_CHARMS);
    Wait(4);
    Turn2DirectionLives<actor ACTOR_NPC_SAANAITO>(4, 10, ACTOR_NPC_CHAAREMU);
    WaitExecuteLives(ACTOR_NPC_SAANAITO);
    message_SetFace(ACTOR_NPC_CHAAREMU, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english=" We've come pretty far.",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2DirectionLives<actor ACTOR_NPC_CHAAREMU>(4, 10, ACTOR_NPC_SAANAITO);
    Wait(3);
    Turn2DirectionLives<actor ACTOR_PLAYER_CHARMS>(4, 10, ACTOR_NPC_SAANAITO);
    message_SetFace(ACTOR_NPC_SAANAITO, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english="""
             I think it's going to get more
            difficult from here on.
        """,
    });
    message_Talk({
        english=" Let's proceed with caution.",
    });
    message_Close();
    end;
}
