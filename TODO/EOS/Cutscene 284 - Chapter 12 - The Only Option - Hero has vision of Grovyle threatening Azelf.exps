            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
            message_SetFace(ACTOR_NPC_JUPUTORU, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
            message_Talk({
                english=" Now I'll take it![K] The Time Gear!",
            });
            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
            MovePositionMark<actor ACTOR_NPC_JUPUTORU>(0.7969, Position<'m0', 46, 27.5>);
            MovePositionMark<actor ACTOR_NPC_JUPUTORU>(0.7969, Position<'m1', 46, 24.5>);
