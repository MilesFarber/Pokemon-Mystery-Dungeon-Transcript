    switch ( sector() ) {
        case 0:
        default:
            @label_0;
            screen_FadeIn(1, 30);
            bgm_PlayFadeIn(BGM_OH_NO, 0, 256);
            Wait(30);
            @label_2;
            message_SetFaceOnly(ACTOR_NPC_AGUNOMU, FACE_NORMAL, FACE_POS_TOP_L_CENTER);
            message_Talk({
                english=" Ugh...[K]urgh...",
