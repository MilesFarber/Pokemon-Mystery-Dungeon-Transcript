def 1 for actor ACTOR_PLAYER {
    SetAnimation(2);
    Lock(5);
    CallCommon(CORO_LOOK_AROUND_FUNC);
    Wait(30);
    Unlock(3);
    Lock(6);
    MovePositionMark(1.1992, Position<'m2', 25, 26>);
    Turn2Direction(4, 10, DIR_UP);
    Wait(15);
    CallCommon(CORO_LOOK_AROUND_FUNC);
    MovePositionMark(1.1992, Position<'m3', 36, 26>);
    Turn2Direction(4, 10, DIR_UP);
    Lock(7);
    MovePositionMark(1.5, Position<'m4', 60.5, 26>);
    Turn2Direction(4, 10, DIR_UP);
    Unlock(3);
    Lock(8);
    hold;
}

