    Unlock(5);
    Wait(15);
    Unlock(13);
    Lock(3);
    MovePositionMark<performer 0>(0.7969, Position<'m0', 41, 24>);
    Unlock(14);
    Wait(15);
    Unlock(6);
    Wait(20);
    Unlock(10);
    Lock(3);
    message_SetFace(ACTOR_ATTENDANT1, FACE_SURPRISED, FACE_POS_STANDARD);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     It's awesome! Look at it,
                    [hero]!
                """,
            }
        case 2:
            {
                english="""
                     It's incredible! Look at it,
                    [hero]!
                """,
            }
        default:
            {
                english="""
                     It's fantastic! Look at it,
                    [hero]!
                """,
            }
    }
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     Look at these fantastic
                    inscriptions and paintings on the rock walls!
                """,
            }
        case 2:
            {
                english="""
                     Look at all these fantastic
                    paintings and inscriptions on the walls!
                """,
            }
        default:
            {
                english="""
                     Look at all these fantastic
                    paintings and inscriptions on the walls!
                """,
            }
    }
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
