    MovePositionOffset<actor ACTOR_ATTENDANT1>(0.7969, 64, 64);
    MovePositionOffset<actor ACTOR_NPC_JUPUTORU>(0.7969, 80, 0);
    MovePositionOffset<actor ACTOR_PLAYER>(0.7969, 80, 0);
    MovePositionOffset<actor ACTOR_ATTENDANT1>(0.7969, 80, 0);
    Wait(15);
    screen_FadeOut(1, 60);
    Wait(60);
    switch ( message_Menu(MENU_DUNGEON_TEAM_RETURNS_FROM_MAP) ) { }
    $SCENARIO_MAIN_BIT_FLAG[8] = 1;
    $COMPULSORY_SAVE_POINT = 15;
    CallCommon(CORO_HANYOU_SAVE_FUNC);
    end;
}
