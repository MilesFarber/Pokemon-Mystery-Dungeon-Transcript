
def 0 {
    sound_Stop();
    back_SetGround(LEVEL_G01P09C);
    supervision_Acting(0);
    camera_SetMyself<performer 0>();
    SetAnimation<actor ACTOR_PLAYER_KIMAWARI>(44);
    bgm2_PlayFadeIn(BGM_OCEAN2, 30, 190);
    screen_FadeIn(1, 30);
    Wait(30);
    MovePositionMark<actor ACTOR_NPC_CHIRIIN>(1, Position<'m0', 27, 21.5>);
    WaitExecuteLives(ACTOR_NPC_CHIRIIN);
    Turn2Direction<actor ACTOR_NPC_CHIRIIN>(4, 10, DIR_UPRIGHT);
    WaitExecuteLives(ACTOR_NPC_CHIRIIN);
    message_SetFace(ACTOR_NPC_CHIRIIN, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english=" Greetings, [CS:Y]Sunflora[CR]!",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    SetAnimation<actor ACTOR_PLAYER_KIMAWARI>(2);
    se_Play(8978);
    SetEffect<actor ACTOR_PLAYER_KIMAWARI>(EFFECT_TWO_ARROWS_AT_SIDE_RIGHT, 3);
    WaitEffect<actor ACTOR_PLAYER_KIMAWARI>();
    WaitExecuteLives(ACTOR_PLAYER_KIMAWARI);
    Turn2Direction<actor ACTOR_PLAYER_KIMAWARI>(4, 10, DIR_DOWNLEFT);
    WaitExecuteLives(ACTOR_PLAYER_KIMAWARI);
    message_SetFace(ACTOR_NPC_CHIRIIN, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english="""
             Everyone's telling scary stories
            in the next room!
        """,
    });
    message_Talk({
        english="""
             [c_name:NPC_HERO_FIRST] and [c_name:NPC_PARTNER_FIRST]
            are there too!
        """,
    });
    message_Talk({
        english="""
             Do you want to join
            us, [CS:Y]Sunflora[CR]?
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_PLAYER_KIMAWARI, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
    message_FacePositionOffset(1, 0);
    message_Talk({
        english="""
             No, thank you.[K] Right now
            I'm writing in my diary...
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_CHIRIIN, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english="""
             Oh, I see.[K] OK, come over when
            you're done, [CS:Y]Sunflora[CR]!
        """,
    });
    message_SetFace(ACTOR_NPC_CHIRIIN, FACE_HAPPY, FACE_POS_STANDARD);
    message_Talk({
        english="""
             [CS:N]Croagunk[CR] had a REALLY
            scary story!
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_PLAYER_KIMAWARI, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
    message_FacePositionOffset(1, 0);
    message_Talk({
        english=" Yeah.[K] I've got it.",
    });
    message_Talk({
        english=" I'll be there shortly.",
    });
    message_Close();
    MovePositionOffset<actor ACTOR_NPC_CHIRIIN>(0.7969, 0, 24);
    WaitExecuteLives(ACTOR_NPC_CHIRIIN);
    se_Play(8978);
    SetEffect<actor ACTOR_NPC_CHIRIIN>(EFFECT_TWO_ARROWS_AT_SIDE_LEFT, 3);
    message_SetFace(ACTOR_PLAYER_KIMAWARI, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
    message_FacePositionOffset(1, 0);
    message_Talk({
        english=" Oh, [CS:N]Chimecho[CR].",
    });
    message_Close();
    Turn2Direction<actor ACTOR_NPC_CHIRIIN>(4, 10, DIR_UPRIGHT);
    WaitExecuteLives(ACTOR_NPC_CHIRIIN);
    se_Play(8962);
    SetEffect<actor ACTOR_NPC_CHIRIIN>(EFFECT_QUESTION_MARK, 3);
    WaitEffect<actor ACTOR_NPC_CHIRIIN>();
    WaitExecuteLives(ACTOR_NPC_CHIRIIN);
    MovePositionOffset<actor ACTOR_NPC_CHIRIIN>(1, 0, -16);
    WaitExecuteLives(ACTOR_NPC_CHIRIIN);
    message_SetFace(ACTOR_NPC_CHIRIIN, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english=" Yes?",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_PLAYER_KIMAWARI, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
    message_FacePositionOffset(1, 0);
    message_Talk({
        english="""
             Has [CS:N]Loudred[CR] returned to his
            room yet?
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_CHIRIIN, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english=" Indeed, no.[K] Not yet, it seems.",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_PLAYER_KIMAWARI, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
    message_FacePositionOffset(1, 0);
    message_Talk({
        english=" I see...",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_CHIRIIN, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english=" See you!",
    });
    message_Close();
    Turn2Direction<actor ACTOR_NPC_CHIRIIN>(4, 10, DIR_DOWN);
    WaitExecuteLives(ACTOR_NPC_CHIRIIN);
    message_SetFace(ACTOR_NPC_CHIRIIN, FACE_HAPPY, FACE_POS_STANDARD);
    message_Talk({
        english="""
             I have to hear the rest of
            the story!
        """,
    });
    message_Talk({
        english="""
             Just remembering it...[K]
            Eek! Scary!
        """,
    });
    ExecuteCommon<actor ACTOR_NPC_CHIRIIN>(CORO_JUMP_ANGRY_FUNC_SERIES, 0);
    WaitExecuteLives(ACTOR_NPC_CHIRIIN);
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2Direction<actor ACTOR_PLAYER_KIMAWARI>(4, 10, DIR_DOWN);
    MovePositionOffset<actor ACTOR_NPC_CHIRIIN>(1, 0, 88);
    WaitExecuteLives(ACTOR_NPC_CHIRIIN);
    Destroy<actor ACTOR_NPC_CHIRIIN>();
    bgm2_FadeOut(150);
    Wait(60);
    message_SetFace(ACTOR_PLAYER_KIMAWARI, FACE_WORRIED, FACE_POS_TOP_R_CENTER);
    message_FacePositionOffset(1, 0);
    message_Talk({
        english=" .........",
    });
    message_Talk({
        english="""
             ... (I wonder if he's still
            gathering Perfect Apples...)
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Wait(30);
    Turn2Direction<actor ACTOR_PLAYER_KIMAWARI>(4, 10, DIR_RIGHT);
    WaitExecuteLives(ACTOR_PLAYER_KIMAWARI);
    Wait(20);
    SetAnimation<actor ACTOR_PLAYER_KIMAWARI>(44);
    Wait(45);
    bgm_PlayFadeIn(BGM_GOODNIGHT, 0, 190);
    message_Mail({
        english="""
            [CN][CS:N]Loudred[CR]...[K]I really need to apologize
            [CN]and to thank you.
        """,
    });
    message_Mail({
        english="""
            [CN]Before, I...[K]I didn't want to go to dungeons with
            [CN]you at all![K]
            [CN]...I'm afraid I kinda blurted out things like that.
        """,
    });
    message_Mail({
        english="""
            [CN]Oh my gosh! I'm really sorry for what I said![K]
            [CN]I wish I could take all that back!
        """,
    });
    message_Mail({
        english="""
            [CN]I wonder if you'll go to dungeons
            [CN]with me in the future.
        """,
    });
    message_Mail({
        english="""
            [CN]I wonder if we...[K]
            [CN]Can we be friends again?
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    SetAnimation<actor ACTOR_PLAYER_KIMAWARI>(2);
    Wait(45);
    Turn2Direction<actor ACTOR_PLAYER_KIMAWARI>(4, 10, DIR_UPLEFT);
    WaitExecuteLives(ACTOR_PLAYER_KIMAWARI);
    Wait(30);
    message_SetFace(ACTOR_PLAYER_KIMAWARI, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
    message_FacePositionOffset(1, 0);
    message_Talk({
        english=" .........",
    });
    message_Talk({
        english=" Anyway...",
    });
    message_Talk({
        english="""
             As soon as [CS:N]Loudred[CR]'s back, I'm
            going straight to him to apologize...
        """,
    });
    message_Close();
    bgm_FadeOut(150);
    screen_FadeOut(1, 60);
    Wait(30);
    message_Narration(30, {
        english="[CN]I've got to tell him...",
    });
    message_Narration(30, {
        english="[CN]What I couldn't say then...",
    });
    message_Narration(30, {
        english="[CN]\"Thank you.\"",
    });
    message_Close();
    end;
