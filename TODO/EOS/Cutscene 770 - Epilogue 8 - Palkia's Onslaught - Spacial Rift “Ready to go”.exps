
def 0 {
    SetAnimation<actor ACTOR_PLAYER>(2);
    SetAnimation<actor ACTOR_ATTENDANT1>(2);
    Turn2DirectionLives<actor ACTOR_PLAYER>(4, 10, ACTOR_ATTENDANT1);
    Turn2DirectionLives<actor ACTOR_ATTENDANT1>(4, 10, ACTOR_PLAYER);
    message_SetFace(ACTOR_ATTENDANT1, FACE_NORMAL, FACE_POS_STANDARD);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     Hey, [hero]. Are you all
                    ready?
                """,
            }
        case 2:
            {
                english=" Are you ready, [hero]?",
            }
        default:
            {
                english=" Are you ready, [hero]?",
            }
    }
    switch ( message_SwitchMenu(0, 1) ) {
        case menu({
            english="Yes",
        }):
        default:
            @label_0;
            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
            message_SwitchTalk ($PARTNER_TALK_KIND) {
                case 1:
                    {
                        english=" Looks like you're all set.",
                    }
                case 2:
                    {
                        english=" OK, we're all set to go.",
                    }
                default:
                    {
                        english=" OK, we're all set to go.",
                    }
            }
            message_SwitchTalk ($PARTNER_TALK_KIND) {
                case 1:
                    {
                        english=" All right! Let's roll on out!",
                    }
                case 2:
                    {
                        english=" OK! Let's go!",
                    }
                default:
                    {
                        english=" OK! Let's go!",
                    }
            }
            message_Close();
            MovePositionMark<actor ACTOR_PLAYER>(1, Position<'m0', 30, 3.5>);
            Wait(15);
            MovePositionMark<actor ACTOR_ATTENDANT1>(1, Position<'m1', 30, 3.5>);
            Wait(20);
            main_EnterDungeon(64, 30);
            switch ( message_Menu(MENU_DUNGEON_INITIALIZE_TEAM) ) { }
            main_EnterDungeon(-1, 30);
            hold;
            end;
        case menu({
            english="No",
        }):
            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
            message_SwitchTalk ($PARTNER_TALK_KIND) {
                case 1:
                    {
                        english=" All right.",
                    }
                case 2:
                    {
                        english=" OK.",
                    }
                default:
                    {
                        english=" OK.",
                    }
            }
            message_SwitchTalk ($PARTNER_TALK_KIND) {
                case 1:
                    {
                        english=" We'll go when you're ready.",
                    }
                case 2:
                    {
                        english=" Let's go when you're ready.",
                    }
                default:
                    {
                        english=" Let's go when you're ready.",
                    }
            }
            message_Close();
            end;
    }
}
