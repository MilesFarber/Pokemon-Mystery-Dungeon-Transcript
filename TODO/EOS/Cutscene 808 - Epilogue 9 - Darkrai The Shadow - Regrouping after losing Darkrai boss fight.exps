
def 0 {
    sound_Stop();
    back_SetGround(LEVEL_D41P21A);
    supervision_StationCommon(0);
    supervision_LoadStation(LEVEL_D41P21A, 'US22');
    supervision_Station(5);
    supervision_Acting(0);
    camera_SetMyself<performer 0>();
    bgm_PlayFadeIn(BGM_DEEP_DARK_CRATER, 0, 256);
    screen_FadeIn(1, 30);
    Wait(30);
    WaitLockLives(5, ACTOR_PLAYER);
    Unlock(5);
    Wait(15);
    Unlock(7);
    Wait(15);
    Unlock(9);
    Lock(3);
    Wait(15);
    Turn2DirectionLives<actor ACTOR_PLAYER>(4, 10, ACTOR_ATTENDANT1);
    Turn2DirectionLives<actor ACTOR_ATTENDANT1>(4, 10, ACTOR_PLAYER);
    Turn2Direction<actor ACTOR_NPC_JUPUTORU>(4, 10, DIR_DOWN);
    Wait(15);
    SetEffect<actor ACTOR_ATTENDANT1>(EFFECT_SWEAT_DROPS_FROM_BOTH_SIDES_MEDIUM, 3);
    WaitEffect<actor ACTOR_ATTENDANT1>();
    message_SetFace(ACTOR_ATTENDANT1, FACE_PAIN, FACE_POS_STANDARD);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" Ugh...[K] That was brutal...",
            }
        case 2:
            {
                english=" Ugh...[K] That was the worst...",
            }
        default:
            {
                english=" Ugh...[K] That was awful...",
            }
    }
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_KURESERIA, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
    message_Talk({
        english=" It certainly was close.",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2DirectionLives<actor ACTOR_PLAYER>(4, 10, ACTOR_NPC_KURESERIA);
    WaitExecuteLives(ACTOR_PLAYER);
    Turn2DirectionLives<actor ACTOR_ATTENDANT1>(4, 10, ACTOR_NPC_KURESERIA);
    message_Talk({
        english=" But...[K]we have to go back.",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2DirectionLives<actor ACTOR_ATTENDANT1>(4, 10, ACTOR_PLAYER);
    WaitExecuteLives(ACTOR_ATTENDANT1);
    Turn2DirectionLives<actor ACTOR_PLAYER>(4, 10, ACTOR_ATTENDANT1);
    message_SetFace(ACTOR_ATTENDANT1, FACE_DETERMINED, FACE_POS_STANDARD);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     You're right.[K] We have to stop
                    [CS:N]Darkrai[CR] soon.
                """,
            }
        case 2:
            {
                english="""
                     You're right.[K] [CS:N]Darkrai[CR] has to be
                    stopped.
                """,
            }
        default:
            {
                english="""
                     You're right.[K] We have to stop
                    [CS:N]Darkrai[CR] soon.
                """,
            }
    }
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     If we don't, the world will
                    be covered by darkness.
                """,
            }
        case 2:
            {
                english="""
                     If we don't, he'll engulf the
                    world in darkness.
                """,
            }
        default:
            {
                english="""
                     If we don't, he'll enshroud the
                    world in darkness.
                """,
            }
    }
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2Direction<actor ACTOR_ATTENDANT1>(4, 10, DIR_UP);
    WaitExecuteLives(ACTOR_ATTENDANT1);
    Turn2Direction<actor ACTOR_PLAYER>(4, 10, DIR_UP);
    message_SetFace(ACTOR_ATTENDANT1, FACE_DETERMINED, FACE_POS_STANDARD);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     OK, [hero] and [CS:N]Cresselia[CR]!
                    Let's go![K] Back to [CS:N]Darkrai[CR]!
                """,
            }
        case 2:
            {
                english="""
                     OK, [hero] and [CS:N]Cresselia[CR]!
                    Let's go![K] Back to [CS:N]Darkrai[CR]!
                """,
            }
        default:
            {
                english="""
                     OK, [hero] and [CS:N]Cresselia[CR]!
                    Let's go![K] Back to [CS:N]Darkrai[CR]!
                """,
            }
    }
    message_Close();
    end;
}

def 1 for actor ACTOR_PLAYER {
    SetPositionInitial();
    SetDirection(DIR_RIGHT);
    SetAnimation(76);
    Lock(5);
    CallCommon(CORO_WAKEUP_FUNC);
    CallCommon(CORO_LOOK_AROUND_DOWN_FUNC);
    Lock(6);
    hold;
}

def 2 for actor ACTOR_ATTENDANT1 {
    SetPositionInitial();
    SetDirection(DIR_LEFT);
    SetAnimation(76);
    Lock(7);
    CallCommon(CORO_WAKEUP_FUNC);
    CallCommon(CORO_LOOK_AROUND_FUNC);
    Unlock(3);
    Lock(8);
    hold;
}

def 3 for actor ACTOR_NPC_KURESERIA {
    SetPositionInitial();
    SetAnimation(2);
    Lock(9);
    Lock(10);
    hold;
}
