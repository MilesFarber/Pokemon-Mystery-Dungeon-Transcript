        """,
    });
    message_Talk({
        english="""
             We have to try to figure out
            where the treasure is.
        """,
    });
    message_Close();
    se_Play(8975);
    SetEffect<actor ACTOR_NPC_CHAAREMU>(EFFECT_ANGRY, 3);
    ExecuteCommon<actor ACTOR_NPC_CHAAREMU>(CORO_JUMP_ANGRY_FUNC_SERIES, 0);
    WaitExecuteLives(ACTOR_NPC_CHAAREMU);
    message_SetFace(ACTOR_NPC_CHAAREMU, FACE_ANGRY, FACE_POS_STANDARD);
    message_Talk({
        english="""
             And get our revenge on
