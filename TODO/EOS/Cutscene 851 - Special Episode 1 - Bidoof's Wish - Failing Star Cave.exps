
def 0 {
    sound_Stop();
    message_SetFace(ACTOR_PLAYER_BIPPA, FACE_PAIN, FACE_POS_STANDARD);
    message_Talk({
        english=" Sniff...[K] It's too tough...",
    });
    message_Talk({
        english=" That's it for today...",
    });
    message_KeyWait();
    screen_FadeOutAll(1, 60);
    message_CloseEnforce();
    Wait(60);
    CallCommon(CORO_FADE_OUT_ALL_AFTER);
    end;
}
