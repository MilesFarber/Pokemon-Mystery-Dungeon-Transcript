                    switch ( $HERO_TALK_KIND ) {
                        case 4:
                            message_Explanation({
                                english="""
                                    [CN]This is all...[K]
                                    [CN]a nightmare!
                                """,
                            });
                            @label_9;
                            message_Close();
                            se_Play(8198);
                            screen_WhiteOut(1, 30);
                            Wait(60);
                            SetPositionMark<actor ACTOR_NPC_DAAKURAI>(Position<'m2', 34.5, 20.5>);
                            SetPositionMark<actor ACTOR_NPC_KURESERIA>(Position<'m3', 36.5, 27.5>);
                            SetPositionMark<actor ACTOR_ATTENDANT1>(Position<'m4', 32.5, 27.5>);
                            SetDirection<actor ACTOR_NPC_DAAKURAI>(DIR_DOWN);
                            SetDirection<actor ACTOR_NPC_KURESERIA>(DIR_UP);
                            SetDirection<actor ACTOR_ATTENDANT1>(DIR_UP);
                            screen_FlushIn(0, 0, 2, 0, 0, 0);
                            screen_FadeIn(1, 15);
                            Wait(30);
                            se_Play(5126);
                            SetAnimation<actor ACTOR_PLAYER>(13);
                            WaitAnimation<actor ACTOR_PLAYER>();
                            screen_WhiteOut(1, 2);
                            Wait(2);
                            screen_FadeIn(1, 2);
                            SetEffect<actor ACTOR_NPC_DAAKURAI>(EFFECT_SHOCKED, 3);
                            SetAnimation<actor ACTOR_NPC_DAAKURAI>(11);
                            SlidePositionOffset<actor ACTOR_NPC_DAAKURAI>(2.5, 0, -16);
                            WaitExecuteLives(ACTOR_NPC_DAAKURAI);
                            SetAnimation<actor ACTOR_NPC_DAAKURAI>(43);
                            WaitExecuteLives(ACTOR_PLAYER);
                            SetAnimation<actor ACTOR_PLAYER>(2);
                            message_SetFace(ACTOR_NPC_DAAKURAI, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
                            message_Talk({
                                english=" Gaaaah!",
                            });
                            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                            ExecuteCommon<actor ACTOR_ATTENDANT1>(CORO_JUMP_ANGRY_FUNC_SERIES, 0);
                            WaitExecuteLives(ACTOR_ATTENDANT1);
                            message_SetFace(ACTOR_ATTENDANT1, FACE_NORMAL, FACE_POS_STANDARD);
                            message_SwitchTalk ($PARTNER_TALK_KIND) {
                                case 1:
                                    {
                                        english=" Oh, [hero]!",
                                    }
                                case 2:
                                    {
                                        english=" Oh, [hero]!",
                                    }
                                default:
                                    {
                                        english=" Oh, [hero]!",
                                    }
                            }
                            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                            se_Play(8967);
                            SetEffect<actor ACTOR_NPC_KURESERIA>(EFFECT_EXCLAMATION_MARK, 3);
                            WaitEffect<actor ACTOR_NPC_KURESERIA>();
                            WaitExecuteLives(ACTOR_NPC_KURESERIA);
                            message_SetFace(ACTOR_NPC_KURESERIA, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
                            message_Talk({
                                english=" Oh, [hero]!",
                            });
                            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                            SetAnimation<actor ACTOR_NPC_DAAKURAI>(2);
                            SetEffect<actor ACTOR_NPC_DAAKURAI>(EFFECT_SHOCKED, 3);
                            message_SetFace(ACTOR_NPC_DAAKURAI, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
                            message_Talk({
                                english=" Y-you!",
                            });
                            message_Close();
                            SetAnimation<actor ACTOR_NPC_DAAKURAI>(12);
                            WaitAnimation<actor ACTOR_NPC_DAAKURAI>();
                            se_Play(5121);
                            screen_WhiteOut(1, 2);
                            Wait(2);
                            screen_FadeIn(1, 2);
                            Wait(10);
                            MovePositionOffset<performer 0>(2.5, 0, 16);
                            SetDirection<actor ACTOR_PLAYER>(DIR_LEFT);
                            SetAnimation<actor ACTOR_PLAYER>(68);
                            SetEffect<actor ACTOR_PLAYER>(EFFECT_SHOCKED, 3);
                            SlidePositionOffset<actor ACTOR_PLAYER>(2.5, 0, 32);
                            WaitExecuteLives(ACTOR_PLAYER);
                            SetEffect<actor ACTOR_ATTENDANT1>(EFFECT_SHOCKED, 3);
                            SetEffect<actor ACTOR_NPC_KURESERIA>(EFFECT_SHOCKED, 3);
                            SetAnimation<actor ACTOR_ATTENDANT1>(5);
                            SetAnimation<actor ACTOR_NPC_KURESERIA>(5);
                            SlidePositionOffset<actor ACTOR_ATTENDANT1>(1, 0, 4);
                            SlidePositionOffset<actor ACTOR_NPC_KURESERIA>(1, 0, 4);
                            WaitExecuteLives(ACTOR_NPC_DAAKURAI);
                            SetAnimation<actor ACTOR_NPC_DAAKURAI>(2);
                            WaitExecuteLives(ACTOR_NPC_KURESERIA);
                            SetAnimation<actor ACTOR_ATTENDANT1>(2);
                            SetAnimation<actor ACTOR_NPC_KURESERIA>(2);
                            MovePositionOffset<actor ACTOR_NPC_DAAKURAI>(1, 0, 16);
                            WaitExecuteLives(ACTOR_NPC_DAAKURAI);
                            Wait(30);
                            message_SetFace(ACTOR_PLAYER, FACE_PAIN, FACE_POS_BOTTOM_R_CENTER);
                            message_FacePositionOffset(0, -2);
                            message_SwitchMonologue ($HERO_TALK_KIND) {
                                case 4:
                                    {
                                        english="(I was right!)",
                                    }
                                default:
                                    {
                                        english="(I was right!)",
                                    }
                            }
                            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                            SetAnimation<actor ACTOR_PLAYER>(63);
                            WaitAnimation<actor ACTOR_PLAYER>();
                            WaitExecuteLives(ACTOR_PLAYER);
                            SetAnimation<actor ACTOR_PLAYER>(2);
                            Turn2Direction<actor ACTOR_PLAYER>(4, 10, DIR_UP);
                            WaitExecuteLives(ACTOR_PLAYER);
                            Wait(30);
                            message_SwitchMonologue ($HERO_TALK_KIND) {
                                case 4:
                                    {
                                        english="(I was being deceived!)",
                                    }
                                default:
                                    {
                                        english="(I was being deceived!)",
                                    }
                            }
                            message_SwitchMonologue ($HERO_TALK_KIND) {
                                case 4:
                                    {
                                        english="([CS:N]Darkrai[CR] was showing me an illusion!)",
                                    }
                                default:
                                    {
                                        english="([CS:N]Darkrai[CR] was showing me an illusion!)",
                                    }
                            }
                            message_SwitchMonologue ($HERO_TALK_KIND) {
                                case 4:
                                    {
                                        english="(That was close!)",
                                    }
                                default:
                                    {
                                        english="(That was close!)",
                                    }
                            }
                            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                            bgm_PlayFadeIn(BGM_DOWN_A_DARK_PATH, 0, 256);
                            message_SetFace(ACTOR_NPC_DAAKURAI, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
                            message_Talk({
                                english="""
                                     Blast it! I was on the verge of
                                    success!
                                """,
                            });
                            message_Talk({
                                english="""
                                     Is that your answer,
                                    [hero]?!
                                """,
                            });
                            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                            message_SetFace(ACTOR_PLAYER, FACE_DETERMINED, FACE_POS_BOTTOM_R_CENTER);
                            message_FacePositionOffset(0, -2);
                            message_SwitchMonologue ($HERO_TALK_KIND) {
                                case 4:
                                    {
                                        english="(Of course!)",
                                    }
                                default:
                                    {
                                        english="(Of course!)",
                                    }
                            }
                            message_SwitchMonologue ($HERO_TALK_KIND) {
                                case 4:
                                    {
                                        english="""
                                            ([partner] would never consider even
                                            saying something like that!)
                                        """,
                                    }
                                default:
                                    {
                                        english="""
                                            ([partner] would never consider even
                                            saying something like that!)
                                        """,
                                    }
                            }
                            message_SwitchMonologue ($HERO_TALK_KIND) {
                                case 4:
                                    {
                                        english="(Join with [CS:N]Darkrai[CR]?[K] Not on my life!)",
                                    }
                                default:
                                    {
                                        english="(Join with [CS:N]Darkrai[CR]?[K] Not on my life!)",
                                    }
                            }
                            message_SwitchMonologue ($HERO_TALK_KIND) {
                                case 4:
                                    {
                                        english="(A world of darkness...[K] I won't let it happen!)",
                                    }
                                default:
                                    {
                                        english="(A world of darkness...[K] I won't let it happen!)",
                                    }
                            }
                            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                            message_SetFace(ACTOR_NPC_DAAKURAI, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
                            message_Talk({
                                english="""
                                     Humph...[K] So be it.[K] You've made
                                    the wrong choice.
                                """,
                            });
                            message_Talk({
                                english="""
                                     There's nothing left to say.[K]
                                    I will be rid of you now.
                                """,
                            });
                            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                            se_Play(5133);
                            screen_FadeOut(1, 15);
                            Wait(15);
                            supervision_Acting(1);
                            screen_FadeIn(1, 15);
                            Wait(30);
                            se_Play(8968);
                            SetEffect<actor ACTOR_ATTENDANT1>(EFFECT_SHOCKED, 3);
                            SetEffect<actor ACTOR_PLAYER>(EFFECT_SHOCKED, 3);
                            SetEffect<actor ACTOR_NPC_KURESERIA>(EFFECT_SHOCKED, 3);
                            ExecuteCommon<actor ACTOR_ATTENDANT1>(CORO_LOOK_AROUND_FUNC_SERIES, 0);
                            Wait(12);
                            ExecuteCommon<actor ACTOR_PLAYER>(CORO_LOOK_AROUND_LEFT_FUNC_SERIES, 0);
                            Wait(4);
                            ExecuteCommon<actor ACTOR_NPC_KURESERIA>(CORO_LOOK_AROUND_DOWN_FUNC_SERIES, 0);
                            Wait(7);
                            message_SetFace(ACTOR_ATTENDANT1, FACE_SURPRISED, FACE_POS_STANDARD);
                            message_SwitchTalk ($PARTNER_TALK_KIND) {
                                case 1:
                                    {
                                        english=" Whoa![K] We're surrounded!",
                                    }
                                case 2:
                                    {
                                        english=" Waah![K] We're surrounded!",
                                    }
                                default:
                                    {
                                        english=" Waah![K] We're surrounded!",
                                    }
                            }
                            WaitExecuteLives(ACTOR_NPC_KURESERIA);
                            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                            se_Play(8967);
                            SetEffect<actor ACTOR_NPC_KURESERIA>(EFFECT_EXCLAMATION_MARK, 3);
                            WaitEffect<actor ACTOR_NPC_KURESERIA>();
                            WaitExecuteLives(ACTOR_NPC_KURESERIA);
                            message_SetFace(ACTOR_NPC_KURESERIA, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
                            message_Talk({
                                english="""
                                     I knew it.[K] I figured that you
                                    would do something like this!
                                """,
                            });
                            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                            message_SetFace(ACTOR_NPC_DAAKURAI, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
                            message_Talk({
                                english=" Humph. Say what you will.",
                            });
                            message_Talk({
                                english="""
                                     This is where I will finally be
                                    rid of you meddlers.
                                """,
                            });
                            message_Close();
                            se_Play(5143);
                            screen_WhiteOut(1, 2);
                            Wait(2);
                            screen_FadeIn(1, 2);
                            Wait(10);
                            message_Talk({
                                english="""
                                     I will seize control of the
                                    darkened world...
                                """,
                            });
                            message_Close();
                            se_Play(5143);
                            screen_WhiteOut(1, 2);
                            Wait(2);
                            screen_FadeIn(1, 2);
                            Wait(10);
                            message_Talk({
                                english=" as its king.",
                            });
                            message_Close();
                            se_Play(5143);
                            screen_WhiteOut(1, 2);
                            Wait(2);
                            screen_FadeIn(1, 2);
                            Wait(10);
                            se_Play(5143);
                            screen_WhiteOut(1, 2);
                            Wait(2);
                            screen_FadeIn(1, 2);
                            Wait(10);
                            message_Talk({
                                english=" This is it![K] Attack!",
                            });
                            message_Close();
                            SetAnimation<actor ACTOR_NPC_DAAKURAI>(18);
                            WaitAnimation<actor ACTOR_NPC_DAAKURAI>();
                            WaitExecuteLives(ACTOR_NPC_DAAKURAI);
                            bgm_Stop();
                            se_Play(5143);
                            screen_WhiteOut(1, 2);
                            Wait(2);
                            screen_FadeIn(1, 2);
                            Wait(10);
                            se_Play(5143);
                            screen_WhiteOut(1, 2);
                            Wait(2);
                            screen_FadeIn(1, 2);
                            WaitSe(5143);
                            se_Play(5136);
                            CallCommon(CORO_BOSS_WIPE_FUNC);
                            end;
                        default:
                            @label_8;
                            message_Explanation({
                                english="""
                                    [CN]This is all...[K]
                                    [CN]a nightmare!
                                """,
                            });
                            jump @label_9;
                    }
                    break;
                case 2:
                    message_Explanation({
                        english="[CN]Don't, [hero]!",
                    });
                    message_Explanation({
                        english="[CN]Don't be fooled!",
                    });
                    jump @label_5;
                default:
                    @label_4;
                    message_Explanation({
                        english="[CN]Don't, [hero]!",
                    });
                    message_Explanation({
                        english="[CN]Don't be fooled!",
                    });
                    jump @label_5;
            }
            break;
        case menu({
            english="I refuse!",
        }):
            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
            message_SetFace(ACTOR_PLAYER, FACE_DETERMINED, FACE_POS_BOTTOM_R_CENTER);
            message_FacePositionOffset(0, -2);
            message_SwitchMonologue ($HERO_TALK_KIND) {
                case 4:
                    {
                        english="(Do that...?[K] I refuse!)",
                    }
                default:
                    {
                        english="(Do that...?[K] I refuse!)",
                    }
            }
            message_SwitchMonologue ($HERO_TALK_KIND) {
                case 4:
                    {
                        english="(This is all...[K] This is all...)",
                    }
                default:
                    {
                        english="(This is all...[K] This is all...)",
                    }
            }
            message_Close();
            bgm_Stop();
            screen_FlushOut(1, 3, 2, 0, 0, 0);
            Wait(15);
            jump @label_6;
    }
}
