
def 0 {
    sound_Stop();
    back_SetGround(LEVEL_T01P03A);
    back_ChangeGround(LEVEL_T01P03A2);
    supervision_StationCommon(5);
    supervision_StationCommon(3);
    supervision_StationCommon(0);
    supervision_Acting(0);
    camera_SetMyself<performer 0>();
    Wait(1);
    SetPositionInitial<actor ACTOR_NPC_GARAGARA>();
    SetAnimation<actor ACTOR_NPC_GARAGARA>(2);
    MovePositionMark<actor ACTOR_PLAYER>(1, Position<'m0', 33.5, 27.5>);
    MovePositionMark<actor ACTOR_ATTENDANT1>(1, Position<'m1', 29.5, 27.5>);
    screen_FadeIn(1, 30);
    Wait(30);
    Turn2Direction<actor ACTOR_PLAYER>(4, 10, DIR_UPLEFT);
    Turn2Direction<actor ACTOR_ATTENDANT1>(4, 10, DIR_UPLEFT);
    WaitExecuteLives(ACTOR_ATTENDANT1);
    se_Play(8967);
    SetEffect<actor ACTOR_PLAYER>(EFFECT_SHOCKED, 3);
    ExecuteCommon<actor ACTOR_ATTENDANT1>(CORO_JUMP_SURPRISE_FUNC_SERIES, 0);
    message_SetFace(ACTOR_ATTENDANT1, FACE_SURPRISED, FACE_POS_STANDARD);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" Whoa! Check out that giant hole!",
            }
        case 2:
            {
                english=" Whoa! Look at that huge hole!",
            }
        default:
            {
                english=" Wow! A giant hole opened up!",
            }
    }
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2Direction<actor ACTOR_ATTENDANT1>(4, 10, DIR_UP);
    WaitExecuteLives(ACTOR_ATTENDANT1);
    Turn2Direction<actor ACTOR_PLAYER>(4, 10, DIR_UP);
    WaitExecuteLives(ACTOR_PLAYER);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" What's going on here?",
            }
        case 2:
            {
                english=" What just happened here?",
            }
        default:
            {
                english=" What happened?",
            }
    }
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2Direction<actor ACTOR_NPC_GARAGARA>(4, 10, DIR_DOWN);
    WaitExecuteLives(ACTOR_NPC_GARAGARA);
    se_Play(8975);
    ExecuteCommon<actor ACTOR_NPC_GARAGARA>(CORO_JUMP_ANGRY_FUNC_SERIES, 0);
    WaitExecuteLives(ACTOR_NPC_GARAGARA);
    message_SetFace(ACTOR_NPC_GARAGARA, FACE_NORMAL, FACE_POS_TOP_C_FACER);
    message_Talk({
        english=" The wall just gave way!",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2Direction<actor ACTOR_NPC_GARAGARA>(4, 10, DIR_UPLEFT);
    WaitExecuteLives(ACTOR_NPC_GARAGARA);
    message_SetFace(ACTOR_NPC_GARAGARA, FACE_NORMAL, FACE_POS_TOP_C_FACEL);
    message_Talk({
        english="""
             And that big hole appeared
            where it was.
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    se_Play(8964);
    SetEffect<actor ACTOR_NPC_GARAGARA>(EFFECT_EXCLAMATION_MARK, 3);
    WaitEffect<actor ACTOR_NPC_GARAGARA>();
    WaitExecuteLives(ACTOR_NPC_GARAGARA);
    message_Talk({
        english="""
             Come to think of it...[K] My grandpa
            mentioned this a long time ago...
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    se_Play(8962);
    SetEffect<actor ACTOR_ATTENDANT1>(EFFECT_QUESTION_MARK, 3);
    WaitEffect<actor ACTOR_ATTENDANT1>();
    WaitExecuteLives(ACTOR_ATTENDANT1);
    message_SetFace(ACTOR_ATTENDANT1, FACE_NORMAL, FACE_POS_STANDARD);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" Your grandpa?",
            }
        case 2:
            {
                english=" Your grandpa?",
            }
        default:
            {
                english=" Your grandfather?",
            }
    }
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2Direction<actor ACTOR_NPC_GARAGARA>(4, 10, DIR_DOWN);
    WaitExecuteLives(ACTOR_NPC_GARAGARA);
    message_SetFace(ACTOR_NPC_GARAGARA, FACE_NORMAL, FACE_POS_TOP_C_FACER);
    message_Talk({
        english="""
             Yeah.[K] You see, my grandpa built
            this dojo originally.
        """,
    });
    message_Talk({
        english="""
             And that same grandpa told me
            there was a very dangerous cave here.
        """,
    });
    message_Talk({
        english="""
             It was so dangerous...[K]he had
            the hole sealed up so no one could get in.
            I remember that now.
        """,
    });
    message_Talk({
        english="""
             Back then, my grandpa used to
            tell me about that hole. And he'd never once
            fail to scare me silly...
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    se_Play(8973);
    SetEffect<actor ACTOR_NPC_GARAGARA>(EFFECT_EXCLAMATION_MARK, 3);
    WaitEffect<actor ACTOR_NPC_GARAGARA>();
    WaitExecuteLives(ACTOR_NPC_GARAGARA);
    message_Talk({
        english=" ...![K] Y-you two... You're not...",
    });
    message_Talk({
        english="""
             You're not seriously considering
            going into that hole, are you?
        """,
    });
    message_Talk({
        english="""
             Don't do it.[K] Don't even think
            about it.
        """,
    });
    message_Talk({
        english="""
             I... I can't guarantee that you'll
            ever come out of there...
        """,
    });
    SlidePositionOffset<actor ACTOR_NPC_GARAGARA>(1, 1, 0);
    Wait(3);
    SlidePositionOffset<actor ACTOR_NPC_GARAGARA>(1, -1, 0);
    Wait(3);
    SlidePositionOffset<actor ACTOR_NPC_GARAGARA>(1, 1, 0);
    Wait(3);
    SlidePositionOffset<actor ACTOR_NPC_GARAGARA>(1, -1, 0);
    message_Close();
    bgm_PlayFadeIn(BGM_WIGGLYTUFFS_GUILD_REMIX, 0, 256);
    end;
}
