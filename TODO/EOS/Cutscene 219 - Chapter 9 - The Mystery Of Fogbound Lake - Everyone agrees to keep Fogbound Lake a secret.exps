    message_SetFace(ACTOR_NPC_PERAPPU, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english=" I'll hop to it, Guildmaster!",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2Direction<actor ACTOR_NPC_PERAPPU>(4, 10, DIR_DOWNLEFT);
    WaitExecuteLives(ACTOR_NPC_PERAPPU);
    Turn2Direction<actor ACTOR_ATTENDANT1>(4, 10, DIR_RIGHT);
    Turn2Direction<actor ACTOR_PLAYER>(4, 10, DIR_RIGHT);
    Turn2Direction<actor ACTOR_NPC_HEIGANI>(4, 10, DIR_UPRIGHT);
    Turn2Direction<actor ACTOR_NPC_CHIRIIN>(4, 10, DIR_UPRIGHT);
    Turn2Direction<actor ACTOR_NPC_DIGUDA>(4, 10, DIR_UPRIGHT);
    Turn2Direction<actor ACTOR_NPC_KIMAWARI>(4, 10, DIR_LEFT);
    WaitExecuteLives(ACTOR_NPC_KIMAWARI);
    Wait(15);
    se_Play(5122);
    SetAnimation<actor ACTOR_NPC_PERAPPU>(18);
