        """,
    });
    message_Narration(30, {
        english="""
            [CN][CS:N]Wigglytuff[CR] and the members
            [CN]safely returned to the guild...
        """,
    });
    message_Narration(30, {
        english="[CN]For [hero] and the apprentices...",
