
def 0 {
    back_SetGround(LEVEL_P04P01C);
    supervision_StationCommon(0);
    supervision_Acting(0);
    camera_SetMyself<performer 0>();
    screen_FadeIn(1, 30);
    Wait(30);
    message_SetFace(ACTOR_NPC_PUKURIN, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english=" So sorry! To have disturbed you!",
    });
    message_Talk({
        english="""
             Had a fantastic time! ♪[K]
            Friend! ♪ Friend! ♪ Friend! ♪
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_YUKUSHII, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
    message_Talk({
        english="""
             I shall not take away your
            memories of this place.
        """,
    });
    message_Talk({
        english=" You have earned my trust.",
    });
    message_Talk({
        english="""
             But I must ask that you keep
            this place a secret.
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    ExecuteCommon<actor ACTOR_NPC_PUKURIN>(CORO_JUMP_HAPPY_FUNC_SERIES, 0);
    WaitExecuteLives(ACTOR_NPC_PUKURIN);
    message_SetFace(ACTOR_NPC_PUKURIN, FACE_HAPPY, FACE_POS_STANDARD);
    message_Talk({
        english="""
             Surely! Thank you! We all know
            what we need to do!
        """,
    });
    message_Talk({
        english="""
             You know, another Time Gear
            has been stolen. This one must stay safe!
        """,
    });
    message_Talk({
        english="""
             We won't ever say a word about
            this place!
        """,
    });
    message_Talk({
        english="""
             I swear it in the name of
            [CS:N]Wigglytuff[CR]'s Guild!
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_YUKUSHII, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
    message_Talk({
        english=" Please hold true to that promise.",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_PUKURIN, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english=" OK![K] Let's be on our way!",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2Direction<actor ACTOR_NPC_PUKURIN>(4, 10, DIR_DOWN);
    WaitExecuteLives(ACTOR_NPC_PUKURIN);
    message_Talk({
        english=" [CS:N]Chatot[CR], if you will!",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    ExecuteCommon<actor ACTOR_NPC_PERAPPU>(CORO_JUMP_HAPPY_FUNC_SERIES, 0);
