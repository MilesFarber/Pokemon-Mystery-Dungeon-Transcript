    switch ( message_Menu(MENU_DUNGEON_TEAM_RETURNS_FROM_MAP) ) { }
    $SCENARIO_BALANCE_FLAG = 3;
    $SPECIAL_EPISODE_OPEN[1] = 1;
    $SCENARIO_MAIN = scn[12, 0];
