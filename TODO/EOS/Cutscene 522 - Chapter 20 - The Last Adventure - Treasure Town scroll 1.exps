
def 0 {
    bgm_PlayFadeIn(BGM_TIME_RESTORED, 0, 200);
    back_SetGround(LEVEL_T01P01A);
    supervision_StationCommon(0);
    supervision_StationCommon(99);
    supervision_Acting(0);
    camera_SetMyself<performer 0>();
    MovePositionOffset<performer 0>(0.5, -200, 0);
    SetAnimation<actor ACTOR_NPC_KEMUSSO>(4);
    SetAnimation<actor ACTOR_NPC_OOSUBAME>(4);
    SetAnimation<actor ACTOR_NPC_HEIGANI>(4);
    SetAnimation<actor ACTOR_NPC_HIMEGUMA>(4);
    SetAnimation<actor ACTOR_NPC_BIPPA>(4);
    SetEffect<actor ACTOR_NPC_HIMEGUMA>(EFFECT_LAUGHING, 3);
    CallCommon(CORO_FADE_OUT_ALL_BEFORE);
    screen_FadeInAll(1, 30);
    Wait(60);
    message_SetActor(ACTOR_ATTENDANT1);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" It's Treasure Town!",
            }
        case 2:
            {
                english=" It's Treasure Town!",
            }
        default:
            {
                english=" It's Treasure Town!",
            }
    }
    Wait(240);
    message_CloseEnforce();
    screen_FadeOutAll(1, 60);
    CallCommon(CORO_FADE_OUT_ALL_AFTER);
