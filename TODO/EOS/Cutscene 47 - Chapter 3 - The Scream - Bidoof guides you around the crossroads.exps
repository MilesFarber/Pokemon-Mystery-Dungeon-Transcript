    MovePositionMark<actor ACTOR_ATTENDANT1>(1, Position<'m4', 29.5, 14.5>);
    Turn2Direction<actor ACTOR_ATTENDANT1>(4, 10, DIR_DOWNRIGHT);
    WaitExecuteLives(ACTOR_ATTENDANT1);
    message_Talk({
        english="""
             Usually, you make a record of
            your adventure by going to your bed at
            the guild, yup yup.
        """,
    });
    message_Talk({
        english="""
             Seems you can make a record
            of your adventure over there too.
        """,
    });
    message_Talk({
        english="""
             By golly, it's a handy spot when
            you want to record your adventure frequently.
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2Direction<actor ACTOR_NPC_BIPPA>(4, 10, DIR_DOWN);
