
def 0 {
    back_SetGround(LEVEL_P01P01A);
    supervision_Acting(0);
    camera_SetMyself<performer 0>();
    Wait(1);
    screen_FadeIn(1, 30);
    bgm_PlayFadeIn(BGM_TREASURE_TOWN, 0, 256);
    Wait(30);
    MovePositionMark<actor ACTOR_NPC_BIPPA>(1, Position<'m0', 27, 19.5>);
    MovePositionMark<actor ACTOR_PLAYER>(1, Position<'m1', 27, 16.5>);
    MovePositionMark<actor ACTOR_ATTENDANT1>(1, Position<'m2', 27, 13.5>);
    WaitExecuteLives(ACTOR_NPC_BIPPA);
    Turn2Direction<actor ACTOR_NPC_BIPPA>(4, 10, DIR_RIGHT);
    Wait(10);
    Turn2Direction<actor ACTOR_PLAYER>(4, 10, DIR_RIGHT);
    Wait(6);
    Turn2Direction<actor ACTOR_ATTENDANT1>(4, 10, DIR_DOWNRIGHT);
    WaitExecuteLives(ACTOR_ATTENDANT1);
    MovePositionMark<performer 0>(1, Position<'m3', 32, 20.5>);
    WaitExecutePerformer(0);
    Wait(10);
    message_SetFace(ACTOR_NPC_BIPPA, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english="""
             I hear you can make a record of
            your adventure at that Watering Hole.
        """,
    });
