def 1 for actor ACTOR_PLAYER_KIMAWARI {
    SetAnimation(2);
    Lock(5);
    SetEffect(692, 0);
    CallCommon(CORO_JUMP_SURPRISE_FUNC);
    SetAnimation(5);
    Lock(6);
    CallCommon(CORO_JUMP_ANGRY_FUNC);
    @label_1;
    forever {
        MovePositionMark(2.5, Position<'m2', 26, 32.5>);
        switch ( $EVENT_LOCAL ) {
            case 1:
                break_loop;
                break;
            default:
                MovePositionMark(2.5, Position<'m3', 33, 32.5>);
                switch ( $EVENT_LOCAL ) {
                    case 1:
                        break_loop;
                        break;
                    default:
                        continue;  // may be redundant
                }
                break;
        }
    }
    @label_0;
    MovePositionMark(2.5, Position<'m4', 29.5, 32.5>);
    Turn2DirectionLives(4, 10, ACTOR_NPC_GOOSUTO);
    Lock(7);
    hold;
}
