
def 0 {
    SetAnimation<actor ACTOR_PLAYER_APPOINT>(2);
    SetAnimation<actor ACTOR_ADVENTURE_NPC1>(2);
    SetAnimation<actor ACTOR_ADVENTURE_NPC2>(2);
    SetAnimation<actor ACTOR_ADVENTURE_NPC3>(2);
    bgm_PlayFadeIn(BGM_IN_THE_DEPTHS_OF_THE_PIT, 0, 256);
    SetAnimation<actor ACTOR_PLAYER_APPOINT>(2);
    message_ResetActor();
    message_Mail({
