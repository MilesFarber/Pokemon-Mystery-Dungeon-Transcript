                                                WaitSe(8966);
                                                message_Close();
                                                $SCENARIO_MAIN_BIT_FLAG[45] = 1;
                                                bgm_PlayFadeIn(BGM_IN_THE_DEPTHS_OF_THE_PIT, 0, 256);
                                                end;
                                            default:
                                                @label_4;
                                                message_Close();
                                                Wait(90);
                                                SetAnimation<object OBJECT_D32P44A1_84>(1);
                                                se_FadeOut(7948, 90);
