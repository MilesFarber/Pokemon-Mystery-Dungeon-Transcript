        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_Mail({
        english="[CN]Will you close your eyes?",
    });
    switch ( message_SwitchMenu(0, 1) ) {
        case menu({
            english="Yes",
        }):
        default:
            @label_0;
            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
            bgm_FadeOut(90);
            message_Mail({
                english="[CN][player] did as instructed.",
            });
            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
