            SetEffect<actor ACTOR_ADVENTURE_NPC2>(EFFECT_EXCLAMATION_MARK, 3);
            SetEffect<actor ACTOR_ADVENTURE_NPC3>(EFFECT_EXCLAMATION_MARK, 3);
            se_Play(7948);
            SetAnimation<object OBJECT_D32P44A1_84>(2);
            if ( not debug ) {
                @label_2;
                message_Close();
                switch ( ProcessSpecial(PROCESS_SPECIAL_COUNT_ITEM_TYPE_IN_BAG, 418, 0) ) {
                    case >= 1:
                        switch ( ProcessSpecial(PROCESS_SPECIAL_COUNT_ITEM_TYPE_IN_BAG, 419, 0) ) {
                            case >= 1:
                                switch ( ProcessSpecial(PROCESS_SPECIAL_COUNT_ITEM_TYPE_IN_BAG, 404, 0) ) {
                                    case >= 2:
                                        switch ( ProcessSpecial(PROCESS_SPECIAL_COUNT_ITEM_TYPE_IN_BAG, 411, 0) ) {
                                            case >= 1:
                                                @label_3;
                                                message_Close();
                                                Wait(30);
                                                message_Mail({
                                                    english="[CN]!!!",
                                                });
                                                message_Mail({
                                                    english="""
                                                        [CN]The [CS:I]Unown Stones[CR] in the Treasure Bag:
                                                        [CN][FT:1]S[FT:0], [FT:1]T[FT:0], [FT:1]E[FT:0], [FT:1]E[FT:0], and [FT:1]L[FT:0] are responding!
                                                    """,
                                                });
                                                message_Mail({
                                                    english="""
                                                        [CN]The activated [CS:I]Unown Stones[CR] were
                                                        [CN]absorbed by the stone marker!
                                                    """,
                                                });
                                                CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                                                switch ( ProcessSpecial(PROCESS_SPECIAL_REMOVE_ITEMS_TYPE_IN_BAG, 418, 0) ) { }
                                                switch ( ProcessSpecial(PROCESS_SPECIAL_REMOVE_ITEMS_TYPE_IN_BAG, 419, 0) ) { }
                                                switch ( ProcessSpecial(PROCESS_SPECIAL_REMOVE_ITEMS_TYPE_IN_BAG, 404, 0) ) { }
                                                switch ( ProcessSpecial(PROCESS_SPECIAL_REMOVE_ITEMS_TYPE_IN_BAG, 404, 0) ) { }
                                                switch ( ProcessSpecial(PROCESS_SPECIAL_REMOVE_ITEMS_TYPE_IN_BAG, 411, 0) ) { }
                                                se_FadeOut(7948, 15);
                                                Wait(15);
                                                se_Play(7949);
                                                Wait(30);
                                                SetAnimation<object OBJECT_D32P44A1_84>(5);
                                                Wait(60);
                                                SetAnimation<object OBJECT_D32P44A1_84>(6);
                                                Wait(60);
                                                SetAnimation<object OBJECT_D32P44A1_84>(19);
                                                WaitAnimation<object OBJECT_D32P44A1_84>();
                                                WaitExecuteObject(OBJECT_D32P44A1_84);
                                                screen_WhiteOut(1, 30);
                                                supervision_Acting(0);
                                                SetAnimation<actor ACTOR_ADVENTURE_NPC1>(4);
                                                SetAnimation<actor ACTOR_ADVENTURE_NPC2>(4);
                                                SetAnimation<actor ACTOR_ADVENTURE_NPC3>(4);
                                                SetPositionOffset<actor ACTOR_PLAYER_APPOINT>(432, 0);
                                                SetPositionOffset<actor ACTOR_ADVENTURE_NPC1>(432, 0);
                                                SetPositionOffset<actor ACTOR_ADVENTURE_NPC2>(432, 0);
                                                SetPositionOffset<actor ACTOR_ADVENTURE_NPC3>(432, 0);
                                                Wait(45);
                                                screen_FadeIn(1, 15);
                                                Wait(45);
                                                se_Play(8966);
                                                message_Mail({
                                                    english="""
                                                        [CN]The stone marker disappeared, and
