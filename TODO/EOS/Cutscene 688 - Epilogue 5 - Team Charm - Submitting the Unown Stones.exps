                                        break;
                                    default:
                                        jump @label_4;
                                }
                                break;
                            default:
                                jump @label_4;
                        }
                        break;
                    default:
                        jump @label_4;
                }
            } else {
                message_Mail({
                    english="[M:D2][CS:C]Debug: Unown Rock[CR]",
                });
                switch ( message_SwitchMenu(0, 1) ) {
                    case menu({
                        english="In possession.",
                    }):
                        jump @label_3;
                    case menu({
                        english="Not in possession.",
                    }):
                        jump @label_4;
                    case menu({
                        english="Check",
                    }):
                    default:
