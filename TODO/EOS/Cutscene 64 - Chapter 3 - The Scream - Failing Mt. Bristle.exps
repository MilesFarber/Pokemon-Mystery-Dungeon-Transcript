
def 0 {
    sound_Stop();
    back_SetGround(LEVEL_S04P01A);
    screen_FadeIn(1, 0);
    message_SetFace(ACTOR_ATTENDANT1, FACE_PAIN, FACE_POS_STANDARD);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" Hmm. That didn't end well...",
            }
        case 2:
            {
                english=" Ugh. That didn't go well.",
            }
        default:
            {
                english=" Hmm. That didn't end well...",
            }
    }
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     Hmmm... This is pretty hard.
                    Let's break for today.
                """,
            }
        case 2:
            {
                english="""
                     Hmmm... This won't be easy...
                    Let's break for today.
                """,
            }
        default:
            {
                english="""
                     Hmmm... This is really tough...
                    Let's call it off for today.
                """,
            }
    }
    message_KeyWait();
    screen_FadeOutAll(1, 60);
    message_CloseEnforce();
    Wait(60);
    CallCommon(CORO_FADE_OUT_ALL_AFTER);
    end;
}
