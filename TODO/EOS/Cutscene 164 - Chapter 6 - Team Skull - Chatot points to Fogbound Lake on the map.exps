
def 0 {
    bgm_PlayFadeIn(BGM_WIGGLYTUFFS_GUILD_REMIX, 0, 256);
    worldmap_SetMode(4);
    worldmap_SetLevel(1);
    back2_SetMode(3);
    WaitSubScreen();
    worldmap_SetCamera(15);
    worldmap_SetMark(184);
    Wait(30);
    message_SetFace(ACTOR_NPC_PERAPPU, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english="""
             First off... This is where
            [CS:P]Fogbound Lake[CR] is said to be.
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    worldmap_SetArrow(15);
    message_Talk({
        english="""
             As an uncharted territory, the
            area is shown under a cloud cover.
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    worldmap_DeleteArrow();
    worldmap_MoveCamera(184);
    WaitSubScreen();
    message_Talk({
        english=" Our guild is here.",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    worldmap_SetArrow(184);
    Wait(15);
    message_Talk({
        english="""
             As you can see, the lake is at a
            considerable distance from the guild.
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    worldmap_DeleteArrow();
    worldmap_MoveCamera(13);
    WaitSubScreen();
    worldmap_SetArrow(13);
    message_Talk({
        english="""
             Therefore, we will encamp
            at the foot of the highlands here. That will
            serve as our base camp.
        """,
    });
    message_Talk({
        english="""
             If we were to travel all at once
            in a single group to the base camp, our
            mobility would be restricted.
        """,
    });
    message_Talk({
        english="""
             The strategy is to split up into
            several groups to travel to the base camp. ♪
        """,
    });
    message_Close();
    se_Play(6667);
    screen2_FadeOut(1, 15);
    back2_SetMode(0);
    end;
}
