    Turn2Direction<actor ACTOR_NPC_CHAAREMU>(4, 10, DIR_UPLEFT);
    WaitExecuteLives(ACTOR_NPC_CHAAREMU);
    Wait(15);
    message_SetFace(ACTOR_NPC_CHAAREMU, FACE_NORMAL, FACE_POS_TOP_R_FACEINW);
    message_Talk({
        english=" Bye-bye!",
    });
    message_Close();
    Turn2Direction<actor ACTOR_NPC_PUKURIN>(4, 10, DIR_RIGHT);
    WaitExecuteLives(ACTOR_NPC_PUKURIN);
    MovePositionOffset<actor ACTOR_NPC_CHAAREMU>(1.5, 88, 0);
    Wait(30);
    SetAnimation<actor ACTOR_NPC_PUKURIN>(46);
    message_SetFace(ACTOR_NPC_PUKURIN, FACE_SIGH, FACE_POS_TOP_C_FACER);
    message_Talk({
        english="""
             Thanks again, so much! ♪[K]
            Friendly friends!
        """,
    });
    message_Close();
    bgm_FadeOut(120);
    screen_FadeOut(1, 60);
    Wait(90);
    $SCENARIO_MAIN_BIT_FLAG[8] = 1;
    $COMPULSORY_SAVE_POINT_SIDE = 5;
    CallCommon(CORO_HANYOU_SAVE_FUNC);
    end;
}
