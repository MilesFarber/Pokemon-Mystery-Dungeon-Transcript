    Wait(15);
    Unlock(7);
    Wait(15);
    Lock(3);
    Wait(15);
    Turn2DirectionLives<actor ACTOR_ATTENDANT1>(4, 10, ACTOR_PLAYER);
    Turn2DirectionLives<actor ACTOR_PLAYER>(4, 10, ACTOR_ATTENDANT1);
    Turn2Direction<actor ACTOR_NPC_JUPUTORU>(4, 10, DIR_DOWN);
    Wait(15);
    SetEffect<actor ACTOR_ATTENDANT1>(EFFECT_SWEAT_DROPS_FROM_BOTH_SIDES_MEDIUM, 3);
    WaitEffect<actor ACTOR_ATTENDANT1>();
    message_SetFace(ACTOR_ATTENDANT1, FACE_PAIN, FACE_POS_STANDARD);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     Hmmm... Maybe we got a little
                    too careless.
                """,
            }
        case 2:
            {
                english="""
                     Hmmm... I think we got a little
                    too careless.
                """,
            }
        default:
            {
                english="""
                     Hmmm... I think we were a bit
                    too careless.
                """,
            }
    }
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    ExecuteCommon<actor ACTOR_ATTENDANT1>(CORO_LOOK_AROUND_DOWN_FUNC_SERIES, 0);
    WaitExecuteLives(ACTOR_ATTENDANT1);
    message_SetFace(ACTOR_ATTENDANT1, FACE_NORMAL, FACE_POS_BOTTOM_L_FACEOUTW);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     I guess the [CS:N]Sableye[CR] aren't here
