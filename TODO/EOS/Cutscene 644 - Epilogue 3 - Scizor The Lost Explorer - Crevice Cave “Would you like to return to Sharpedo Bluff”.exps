
def 0 {
    bgm_PlayFadeIn(BGM_IN_THE_DEPTHS_OF_THE_PIT, 0, 256);
    message_Mail({
        english="""
            [CN]Would you like to return
            [CN]to Sharpedo Bluff?
        """,
    });
    switch ( message_SwitchMenu(0, 1) ) {
        case menu({
            english="Yes",
        }):
        default:
            @label_0;
            message_Close();
            bgm_FadeOut(60);
            screen_FadeOut(1, 30);
            WaitBgm(BGM_IN_THE_DEPTHS_OF_THE_PIT);
            supervision_ExecuteCommon(CORO_EVENT_HA_SAME);
            end;
        case menu({
            english="No",
        }):
            message_Close();
            end;
    }
}
