
def 0 {
    sound_Stop();
    back_SetGround(LEVEL_G01P04A);
    supervision_Acting(0);
    Wait(1);
    supervision_StationCommon(99);
    supervision_StationCommon(0);
    camera_SetMyself<performer 0>();
    SetAnimation<actor ACTOR_NPC_GUREGGURU>(2);
    SetDirection<actor ACTOR_NPC_GUREGGURU>(DIR_UP);
    WaitExecuteLives(ACTOR_NPC_GUREGGURU);
    screen_FadeIn(1, 30);
    bgm_PlayFadeIn(BGM_WIGGLYTUFFS_GUILD_REMIX, 0, 256);
    Wait(30);
    message_SetFace(ACTOR_ATTENDANT1, FACE_WORRIED, FACE_POS_BOTTOM_R_FACEINW);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     OK, so we climb down this hole.
                    What next?
                """,
            }
        case 2:
            {
                english="""
                     OK, you want us to climb down
                    this hole. And then?
                """,
            }
        default:
            {
                english="""
                     OK, so we should climb down
                    this hole. And then what?
                """,
            }
    }
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2Direction<actor ACTOR_PLAYER>(4, 10, DIR_LEFT);
    Turn2Direction<actor ACTOR_ATTENDANT1>(4, 10, DIR_UPLEFT);
    WaitExecuteLives(ACTOR_ATTENDANT1);
    message_SetFace(ACTOR_NPC_DOGOOMU, FACE_NORMAL, FACE_POS_TOP_L_CENTER);
    message_FacePositionOffset(-3, 0);
    message_Talk({
        english="""
             The tunnel down there leads to
            the sentry post.
        """,
    });
    message_Close();
    screen_FadeOut(1, 15);
    end;
}
