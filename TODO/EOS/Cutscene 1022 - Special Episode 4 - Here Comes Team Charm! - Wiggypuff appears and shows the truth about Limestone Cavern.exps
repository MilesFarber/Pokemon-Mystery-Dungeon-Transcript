    Turn2Direction<actor ACTOR_PLAYER_CHARMS>(1, 10, DIR_LEFT);
    WaitExecuteLives(ACTOR_NPC_MANYUURA);
    Turn2Direction<actor ACTOR_NPC_MANYUURA>(1, 10, DIR_RIGHT);
    WaitExecuteLives(ACTOR_NPC_AABOKKU);
    Turn2Direction<actor ACTOR_NPC_AABOKKU>(1, 10, DIR_UPRIGHT);
    WaitExecuteLives(ACTOR_NPC_DORAPION);
    Turn2Direction<actor ACTOR_NPC_DORAPION>(1, 10, DIR_UPLEFT);
    WaitExecutePerformer(0);
    se_FadeOut(10255, 30);
    Wait(30);
    SetOutputAttribute<object OBJECT_D56P41A1_437>(4);
    SetAnimation<object OBJECT_D56P41A1_437>(20);
    Wait(20);
    se_Play(10256);
    Wait(130);
    screen_WhiteOut(1, 30);
    Wait(45);
    supervision_RemoveActing(1);
    supervision_Acting(3);
    screen_FadeIn(1, 30);
    se_Play(8968);
    SetEffect<actor ACTOR_NPC_AABOKKU>(EFFECT_SHOCKED, 3);
    SlidePositionOffset<actor ACTOR_NPC_AABOKKU>(1, -4, 4);
    Wait(3);
    SetEffect<actor ACTOR_NPC_SAANAITO>(EFFECT_SHOCKED, 3);
    SlidePositionOffset<actor ACTOR_NPC_SAANAITO>(1, 4, -4);
    Wait(2);
    SetEffect<actor ACTOR_NPC_MANYUURA>(EFFECT_EXCLAMATION_MARK, 3);
    SlidePositionOffset<actor ACTOR_NPC_MANYUURA>(1, -4, 0);
    Wait(2);
    SetEffect<actor ACTOR_NPC_CHAAREMU>(EFFECT_SHOCKED_MIRRORED, 3);
    SlidePositionOffset<actor ACTOR_NPC_CHAAREMU>(1, -4, -4);
    ExecuteCommon<actor ACTOR_NPC_CHAAREMU>(CORO_JUMP_SURPRISE_FUNC_SERIES, 0);
    WaitExecuteLives(ACTOR_NPC_CHAAREMU);
    SetEffect<actor ACTOR_PLAYER_CHARMS>(EFFECT_EXCLAMATION_MARK, 3);
    SlidePositionOffset<actor ACTOR_PLAYER_CHARMS>(1, 4, 0);
    Wait(3);
    SetEffect<actor ACTOR_NPC_DORAPION>(EFFECT_SHOCKED, 3);
    SlidePositionOffset<actor ACTOR_NPC_DORAPION>(1, 4, 4);
    WaitExecuteLives(ACTOR_NPC_DORAPION);
    message_SetFace(ACTOR_NPC_DORAPION, FACE_SURPRISED, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english=" What the...?!",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_CHAAREMU, FACE_SURPRISED, FACE_POS_TOP_L_FACEINW);
    message_Talk({
        english=" Is that...[K]a Pokémon?!",
    });
    message_Close();
    message_SetFaceOnly(ACTOR_NPC_METAMON, FACE_SAD, FACE_POS_TOP_C_FACEL);
    message_Talk({
        english=" .........",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_PUKURIN, FACE_NORMAL, FACE_POS_BOTTOM_R_CENTER);
    message_Talk({
        english="""
             His name is [CS:N]Ditto[CR]...[K] He's a
            Pokémon who can use the move [CS:M]Transform[CR]...
        """,
    });
    message_Close();
    se_Play(8967);
    SetEffect<actor ACTOR_NPC_SAANAITO>(EFFECT_EXCLAMATION_MARK, 3);
    WaitEffect<actor ACTOR_NPC_SAANAITO>();
    WaitExecuteLives(ACTOR_NPC_SAANAITO);
    bgm_PlayFadeIn(BGM_ILLUSION_STONE_CHAMBER, 0, 256);
    message_SetFace(ACTOR_NPC_SAANAITO, FACE_SURPRISED, FACE_POS_TOP_R_FACEINW);
    message_Talk({
        english=" [CS:M]T[CR]-[CS:M]Transform[CR]?!",
    });
    message_Talk({
        english="""
             So, you used [CS:M]Transform[CR] to
            turn into a treasure chest?
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2DirectionLives<actor ACTOR_NPC_METAMON>(4, 10, ACTOR_NPC_SAANAITO);
    WaitExecuteLives(ACTOR_NPC_METAMON);
    message_SetFace(ACTOR_NPC_METAMON, FACE_SAD, FACE_POS_TOP_C_FACER);
    message_Talk({
        english=" ...Treasure chest...[K] Yes...",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_PUKURIN, FACE_NORMAL, FACE_POS_BOTTOM_R_CENTER);
    message_Talk({
        english="""
             When my food was stolen in
            [CS:P]Southern Jungle[CR]...
        """,
    });
    Wait(3);
    Turn2DirectionLives<actor ACTOR_NPC_METAMON>(4, 10, ACTOR_NPC_PUKURIN);
    WaitExecuteLives(ACTOR_NPC_METAMON);
    message_Talk({
        english=" That was you, wasn't it?",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_METAMON, FACE_SAD, FACE_POS_TOP_C_FACEL);
    message_Talk({
        english="""
             ...Wasn't it...? Yeah...[K]
            That's right...
        """,
    });
    message_Talk({
        english=" I did that...[K] I'm really sorry...",
    });
    message_Talk({
        english=" And...",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2DirectionLives<actor ACTOR_NPC_METAMON>(4, 10, ACTOR_NPC_CHAAREMU);
    WaitExecuteLives(ACTOR_NPC_METAMON);
    Wait(30);
    Turn2DirectionLives<actor ACTOR_NPC_METAMON>(4, 10, ACTOR_NPC_SAANAITO);
    WaitExecuteLives(ACTOR_NPC_METAMON);
    Wait(30);
    Turn2DirectionLives<actor ACTOR_NPC_METAMON>(4, 10, ACTOR_PLAYER_CHARMS);
    WaitExecuteLives(ACTOR_NPC_METAMON);
    Wait(30);
    message_SetFace(ACTOR_NPC_METAMON, FACE_SAD, FACE_POS_TOP_C_FACER);
    message_Talk({
        english=" Team [CS:X]Charm[CR]...",
    });
    message_Close();
    se_Play(8964);
    SetEffect<actor ACTOR_NPC_SAANAITO>(EFFECT_TWO_ARROWS_AT_SIDE_LEFT, 3);
    Wait(4);
    SetEffect<actor ACTOR_NPC_CHAAREMU>(EFFECT_TWO_ARROWS_AT_SIDE_RIGHT, 3);
    Wait(4);
    SetEffect<actor ACTOR_PLAYER_CHARMS>(EFFECT_TWO_ARROWS_AT_SIDE_LEFT, 3);
    WaitEffect<actor ACTOR_PLAYER_CHARMS>();
    WaitExecuteLives(ACTOR_PLAYER_CHARMS);
    message_SetFace(ACTOR_NPC_METAMON, FACE_SAD, FACE_POS_TOP_C_FACER);
    message_Talk({
        english="""
             I deceived you many times,
            Team [CS:X]Charm[CR]...[K] I'm sorry.
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_PLAYER_CHARMS, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
    message_Talk({
        english=" Huh?[K] Deceived?",
    });
    message_SetFace(ACTOR_PLAYER_CHARMS, FACE_WORRIED, FACE_POS_TOP_R_CENTER);
    message_Talk({
        english=" Deceived...",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_METAMON, FACE_SAD, FACE_POS_TOP_C_FACER);
    message_Talk({
        english="""
             ...Deceived... As you saw...[K]
            I have the power to use the move
            [CS:M]Transform[CR]...
        """,
    });
    message_Talk({
        english="""
             I was a treasure chest earlier,
            but that's not all...
        """,
    });
    message_Talk({
        english="""
             I can also...[K][CS:M]Transform[CR]
            into Pokémon...
        """,
    });
    message_Close();
    se_Play(8973);
    SetEffect<actor ACTOR_PLAYER_CHARMS>(EFFECT_SHOCKED, 3);
    WaitEffect<actor ACTOR_PLAYER_CHARMS>();
    WaitExecuteLives(ACTOR_PLAYER_CHARMS);
    message_SetFace(ACTOR_PLAYER_CHARMS, FACE_SURPRISED, FACE_POS_TOP_R_CENTER);
    message_Talk({
        english=" ...![K] I-is that true?!",
    });
    message_Talk({
        english=" Don't tell me. Back then?!",
    });
    message_Close();
    screen_WhiteOut(1, 30);
    Wait(30);
    end;
}
