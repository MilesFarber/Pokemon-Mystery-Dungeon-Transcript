
def 0 {
    sound_Stop();
    if ( not debug ) {
        @label_0;
        $SCENARIO_SIDE = scn[43, 1];
        message_Narration(30, {
            english="[CN]One night at the guild...",
        });
        message_Close();
        back2_SetMode(4);
        back2_SetGround(LEVEL_V02P06A);
        back_SetGround(LEVEL_G01P01C);
        supervision_StationCommon(0);
        supervision_Acting(0);
        camera2_SetPositionMark(Position<'m0', 19.5, 16.5>);
        camera_SetMyself<performer 0>();
        bgm_PlayFadeIn(BGM_FIRE_CRACKLING_LOUDER, 120, 256);
        screen2_FadeIn(0, 60);
        screen_FadeIn(1, 60);
        Wait(150);
        bgm_FadeOut(120);
        screen2_FadeOut(0, 60);
        screen_FadeOut(1, 60);
        back2_SetMode(0);
        end;
    } else {
        message_Notice({
            english="[M:D2][CS:C]Start from where?[CR]",
        });
        switch ( message_SwitchMenu(0, 1) ) {
            case menu({
                english="[M:D2]Beginning",
            }):
            default:
                message_Close();
                jump @label_0;
            case menu({
                english="[M:D2]SectionA",
            }):
                message_Close();
                $SCENARIO_SIDE = scn[43, 1];
                main_EnterGround(LEVEL_P01P01A, 30);
                hold;
            case menu({
                english="[M:D2]SectionB",
            }):
                message_Close();
                $SCENARIO_SIDE = scn[43, 2];
                main_EnterGround(LEVEL_P01P01A, 30);
                hold;
            case menu({
                english="[M:D2]SectionC",
            }):
                message_Close();
                $SCENARIO_SIDE = scn[43, 4];
                main_EnterGround(LEVEL_P01P01A, 30);
                hold;
            case menu({
                english="[M:D2]SectionD",
            }):
                message_Close();
                $SCENARIO_SIDE = scn[43, 6];
                main_EnterGround(LEVEL_P01P01A, 30);
                hold;
            case menu({
                english="[M:D2]SpringCaveMidpoint",
            }):
                message_Close();
                $SCENARIO_SIDE = scn[43, 7];
                main_EnterGround(LEVEL_D57P21A, 30);
                hold;
            case menu({
                english="[M:D2]SpringCaveDepths2ndTry",
            }):
                message_Close();
                $SCENARIO_SIDE = scn[43, 8];
                main_EnterGround(LEVEL_D57P21A, 30);
                hold;
            case menu({
                english="[M:D2]SectionF",
            }):
                message_Close();
                $SCENARIO_SIDE = scn[43, 9];
                main_EnterGround(LEVEL_P01P01A, 30);
                hold;
            case menu({
                english="[M:D2]TALK-N04-01",
            }):
                $SCENARIO_SIDE = scn[43, 1];
                @label_11;
                message_Close();
                main_EnterGround(LEVEL_P01P01A, 30);
                hold;
            case menu({
                english="[M:D2]TALK-N04-02",
            }):
                $SCENARIO_SIDE = scn[43, 2];
                jump @label_11;
        }
    }
}
