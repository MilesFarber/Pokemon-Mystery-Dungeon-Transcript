        case menu({
            english=" This is for the best...",
        }):
            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
            message_SwitchTalk ($PARTNER_TALK_KIND) {
                case 1:
                    {
                        english=" Yup...[K] You're right...",
                    }
                case 2:
                    {
                        english=" Yes...[K] You're right...",
                    }
                default:
                    {
                        english=" Yes...[K] You're right...",
                    }
            }
