
def 0 {
    SetAnimation<actor ACTOR_NPC_SAANAITO>(2);
    SetAnimation<actor ACTOR_NPC_CHAAREMU>(2);
    SetAnimation<actor ACTOR_PLAYER_CHARMS>(2);
    Turn2Direction<actor ACTOR_NPC_SAANAITO>(4, 10, DIR_UPRIGHT);
    Turn2Direction<actor ACTOR_NPC_CHAAREMU>(4, 10, DIR_UPRIGHT);
    Turn2Direction<actor ACTOR_PLAYER_CHARMS>(4, 10, DIR_UPRIGHT);
    WaitExecuteLives(ACTOR_PLAYER_CHARMS);
    message_ResetActor();
    message_Mail({
        english="[CN]Enter the entrance on the right?",
    });
    switch ( message_SwitchMenu(0, 1) ) {
        case menu({
            english="Yes",
        }):
        default:
            @label_0;
            message_Close();
            if ( scn($SCENARIO_SIDE) >= [45, 8] ) {
                @label_2;
                bgm_FadeOut(60);
                main_EnterDungeon(153, 30);
                switch ( message_Menu(MENU_DUNGEON_INITIALIZE_TEAM) ) { }
                main_EnterDungeon(-1, 30);
                hold;
            } else {
                $SCENARIO_SIDE = scn[45, 8];
                jump @label_2;
            }
            break;
        case menu({
            english="No",
        }):
            message_Close();
            end;
    }
}
