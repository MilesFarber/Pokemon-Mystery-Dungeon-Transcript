
def 0 {
    bgm_PlayFadeIn(BGM_TIME_RESTORED, 0, 256);
    back_SetGround(LEVEL_P04P01C);
    supervision_StationCommon(0);
    supervision_Acting(0);
    camera_SetMyself<performer 0>();
    screen_FadeIn(1, 60);
    Wait(30);
    message_SetFace(ACTOR_NPC_CHIRIIN, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english=" Oh, my! So shimmering!",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_BIPPA, FACE_SIGH, FACE_POS_STANDARD);
    message_Talk({
        english=" Yup yup! Some kind of pretty!",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_YUKUSHII, FACE_NORMAL, FACE_POS_TOP_L_CENTER);
    message_Talk({
        english="""
             Yes, the lake geyser erupts
            every now and then.
        """,
    });
    message_Talk({
        english="""
             It sends up water, just like a
            fountain...
        """,
    });
    message_Talk({
        english="""
             And the Time Gear sends up
            illumination from below...
        """,
    });
    message_Talk({
        english="""
             While many [CS:N]Illumise[CR] and [CS:N]Volbeat[CR]
            glow upon the fountain of water...
        """,
    });
    message_Talk({
        english="""
             In harmony, they are the very
            vision of beauty!
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_PUKURIN, FACE_NORMAL, FACE_POS_TOP_R_FACEINW);
    message_Talk({
        english=" The treasure!",
    });
    message_Talk({
        english="""
             The treasure...[K]must be the view
            of [CS:P]Fogbound Lake[CR]!
        """,
    });
    message_Close();
    screen_FadeOut(1, 60);
    end;
}
