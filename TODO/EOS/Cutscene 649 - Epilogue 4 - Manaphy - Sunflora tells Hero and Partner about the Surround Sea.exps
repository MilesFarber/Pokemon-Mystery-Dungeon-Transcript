
def 0 {
    bgm_PlayFadeIn(BGM_WIGGLYTUFFS_GUILD, 0, 256);
    $SCENARIO_MAIN = scn[29, 41];
    SetAnimation<actor ACTOR_ATTENDANT1>(2);
    WaitExecuteLives(ACTOR_ATTENDANT1);
    message_SetFace(ACTOR_NPC_KIMAWARI, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english="""
             Have you two heard about the
            [CS:P]Surrounded Sea[CR]?
        """,
    });
    message_Talk({
        english="""
             The [CS:P]Surrounded Sea[CR] is a sea
            far in the south.
        """,
    });
    message_Talk({
        english="""
             It's an uncharted part of the
            ocean. And can you imagine? It's been encased
            in ice over tens of thousands of years.
        """,
    });
    message_Talk({
        english="""
             But word is spreading about a
            recent discovery there! They say that there's
            now a break in the ice!
        """,
    });
    message_Talk({
        english="""
             That gap opened a way for
            explorers to go into that enclosed sea!
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    SetEffect<actor ACTOR_NPC_KIMAWARI>(EFFECT_JOYOUS, 3);
    se_Play(8975);
    ExecuteCommon<actor ACTOR_NPC_KIMAWARI>(CORO_JUMP_ANGRY_FUNC_SERIES, 0);
    WaitExecuteLives(ACTOR_NPC_KIMAWARI);
    message_Talk({
        english="""
             Oh my gosh! Can you imagine it?
            A world that no one has seen for tens of
            thousands of years!
        """,
    });
    message_Talk({
        english="""
             This is the stuff of sweeping
            epics! So dreamy and adventurous!
        """,
    });
    message_KeyWait();
    SetEffect<actor ACTOR_NPC_KIMAWARI>(EFFECT_NONE, 3);
    message_Talk({
        english="""
             Oh, but that's not all! No, no, no!
            Apparently, the world's ocean currents all
            course through the [CS:P]Surrounded Sea[CR].
        """,
    });
    message_Talk({
        english="""
             I've heard rumors that many
            rare treasures are carried there by
            the currents!
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    SetEffect<actor ACTOR_NPC_KIMAWARI>(EFFECT_JOYOUS, 3);
    se_Play(8975);
    ExecuteCommon<actor ACTOR_NPC_KIMAWARI>(CORO_JUMP_ANGRY_FUNC_SERIES, 0);
    WaitExecuteLives(ACTOR_NPC_KIMAWARI);
    message_Talk({
        english="""
             Oh my gosh! Just thinking that
            is enough to make me feel faint!
        """,
    });
    message_KeyWait();
    SetEffect<actor ACTOR_NPC_KIMAWARI>(EFFECT_NONE, 3);
    message_Talk({
        english="""
             The [CS:P]Surrounded Sea[CR]'s entrance
            is supposedly east of [CS:P]Blizzard Island[CR].
        """,
    });
    message_Talk({
        english="""
             You should go for a look
            yourselves!
        """,
    });
    message_Close();
    screen_FadeOut(1, 30);
    worldmap_SetMode(4);
    worldmap_SetLevel(8);
    back2_SetMode(3);
    WaitSubScreen();
    worldmap_SetCamera(51);
    worldmap_SetArrow(51);
    worldmap_BlinkMark(51);
    Wait(30);
    me_Play(6);
    message_Mail({
        english="""
            [CN]You can now go to
            [CN]the [CS:P]Surrounded Sea[CR]!
        """,
    });
    WaitMe(6);
    message_Close();
    screen2_FadeOut(1, 15);
    back2_SetMode(0);
    dungeon_mode(50) = DMODE_OPEN;
    screen_FadeIn(1, 30);
    end;
}
