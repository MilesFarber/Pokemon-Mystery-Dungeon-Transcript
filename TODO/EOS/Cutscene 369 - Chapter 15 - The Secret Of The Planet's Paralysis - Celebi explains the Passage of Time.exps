
def 0 {
    sound_Stop();
    $SCENARIO_MAIN = scn[20, 3];
    message_SetFace(ACTOR_ATTENDANT1, FACE_NORMAL, FACE_POS_STANDARD);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" Hey, [CS:N]Grovyle[CR].",
            }
        case 2:
            {
                english=" Hey, [CS:N]Grovyle[CR].",
            }
        default:
            {
                english=" Say, [CS:N]Grovyle[CR].",
            }
    }
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" So what's the Passage of Time?",
            }
        case 2:
            {
                english=" So what's the Passage of Time?",
            }
        default:
            {
                english=" So what's the Passage of Time?",
            }
    }
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_JUPUTORU, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english="""
             The Passage of Time is a portal
            that [CS:N]Celebi[CR] uses to travel through time.
        """,
    });
    message_Talk({
        english="""
             It's a secret corridor that
            spans dimensions.
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_SEREBII, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english="""
             For short trips, I can travel
            through time all by myself.
        """,
    });
    message_Talk({
        english="""
             But for big trips that span many
            generations, I must use the Passage of Time.
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_ATTENDANT1, FACE_NORMAL, FACE_POS_STANDARD);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     Oh! So if we go through that
                    Passage of Time...
                """,
            }
        case 2:
            {
                english="""
                     Oh! So if we were to go
                    through that Passage of Time...
                """,
            }
        default:
            {
                english="""
                     Oh! So if we were to go
                    through that Passage of Time...
                """,
            }
    }
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_JUPUTORU, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english="""
             Yes. You will be able to return
            to your time.
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_SEREBII, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english=" Oh! I see it!",
    });
    message_Close();
    back_SetGround(LEVEL_D23P11A);
    supervision_StationCommon(0);
    supervision_LoadStation(LEVEL_D23P11A, 'UM19');
    supervision_Station(3);
    supervision_Acting(0);
    Wait(1);
    camera_SetMyself<performer 0>();
    SetPositionInitial<actor ACTOR_NPC_JUPUTORU>();
    SetPositionInitial<actor ACTOR_NPC_SEREBII>();
    SetAnimation<actor ACTOR_NPC_SEREBII>(2);
    SetAnimation<actor ACTOR_NPC_JUPUTORU>(2);
    screen_FadeIn(1, 30);
    bgm_PlayFadeIn(BGM_DEEP_DUSK_FOREST, 0, 256);
    Wait(30);
    MovePositionMark<actor ACTOR_NPC_SEREBII>(1, Position<'m0', 34.5, 38.5>);
    Wait(15);
    MovePositionMark<actor ACTOR_NPC_JUPUTORU>(1, Position<'m1', 34.5, 43.5>);
    Wait(10);
    MovePositionMark<actor ACTOR_ATTENDANT1>(1, Position<'m2', 32, 46.5>);
    Wait(5);
    MovePositionMark<actor ACTOR_PLAYER>(1, Position<'m3', 37, 46.5>);
    Turn2Direction<actor ACTOR_NPC_SEREBII>(4, 10, DIR_DOWN);
    WaitExecuteLives(ACTOR_PLAYER);
    Wait(30);
    Turn2Direction<actor ACTOR_NPC_SEREBII>(4, 2, DIR_UP);
    WaitExecuteLives(ACTOR_NPC_SEREBII);
    message_SetFace(ACTOR_NPC_SEREBII, FACE_NORMAL, FACE_POS_TOP_L_CENTER);
    message_Talk({
        english="""
             There's the entrance that leads
            up to the plateau.
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2Direction<actor ACTOR_NPC_SEREBII>(4, 10, DIR_DOWN);
    WaitExecuteLives(ACTOR_NPC_SEREBII);
    message_Talk({
        english="""
             The Passage of Time is way
            up there.
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_JUPUTORU, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english="""
             Good.[K] We'll leave as soon as
            we're ready.
        """,
    });
    message_Close();
    MovePositionMark<actor ACTOR_NPC_JUPUTORU>(1, Position<'m4', 28.5, 40.5>);
    WaitExecuteLives(ACTOR_NPC_JUPUTORU);
    Turn2Direction<actor ACTOR_NPC_JUPUTORU>(4, 10, DIR_UPLEFT);
    WaitExecuteLives(ACTOR_NPC_JUPUTORU);
    Wait(30);
    end;
}
