    }
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    SetAnimation<actor ACTOR_PLAYER>(71);
    WaitAnimation<actor ACTOR_PLAYER>();
    WaitExecuteLives(ACTOR_PLAYER);
    SetAnimation<actor ACTOR_PLAYER>(2);
    Wait(30);
    screen_FadeOut(1, 60);
    camera_SetDefault();
    SetPositionMark<actor ACTOR_PLAYER>(Position<'m3', 45, 33.5>);
    SetPositionMark<actor ACTOR_ATTENDANT1>(Position<'m4', 41.5, 33.5>);
    SetDirection<actor ACTOR_PLAYER>(DIR_DOWN);
    SetDirection<actor ACTOR_ATTENDANT1>(DIR_DOWN);
    Wait(30);
    supervision_RemoveActing(2);
    supervision_RemoveActing(1);
    supervision_LoadStation(LEVEL_P01P04A, 'US31');
    supervision_Station(1);
    supervision_StationCommon(10);
    supervision_StationCommon(11);
    supervision_StationCommon(12);
    supervision_StationCommon(13);
    screen_FadeIn(1, 30);
    end;
}
