    SetAnimation<actor ACTOR_NPC_RURIRI>(768);
    MovePositionMark<actor ACTOR_NPC_RURIRI>(1, Position<'m10', 52, 26.5>);
    WaitExecuteLives(ACTOR_NPC_RURIRI);
    bgm_FadeOut(10);
    se_Play(6412);
    SetAnimation<actor ACTOR_NPC_RURIRI>(22);
    WaitAnimation<actor ACTOR_NPC_RURIRI>();
    SetEffect<actor ACTOR_NPC_KAKUREON1>(EFFECT_SHOCKED_MIRRORED, 3);
    SetEffect<actor ACTOR_NPC_KAKUREON2>(EFFECT_EXCLAMATION_MARK, 3);
    SetEffect<actor ACTOR_ATTENDANT1>(EFFECT_SHOCKED_MIRRORED, 3);
    SetEffect<actor ACTOR_PLAYER>(EFFECT_EXCLAMATION_MARK, 3);
    message_SetFace(ACTOR_NPC_RURIRI, FACE_TEARY_EYED, FACE_POS_BOTTOM_RC_FACEOUTW);
    message_FacePositionOffset(2, -3);
    message_Talk({
        english=" Yowch!",
    });
    se_Play(6413);
    supervision_Acting(2);
    SlidePositionMark<object OBJECT_P03P02A1_128>(1, Position<'m11', 42, 24.5>);
    SetAnimation<object OBJECT_P03P02A1_128>(18);
    WaitAnimation<object OBJECT_P03P02A1_128>();
    Wait(30);
    Turn2Direction<actor ACTOR_ATTENDANT1>(4, 10, DIR_UPRIGHT);
    Turn2Direction<actor ACTOR_NPC_KAKUREON1>(4, 10, DIR_DOWN);
    Wait(4);
    Turn2Direction<actor ACTOR_NPC_KAKUREON2>(4, 10, DIR_DOWN);
    WaitExecuteObject(OBJECT_P03P02A1_128);
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    MovePositionOffset<actor ACTOR_PLAYER>(1, 20, 0);
    WaitExecuteLives(ACTOR_PLAYER);
    se_Play(8710);
    Destroy<object OBJECT_P03P02A1_128>();
    Wait(30);
    SetAnimation<actor ACTOR_NPC_RURIRI>(2);
    Move2PositionOffset<actor ACTOR_NPC_RURIRI>(1.5, -8, -16);
    WaitExecuteLives(ACTOR_NPC_RURIRI);
    MovePositionMark<actor ACTOR_NPC_RURIRI>(1.5, Position<'m12', 45, 24.5>);
    WaitExecuteLives(ACTOR_NPC_RURIRI);
    Wait(20);
    SetAnimation<actor ACTOR_NPC_RURIRI>(23);
    WaitAnimation<actor ACTOR_NPC_RURIRI>();
    WaitExecuteLives(ACTOR_NPC_RURIRI);
    SetAnimation<actor ACTOR_NPC_RURIRI>(2);
    message_SetFace(ACTOR_NPC_RURIRI, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english="""
             W-we're sorry to bother you.
