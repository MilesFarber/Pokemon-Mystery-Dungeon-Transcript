
def 0 {
    bgm_PlayFadeIn(BGM_TREASURE_TOWN, 0, 256);
    $SCENARIO_MAIN = scn[4, 2];
    SetAnimation<actor ACTOR_NPC_KAKUREON1>(2);
    SetAnimation<actor ACTOR_NPC_KAKUREON2>(2);
    SetAnimation<actor ACTOR_ATTENDANT1>(2);
    supervision_Acting(1);
    Wait(1);
    Move2PositionMark<actor ACTOR_NPC_MARIRU>(1, Position<'m0', 43.5, 24.5>);
    Move2PositionMark<actor ACTOR_NPC_RURIRI>(1, Position<'m1', 44.5, 26.5>);
    bgm_FadeOut(120);
    message_SetActor(ACTOR_NPC_MARIRU);
    message_Talk({
        english=" Misters [CS:N]Kecleon[CR]!",
    });
