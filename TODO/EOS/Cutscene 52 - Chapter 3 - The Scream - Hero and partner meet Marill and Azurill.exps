    Wait(20);
    Move2PositionMark<actor ACTOR_NPC_RURIRI>(1, Position<'m6', 66, 26.5>);
    WaitExecuteLives(ACTOR_NPC_MARIRU);
    WaitExecuteLives(ACTOR_NPC_RURIRI);
    Turn2Direction<actor ACTOR_NPC_KAKUREON1>(4, 10, DIR_DOWN);
    WaitExecuteLives(ACTOR_NPC_KAKUREON1);
    Turn2Direction<actor ACTOR_NPC_KAKUREON2>(4, 10, DIR_DOWNLEFT);
    WaitExecuteLives(ACTOR_NPC_KAKUREON2);
    Turn2Direction<actor ACTOR_PLAYER>(4, 10, DIR_UP);
    Wait(5);
    Turn2Direction<actor ACTOR_ATTENDANT1>(4, 10, DIR_UP);
    message_SetFace(ACTOR_NPC_KAKUREON1, FACE_NORMAL, FACE_POS_TOP_L_CENTER);
    message_Talk({
        english="""
             You see, those delightful
            children are brothers.
        """,
    });
    message_Talk({
        english="""
             Lately, their poor mother has
            fallen sick. So those youngsters come and
            do the shopping for her.
        """,
    });
    message_Talk({
        english="""
             It's quite remarkable. Though
            very young, they've stepped up and
            taken charge. ♪
        """,
    });
    message_Close();
    Move2PositionMark<actor ACTOR_NPC_MARIRU>(3, Position<'m7', 43.5, 24.5>);
    Wait(20);
    SetAnimation<actor ACTOR_NPC_RURIRI>(1024);
    Move2PositionMark<actor ACTOR_NPC_RURIRI>(3, Position<'m8', 44.5, 26.5>);
    SetEffect<actor ACTOR_NPC_KAKUREON1>(EFFECT_EXCLAMATION_MARK, 3);
    message_SetActor(ACTOR_NPC_MARIRU);
    message_Talk({
        english=" Misters [CS:N]Kecleon[CR]!",
    });
