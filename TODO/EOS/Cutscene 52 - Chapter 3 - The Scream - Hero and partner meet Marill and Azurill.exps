    Wait(5);
    Turn2Direction<actor ACTOR_NPC_KAKUREON2>(8, 10, DIR_RIGHT);
    Turn2Direction<actor ACTOR_ATTENDANT1>(4, 10, DIR_RIGHT);
    Wait(90);
    message_CloseEnforce();
    SetPositionLives<performer 0>(0);
