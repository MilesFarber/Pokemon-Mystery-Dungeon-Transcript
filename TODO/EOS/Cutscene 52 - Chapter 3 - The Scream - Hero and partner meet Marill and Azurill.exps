    Turn2Direction<actor ACTOR_NPC_KAKUREON2>(4, 10, DIR_DOWNRIGHT);
    Turn2Direction<actor ACTOR_PLAYER>(4, 10, DIR_RIGHT);
    Wait(5);
    Turn2Direction<actor ACTOR_ATTENDANT1>(4, 10, DIR_RIGHT);
    WaitExecuteLives(ACTOR_NPC_MARIRU);
    Turn2Direction<actor ACTOR_NPC_KAKUREON2>(4, 10, DIR_DOWN);
    Turn2Direction<actor ACTOR_NPC_MARIRU>(4, 10, DIR_UP);
    WaitExecuteLives(ACTOR_NPC_RURIRI);
    Turn2Direction<actor ACTOR_NPC_RURIRI>(4, 10, DIR_UP);
    WaitExecuteLives(ACTOR_NPC_RURIRI);
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    se_Play(8962);
    SetEffect<actor ACTOR_NPC_KAKUREON1>(EFFECT_QUESTION_MARK, 3);
    WaitEffect<actor ACTOR_NPC_KAKUREON1>();
    message_SetFace(ACTOR_NPC_KAKUREON1, FACE_NORMAL, FACE_POS_TOP_L_CENTER);
    message_Talk({
        english="""
             Oh? What's the hurry? What
