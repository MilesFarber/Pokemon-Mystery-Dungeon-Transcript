    Move2PositionMark<performer 0>(1, Position<'m2', 42, 24.5>);
    Move2PositionMark<actor ACTOR_PLAYER>(1, Position<'m3', 39, 24.5>);
    Move2PositionMark<actor ACTOR_ATTENDANT1>(1, Position<'m4', 39, 26.5>);
    WaitExecuteLives(ACTOR_PLAYER);
    WaitExecuteLives(ACTOR_ATTENDANT1);
    Turn2Direction<actor ACTOR_PLAYER>(4, 10, DIR_RIGHT);
    Turn2Direction<actor ACTOR_ATTENDANT1>(4, 10, DIR_RIGHT);
    Turn2Direction<actor ACTOR_NPC_KAKUREON2>(8, 10, DIR_DOWN);
    WaitExecuteLives(ACTOR_NPC_MARIRU);
    Turn2Direction<actor ACTOR_NPC_MARIRU>(4, 10, DIR_UP);
    WaitExecuteLives(ACTOR_NPC_RURIRI);
    Turn2Direction<actor ACTOR_NPC_RURIRI>(4, 10, DIR_UP);
    WaitExecuteLives(ACTOR_NPC_RURIRI);
    bgm_PlayFadeIn(BGM_HEARTWARMING, 0, 256);
    SetEffect<actor ACTOR_NPC_KAKUREON1>(EFFECT_LAUGHING, 3);
