        english=" Really?!",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    SetEffect<actor ACTOR_NPC_RURIRI>(EFFECT_LAUGHING, 3);
    message_SetFace(ACTOR_NPC_RURIRI, FACE_JOYOUS, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english="""
             Yay! Thank you, Mr. [CS:N]Kecleon[CR]
