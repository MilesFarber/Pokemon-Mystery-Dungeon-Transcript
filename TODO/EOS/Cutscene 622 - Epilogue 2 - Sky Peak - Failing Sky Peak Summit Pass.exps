
def 0 {
    sound_Stop();
    message_SetFace(ACTOR_NPC_SHEIMI, FACE_WORRIED, FACE_POS_STANDARD);
    message_Talk({
        english="""
             Oogh...
            It's hard to make progress...
        """,
    });
    message_KeyWait();
    screen_FadeOutAll(1, 60);
    message_CloseEnforce();
    CallCommon(CORO_FADE_OUT_ALL_AFTER);
    back_SetGround(LEVEL_D73P29A);
    supervision_LoadStation(LEVEL_D73P29A, 'US31');
    supervision_Station(20);
    supervision_StationCommon(0);
    supervision_StationCommon(9);
    supervision_Acting(0);
    SetPositionInitial<actor ACTOR_NPC_SHEIMI>();
    SetPositionInitial<actor ACTOR_ADVENTURE_NPC1>();
    SetPositionInitial<actor ACTOR_ADVENTURE_NPC2>();
    SetAnimation<actor ACTOR_NPC_SHEIMI>(2);
    SetAnimation<actor ACTOR_ADVENTURE_NPC1>(2);
    SetAnimation<actor ACTOR_ADVENTURE_NPC2>(2);
    camera_SetMyself<performer 0>();
    screen_FadeIn(1, 30);
    bgm_PlayFadeIn(BGM_SKY_PEAK_FINAL_PASS, 0, 256);
    Wait(30);
    if ( scn($SCENARIO_MAIN) == [29, 30] ) {
        @label_0;
        message_SetFace(ACTOR_NPC_SHEIMI, FACE_WORRIED, FACE_POS_TOP_C_FACER);
        message_Talk({
            english="""
                 Usually, [CS:N]Grimer[CR] and [CS:N]Muk[CR] should
                be living farther down the mountain, I think...
            """,
        });
        message_SetFace(ACTOR_NPC_SHEIMI, FACE_NORMAL, FACE_POS_TOP_C_FACER);
        message_Talk({
            english="""
                 We need to do something about
                the summit, no matter what!
            """,
        });
        message_Close();
        end;
    } else {
        message_SetFace(ACTOR_NPC_SHEIMI, FACE_WORRIED, FACE_POS_TOP_C_FACER);
        message_Talk({
            english="""
                 Yeah...
                Looks like it might be too difficult...
            """,
        });
        message_SetFace(ACTOR_NPC_SHEIMI, FACE_NORMAL, FACE_POS_TOP_C_FACER);
        message_Talk({
            english="""
                 But it will be amazing to reach
                the summit after such hard work!
            """,
        });
        message_Talk({
            english="""
                 We can't give up!
                Let's do our best!
            """,
        });
        message_Close();
        end;
    }
}
