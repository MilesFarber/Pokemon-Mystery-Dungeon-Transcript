
def 0 {
    sound_Stop();
    Wait(30);
    back2_SetMode(4);
    back2_SetGround(LEVEL_V02P06A);
    camera2_SetPositionMark(Position<'m0', 19.5, 15.5>);
    screen2_FadeIn(0, 60);
    Wait(150);
    screen2_FadeOut(1, 60);
    back2_SetMode(0);
    Wait(90);
    message_SetFace(ACTOR_NPC_ZUBATTO, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english="""
             We just had dinner, but I could
            go for some more food.
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_DOGAASU, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english="""
             My belly'll never get filled on
            grub like that.
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_SUKATANKU, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english="""
             All right. The guild members
            have all gone off to bed...
        """,
    });
    message_Talk({
        english=" Let's go find it now.",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_ZUBATTO, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english=" Huh? Find what?",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_SUKATANKU, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english="""
             What else? The guild's food
            stock.
        """,
    });
    message_Talk({
        english="""
             We'll find their food and give
            ourselves a proper feast.
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_DOGAASU, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english=" I like that thinking, Chief!",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_ZUBATTO, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english=" Okay, let's get to it!",
    });
    message_Close();
    Wait(90);
    end;
}
