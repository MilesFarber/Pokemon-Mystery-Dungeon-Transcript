        case 1:
            {
                english=" Th-there's trouble!",
            }
        case 2:
            {
                english=" Th-there's trouble!",
            }
        default:
            {
                english=" Th-there's trouble!",
            }
    }
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" It's [CS:N]Manaphy[CR]...[K] [CS:N]Manaphy[CR]'s gone!",
            }
        case 2:
            {
                english="""
                     It's [CS:N]Manaphy[CR]...[K] [CS:N]Manaphy[CR]
                    disappeared!
                """,
            }
        default:
            {
                english="""
                     It's [CS:N]Manaphy[CR]...[K] [CS:N]Manaphy[CR]
                    disappeared!
                """,
            }
