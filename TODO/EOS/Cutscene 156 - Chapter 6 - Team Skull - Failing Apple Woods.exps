
def 0 {
    bgm_PlayFadeIn(BGM_WIGGLYTUFFS_GUILD, 0, 256);
    supervision_Acting(0);
    Wait(1);
    SetPositionInitial<actor ACTOR_NPC_DOGAASU>();
    supervision_StationCommon(0);
    supervision_StationCommon(99);
    SetAnimation<actor ACTOR_NPC_PERAPPU>(2);
    WaitExecuteLives(ACTOR_NPC_PERAPPU);
    SetPositionMark<performer 0>(Position<'m0', 60.5, 31.5>);
    camera_SetMyself<performer 0>();
    Turn2DirectionLives<actor ACTOR_NPC_PERAPPU>(4, 10, ACTOR_PLAYER);
    WaitExecuteLives(ACTOR_NPC_PERAPPU);
    message_SetFace(ACTOR_NPC_PERAPPU, FACE_ANGRY, FACE_POS_TOP_L_CENTER);
    message_FacePositionOffset(0, -1);
    message_Talk({
        english=" You two!",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2Direction<actor ACTOR_PLAYER>(4, 10, DIR_UPLEFT);
    Turn2Direction<actor ACTOR_ATTENDANT1>(4, 10, DIR_UPLEFT);
    WaitExecuteLives(ACTOR_ATTENDANT1);
    se_Play(8971);
    ExecuteCommon<actor ACTOR_NPC_PERAPPU>(CORO_JUMP_ANGRY_FUNC_SERIES, 0);
    WaitExecuteLives(ACTOR_NPC_PERAPPU);
    message_SetFace(ACTOR_NPC_PERAPPU, FACE_ANGRY, FACE_POS_TOP_L_CENTER);
    message_FacePositionOffset(0, -1);
    message_Talk({
        english="""
             You two! I hope you will finally
            bring back some Perfect Apples today.
        """,
    });
    message_Talk({
        english="""
             Perfect Apples can be found
            deep in [CS:P]Apple Woods[CR].
        """,
    });
    message_Talk({
        english="""
             If you don't come back soon with
            some Perfect Apples, the Guildmaster will...
        """,
    });
    message_Talk({
        english=" Anyway! We're counting on you!",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    se_Play(8972);
    SetEffect<actor ACTOR_ATTENDANT1>(EFFECT_SWEAT_DROPS_FROM_BOTH_SIDES_MEDIUM, 3);
    WaitEffect<actor ACTOR_ATTENDANT1>();
    WaitExecuteLives(ACTOR_ATTENDANT1);
    message_SetFace(ACTOR_ATTENDANT1, FACE_SAD, FACE_POS_BOTTOM_R_FACEINW);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" Uh... All right.",
            }
        case 2:
            {
                english=" Uh... All right.",
            }
        default:
            {
                english=" Uh... All right.",
            }
    }
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2Direction<actor ACTOR_NPC_PERAPPU>(4, 10, DIR_DOWN);
    Turn2DirectionLives<actor ACTOR_ATTENDANT1>(4, 10, ACTOR_PLAYER);
    WaitExecuteLives(ACTOR_ATTENDANT1);
    Turn2DirectionLives<actor ACTOR_PLAYER>(4, 10, ACTOR_ATTENDANT1);
    message_SetFace(ACTOR_ATTENDANT1, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     Let's give it our best try,
                    [hero]!
                """,
            }
        case 2:
            {
                english="""
                     Let's keep doing our best,
                    [hero]!
                """,
            }
        default:
            {
                english="""
                     Let's keep doing our best,
                    [hero]!
                """,
            }
    }
    message_Close();
