    message_SetFace(ACTOR_PLAYER_PUPURIN, FACE_HAPPY, FACE_POS_TOP_L_FACEINW);
    message_Talk({
        english="""
             Good morning! ♪[K]
            [CS:N]Papa[CR]. ♪ [CS:N]Mama[CR]. ♪
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_PUKURIN_PAPA, FACE_HAPPY, FACE_POS_TOP_R_CENTER);
    message_Talk({
        english=" Yep. Good morning. ♪",
