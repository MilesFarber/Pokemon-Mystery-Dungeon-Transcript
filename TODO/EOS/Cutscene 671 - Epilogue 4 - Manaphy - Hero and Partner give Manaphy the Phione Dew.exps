                """,
            }
        case 2:
            {
                english="""
                     Here, take this, [CS:N]Manaphy[CR].[K]
                    It's a Phione Dew.
                """,
            }
        default:
            {
                english="""
                     Here, take this, [CS:N]Manaphy[CR].[K]
                    It's a Phione Dew.
                """,
            }
