
def 0 {
    bgm_PlayFadeIn(BGM_DO_YOUR_BEST_AS_ALWAYS, 0, 256);
    $SCENARIO_MAIN = scn[29, 98];
    dungeon_mode(72) = DMODE_OPEN_AND_REQUEST;
    supervision_Acting(0);
    bgm_FadeOut(60);
    message_ResetActor();
    message_Talk({
        english=" Oh! [hero]! [partner]!",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    se_Play(8964);
    SetEffect<actor ACTOR_PLAYER>(EFFECT_EXCLAMATION_MARK, 3);
    SetEffect<actor ACTOR_ATTENDANT1>(EFFECT_EXCLAMATION_MARK, 3);
    WaitEffect<actor ACTOR_ATTENDANT1>();
    WaitExecuteLives(ACTOR_ATTENDANT1);
    message_Talk({
        english=" Good morning! Are you awake?",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2Direction<actor ACTOR_ATTENDANT1>(4, 10, DIR_UP);
    WaitExecuteLives(ACTOR_ATTENDANT1);
    Turn2Direction<actor ACTOR_PLAYER>(4, 10, DIR_UP);
    message_SetFace(ACTOR_ATTENDANT1, FACE_NORMAL, FACE_POS_STANDARD);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" Hm? Who's out there?",
            }
        case 2:
            {
                english=" Hm? Who could that be?",
            }
        default:
            {
                english=" Hm? Who's our visitor?",
            }
    }
    message_Close();
    screen_FadeOut(1, 30);
    end;
}
