
def 0 {
    back_SetGround(LEVEL_V17P03A);
    supervision_Acting(0);
    camera_SetMyself<performer 0>();
    MovePositionMark<performer 0>(0.25, Position<'m0', 59, 19.5>);
    back_SetBackScrollSpeed(2, 0);
    screen_FadeIn(1, 30);
    Wait(30);
    message_SetWaitMode(180, 90);
    message_SetActor(ACTOR_NPC_YONOWAARU);
    message_Talk({
        english="""
             No winds blow...[K] The day never
