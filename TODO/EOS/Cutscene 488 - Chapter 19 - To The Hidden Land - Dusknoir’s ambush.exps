                english=" [CS:N]D-Dusknoir[CR]!",
            }
        case 2:
            {
                english=" [CS:N]D-Dusknoir[CR]!",
            }
        default:
            {
                english=" [CS:N]D-Dusknoir[CR]!",
            }
    }
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_JUPUTORU, FACE_NORMAL, FACE_POS_TOP_L_CENTER);
    message_Talk({
        english=" How did you get here?!",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_YONOWAARU, FACE_NORMAL, FACE_POS_TOP_R_FACEINW);
    message_Talk({
        english=" Humph...[K] Quite simple, actually.",
    });
    message_Talk({
        english="""
             I had Master [CS:N]Dialga[CR] warp us
            here directly.
        """,
    });
    message_Talk({
        english="""
             After all, I knew that you would
            inevitably come here.
        """,
    });
    message_Talk({
        english="""
             Waiting here spared us the
            bother of having to search for you.
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_JUPUTORU, FACE_NORMAL, FACE_POS_TOP_L_CENTER);
    message_Talk({
        english=" Urgh...",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_YONOWAARU, FACE_NORMAL, FACE_POS_TOP_R_FACEINW);
    message_Talk({
        english="""
             Hoo-hoo-ha![K] Unfortunately, you
            are coming back to the future with me.
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2Direction<actor ACTOR_NPC_YONOWAARU>(8, 10, DIR_DOWNLEFT);
    Wait(45);
    Turn2Direction<actor ACTOR_NPC_YONOWAARU>(8, 10, DIR_UPLEFT);
    Wait(45);
    Turn2Direction<actor ACTOR_NPC_YONOWAARU>(8, 10, DIR_LEFT);
    WaitExecuteLives(ACTOR_NPC_YONOWAARU);
    message_Talk({
        english="""
             [CS:N]Sableye[CR]![K] Take them to the
            dimensional hole!
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    SetAnimation<actor ACTOR_NPC_YAMIRAMI>(17);
    SetAnimation<actor ACTOR_NPC_YAMIRAMI3>(17);
    SetAnimation<actor ACTOR_NPC_YAMIRAMI5>(17);
    Wait(10);
    SetAnimation<actor ACTOR_NPC_YAMIRAMI2>(17);
    SetAnimation<actor ACTOR_NPC_YAMIRAMI4>(17);
    SetAnimation<actor ACTOR_NPC_YAMIRAMI6>(17);
    message_EmptyActor();
    message_Talk({
        english="[CS:N]Sableye[CR]: Wheh-heh-heh!",
    });
    WaitAnimation<actor ACTOR_NPC_YAMIRAMI6>();
    WaitExecuteLives(ACTOR_NPC_YAMIRAMI6);
    SetAnimation<actor ACTOR_NPC_YAMIRAMI>(17);
    SetAnimation<actor ACTOR_NPC_YAMIRAMI4>(17);
    SetAnimation<actor ACTOR_NPC_YAMIRAMI5>(17);
    SetAnimation<actor ACTOR_NPC_YAMIRAMI2>(17);
    SetAnimation<actor ACTOR_NPC_YAMIRAMI3>(17);
    SetAnimation<actor ACTOR_NPC_YAMIRAMI6>(17);
    WaitAnimation<actor ACTOR_NPC_YAMIRAMI6>();
    WaitExecuteLives(ACTOR_NPC_YAMIRAMI6);
    SetAnimation<actor ACTOR_NPC_YAMIRAMI>(2);
    SetAnimation<actor ACTOR_NPC_YAMIRAMI4>(2);
    SetAnimation<actor ACTOR_NPC_YAMIRAMI5>(2);
    SetAnimation<actor ACTOR_NPC_YAMIRAMI2>(2);
    SetAnimation<actor ACTOR_NPC_YAMIRAMI3>(2);
    SetAnimation<actor ACTOR_NPC_YAMIRAMI6>(2);
    message_Close();
    screen_FadeOut(1, 30);
    end;
}
