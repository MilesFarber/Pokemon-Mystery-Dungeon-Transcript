
def 0 {
    sound_Stop();
    back_SetGround(LEVEL_D32P33A);
    supervision_Acting(0);
    camera_SetMyself<performer 0>();
    SetAnimation<object OBJECT_D32P44A5_88>(9);
    screen_FadeIn(1, 30);
    Wait(30);
    se_Play(7950);
    SetAnimation<object OBJECT_D32P44A5_88>(17);
    WaitAnimation<object OBJECT_D32P44A5_88>();
    WaitExecuteObject(OBJECT_D32P44A5_88);
    SetAnimation<object OBJECT_D32P44A5_88>(2);
    SetOutputAttribute<object OBJECT_D32P44A5_88>(4);
    Wait(60);
    MovePositionMark<object OBJECT_D32P44A5_88>(0.2969, Position<'m0', 22.5, 32>);
    WaitExecuteObject(OBJECT_D32P44A5_88);
    Wait(30);
    se_FadeOut(7950, 90);
    message_Mail({
        english="""
            [CN]A mysterious light
            [CN]enveloped [player]!
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    WaitSe(7950);
    se_Play(7951);
    SetAnimation<object OBJECT_D32P44A5_88>(19);
    WaitAnimation<object OBJECT_D32P44A5_88>();
    WaitExecuteObject(OBJECT_D32P44A5_88);
    Destroy<object OBJECT_D32P44A5_88>();
    message_Mail({
        english="[CN]The guardian's permission was granted!",
    });
    WaitSe(7951);
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    if ( scn($SCENARIO_MAIN) < [29, 67] ) {
        @label_0;
        MovePositionMark<performer 0>(1, Position<'m1', 22.5, 20.5>);
        WaitExecutePerformer(0);
        Wait(30);
        se_Play(7187);
        camera_SetEffect(2, 2, 2.0);
        Wait(10);
        supervision_RemoveActing(0);
        supervision_Acting(1);
        camera_SetEffect(2, 2, 2.0);
        Wait(15);
        camera_SetEffect(0, 0, 0);
        Wait(30);
        MovePositionMark<performer 0>(1, Position<'m2', 76.5, 33.5>);
        WaitExecutePerformer(0);
        Wait(15);
        MovePositionMark<actor ACTOR_PLAYER_APPOINT>(1, Position<'m3', 76.5, 15.5>);
        Wait(10);
        MovePositionMark<actor ACTOR_ADVENTURE_NPC1>(1, Position<'m4', 76.5, 15.5>);
        Wait(10);
        MovePositionMark<actor ACTOR_ADVENTURE_NPC2>(1, Position<'m5', 76.5, 15.5>);
        MovePositionMark<actor ACTOR_ADVENTURE_NPC3>(1, Position<'m6', 76.5, 15.5>);
        Wait(30);
        screen_FadeOut(1, 30);
        end;
    } else {
        switch ( random(100) ) {
            case < 50:
                Wait(15);
                bgm_PlayFadeIn(BGM_IN_THE_DEPTHS_OF_THE_PIT, 0, 256);
                message_Mail({
                    english="[CN]........................",
                });
                message_Mail({
                    english="[CN]A voice echoed from somewhere...",
                });
                CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                se_Play(7175);
                SetEffect<performer 3>(EFFECT_WHITE_LIGHT_ENGULFING_OUT, 3);
                Wait(15);
                supervision_Acting(2);
                Wait(15);
                WaitExecutePerformer(3);
                SetEffect<performer 3>(EFFECT_NONE, 3);
                Wait(15);
                message_SetFace(ACTOR_NPC_REJISUCHIRU, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
                message_Talk({
                    english=" I AM [CS:N]REGISTEEL[CR]...",
                });
                message_Talk({
                    english=" I PLEDGE...SERVICE TO YOU...",
                });
                @label_4;
                CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                switch ( ProcessSpecial(PROCESS_SPECIAL_PREPARE_MENU_ACCEPT_TEAM_MEMBER, 2, 0) ) { }
                switch ( message_Menu(MENU_ACCEPT_TEAM_MEMBER) ) {
                    case 1:
                        CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                        me_Play(5);
                        message_Mail({
                            english="[CN][c_name:NPC_NEW_FRIEND] joined the team!",
                        });
                        WaitMe(5);
                        CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                        bgm_FadeOut(30);
                        se_Play(7183);
                        SetEffect<performer 3>(EFFECT_WHITE_LIGHT_ENGULFING, 3);
                        Wait(10);
                        Destroy<actor ACTOR_NPC_REJISUCHIRU>();
                        Wait(15);
                        WaitExecutePerformer(3);
                        SetEffect<performer 3>(EFFECT_NONE, 3);
                        Wait(30);
                        jump @label_0;
                    case 2:
                    default:
                        CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                        message_Mail({
                            english="""
                                [CN]Are you sure?[K]
                                [CN]You're sure you won't accept
                                [CN]this potential new member?
                            """,
                        });
                        switch ( message_SwitchMenu(0, 1) ) {
                            case menu({
                                english="Reconsider",
                            }):
                                jump @label_4;
                            case menu({
                                english="Refuse",
                            }):
                            default:
                                CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                                message_Mail({
                                    english="""
                                        [CN][player] turned down
                                        [CN][CS:N]Registeel[CR]'s offer to join.
                                    """,
                                });
                                message_Close();
                                bgm_FadeOut(30);
                                se_Play(7183);
                                SetEffect<performer 3>(EFFECT_WHITE_LIGHT_ENGULFING, 3);
                                Wait(10);
                                Destroy<actor ACTOR_NPC_REJISUCHIRU>();
                                Wait(15);
                                WaitExecutePerformer(3);
                                SetEffect<performer 3>(EFFECT_NONE, 3);
                                Wait(30);
                                jump @label_0;
                        }
                        break;
                }
                break;
            default:
                jump @label_0;
        }
    }
}
