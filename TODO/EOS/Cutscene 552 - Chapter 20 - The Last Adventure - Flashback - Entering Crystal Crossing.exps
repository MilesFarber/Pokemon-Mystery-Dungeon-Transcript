
def 0 {
    bgm_PlayFadeIn(BGM_MEMORIES_RETURNED, 0, 256);
    back_SetGround(LEVEL_D17P11A);
    supervision_StationCommon(0);
    supervision_Acting(0);
    Wait(1);
    camera_SetMyself<performer 0>();
    SetPositionMark<actor ACTOR_PLAYER>(Position<'m0', 39.5, 35.5>);
    SetPositionMark<actor ACTOR_ATTENDANT1>(Position<'m1', 35.5, 35.5>);
    SetDirection<actor ACTOR_ATTENDANT1>(DIR_RIGHT);
    SetDirection<actor ACTOR_PLAYER>(DIR_LEFT);
    screen_FlushOut(1, 0, 8, 0, 0, 0);
    screen_FadeIn(1, 30);
    Wait(30);
    message_SetFace(ACTOR_ATTENDANT1, FACE_NORMAL, FACE_POS_STANDARD);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" Let's roll, [hero]!",
            }
        case 2:
            {
                english=" Let's go, [hero]!",
            }
        default:
            {
                english=" Let's go, [hero]!",
            }
    }
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" We're off to [CS:N]Azelf[CR]'s lake!",
            }
        case 2:
            {
                english=" Onward to [CS:N]Azelf[CR]'s lake!",
            }
        default:
            {
                english=" We're off to [CS:N]Azelf[CR]'s lake!",
            }
    }
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    SetAnimation<actor ACTOR_ATTENDANT1>(71);
    SetAnimation<actor ACTOR_PLAYER>(71);
    WaitAnimation<actor ACTOR_ATTENDANT1>();
    WaitAnimation<actor ACTOR_PLAYER>();
    WaitExecuteLives(ACTOR_PLAYER);
    WaitExecuteLives(ACTOR_ATTENDANT1);
    Wait(30);
    screen_WhiteOut(1, 30);
    screen_FlushIn(1, 0, 1, 0, 0, 0);
    end;
}
