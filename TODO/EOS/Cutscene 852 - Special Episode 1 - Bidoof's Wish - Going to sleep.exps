    Wait(30);
    message_SetFace(ACTOR_PLAYER_BIPPA, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english="""
             Today I should sleep and rest up,
            and I can try again tomorrow. Yup yup.
        """,
    });
