    screen2_FadeIn(1, 60);
    Wait(150);
    screen2_FadeOut(1, 60);
    back2_SetMode(0);
    back_SetGround(LEVEL_G01P10C);
    supervision_Acting(0);
    camera_SetMyself<performer 0>();
    SetAnimation<actor ACTOR_NPC_DOGOOMU>(44);
    Wait(10);
    SetAnimation<actor ACTOR_NPC_HEIGANI>(45);
    screen_FadeChange(1, 60, 0, 192);
