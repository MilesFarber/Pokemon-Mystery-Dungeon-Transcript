    message_Talk({
        english=" All right!",
    });
    message_Close();
    MovePositionOffset<actor ACTOR_NPC_HEIGANI>(1, 0, -48);
    Wait(15);
    Move2PositionMark<actor ACTOR_NPC_KIMAWARI>(1, Position<'m14', 40, 31.5>);
    MovePositionMark<actor ACTOR_NPC_BIPPA>(1, Position<'m15', 47, 29.5>);
    MovePositionMark<actor ACTOR_NPC_DAGUTORIO>(1, Position<'m16', 43.5, 33.5>);
    MovePositionMark<actor ACTOR_NPC_DOGOOMU>(1, Position<'m17', 50, 28.5>);
    MovePositionMark<actor ACTOR_NPC_HEIGANI>(1, Position<'m18', 41.5, 28.5>);
    screen_FadeOut(1, 60);
    Wait(30);
    switch ( message_Menu(MENU_DUNGEON_TEAM_RETURNS_FROM_MAP) ) { }
    worldmap_SetMode(3);
    worldmap_SetLevel(4);
    back2_SetMode(3);
    WaitSubScreen();
    worldmap_ChangeLevel(5);
    worldmap_SetCamera(26);
    WaitSubScreen();
    message_Mail({
        english="""
            [CN]The clouds parted over
            [CN][CS:P]Crystal Crossing[CR] and the
            [CN]vicinities of the [CS:P]Forest Area[CR]!
        """,
    });
    message_Close();
    screen2_FadeOut(1, 15);
    back2_SetMode(0);
    $SCENARIO_MAIN_BIT_FLAG[8] = 1;
    $COMPULSORY_SAVE_POINT = 13;
    CallCommon(CORO_HANYOU_SAVE_FUNC);
    end;
}
