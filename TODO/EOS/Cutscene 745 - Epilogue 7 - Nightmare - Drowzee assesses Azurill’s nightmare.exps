                """,
            }
        case 2:
            {
                english="""
                     [CS:N]Marill[CR]![K] We can tackle the
                    mystery of the unending nightmare now!
                """,
            }
        default:
            {
                english="""
                     [CS:N]Marill[CR]![K] We can tackle the
                    mystery of the unending nightmare now!
                """,
            }
    }
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    ExecuteCommon<actor ACTOR_NPC_MARIRU>(CORO_JUMP_HAPPY_FUNC_SERIES, 0);
    WaitExecuteLives(ACTOR_NPC_MARIRU);
    message_SetFace(ACTOR_NPC_MARIRU, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
    message_Talk({
        english=" Great!",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_SURIIPU, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english="""
             But I want you to be extra
            careful when you're inside this kid's dream.
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2Direction<actor ACTOR_PLAYER>(4, 10, DIR_DOWNRIGHT);
    Turn2Direction<actor ACTOR_ATTENDANT1>(4, 10, DIR_DOWNRIGHT);
    Turn2Direction<actor ACTOR_NPC_MARIRU>(4, 10, DIR_DOWN);
    WaitExecuteLives(ACTOR_ATTENDANT1);
    message_Talk({
        english="""
             There's something rotten about
            this dream...[K] I have a feeling that something
            has gone bad. Or gone wrong.
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_ATTENDANT1, FACE_SAD, FACE_POS_TOP_L_CENTER);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" Urk...[K] Is that right...?",
            }
        case 2:
            {
                english=" Urk...[K] Is that right...?",
            }
        default:
            {
                english=" Urk...[K] Is that right...?",
            }
    }
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" All right. We'll be careful.",
            }
        case 2:
            {
                english=" OK. We'll be on our guard.",
            }
        default:
            {
                english=" OK. We'll be careful.",
            }
    }
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_SURIIPU, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english="""
             One more thing.[K] I want only you
            two to enter the dream.
        """,
    });
    message_Talk({
        english=" I'd prefer to go as well, but...",
    });
    message_Talk({
        english="""
             In all honesty, at my skill level,
            I think I'd slow you down too much.
        """,
    });
    message_Talk({
        english="""
             I'm sorry I couldn't do more for
            you, but...
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_ATTENDANT1, FACE_NORMAL, FACE_POS_TOP_L_CENTER);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     Don't be silly.[K] You're doing
                    plenty, sending us into the dream.
                """,
            }
        case 2:
            {
                english="""
                     No, there's no need for that![K]
                    Sending us into the dream is more than enough!
                """,
            }
        default:
            {
                english="""
                     No, you're great.[K] Just sending us
                    into the dream is plenty.
                """,
            }
    }
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     Thanks, [CS:N]Drowzee[CR].[K] We'll get
                    ready to go.
                """,
            }
        case 2:
            {
                english="""
                     Thank you, [CS:N]Drowzee[CR].[K] We'll get
                    ready to go.
                """,
            }
        default:
            {
                english="""
                     Thank you, [CS:N]Drowzee[CR].[K] We'll get
