
def 0 {
    sound_Stop();
    back_SetGround(LEVEL_G01P07A);
    supervision_LoadStation(LEVEL_G01P07A, 'US20');
    supervision_StationCommon(0);
    supervision_Station(12);
    supervision_Acting(0);
    camera_SetMyself<performer 0>();
    SetPositionInitial<actor ACTOR_NPC_SURIIPU>();
    SetPositionInitial<actor ACTOR_NPC_MARIRU>();
    SetPositionInitial<actor ACTOR_NPC_RURIRI>();
    SetAnimation<actor ACTOR_NPC_SURIIPU>(2);
    SetAnimation<actor ACTOR_NPC_MARIRU>(2);
    SetAnimation<actor ACTOR_NPC_RURIRI>(45);
    screen_FadeIn(1, 30);
    Wait(30);
    message_SetFace(ACTOR_NPC_SURIIPU, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english=" ..................",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_ATTENDANT1, FACE_SAD, FACE_POS_TOP_L_CENTER);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" How's it looking, [CS:N]Drowzee[CR]?",
            }
        case 2:
            {
                english=" How is it going, [CS:N]Drowzee[CR]?",
            }
        default:
            {
                english=" How is it going, [CS:N]Drowzee[CR]?",
            }
    }
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" Are you getting anywhere?",
            }
        case 2:
            {
                english=" Can you do something?",
            }
        default:
            {
                english=" Can you do something?",
            }
    }
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_SURIIPU, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english="""
             ...[K]Oh, you two![K] I want you
            to get stocked up for an exploration.
        """,
    });
    message_Talk({
        english="""
             When you're all ready, I'll send
            you on an exploration of...[K][CS:N]Azurill[CR]'s dream.
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    se_Play(8967);
    SetEffect<actor ACTOR_PLAYER>(EFFECT_EXCLAMATION_MARK, 3);
    Wait(5);
    SetEffect<actor ACTOR_NPC_MARIRU>(EFFECT_EXCLAMATION_MARK, 3);
    SetEffect<actor ACTOR_ATTENDANT1>(EFFECT_EXCLAMATION_MARK, 3);
    WaitEffect<actor ACTOR_ATTENDANT1>();
    WaitExecuteLives(ACTOR_ATTENDANT1);
    message_SetFace(ACTOR_ATTENDANT1, FACE_NORMAL, FACE_POS_TOP_L_CENTER);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" Huh?![K] So that means...!",
            }
        case 2:
            {
                english=" What?![K] So that means...!",
            }
        default:
            {
                english=" What?![K] So that means...!",
            }
    }
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2Direction<actor ACTOR_NPC_SURIIPU>(4, 10, DIR_UPLEFT);
    WaitExecuteLives(ACTOR_NPC_SURIIPU);
    message_SetFace(ACTOR_NPC_SURIIPU, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english="""
             You guessed it.[K] It is possible to
            get into [CS:N]Azurill[CR]'s dream.
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    ExecuteCommon<actor ACTOR_ATTENDANT1>(CORO_JUMP_ANGRY_FUNC_SERIES, 0);
    bgm_PlayFadeIn(BGM_WIGGLYTUFFS_GUILD, 0, 256);
    message_SetFace(ACTOR_ATTENDANT1, FACE_INSPIRED, FACE_POS_TOP_L_CENTER);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" Yes!",
            }
        case 2:
            {
                english=" Yes!",
            }
        default:
            {
                english=" Yes!",
            }
    }
    WaitExecuteLives(ACTOR_ATTENDANT1);
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2Direction<actor ACTOR_ATTENDANT1>(4, 10, DIR_RIGHT);
    WaitExecuteLives(ACTOR_ATTENDANT1);
    Turn2Direction<actor ACTOR_PLAYER>(4, 10, DIR_UPRIGHT);
    Turn2Direction<actor ACTOR_NPC_MARIRU>(4, 10, DIR_LEFT);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     [CS:N]Marill[CR]![K] We can tackle the
