    camera_SetMyself<performer 0>();
    screen_FadeIn(1, 30);
    Wait(30);
    ExecuteCommon<actor ACTOR_NPC_BIPPA>(CORO_LOOK_AROUND_FUNC_SERIES, 0);
    message_SetFace(ACTOR_NPC_BIPPA, FACE_NORMAL, FACE_POS_BOTTOM_L_FACEINW);
    message_Talk({
        english=" First things first!",
    });
    WaitExecuteLives(ACTOR_NPC_BIPPA);
