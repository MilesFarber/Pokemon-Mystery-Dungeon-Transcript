    WaitExecuteLives(ACTOR_NPC_BIPPA);
    Turn2Direction<actor ACTOR_ATTENDANT1>(4, 10, DIR_DOWNLEFT);
    WaitExecuteLives(ACTOR_ATTENDANT1);
    Turn2Direction<actor ACTOR_PLAYER>(4, 10, DIR_DOWNLEFT);
    WaitExecuteLives(ACTOR_PLAYER);
    MovePositionMark<performer 0>(1.5, Position<'m0', 28.5, 27.5>);
