        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    MovePositionMark<performer 0>(1.5, Position<'m4', 52.5, 27.5>);
    Turn2Direction<actor ACTOR_NPC_BIPPA>(8, 10, DIR_UPRIGHT);
    Turn2Direction<actor ACTOR_ATTENDANT1>(8, 10, DIR_RIGHT);
    Turn2Direction<actor ACTOR_PLAYER>(8, 10, DIR_RIGHT);
    WaitExecutePerformer(0);
    message_Talk({
        english="""
             And this here leads to the
            Guildmaster's Chamber.
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    MovePositionMark<performer 0>(1.5, Position<'m5', 40.5, 27.5>);
    WaitExecutePerformer(0);
    Turn2Direction<actor ACTOR_NPC_BIPPA>(4, 10, DIR_UP);
    WaitExecuteLives(ACTOR_NPC_BIPPA);
    Turn2Direction<actor ACTOR_PLAYER>(4, 10, DIR_DOWN);
    Turn2Direction<actor ACTOR_ATTENDANT1>(4, 10, DIR_DOWN);
