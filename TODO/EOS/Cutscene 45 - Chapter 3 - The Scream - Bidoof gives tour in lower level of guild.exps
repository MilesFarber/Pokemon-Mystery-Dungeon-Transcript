    message_SetActor(ACTOR_NPC_BIPPA);
    message_Talk({
        english=" Here, we have [CS:N]Croagunk[CR]...",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    SetEffect<actor ACTOR_NPC_BIPPA>(EFFECT_SWEAT_DROPS_FROM_BOTH_SIDES_MEDIUM, 3);
