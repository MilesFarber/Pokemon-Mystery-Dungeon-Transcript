        """,
    });
    message_Talk({
        english="""
             He always seems to be fiddling
            around with that big cauldron back there.
            It's all a mystery to me! Yup yup!
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    MovePositionMark<performer 0>(1.5, Position<'m1', 15.5, 34.5>);
    Turn2Direction<actor ACTOR_NPC_BIPPA>(4, 10, DIR_DOWNLEFT);
    WaitExecutePerformer(0);
    message_Talk({
        english=" Over this way's the mess hall.",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    MovePositionMark<performer 0>(2, Position<'m2', 37.5, 34.5>);
    MovePositionMark<performer 0>(2, Position<'m3', 63.5, 34.5>);
    Turn2Direction<actor ACTOR_NPC_BIPPA>(8, 10, DIR_DOWNRIGHT);
    Turn2Direction<actor ACTOR_ATTENDANT1>(8, 10, DIR_DOWNRIGHT);
    Wait(10);
    Turn2Direction<actor ACTOR_PLAYER>(4, 10, DIR_DOWNRIGHT);
    WaitExecutePerformer(0);
    message_Talk({
        english="""
             And if you all look that way,
