def 1 for object OBJECT_P26P01A4_524 {
    SetAnimation(17);
    Lock(5);
    SetAnimation(17);
    Lock(6);
    @label_1;
    forever {
        switch ( $EVENT_LOCAL ) {
            case 1:
                break_loop;
                break;
            default:
                SetPositionMark(Position<'m10', 29, 12.5>);
                SetAnimation(17);
                MovePositionOffset(1, 0, 4);
                WaitAnimation();
                switch ( $EVENT_LOCAL ) {
                    case 1:
                        break_loop;
                        break;
                    default:
                        WaitRandom(0, 1);
                        SetPositionMark(Position<'m11', 28, 12.5>);
                        SetAnimation(18);
                        MovePositionOffset(1, 0, 8);
                        WaitAnimation();
                        switch ( $EVENT_LOCAL ) {
                            case 1:
                                break_loop;
                                break;
                            default:
                                continue;  // may be redundant
                        }
                        break;
                }
                break;
        }
    }
    @label_0;
    Lock(7);
    hold;
}

