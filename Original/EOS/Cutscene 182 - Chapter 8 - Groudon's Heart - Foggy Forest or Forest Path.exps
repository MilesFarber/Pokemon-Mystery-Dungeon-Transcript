
def 0 {
    SetAnimation<actor ACTOR_PLAYER>(2);
    SetAnimation<actor ACTOR_ATTENDANT1>(2);
    Turn2DirectionLives<actor ACTOR_PLAYER>(4, 10, ACTOR_ATTENDANT1);
    Turn2DirectionLives<actor ACTOR_ATTENDANT1>(4, 10, ACTOR_PLAYER);
    WaitExecuteLives(ACTOR_ATTENDANT1);
    message_SetFace(ACTOR_ATTENDANT1, FACE_NORMAL, FACE_POS_STANDARD);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" Are you ready, [hero]?",
            }
        case 2:
            {
                english=" Are you ready, [hero]?",
            }
        default:
            {
                english=" Are you ready, [hero]?",
            }
    }
    switch ( message_SwitchMenu(0, 1) ) {
        case menu({
            english="Yes",
        }):
        default:
            @label_0;
            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
            message_SwitchTalk ($PARTNER_TALK_KIND) {
                case 1:
                    {
                        english=" Which way should we go?",
                    }
                case 2:
                    {
                        english=" Which way should we go?",
                    }
                default:
                    {
                        english=" Which way should we go?",
                    }
            }
            switch ( message_SwitchMenu(0, 1) ) {
                case menu({
                    english="[CS:P]Foggy Forest[CR]",
                }):
                default:
                    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                    message_SetFace(ACTOR_ATTENDANT1, FACE_NORMAL, FACE_POS_STANDARD);
                    message_SwitchTalk ($PARTNER_TALK_KIND) {
                        case 1:
                            {
                                english=" All right. [CS:P]Foggy Forest[CR] it is.",
                            }
                        case 2:
                            {
                                english=" All right. [CS:P]Foggy Forest[CR] it is.",
                            }
                        default:
                            {
                                english=" All right. [CS:P]Foggy Forest[CR] it is.",
                            }
                    }
                    message_SwitchTalk ($PARTNER_TALK_KIND) {
                        case 1:
                            {
                                english=" All right! Let's go!",
                            }
                        case 2:
                            {
                                english=" All right! Let's go!",
                            }
                        default:
                            {
                                english=" All right! Let's go!",
                            }
                    }
                    message_Close();
                    MovePositionMark<actor ACTOR_PLAYER>(1, Position<'m0', 37.5, 10.5>);
                    Wait(10);
                    MovePositionMark<actor ACTOR_ATTENDANT1>(1, Position<'m1', 37.5, 10.5>);
                    Wait(20);
                    screen_FadeOutAll(1, 30);
                    CallCommon(CORO_FADE_OUT_ALL_AFTER);
                    main_EnterDungeon(12, 0);
                    switch ( message_Menu(MENU_DUNGEON_INITIALIZE_TEAM) ) { }
                    main_EnterDungeon(-1, 0);
                    hold;
                case menu({
                    english="[CS:P]Forest Path[CR]",
                }):
                    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                    message_SetFace(ACTOR_ATTENDANT1, FACE_NORMAL, FACE_POS_STANDARD);
                    message_SwitchTalk ($PARTNER_TALK_KIND) {
                        case 1:
                            {
                                english=" OK, [CS:P]Forest Path[CR] it is.",
                            }
                        case 2:
                            {
                                english=" OK, [CS:P]Forest Path[CR] it is.",
                            }
                        default:
                            {
                                english=" OK, [CS:P]Forest Path[CR] it is.",
                            }
                    }
                    message_SwitchTalk ($PARTNER_TALK_KIND) {
                        case 1:
                            {
                                english=" OK! Let's go!",
                            }
                        case 2:
                            {
                                english=" OK! Let's go!",
                            }
                        default:
                            {
                                english=" OK! Let's go!",
                            }
                    }
                    message_Close();
                    bgm_FadeOut(60);
                    MovePositionMark<actor ACTOR_PLAYER>(1, Position<'m2', 37.5, 10.5>);
                    Wait(10);
                    MovePositionMark<actor ACTOR_ATTENDANT1>(1, Position<'m3', 37.5, 10.5>);
                    Wait(20);
                    screen_FadeOutAll(1, 30);
                    CallCommon(CORO_FADE_OUT_ALL_AFTER);
                    main_EnterDungeon(13, 0);
                    switch ( message_Menu(MENU_DUNGEON_INITIALIZE_TEAM) ) { }
                    main_EnterDungeon(-1, 0);
                    hold;
            }
            break;
        case menu({
            english="Not yet",
        }):
            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
            message_SwitchTalk ($PARTNER_TALK_KIND) {
                case 1:
                    {
                        english="""
                             All right. We'll get moving when
                            you're ready.
                        """,
                    }
                case 2:
                    {
                        english="""
                             All right. We'll get moving when
                            you're ready.
                        """,
                    }
                default:
                    {
                        english="""
                             All right. We'll get moving when
                            you're ready.
                        """,
                    }
            }
            message_Close();
            end;
    }
}
