
def 0 {
    sound_Stop();
    $SCENARIO_SIDE = scn[43, 7];
    back_SetGround(LEVEL_D57P21A);
    supervision_StationCommon(0);
    supervision_Acting(0);
    camera_SetMyself<performer 0>();
    screen_FadeIn(1, 30);
    bgm_PlayFadeIn(BGM_SPRING_CAVE_DEPTHS, 0, 256);
    MovePositionMark<actor ACTOR_PLAYER_KIMAWARI>(1, Position<'m0', 28.5, 35.5>);
    WaitExecuteLives(ACTOR_PLAYER_KIMAWARI);
    Wait(15);
    ExecuteCommon<actor ACTOR_PLAYER_KIMAWARI>(CORO_LOOK_AROUND_RIGHT_FUNC_SERIES, 0);
    WaitExecuteLives(ACTOR_PLAYER_KIMAWARI);
    Wait(10);
    message_SetFace(ACTOR_PLAYER_KIMAWARI, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english=" I've come pretty far...",
    });
    message_Close();
    Turn2Direction<actor ACTOR_PLAYER_KIMAWARI>(4, 10, DIR_UP);
    WaitExecuteLives(ACTOR_PLAYER_KIMAWARI);
    message_SetFace(ACTOR_PLAYER_KIMAWARI, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english="""
             [CS:N]Haunter[CR] must be hiding
            just ahead!
        """,
    });
    message_Talk({
        english="""
             This time I will most definitely
            catch him!
        """,
    });
    ExecuteCommon<actor ACTOR_PLAYER_KIMAWARI>(CORO_JUMP_ANGRY_FUNC_SERIES, 0);
    WaitExecuteLives(ACTOR_PLAYER_KIMAWARI);
    message_Close();
    end;
}
