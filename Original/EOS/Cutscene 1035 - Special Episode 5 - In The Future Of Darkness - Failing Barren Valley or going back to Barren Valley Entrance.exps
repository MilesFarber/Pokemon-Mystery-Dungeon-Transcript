
def 0 {
    sound_Stop();
    message_SetFace(ACTOR_PLAYER_FUTURE, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english=" Ooogh...",
    });
    message_Talk({
        english="""
             Feels like my wounds haven't
            fully healed yet...[K] I'm not at my best...
        """,
    });
    message_Talk({
        english=" I should turn back for now.",
    });
    message_KeyWait();
    screen_FadeOutAll(1, 60);
    message_CloseEnforce();
    CallCommon(CORO_FADE_OUT_ALL_AFTER);
    back_SetGround(LEVEL_D46P11A);
    supervision_StationCommon(0);
    supervision_Acting(0);
    camera_SetMyself<performer 0>();
    screen_FadeIn(1, 30);
    bgm_PlayFadeIn(BGM_BARREN_VALLEY, 0, 256);
    Wait(30);
    ExecuteCommon<actor ACTOR_PLAYER_FUTURE>(CORO_LOOK_AROUND_FUNC_SERIES, 0);
    WaitExecuteLives(ACTOR_PLAYER_FUTURE);
    message_SetFace(ACTOR_PLAYER_FUTURE, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english="""
             [CS:N]Dusknoir[CR] isn't here...[K] That's
            not a surprise...
        """,
    });
    message_Talk({
        english="""
             I'd rather avoid another fight
            with him.
        """,
    });
    message_Talk({
        english="""
             The smartest thing I can do is
            save my strength until I reach [CS:N]Dialga[CR]'s place.
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2Direction<actor ACTOR_PLAYER_FUTURE>(4, 10, DIR_UP);
    WaitExecuteLives(ACTOR_PLAYER_FUTURE);
    message_Talk({
        english="""
             Right. I'll get prepared and then
            head out.
        """,
    });
    message_Close();
    end;
}
