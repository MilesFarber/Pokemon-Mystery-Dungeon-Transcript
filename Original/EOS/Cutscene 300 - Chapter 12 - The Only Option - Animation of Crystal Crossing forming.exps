
def 0 {
    sound_Stop();
    back2_SetMode(5);
    back_SetGround(LEVEL_V15P01A);
    back2_SetGround(LEVEL_V15P01A);
    supervision_Acting(0);
    supervision_Acting(1);
    camera_SetMyself<performer 0>();
    camera_SetEffect(2, 8, 1.0);
    back_SetBackScrollOffset(0, -240);
    bgm_PlayFadeIn(BGM_EARTHQUAKE3, 40, 256);
    screen2_FadeIn(0, 30);
    screen_FadeIn(1, 30);
    se_Play(7177);
    Wait(30);
    back_SetBackScrollSpeed(0, 10);
    Wait(180);
    supervision_RemoveActing(1);
    supervision_Acting(2);
    Wait(95);
    back_SetBackScrollSpeed(0, 0);
    bgm_FadeOut(30);
    se_FadeOut(7177, 10);
    se_Play(7197);
    camera_SetEffect(0, 0, 0);
    camera2_SetEffect(0, 0, 0);
    WaitSe(7197);
    screen2_FadeOut(0, 30);
    screen_FadeOut(1, 30);
    back2_SetMode(0);
    end;
}

