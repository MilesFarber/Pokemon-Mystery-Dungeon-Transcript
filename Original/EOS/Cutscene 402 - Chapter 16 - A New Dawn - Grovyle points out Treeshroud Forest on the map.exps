    message_SetFace(ACTOR_NPC_JUPUTORU, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english="""
             It is a little far from here,
            but...
        """,
    });
    message_Talk({
        english="""
             There is no one like [CS:N]Uxie[CR]
