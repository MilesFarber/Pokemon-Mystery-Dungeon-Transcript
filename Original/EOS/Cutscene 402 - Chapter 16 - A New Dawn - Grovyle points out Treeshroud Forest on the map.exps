    worldmap_SetArrow(188);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     I guess the [CS:P]Underground Lake[CR]
                    would be the closest.
                """,
            }
        case 2:
            {
                english="""
                     The [CS:P]Underground Lake[CR] would
