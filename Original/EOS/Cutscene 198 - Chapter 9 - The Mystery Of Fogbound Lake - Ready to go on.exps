
def 0 {
    SetAnimation<actor ACTOR_PLAYER>(2);
    SetAnimation<actor ACTOR_ATTENDANT1>(2);
    WaitExecuteLives(ACTOR_ATTENDANT1);
    message_Mail({
        english="[CN]Would you like to go on?",
    });
    switch ( message_SwitchMenu(0, 1) ) {
        case menu({
            english="Yes",
        }):
        default:
            @label_0;
            message_Close();
            if ( scn($SCENARIO_MAIN) == [11, 3] ) {
                bgm_FadeOut(60);
                screen_FadeOut(1, 30);
                WaitBgm(BGM_UPPER_STEAM_CAVE);
                supervision_ExecuteCommon(CORO_EVENT_M10_07);
                hold;
            } else {
                MovePositionMark<actor ACTOR_PLAYER>(1, Position<'m0', 28.5, 2.5>);
                Wait(15);
                MovePositionMark<actor ACTOR_ATTENDANT1>(1, Position<'m1', 28.5, 2.5>);
                Wait(20);
                screen_FadeOut(1, 30);
                main_EnterDungeon(15, 0);
                main_EnterDungeon(-1, 0);
                hold;
            }
            break;
        case menu({
            english="No",
        }):
            message_Close();
            end;
    }
}
