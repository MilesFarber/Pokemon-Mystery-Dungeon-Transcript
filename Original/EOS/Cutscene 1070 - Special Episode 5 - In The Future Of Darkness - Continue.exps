
def 0 {
    Turn2Direction<actor ACTOR_PLAYER_FUTURE>(4, 10, DIR_RIGHT);
    WaitExecuteLives(ACTOR_PLAYER_FUTURE);
    message_ResetActor();
    message_Mail({
        english="[CN]Would you like to go on?",
    });
    switch ( message_SwitchMenu(0, 1) ) {
        case menu({
            english="Yes",
        }):
        default:
            @label_0;
            message_Close();
            if ( scn($SCENARIO_SIDE) >= [48, 1] ) {
                @label_2;
                main_EnterDungeon(142, 30);
                switch ( message_Menu(MENU_DUNGEON_INITIALIZE_TEAM) ) { }
                main_EnterDungeon(-1, 30);
                hold;
            } else {
                $SCENARIO_SIDE = scn[48, 1];
                jump @label_2;
            }
            break;
        case menu({
            english="No",
        }):
            message_Close();
            end;
    }
}
