
def 0 {
    if ( scn($SCENARIO_SIDE) >= [40, 2] ) {
        @label_0;
        message_SetFace(ACTOR_PLAYER_BIPPA, FACE_NORMAL, FACE_POS_STANDARD);
        message_Talk({
            english="""
                 I don't have time to be looking
                at the Outlaw Notice Board! Yup yup!
            """,
        });
        CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
        @label_1;
        Turn2Direction<actor ACTOR_PLAYER_BIPPA>(4, 10, DIR_DOWN);
        WaitExecuteLives(ACTOR_PLAYER_BIPPA);
        end;
    } else {
        message_SetFace(ACTOR_PLAYER_BIPPA, FACE_NORMAL, FACE_POS_STANDARD);
        message_Talk({
            english=" This is the Outlaw Notice Board.",
        });
        message_KeyWait();
        se_Play(8972);
        SetEffect<actor ACTOR_PLAYER_BIPPA>(EFFECT_SWEAT_DROPS_FROM_BOTH_SIDES_MEDIUM, 3);
        WaitEffect<actor ACTOR_PLAYER_BIPPA>();
        WaitExecuteLives(ACTOR_PLAYER_BIPPA);
        message_SetFace(ACTOR_PLAYER_BIPPA, FACE_SAD, FACE_POS_STANDARD);
        message_Talk({
            english="""
                 Sniff...[K] But I'm too scared to
                face someone with a mean look on their face...
            """,
        });
        message_SetFace(ACTOR_PLAYER_BIPPA, FACE_NORMAL, FACE_POS_STANDARD);
        message_Talk({
            english="""
                 ...If I goof off, [CS:N]Chatot[CR] will
                be mighty angry.
            """,
        });
        message_Talk({
            english="""
                 I should get going to
                Treasure Town.
            """,
        });
        CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
        jump @label_1;
    }
}
