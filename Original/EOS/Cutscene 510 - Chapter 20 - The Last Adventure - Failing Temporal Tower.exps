    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" Ugh...[K] We messed up...",
            }
        case 2:
            {
                english=" Ugh...[K] That's not how to do it...",
            }
        default:
            {
                english=" Ugh...[K] That wasn't so good...",
            }
    }
    message_KeyWait();
