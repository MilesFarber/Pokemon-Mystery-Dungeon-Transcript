    message_SetFace(ACTOR_ATTENDANT1, FACE_DETERMINED, FACE_POS_STANDARD);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     But we don't have far to go.[K]
                    Let's keep pressing onward, [hero]!
                """,
            }
        case 2:
            {
                english="""
                     But we're almost there.[K]
                    Let's keep going, [hero]!
