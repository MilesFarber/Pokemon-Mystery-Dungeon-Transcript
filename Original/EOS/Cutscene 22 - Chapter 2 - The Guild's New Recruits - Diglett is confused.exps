    WaitExecuteLives(ACTOR_NPC_DIGUDA);
    message_SetFace(ACTOR_NPC_DIGUDA, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english=" Umm...[K] The footprint is...",
    });
