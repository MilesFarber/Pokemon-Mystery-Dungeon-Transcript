    message_SetFace(ACTOR_NPC_DIGUDA, FACE_PAIN, FACE_POS_BOTTOM_L_FACEOUTW);
    message_Talk({
        english="""
             B-but...[K] It's not a footprint that
            you normally see around here...
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_ResetActor();
    message_Talk({
        english=" UGH! That's pretty crummy!",
    });
    message_Talk({
        english="""
             Checking the footprints of visiting
