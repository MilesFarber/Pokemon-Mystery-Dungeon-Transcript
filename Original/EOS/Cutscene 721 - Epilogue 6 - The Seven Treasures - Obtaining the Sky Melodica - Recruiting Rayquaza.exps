
def 0 {
    sound_Stop();
    back_SetGround(LEVEL_D71P41A);
    supervision_Acting(0);
    camera_SetMyself<performer 0>();
    screen_FadeIn(1, 30);
    se_Play(8194);
    SetEffect<performer 3>(EFFECT_LIGHT_ENGULFING2, 3);
    WaitEffect<performer 3>();
    WaitExecutePerformer(3);
    supervision_Acting(1);
    SetEffect<performer 3>(EFFECT_NONE, 3);
    Wait(30);
    WaitSe(8194);
    se_Play(8967);
    SetEffect<actor ACTOR_PLAYER_APPOINT>(EFFECT_EXCLAMATION_MARK, 3);
    Wait(5);
    SetEffect<actor ACTOR_ADVENTURE_NPC1>(EFFECT_EXCLAMATION_MARK, 3);
    SetEffect<actor ACTOR_ADVENTURE_NPC2>(EFFECT_EXCLAMATION_MARK, 3);
    SetEffect<actor ACTOR_ADVENTURE_NPC3>(EFFECT_EXCLAMATION_MARK, 3);
    WaitEffect<actor ACTOR_PLAYER_APPOINT>();
    WaitExecuteLives(ACTOR_PLAYER_APPOINT);
    Wait(45);
    MovePositionOffset<actor ACTOR_PLAYER_APPOINT>(1, 0, -40);
    WaitExecuteLives(ACTOR_PLAYER_APPOINT);
    se_Play(6410);
    supervision_RemoveActing(1);
    Wait(30);
    message_Mail({
        english="""
            [CN]The treasure box contained...[K]
            [CN]a [CS:I]Sky Melodica[CR]!
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    item_Set(0, 65, 0);
    switch ( message_Menu(MENU_GIVE_ITEM) ) {
        case 2:
            @label_1;
            switch ( random(100) ) {
                case < 50:
                    SetAnimation<actor ACTOR_PLAYER_APPOINT>(5);
                    SlidePositionOffset<actor ACTOR_PLAYER_APPOINT>(1, 0, 36);
                    WaitExecuteLives(ACTOR_PLAYER_APPOINT);
                    SetAnimation<actor ACTOR_PLAYER_APPOINT>(2);
                    Wait(30);
                    se_Play(7175);
                    SetEffect<performer 4>(EFFECT_WHITE_LIGHT_ENGULFING_OUT, 3);
                    Wait(15);
                    supervision_Acting(2);
                    Wait(15);
                    WaitExecutePerformer(4);
                    SetEffect<performer 4>(EFFECT_NONE, 3);
                    Wait(15);
                    bgm_PlayFadeIn(BGM_IN_THE_DEPTHS_OF_THE_PIT, 0, 256);
                    message_Mail({
                        english="""
                            [CN]Oh?[K]
                            [CN][CS:N]Rayquaza[CR] is saying something.
                        """,
                    });
                    message_Mail({
                        english="""
                            [CN]It seemed to develop a kinship
                            [CN]with [player] while battling!
                        """,
                    });
                    message_Mail({
                        english="""
                            [CN]It says that it wants
                            [CN]to join the team!
                        """,
                    });
                    @label_6;
                    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                    switch ( ProcessSpecial(PROCESS_SPECIAL_PREPARE_MENU_ACCEPT_TEAM_MEMBER, 19, 0) ) { }
                    switch ( message_Menu(MENU_ACCEPT_TEAM_MEMBER) ) {
                        case 1:
                            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                            me_Play(5);
                            message_Mail({
                                english="[CN][c_name:NPC_NEW_FRIEND] joined the team!",
                            });
                            WaitMe(5);
                            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                            bgm_FadeOut(30);
                            se_Play(7183);
                            SetEffect<performer 4>(EFFECT_WHITE_LIGHT_ENGULFING, 3);
                            Wait(10);
                            Destroy<actor ACTOR_NPC_REKKUUZA>();
                            Wait(15);
                            WaitExecutePerformer(4);
                            SetEffect<performer 4>(EFFECT_NONE, 3);
                            Wait(30);
                            WaitSe(7183);
                            @label_3;
                            screen_FadeOut(1, 60);
                            Wait(30);
                            $SCENARIO_MAIN_BIT_FLAG[39] = 0;
                            if ( $SCENARIO_MAIN_BIT_FLAG[33] || $SCENARIO_MAIN_BIT_FLAG[34] || $SCENARIO_MAIN_BIT_FLAG[35] || $SCENARIO_MAIN_BIT_FLAG[36] || $SCENARIO_MAIN_BIT_FLAG[37] || $SCENARIO_MAIN_BIT_FLAG[38] || $SCENARIO_MAIN_BIT_FLAG[39] ) {
                                @label_8;
                                end;
                            } else {
                                $PERFORMANCE_PROGRESS_LIST[21] = 1;
                                jump @label_8;
                            }
                            break;
                        case 2:
                        default:
                            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                            message_Mail({
                                english="""
                                    [CN]Are you sure?[K]
                                    [CN]You're sure you won't accept
                                    [CN]this potential new member?
                                """,
                            });
                            switch ( message_SwitchMenu(0, 1) ) {
                                case menu({
                                    english="Reconsider",
                                }):
                                    jump @label_6;
                                case menu({
                                    english="Refuse",
                                }):
                                default:
                                    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                                    message_Mail({
                                        english="""
                                            [CN][CS:N]Rayquaza[CR] was turned down
                                            [CN]as a team member.
                                        """,
                                    });
                                    message_Close();
                                    bgm_FadeOut(30);
                                    se_Play(7183);
                                    SetEffect<performer 4>(EFFECT_WHITE_LIGHT_ENGULFING, 3);
                                    Wait(10);
                                    Destroy<actor ACTOR_NPC_REKKUUZA>();
                                    Wait(15);
                                    WaitExecutePerformer(4);
                                    SetEffect<performer 4>(EFFECT_NONE, 3);
                                    Wait(30);
                                    WaitSe(7183);
                                    jump @label_3;
                            }
                            break;
                    }
                    break;
                default:
                    jump @label_3;
            }
            break;
        default:
            Wait(10);
            me_Play(9);
            message_Mail({
                english="""
                    [CN][player] obtained
                    [CN]a [CS:I]Sky Melodica[CR], one of
                    [CN]the seven treasures!
                """,
            });
            WaitMe(9);
            message_Close();
            jump @label_1;
    }
}
