    Move2PositionMark<actor ACTOR_ATTENDANT1>(1.5, Position<'m11', 38, 17.5>);
    bgm_FadeOut(160);
    WaitExecuteLives(ACTOR_ATTENDANT1);
    WaitExecuteLives(ACTOR_PLAYER);
    Wait(60);
    message_SetFace(ACTOR_NPC_SUKATANKU, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
    message_Talk({
        english=" ...You two, can you move?",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_DOGAASU, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english=" Whoa-ho... You can't be serious!",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_ZUBATTO, FACE_NORMAL, FACE_POS_TOP_L_FACEINW);
    message_Talk({
        english="""
             Heh-heh-heh... The way they
            trounced us, I'm just too wiped out...
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_SUKATANKU, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
    message_Talk({
        english=" So that's it...",
    });
    message_Talk({
        english="""
             Well, we must really look like a
            mess...[K] Chaw-haw-haw...
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_DOGAASU, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english=" Whoa-ho-ho...but, Chief...",
    });
    message_Talk({
        english="""
             I like how you kept it to
            yourself until the very end...
        """,
    });
    message_Talk({
        english="""
             That you're a little bit of a good
            guy. You redeemed yourself!
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_SUKATANKU, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
    message_Talk({
        english=" Shut it...[K] Chaw-haw-haw...",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_ZUBATTO, FACE_NORMAL, FACE_POS_TOP_L_FACEINW);
    message_Talk({
        english="""
             But I gotta say, Chief, there's
            something to be said about you doing that![K]
            Heh-heh-heh...
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_SUKATANKU, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
    message_Talk({
        english=" Shut up...[K] Chaw-haw-haw...",
    });
    message_Close();
    screen_FadeOut(1, 60);
    Wait(30);
    end;
}
