                        """,
                    }
                default:
                    {
                        english="""
                             I'm not giving up over something
                            like this.
                        """,
                    }
            }
            message_KeyWait();
            bgm_PlayFadeIn(BGM_WIGGLYTUFFS_GUILD, 0, 256);
            message_SetFace(ACTOR_ATTENDANT1, FACE_HAPPY, FACE_POS_STANDARD);
            message_SwitchTalk ($PARTNER_TALK_KIND) {
                case 1:
