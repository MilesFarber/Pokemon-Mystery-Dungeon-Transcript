        english=" Yep.",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_EMURITTO, FACE_NORMAL, FACE_POS_TOP_L_FACEINW);
    message_Talk({
