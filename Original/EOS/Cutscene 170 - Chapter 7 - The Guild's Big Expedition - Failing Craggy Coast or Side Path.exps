
def 0 {
    sound_Stop();
    message_SetFace(ACTOR_NPC_BIPPA, FACE_SAD, FACE_POS_STANDARD);
    message_Talk({
        english="""
             Oof... By gosh, we couldn't get
            through there...
        """,
    });
    message_KeyWait();
    screen_FadeOutAll(1, 60);
    message_CloseEnforce();
    CallCommon(CORO_FADE_OUT_ALL_AFTER);
    back_SetGround(LEVEL_D06P11A);
    supervision_LoadStation(LEVEL_D06P11A, 'UM08');
    supervision_StationCommon(0);
    supervision_Station(3);
    supervision_Acting(0);
    camera_SetMyself<performer 0>();
    screen_FadeIn(1, 30);
    bgm_PlayFadeIn(BGM_CRAGGY_COAST, 0, 256);
    Wait(30);
    WaitLockLives(5, ACTOR_PLAYER);
    Unlock(5);
    Wait(15);
    Unlock(7);
    Wait(15);
    Unlock(9);
    Lock(3);
    Wait(15);
    Turn2DirectionLives<actor ACTOR_PLAYER>(4, 10, ACTOR_ATTENDANT1);
    Turn2DirectionLives<actor ACTOR_ATTENDANT1>(4, 10, ACTOR_PLAYER);
    Turn2Direction<actor ACTOR_NPC_BIPPA>(4, 10, DIR_LEFT);
    Wait(15);
    SetEffect<actor ACTOR_ATTENDANT1>(EFFECT_SWEAT_DROPS_FROM_BOTH_SIDES_MEDIUM, 3);
    WaitEffect<actor ACTOR_ATTENDANT1>();
    WaitExecuteLives(ACTOR_ATTENDANT1);
    message_SetFace(ACTOR_ATTENDANT1, FACE_PAIN, FACE_POS_STANDARD);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     I think we got cocky and
                    careless.
                """,
            }
        case 2:
            {
                english=" I guess we got a little careless.",
            }
        default:
            {
                english=" Maybe we got a little careless.",
            }
    }
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2DirectionLives<actor ACTOR_PLAYER>(4, 10, ACTOR_NPC_BIPPA);
    Turn2DirectionLives<actor ACTOR_ATTENDANT1>(4, 10, ACTOR_NPC_BIPPA);
    WaitExecuteLives(ACTOR_ATTENDANT1);
    se_Play(8972);
    SetEffect<actor ACTOR_NPC_BIPPA>(EFFECT_SWEAT_DROPS_FROM_BOTH_SIDES_MEDIUM, 3);
    WaitEffect<actor ACTOR_NPC_BIPPA>();
    WaitExecuteLives(ACTOR_NPC_BIPPA);
    message_SetFace(ACTOR_NPC_BIPPA, FACE_SAD, FACE_POS_TOP_R_CENTER);
    message_FacePositionOffset(-1, 0);
    message_Talk({
        english="""
             It's because I'm not pulling my
            own weight here, isn't it...
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2DirectionLives<actor ACTOR_PLAYER>(4, 10, ACTOR_ATTENDANT1);
    Turn2DirectionLives<actor ACTOR_NPC_BIPPA>(4, 10, ACTOR_ATTENDANT1);
    WaitExecuteLives(ACTOR_NPC_BIPPA);
    message_SetFace(ACTOR_ATTENDANT1, FACE_NORMAL, FACE_POS_STANDARD);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     No, [CS:N]Bidoof[CR], it's not your fault.
                    We're a team, and that's what's important.
                """,
            }
        case 2:
            {
                english="""
                     No, [CS:N]Bidoof[CR], it's not your fault.
                    We're a team, and that's what's important.
                """,
            }
        default:
            {
                english="""
                     No, [CS:N]Bidoof[CR], it's not your fault.
                    We're a team, and that's what's important.
                """,
            }
    }
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     We need to hurry so we can
                    meet up with the others at the base camp.
                """,
            }
        case 2:
            {
                english="""
                     We should hurry so we can
                    link up with the others at the base camp.
                """,
            }
        default:
            {
                english="""
                     Let's hurry so we can join the
                    others at the base camp.
                """,
            }
    }
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" Let's get it done!",
            }
        case 2:
            {
                english=" Let's get it done!",
            }
        default:
            {
                english=" Let's get it done!",
            }
    }
    message_Close();
    end;
}

def 1 for actor ACTOR_PLAYER {
    SetDirection(DIR_RIGHT);
    SetAnimation(76);
    Lock(5);
    CallCommon(CORO_WAKEUP_FUNC);
    CallCommon(CORO_LOOK_AROUND_FUNC);
    Lock(6);
    hold;
}

def 2 for actor ACTOR_ATTENDANT1 {
    SetDirection(DIR_LEFT);
    SetAnimation(76);
    Lock(7);
    CallCommon(CORO_WAKEUP_FUNC);
    CallCommon(CORO_LOOK_AROUND_FUNC);
    Unlock(3);
    Lock(8);
    hold;
}

def 3 for actor ACTOR_NPC_BIPPA {
    SetPositionInitial();
    SetAnimation(2);
    Lock(9);
    Lock(10);
    hold;
}
