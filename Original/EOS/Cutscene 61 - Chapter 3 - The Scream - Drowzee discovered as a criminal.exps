def 1 for actor ACTOR_ATTENDANT1 {
    SetAnimation(2);
    Lock(5);
    SetEffect(EFFECT_EXCLAMATION_MARK, 3);
    Lock(6);
    Turn2Direction(4, 10, DIR_UP);
    Lock(7);
    ResetHitAttribute(31);
    SetAnimation(3);
    @label_1;
    forever {
        SlidePositionOffset(1, 1, 0);
        Wait(1);
        SlidePositionOffset(1, -1, 0);
        Wait(1);
        switch ( $EVENT_LOCAL ) {
            case 1:
                break_loop;
                break;
            default:
                continue;  // may be redundant
        }
    }
    @label_0;
    SetAnimation(2);
    Lock(8);
    hold;
}
