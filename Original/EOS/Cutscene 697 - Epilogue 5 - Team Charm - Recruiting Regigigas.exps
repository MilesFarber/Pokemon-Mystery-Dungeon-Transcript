
def 0 {
    sound_Stop();
    back_SetGround(LEVEL_D32P44A);
    supervision_Acting(0);
    camera_SetMyself<performer 0>();
    screen_FadeIn(1, 30);
    bgm_PlayFadeIn(BGM_IN_THE_DEPTHS_OF_THE_PIT, 0, 256);
    Wait(30);
    message_SetFace(ACTOR_NPC_REJIGIGASU, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
    message_Talk({
        english=" I AM [CS:N]REGIGIGAS[CR]...",
    });
    message_Talk({
        english=" I PLEDGE...SERVICE TO YOU...",
    });
    @label_2;
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    switch ( ProcessSpecial(PROCESS_SPECIAL_PREPARE_MENU_ACCEPT_TEAM_MEMBER, 9, 0) ) { }
    switch ( message_Menu(MENU_ACCEPT_TEAM_MEMBER) ) {
        case 1:
            @label_0;
            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
            me_Play(5);
            message_Mail({
                english="[CN][c_name:NPC_NEW_FRIEND] joined the team!",
            });
            WaitMe(5);
            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
            bgm_FadeOut(120);
            screen_FadeOut(1, 60);
            WaitBgm(BGM_IN_THE_DEPTHS_OF_THE_PIT);
            @label_4;
            message_Explanation({
                english="""
                    [CN][player] cleared [CS:P]Aegis Cave[CR]
                    [CN]in admirable fashion!
                """,
            });
            message_Close();
            switch ( ProcessSpecial(55, 58, 0) ) { }
            switch ( message_Menu(MENU_DUNGEON_EXPLORATION_RESULTS) ) { }
            switch ( message_Menu(MENU_DUNGEON_TEAM_RETURNS_FROM_MAP) ) { }
            end;
        case 2:
        default:
            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
            message_Mail({
                english="""
                    [CN]Are you sure?[K]
                    [CN]You're sure you won't accept
                    [CN]this potential new member?
                """,
            });
            switch ( message_SwitchMenu(0, 1) ) {
                case menu({
                    english="Reconsider",
                }):
                    jump @label_2;
                case menu({
                    english="Refuse",
                }):
                default:
                    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                    message_Mail({
                        english="""
                            [CN][player] turned down
                            [CN][CS:N]Regigigas[CR]'s offer to join.
                        """,
                    });
                    message_Close();
                    bgm_FadeOut(120);
                    screen_FadeOut(1, 60);
                    WaitBgm(BGM_IN_THE_DEPTHS_OF_THE_PIT);
                    jump @label_4;
            }
            break;
    }
}
