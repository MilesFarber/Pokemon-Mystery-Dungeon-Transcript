    SetAnimation<actor ACTOR_NPC_HEIGANI>(2);
    SetAnimation<actor ACTOR_NPC_BIPPA>(2);
    SetAnimation<actor ACTOR_NPC_DOGOOMU>(2);
    SetAnimation<actor ACTOR_NPC_KIMAWARI>(2);
