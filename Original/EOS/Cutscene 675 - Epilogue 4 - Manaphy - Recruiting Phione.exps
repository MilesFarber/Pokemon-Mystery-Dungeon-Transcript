
def 0 {
    sound_Stop();
    back_SetDungeonBanner(53, 0);
    screen_FadeIn(1, 16);
    Wait(60);
    screen_FadeOut(1, 16);
    Wait(15);
    back_SetGround(LEVEL_D35P41A);
    supervision_Acting(0);
    camera_SetMyself<performer 0>();
    SetEffect<actor ACTOR_NPC_FIONE1>(EFFECT_LAUGHING, 3);
    SetEffect<actor ACTOR_NPC_FIONE4>(EFFECT_LAUGHING, 3);
    SetEffect<actor ACTOR_NPC_FIONE7>(EFFECT_LAUGHING, 3);
    SetEffect<actor ACTOR_NPC_FIONE8>(EFFECT_LAUGHING, 3);
    screen_FadeIn(1, 30);
    bgm_PlayFadeIn(BGM_MYSTIFYING_FOREST, 0, 256);
    MovePositionMark<actor ACTOR_PLAYER_APPOINT>(1, Position<'m0', 43.5, 40.5>);
    Wait(5);
    MovePositionMark<actor ACTOR_ADVENTURE_NPC1>(1, Position<'m1', 46.5, 43>);
    MovePositionMark<actor ACTOR_ADVENTURE_NPC2>(1, Position<'m2', 40.5, 42.5>);
    MovePositionMark<actor ACTOR_ADVENTURE_NPC3>(1, Position<'m3', 43.5, 44.5>);
    WaitExecuteLives(ACTOR_PLAYER_APPOINT);
    se_Play(8967);
    SetEffect<actor ACTOR_NPC_FIONE1>(EFFECT_NONE, 3);
    SetEffect<actor ACTOR_NPC_FIONE4>(EFFECT_NONE, 3);
    SetEffect<actor ACTOR_NPC_FIONE7>(EFFECT_NONE, 3);
    SetEffect<actor ACTOR_NPC_FIONE8>(EFFECT_NONE, 3);
    SetEffect<actor ACTOR_NPC_FIONE7>(EFFECT_EXCLAMATION_MARK, 3);
    Wait(5);
    SetEffect<actor ACTOR_NPC_FIONE2>(EFFECT_EXCLAMATION_MARK, 3);
    SetEffect<actor ACTOR_NPC_FIONE6>(EFFECT_EXCLAMATION_MARK, 3);
    Wait(5);
    SetEffect<actor ACTOR_NPC_FIONE1>(EFFECT_EXCLAMATION_MARK, 3);
    SetEffect<actor ACTOR_NPC_FIONE8>(EFFECT_EXCLAMATION_MARK, 3);
    WaitEffect<actor ACTOR_NPC_FIONE8>();
    WaitExecuteLives(ACTOR_NPC_FIONE8);
    Turn2Direction<actor ACTOR_NPC_FIONE1>(1, 10, DIR_DOWN);
    Turn2Direction<actor ACTOR_NPC_FIONE2>(1, 10, DIR_DOWN);
    Wait(5);
    Turn2Direction<actor ACTOR_NPC_FIONE3>(1, 10, DIR_DOWN);
    Turn2Direction<actor ACTOR_NPC_FIONE4>(1, 10, DIR_DOWN);
    Wait(5);
    Turn2Direction<actor ACTOR_NPC_FIONE5>(1, 10, DIR_DOWN);
    Turn2Direction<actor ACTOR_NPC_FIONE6>(1, 10, DIR_DOWN);
    Wait(5);
    Turn2Direction<actor ACTOR_NPC_FIONE7>(1, 10, DIR_DOWN);
    Turn2Direction<actor ACTOR_NPC_FIONE8>(1, 10, DIR_DOWN);
    WaitExecuteLives(ACTOR_NPC_FIONE8);
    Wait(45);
    MovePositionOffset<actor ACTOR_NPC_FIONE1>(1, 0, 24);
    WaitExecuteLives(ACTOR_NPC_FIONE1);
    Wait(30);
    message_Mail({
        english="""
            [CN]This [CS:N]Phione[CR] appears
            [CN]eager to join the team.
        """,
    });
    @label_2;
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    switch ( ProcessSpecial(PROCESS_SPECIAL_PREPARE_MENU_ACCEPT_TEAM_MEMBER, 17, 0) ) { }
    switch ( message_Menu(MENU_ACCEPT_TEAM_MEMBER) ) {
        case 1:
            @label_0;
            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
            bgm_Stop();
            me_Play(5);
            message_Mail({
                english="[CN][c_name:NPC_NEW_FRIEND] joined the team!",
            });
            WaitMe(5);
            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
            bgm_FadeOut(120);
            screen_FadeOut(1, 60);
            Wait(30);
            WaitBgm(BGM_MYSTIFYING_FOREST);
            message_Explanation({
                english="""
                    [CN][player] cleared the [CS:P]Miracle Sea[CR]
                    [CN]in admirable fashion!
                """,
            });
            message_Close();
            end;
        case 2:
        default:
            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
            message_Mail({
                english="""
                    [CN]Are you sure?[K]
                    [CN]You're sure you won't accept
                    [CN]this potential new member?
                """,
            });
            switch ( message_SwitchMenu(0, 1) ) {
                case menu({
                    english="Reconsider",
                }):
                    jump @label_2;
                case menu({
                    english="Refuse",
                }):
                default:
                    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
                    message_Mail({
                        english="""
                            [CN][player] turned down
                            [CN][CS:N]Phione[CR]'s offer to join.
                        """,
                    });
                    message_Close();
                    bgm_FadeOut(120);
                    screen_FadeOut(1, 60);
                    Wait(30);
                    WaitBgm(BGM_MYSTIFYING_FOREST);
                    end;
            }
            break;
    }
}
