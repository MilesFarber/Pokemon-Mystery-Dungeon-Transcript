
def 0 {
    sound_Stop();
    message_Narration(30, {
        english="[CN]The next morning...",
    });
    message_Close();
    Wait(30);
    se_Play(8971);
    message_SetFace(ACTOR_NPC_DOGOOMU, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english="""
             HEY!![K]
            HEEEEEEEEEYYYYYYYYYYY!!
        """,
    });
    message_KeyWait();
    se_Play(8970);
    message_Talk({
        english="""
             GET UUUUUUUUUUUUUUPPPPPP![K]
            IT'S MORRRRRRRNNNIIIIIIIIIINNNNNNGGGG!
        """,
    });
    WaitSe(8970);
    message_Close();
    back_SetGround(LEVEL_G01P10A);
    supervision_Acting(0);
    camera_SetMyself<performer 0>();
    SetAnimation<actor ACTOR_PLAYER_BIPPA>(27);
    screen_FadeIn(1, 30);
    Wait(30);
    message_SetFace(ACTOR_PLAYER_BIPPA, FACE_DIZZY, FACE_POS_STANDARD);
    message_Talk({
        english=" H-huh...?[K] What's that...?",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    se_Play(8971);
    camera_SetEffect(2, 2, 3.0);
    SetAnimation<actor ACTOR_NPC_DOGOOMU>(19);
    WaitAnimation<actor ACTOR_NPC_DOGOOMU>();
    SetAnimation<actor ACTOR_NPC_DOGOOMU>(2);
    camera_SetEffect(0, 0, 0);
    SetEffect<actor ACTOR_NPC_DOGOOMU>(EFFECT_ANGRY, 3);
    message_SetFace(ACTOR_NPC_DOGOOMU, FACE_ANGRY, FACE_POS_TOP_R_CENTER);
    message_Talk({
        english=" How LATE will you SLEEP!",
    });
    message_Talk({
        english="""
             The MORNING address is
            STARTING![K] HURRY UP!
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    MovePositionMark<actor ACTOR_NPC_DOGOOMU>(1, Position<'m0', 27, 15.5>);
    WaitExecuteLives(ACTOR_NPC_DOGOOMU);
    Destroy<actor ACTOR_NPC_DOGOOMU>();
    Wait(30);
    message_SetFace(ACTOR_PLAYER_BIPPA, FACE_DIZZY, FACE_POS_STANDARD);
    message_Talk({
        english="""
             Oogh...[K] Whose fault do you think
            it is I can't get up in the first place...?
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    SetDirection<actor ACTOR_PLAYER_BIPPA>(DIR_LEFT);
    SetAnimation<actor ACTOR_PLAYER_BIPPA>(28);
    WaitAnimation<actor ACTOR_PLAYER_BIPPA>();
    WaitExecuteLives(ACTOR_PLAYER_BIPPA);
    SetAnimation<actor ACTOR_PLAYER_BIPPA>(2);
    Wait(10);
    ExecuteCommon<actor ACTOR_PLAYER_BIPPA>(CORO_HEAD_SHAKE_FUNC_SERIES, 0);
    WaitExecuteLives(ACTOR_PLAYER_BIPPA);
    Wait(30);
    Turn2Direction<actor ACTOR_PLAYER_BIPPA>(4, 10, DIR_UP);
    WaitExecuteLives(ACTOR_PLAYER_BIPPA);
    message_SetFace(ACTOR_PLAYER_BIPPA, FACE_SPECIAL2, FACE_POS_STANDARD);
    message_Talk({
        english="""
             Sniff...[K] His snoring made it
            really hard for me to sleep, yup yup...
        """,
    });
    message_Talk({
        english="""
             But if I don't get up, I'll miss
            the morning address...
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    se_Play(8974);
    ExecuteCommon<actor ACTOR_PLAYER_BIPPA>(CORO_JUMP_SURPRISE_FUNC_SERIES, 0);
    WaitExecuteLives(ACTOR_PLAYER_BIPPA);
    message_SetFace(ACTOR_PLAYER_BIPPA, FACE_SURPRISED, FACE_POS_STANDARD);
    message_Talk({
        english=" I-I've got to hurry!",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    bgm_PlayFadeIn(BGM_WIGGLYTUFFS_GUILD, 0, 256);
    $SCENARIO_MAIN_BIT_FLAG[1] = 1;
    main_SetGround(LEVEL_G01P10A);
    $SCENARIO_MAIN_BIT_FLAG[7] = 1;
    CallCommon(CORO_HANYOU_SAVE_FUNC);
    end;
