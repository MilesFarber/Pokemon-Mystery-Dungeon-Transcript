
def 0 {
    sound_Stop();
    back_SetGround(LEVEL_D56P12A);
    supervision_Acting(0);
    Wait(1);
    camera_SetMyself<performer 0>();
    Wait(30);
    screen_FadeIn(0, 30);
    bgm_PlayFadeIn(BGM_LIMESTONE_CAVERN, 0, 256);
    MovePositionMark<actor ACTOR_PLAYER_CHARMS>(1, Position<'m0', 19.5, 28.5>);
    MovePositionMark<actor ACTOR_NPC_CHAAREMU>(1, Position<'m1', 16.5, 30.5>);
    MovePositionMark<actor ACTOR_NPC_SAANAITO>(1, Position<'m2', 22.5, 30.5>);
    WaitExecuteLives(ACTOR_NPC_CHAAREMU);
    se_Play(8968);
    SetEffect<actor ACTOR_PLAYER_CHARMS>(EFFECT_SHOCKED, 3);
    Wait(3);
    SetEffect<actor ACTOR_NPC_SAANAITO>(EFFECT_SHOCKED, 3);
    Wait(3);
    SetEffect<actor ACTOR_NPC_CHAAREMU>(EFFECT_SHOCKED, 3);
    WaitEffect<actor ACTOR_PLAYER_CHARMS>();
    WaitExecuteLives(ACTOR_PLAYER_CHARMS);
    ExecuteCommon<actor ACTOR_PLAYER_CHARMS>(CORO_LOOK_AROUND_FUNC_SERIES, 0);
    Wait(6);
    ExecuteCommon<actor ACTOR_NPC_CHAAREMU>(CORO_LOOK_AROUND_RIGHT_FUNC_SERIES, 0);
    Wait(4);
    ExecuteCommon<actor ACTOR_NPC_SAANAITO>(CORO_LOOK_AROUND_LEFT_FUNC_SERIES, 0);
    WaitExecuteLives(ACTOR_NPC_CHAAREMU);
    Turn2DirectionLives<actor ACTOR_NPC_CHAAREMU>(4, 10, ACTOR_PLAYER_CHARMS);
    Wait(6);
    Turn2DirectionLives<actor ACTOR_PLAYER_CHARMS>(4, 10, ACTOR_NPC_CHAAREMU);
    Wait(9);
    Turn2DirectionLives<actor ACTOR_NPC_SAANAITO>(4, 10, ACTOR_NPC_CHAAREMU);
    WaitExecuteLives(ACTOR_NPC_SAANAITO);
    Wait(3);
    message_SetFace(ACTOR_NPC_CHAAREMU, FACE_SURPRISED, FACE_POS_STANDARD);
    message_Talk({
        english=" Wh-where are we?!",
    });
    message_Close();
    message_SetFace(ACTOR_NPC_SAANAITO, FACE_SURPRISED, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english=" I-in a limestone cavern!",
    });
    message_Talk({
        english="""
             Past that wall...[K] This
            huge limestone cave opens up!
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_PLAYER_CHARMS, FACE_NORMAL, FACE_POS_TOP_C_FACEL);
    message_Talk({
        english=" I knew it.",
    });
    message_Talk({
        english="""
             I knew that the wall held the
            secret to finding the correct path onward...
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2Direction<actor ACTOR_NPC_SAANAITO>(4, 10, DIR_UPRIGHT);
    Wait(4);
    Turn2DirectionLives<actor ACTOR_PLAYER_CHARMS>(4, 10, ACTOR_NPC_SAANAITO);
    Wait(6);
    Turn2DirectionLives<actor ACTOR_NPC_CHAAREMU>(4, 10, ACTOR_NPC_SAANAITO);
    WaitExecuteLives(ACTOR_NPC_SAANAITO);
    ExecuteCommon<actor ACTOR_NPC_SAANAITO>(CORO_LOOK_AROUND_RIGHT_FUNC_SERIES, 0);
    WaitExecuteLives(ACTOR_NPC_SAANAITO);
    Turn2DirectionLives<actor ACTOR_NPC_SAANAITO>(4, 2, ACTOR_PLAYER_CHARMS);
    WaitExecuteLives(ACTOR_NPC_SAANAITO);
    message_SetFace(ACTOR_NPC_SAANAITO, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english=" ...[K][CS:N]Wigglytuff[CR] isn't here...",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_PLAYER_CHARMS, FACE_NORMAL, FACE_POS_TOP_C_FACER);
    message_Talk({
        english="""
             He probably went on ahead.[K] We
            should get going too.
        """,
    });
    message_Close();
    MovePositionMark<performer 0>(1, Position<'m3', 19.5, 9.5>);
    MovePositionMark<actor ACTOR_PLAYER_CHARMS>(1.5, Position<'m4', 19.5, 9.5>);
    Wait(12);
    MovePositionMark<actor ACTOR_NPC_CHAAREMU>(1.5, Position<'m5', 16.5, 12.5>);
    Wait(6);
    MovePositionMark<actor ACTOR_NPC_SAANAITO>(1.5, Position<'m6', 22.5, 12.5>);
    Wait(20);
    main_EnterDungeon(155, 30);
    switch ( message_Menu(MENU_DUNGEON_INITIALIZE_TEAM) ) { }
    main_EnterDungeon(-1, 30);
    end;
}
