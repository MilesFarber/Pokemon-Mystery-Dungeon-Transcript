    MovePositionMark<actor ACTOR_PLAYER>(1, Position<'m2', 48, 25>);
    MovePositionMark<actor ACTOR_ATTENDANT1>(1, Position<'m3', 48, 28>);
    WaitExecuteLives(ACTOR_NPC_PERAPPU);
