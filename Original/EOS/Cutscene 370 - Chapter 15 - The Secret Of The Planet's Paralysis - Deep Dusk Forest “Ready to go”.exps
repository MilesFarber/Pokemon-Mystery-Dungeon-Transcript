
def 0 {
    bgm_PlayFadeIn(BGM_DEEP_DUSK_FOREST, 0, 256);
    SetAnimation<actor ACTOR_PLAYER>(2);
    SetAnimation<actor ACTOR_ATTENDANT1>(2);
    SetAnimation<actor ACTOR_NPC_JUPUTORU>(2);
    SetAnimation<actor ACTOR_NPC_SEREBII>(2);
    WaitExecuteLives(ACTOR_NPC_SEREBII);
    Turn2DirectionLives<actor ACTOR_ATTENDANT1>(4, 10, ACTOR_PLAYER);
    WaitExecuteLives(ACTOR_ATTENDANT1);
    Turn2DirectionLives<actor ACTOR_PLAYER>(4, 10, ACTOR_ATTENDANT1);
    message_SetFace(ACTOR_ATTENDANT1, FACE_NORMAL, FACE_POS_STANDARD);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" Are you all ready to roll?",
            }
        case 2:
            {
                english=" Are you all ready?",
            }
        default:
            {
                english=" Are you all ready?",
            }
    }
    switch ( message_SwitchMenu(0, 1) ) {
        case menu({
            english="Yes",
        }):
        default:
            @label_0;
            message_Close();
            supervision_Acting(0);
            SetPositionLives<performer 0>(0);
            camera_SetMyself<performer 0>();
            MovePositionOffset<performer 0>(1, 0, 48);
            MovePositionMark<actor ACTOR_NPC_SEREBII>(1, Position<'m0', 36.5, 32.5>);
            MovePositionMark<actor ACTOR_NPC_JUPUTORU>(1, Position<'m1', 32.5, 32.5>);
            Turn2DirectionLives<actor ACTOR_NPC_SEREBII>(4, 10, ACTOR_ATTENDANT1);
            Turn2DirectionLives<actor ACTOR_NPC_JUPUTORU>(4, 10, ACTOR_ATTENDANT1);
            WaitExecuteLives(ACTOR_NPC_JUPUTORU);
            Turn2DirectionLives<actor ACTOR_ATTENDANT1>(4, 10, ACTOR_NPC_JUPUTORU);
            WaitExecuteLives(ACTOR_ATTENDANT1);
            Turn2DirectionLives<actor ACTOR_PLAYER>(4, 10, ACTOR_NPC_JUPUTORU);
            WaitExecuteLives(ACTOR_PLAYER);
            message_SetFace(ACTOR_NPC_JUPUTORU, FACE_NORMAL, FACE_POS_STANDARD);
            message_Talk({
                english=" Good.[K] We're leaving.",
            });
            message_Talk({
                english="""
                     We must make our way to the
                    Passage of Time.
                """,
            });
            message_Talk({
                english=" Let's go.",
            });
            message_Close();
            MovePositionOffset<actor ACTOR_PLAYER>(1, 0, -80);
            Wait(10);
            MovePositionOffset<actor ACTOR_ATTENDANT1>(1, 0, -80);
            Wait(5);
            MovePositionOffset<actor ACTOR_NPC_JUPUTORU>(1, 0, -80);
            Wait(5);
            MovePositionOffset<actor ACTOR_NPC_SEREBII>(1, 0, -80);
            Wait(10);
            screen_FadeOut(1, 30);
            main_EnterDungeon(33, 0);
            switch ( message_Menu(MENU_DUNGEON_INITIALIZE_TEAM) ) { }
            main_EnterDungeon(-1, 0);
            hold;
            end;
        case menu({
            english="Not yet",
        }):
            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
            message_SetFace(ACTOR_ATTENDANT1, FACE_NORMAL, FACE_POS_STANDARD);
            message_SwitchTalk ($PARTNER_TALK_KIND) {
                case 1:
                    {
                        english=" All right.",
                    }
                case 2:
                    {
                        english=" OK.",
                    }
                default:
                    {
                        english=" OK.",
                    }
            }
            message_SwitchTalk ($PARTNER_TALK_KIND) {
                case 1:
                    {
                        english=" We'll go when you're ready.",
                    }
                case 2:
                    {
                        english=" Let's go when you're ready.",
                    }
                default:
                    {
                        english=" Let's go when you're ready.",
                    }
            }
            message_Close();
            end;
    }
}
