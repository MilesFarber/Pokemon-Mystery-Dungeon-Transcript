
def 0 {
    bgm_PlayFadeIn(BGM_HIDDEN_HIGHLAND, 0, 256);
    screen_WhiteOutAll(1, 0);
    Wait(1);
    screen_FadeIn(1, 0);
    back_SetGround(LEVEL_T01P02A);
    supervision_Acting(0);
    camera_SetMyself<performer 0>();
    back_SetWeather(9);
    screen_FlushOut(1, 0, 8, 0, 0, 0);
    screen_FadeInAll(1, 30);
    Wait(30);
    back_SetBackEffect(4);
    Wait(15);
    message_EmptyActor();
    message_Talk({
        english="""
            [CN]And at one point, I met
            [CN]Team [team:].
        """,
    });
    message_Close();
    back_SetBackEffect(5);
    SetEffect<actor ACTOR_NPC_YONOWAARU>(EFFECT_EXCLAMATION_MARK, 3);
    WaitEffect<actor ACTOR_NPC_YONOWAARU>();
    WaitExecuteLives(ACTOR_NPC_YONOWAARU);
    Turn2DirectionLives<actor ACTOR_NPC_YONOWAARU>(4, 10, ACTOR_PLAYER);
    WaitExecuteLives(ACTOR_NPC_YONOWAARU);
    message_SetFace(ACTOR_NPC_YONOWAARU, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english="""
             Hello there! You're from the
            guild, if I'm not mistaken?
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_ATTENDANT1, FACE_HAPPY, FACE_POS_BOTTOM_R_FACEINW);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" Yup. We're Team [team:].",
            }
        case 2:
            {
                english=" Yes. We're Team [team:].",
            }
        default:
            {
                english=" Yes. We're Team [team:].",
            }
    }
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     We work at the guild.[K] Great to
                    meet you!
                """,
            }
        case 2:
            {
                english="""
                     We work at the guild.[K]
                    It's great to meet you!
                """,
            }
        default:
            {
                english="""
                     We work at the guild.[K]
                    We're pleased to meet you!
                """,
            }
    }
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    back_SetBackEffect(4);
    Wait(30);
    message_EmptyActor();
    message_Talk({
        english="""
            [CN]But at that point,
            [CN]I suspected nothing...
        """,
    });
    message_Close();
    screen_WhiteOutAll(1, 30);
    screen_FlushIn(1, 0, 1, 0, 0, 0);
    screen_WhiteOut(1, 0);
    screen_FadeInAll(1, 0);
    end;
}
