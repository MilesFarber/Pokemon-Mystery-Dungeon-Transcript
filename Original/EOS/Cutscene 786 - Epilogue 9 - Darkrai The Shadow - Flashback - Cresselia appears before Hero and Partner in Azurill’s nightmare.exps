
def 0 {
    bgm_PlayFadeIn(BGM_WELCOME_TO_THE_WORLD_OF_POKEMON, 0, 256);
    back_SetGround(LEVEL_D37P41A);
    supervision_Acting(0);
    camera_SetMyself<performer 0>();
    screen_FlushOut(1, 0, 8, 0, 0, 0);
    screen_FadeIn(1, 30);
    Wait(30);
    message_SetFace(ACTOR_NPC_KURESERIA, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
    message_Talk({
        english="""
             I cannot fathom how you've
            come here, but...
        """,
    });
    message_Talk({
        english="""
             I find your visit ever so
            convenient!
        """,
    });
    message_Talk({
        english=" I've longed to meet both of you!",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_EmptyActor();
    message_SwitchMonologue ($HERO_TALK_KIND) {
        case 4:
            {
                english="""
                    (That time I wasn't dreaming, so I guess
                    it never occurred to me...)
                """,
            }
        default:
            {
                english="""
                    (That time I wasn't dreaming, so I guess
                    it never occurred to me...)
                """,
            }
    }
    message_SwitchMonologue ($HERO_TALK_KIND) {
        case 4:
            {
                english="(But I realize that was in [CS:N]Azurill[CR]'s nightmare.)",
            }
        default:
            {
                english="(But I realize that was in [CS:N]Azurill[CR]'s nightmare.)",
            }
    }
    message_SwitchMonologue ($HERO_TALK_KIND) {
        case 4:
            {
                english="(In other words, it was still in a dream.)",
            }
        default:
            {
                english="(In other words, it was still in a dream.)",
            }
    }
    message_Close();
    screen_FadeOut(1, 30);
    screen_FlushIn(1, 0, 1, 0, 0, 0);
    end;
}
