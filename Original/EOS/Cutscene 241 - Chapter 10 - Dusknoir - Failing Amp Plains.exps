
def 0 {
    sound_Stop();
    back_SetGround(LEVEL_S04P01A);
    screen_FadeIn(1, 0);
    message_SetFace(ACTOR_ATTENDANT1, FACE_PAIN, FACE_POS_STANDARD);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" Ugh! We blew that try...",
            }
        case 2:
            {
                english=" Ugh! That ended badly...",
            }
        default:
            {
                english=" Ugh! That wasn't so good...",
            }
    }
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     It's harder than I thought...[K]
                    Let's go home for today.
                """,
            }
        case 2:
            {
                english="""
                     It's harder than I thought...[K]
                    Let's go home for today.
                """,
            }
        default:
            {
                english="""
                     Hmm... This won't be easy...[K]
                    Let's call it a day.
                """,
            }
    }
    message_KeyWait();
    screen_FadeOutAll(1, 60);
