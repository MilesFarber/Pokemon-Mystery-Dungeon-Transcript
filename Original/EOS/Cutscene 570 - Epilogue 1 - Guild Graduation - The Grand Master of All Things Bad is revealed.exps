    SetDirection(DIR_RIGHT);
    SetAnimation(68);
    Wait(60);
    Lock(6);
    SetAnimation(63);
    WaitAnimation();
    SetAnimation(2);
    Lock(7);
    Turn2Direction(4, 10, DIR_UPRIGHT);
    Wait(20);
    CallCommon(CORO_LOOK_AROUND_FUNC);
    Unlock(3);
    Lock(8);
    hold;
}

