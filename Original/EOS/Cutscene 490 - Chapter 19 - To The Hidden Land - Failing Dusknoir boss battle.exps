
def 0 {
    sound_Stop();
    back_SetGround(LEVEL_S04P01A);
    screen_FadeIn(1, 0);
    message_SetFace(ACTOR_NPC_YAMIRAMI, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english=" Wheh-heh...heh?",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_YONOWAARU, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english=" They vanished?![K] No, that isn't it.",
    });
    message_Talk({
        english=" They just managed to retreat.",
    });
    message_Talk({
        english="""
             ...Humph. So be it.[K] There is no
            need for panic.
        """,
    });
    message_Talk({
        english=" They will return. They have to.",
    });
    message_Talk({
        english="""
             And we'll be waiting![K] Ha-ha-ha!
            Hoo-hoo-ha!
        """,
    });
    message_KeyWait();
    screen_FadeOutAll(1, 60);
    message_CloseEnforce();
    CallCommon(CORO_FADE_OUT_ALL_AFTER);
    back_SetGround(LEVEL_D28P21A);
    supervision_StationCommon(0);
    supervision_LoadStation(LEVEL_D28P21A, 'UM24');
    supervision_Station(5);
    supervision_Acting(0);
    camera_SetMyself<performer 0>();
    screen_FadeIn(1, 30);
    bgm_PlayFadeIn(BGM_HIDDEN_HIGHLAND, 0, 256);
    WaitLockLives(5, ACTOR_PLAYER);
    Unlock(5);
    Wait(15);
    Unlock(9);
    Wait(15);
    Unlock(7);
    Lock(3);
    Wait(15);
    Turn2DirectionLives<actor ACTOR_PLAYER>(4, 10, ACTOR_ATTENDANT1);
    Turn2DirectionLives<actor ACTOR_NPC_JUPUTORU>(4, 10, ACTOR_PLAYER);
    Turn2DirectionLives<actor ACTOR_ATTENDANT1>(4, 10, ACTOR_PLAYER);
    Wait(15);
    SetEffect<actor ACTOR_ATTENDANT1>(EFFECT_SWEAT_DROPS_FROM_BOTH_SIDES_MEDIUM, 3);
    WaitEffect<actor ACTOR_ATTENDANT1>();
    message_SetFace(ACTOR_ATTENDANT1, FACE_PAIN, FACE_POS_STANDARD);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" Urk![K] This isn't easy at all.",
            }
        case 2:
            {
                english=" Urk![K] This is really challenging.",
            }
        default:
            {
                english=" Urk![K] It's really tough.",
            }
    }
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_JUPUTORU, FACE_NORMAL, FACE_POS_TOP_C_FACER);
    message_Talk({
        english="""
             It doesn't matter if [CS:N]Dusknoir[CR] is
            lying in wait.
        """,
    });
    message_Talk({
        english=" We will get through this time.",
    });
    message_Close();
    end;
}

def 1 for actor ACTOR_PLAYER {
    SetDirection(DIR_RIGHT);
    SetAnimation(76);
    Lock(5);
    CallCommon(CORO_WAKEUP_FUNC);
    CallCommon(CORO_LOOK_AROUND_DOWN_FUNC);
    Lock(6);
    hold;
}

def 2 for actor ACTOR_ATTENDANT1 {
    SetDirection(DIR_LEFT);
    SetAnimation(76);
    Lock(7);
    CallCommon(CORO_WAKEUP_FUNC);
    CallCommon(CORO_LOOK_AROUND_FUNC);
    Unlock(3);
    Lock(8);
    hold;
}

def 3 for actor ACTOR_NPC_JUPUTORU {
    SetPositionInitial();
    SetAnimation(29);
    Lock(9);
    Wait(30);
    SetAnimation(31);
    WaitAnimation();
    SetAnimation(2);
    Wait(15);
    Turn2Direction(4, 10, DIR_UPLEFT);
    CallCommon(CORO_LOOK_AROUND_FUNC);
    Lock(10);
    hold;
}
