             I've got no choice but to
            go...[K]to [CS:P]Temporal Tower[CR].
        """,
    });
    message_Talk({
        english="""
             Whether Master [CS:N]Dialga[CR]
            really said to eliminate me or not...
        """,
    });
    message_Talk({
        english=" I can't be sure either way.",
    });
    message_Talk({
        english="""
             I have to go to
            [CS:P]Temporal Tower[CR] too.[K] I have to know...
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2Direction<actor ACTOR_NPC_YONOWAARU_N8>(4, 10, DIR_DOWNLEFT);
    WaitExecuteLives(ACTOR_NPC_YONOWAARU_N8);
    message_SetFace(ACTOR_NPC_YONOWAARU, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
    message_Talk({
        english=" Master [CS:N]Dialga[CR]'s true intentions...",
    });
    message_Talk({
        english=" Let's go.",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    MovePositionOffset<performer 0>(0.5, 0, 24);
    Move2PositionMark<actor ACTOR_NPC_YONOWAARU_N8>(0.5, Position<'m4', 18.5, 40.5>);
    Wait(30);
    Turn2Direction<actor ACTOR_PLAYER_FUTURE>(32, 10, DIR_LEFT);
    WaitExecuteLives(ACTOR_PLAYER_FUTURE);
    message_SetFace(ACTOR_PLAYER_FUTURE, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english="""
             ... (For now, fighting alongside
            him is reassuring...)
        """,
    });
    message_Talk({
        english=" (However...)",
    });
    message_Talk({
        english="""
             ([CS:N]Dusknoir[CR] still looks up to
            [CS:N]Dialga[CR]. That hasn't changed.)
        """,
    });
    Turn2Direction<actor ACTOR_NPC_YONOWAARU_N8>(4, 10, DIR_LEFT);
    message_Talk({
        english="""
             (Now when we meet [CS:N]Dialga[CR]
            at [CS:P]Temporal Tower[CR]...)
        """,
    });
    message_Talk({
        english="""
             ([CS:N]Dusknoir[CR] will probably side
            with [CS:N]Dialga[CR]...)
        """,
    });
    message_Talk({
        english="""
             (Then I'll have to take on
            [CS:N]Dialga[CR] and [CS:N]Dusknoir[CR] by myself...)
        """,
    });
    message_Talk({
        english="""
             (Well, not just them.[K] There's
            also [CS:N]Dialga[CR]'s new henchman.)
        """,
    });
    message_Talk({
        english="""
             (So I'll have to fight
            three enemies!)
        """,
    });
    message_Talk({
        english="""
             (Can I do that?[K] All those
            opponents...[K]by myself...)
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    bgm_FadeOut(160);
    Wait(60);
    Turn2DirectionLives<actor ACTOR_NPC_YONOWAARU_N8>(4, 10, ACTOR_PLAYER_FUTURE);
    WaitExecuteLives(ACTOR_NPC_YONOWAARU_N8);
    message_SetFace(ACTOR_NPC_YONOWAARU, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english=" What's wrong?[K] Aren't you going?",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    se_Play(8978);
    SetEffect<actor ACTOR_PLAYER_FUTURE>(EFFECT_TWO_ARROWS_AT_SIDE_LEFT, 3);
    WaitEffect<actor ACTOR_PLAYER_FUTURE>();
    WaitExecuteLives(ACTOR_PLAYER_FUTURE);
    Wait(15);
    message_SetFace(ACTOR_PLAYER_FUTURE, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english="""
             ... (Humph![K] When that
            time comes...!)
        """,
    });
    message_Talk({
        english=" (I'll be ready!)",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    MovePositionOffset<actor ACTOR_PLAYER_FUTURE>(0.5, -8, 0);
    WaitExecuteLives(ACTOR_PLAYER_FUTURE);
    message_SetFace(ACTOR_PLAYER_FUTURE, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english="""
             I've decided to go.[K]
            I'm just getting myself psyched up.
        """,
    });
    message_Talk({
        english=" Let's go!",
    });
    message_Close();
    MovePositionMark<actor ACTOR_NPC_YONOWAARU_N8>(1, Position<'m5', 13.5, 40.5>, Position<'m6', 1.5, 40.5>);
    Wait(15);
    MovePositionMark<actor ACTOR_PLAYER_FUTURE>(1, Position<'m7', 13.5, 40.5>, Position<'m8', 1.5, 40.5>);
    Wait(60);
    screen2_FadeOut(0, 60);
    screen_FadeOut(1, 60);
    back2_SetMode(0);
    Wait(60);
    end;
}
