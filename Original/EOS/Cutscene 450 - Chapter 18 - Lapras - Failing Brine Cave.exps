            }
    }
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" There's no giving up!",
            }
        case 2:
            {
                english=" There's no giving up!",
            }
        default:
            {
                english=" There's no giving up!",
            }
    }
