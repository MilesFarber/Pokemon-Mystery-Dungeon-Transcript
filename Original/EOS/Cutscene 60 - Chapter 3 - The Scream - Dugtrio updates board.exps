    ExecuteCommon<actor ACTOR_NPC_KEMUSSO>(CORO_JUMP_SURPRISE_FUNC_SERIES, 0);
    WaitExecuteLives(ACTOR_NPC_KEMUSSO);
    SetAnimation<actor ACTOR_NPC_OOSUBAME>(2);
