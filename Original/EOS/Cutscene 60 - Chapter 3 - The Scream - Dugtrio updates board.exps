    SetAnimation<object OBJECT_V03P03A1_193>(18);
    WaitAnimation<object OBJECT_V03P03A1_193>();
    WaitExecuteObject(OBJECT_V03P03A1_193);
    SetAnimation<actor ACTOR_NPC_DAGUTORIO>(2);
    SetEffect<actor ACTOR_NPC_OOSUBAME>(EFFECT_SHOCKED, 3);
