        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    SetEffect<actor ACTOR_NPC_OOSUBAME>(EFFECT_SWEAT_DROPS_FROM_BOTH_SIDES_MEDIUM, 3);
    Wait(10);
    SetEffect<actor ACTOR_NPC_KEMUSSO>(EFFECT_SWEAT_DROPS_FROM_BOTH_SIDES_MEDIUM, 3);
    SetEffect<actor ACTOR_NPC_DAGUTORIO>(EFFECT_NONE, 3);
    Wait(15);
    se_Play(6416);
    SetEffect<actor ACTOR_NPC_DAGUTORIO>(EFFECT_SHOCKED, 3);
    SetAnimation<actor ACTOR_NPC_DAGUTORIO>(12);
    WaitAnimation<actor ACTOR_NPC_DAGUTORIO>();
