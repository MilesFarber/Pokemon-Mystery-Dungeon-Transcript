    SetEffect<actor ACTOR_NPC_OOSUBAME>(EFFECT_SWEAT_DROPS_FROM_BOTH_SIDES_MEDIUM, 3);
    Wait(10);
    SetAnimation<actor ACTOR_NPC_KEMUSSO>(4);
    SetEffect<actor ACTOR_NPC_KEMUSSO>(EFFECT_SWEAT_DROPS_FROM_BOTH_SIDES_MEDIUM, 3);
    message_Talk({
        english="""
             Then he flips the panel and
