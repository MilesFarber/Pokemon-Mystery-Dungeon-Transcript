    Turn2DirectionLives<actor ACTOR_NPC_OOSUBAME>(4, 10, ACTOR_NPC_KEMUSSO);
    WaitExecuteLives(ACTOR_NPC_OOSUBAME);
    SetAnimation<actor ACTOR_NPC_OOSUBAME>(4);
