    MovePositionMark<actor ACTOR_NPC_DAGUTORIO>(1, Position<'m1', 38, 17.5>);
    WaitExecuteLives(ACTOR_NPC_DAGUTORIO);
    Destroy<actor ACTOR_NPC_DAGUTORIO>();
    se_Play(8961);
    SetEffect<actor ACTOR_NPC_OOSUBAME>(EFFECT_SWEAT_DROP_SLOW, 3);
