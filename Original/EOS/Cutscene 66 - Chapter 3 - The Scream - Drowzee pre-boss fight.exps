def 1 for actor ACTOR_ATTENDANT1 {
    SetAnimation(2);
    Lock(5);
    MovePositionMark(1, Position<'m10', 41, 40.5>);
    Lock(6);
    SetAnimation(3);
    @label_1;
    forever {
        SlidePositionOffset(1, 1, 0);
        Wait(1);
        SlidePositionOffset(1, -1, 0);
        Wait(1);
        switch ( $EVENT_LOCAL ) {
            case 1:
                break_loop;
                break;
            default:
                continue;  // may be redundant
        }
    }
    @label_0;
    SetAnimation(2);
    Lock(7);
    hold;
}
