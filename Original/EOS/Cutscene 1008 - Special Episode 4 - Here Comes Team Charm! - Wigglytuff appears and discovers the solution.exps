    SetEffect<actor ACTOR_NPC_PUKURIN>(EFFECT_SHOCKED, 3);
    message_SetFace(ACTOR_NPC_PUKURIN, FACE_SURPRISED, FACE_POS_TOP_C_FACER);
    message_Talk({
        english=" P-Perfect Apple!",
    });
    message_Close();
    MovePositionMark<actor ACTOR_NPC_PUKURIN>(1, Position<'m2', 31.5, 21>);
    Wait(6);
    Turn2Direction<actor ACTOR_NPC_SAANAITO>(4, 10, DIR_UP);
    Wait(2);
    Turn2Direction<actor ACTOR_NPC_CHAAREMU>(4, 10, DIR_UP);
    Wait(2);
    Turn2Direction<actor ACTOR_PLAYER_CHARMS>(4, 10, DIR_UP);
    WaitExecuteLives(ACTOR_NPC_PUKURIN);
    message_SetFace(ACTOR_NPC_PUKURIN, FACE_TEARY_EYED, FACE_POS_TOP_C_FACER);
    message_Talk({
        english=" Perfect Apple! Perfect Apple!!",
    });
    message_Close();
    MovePositionMark<actor ACTOR_NPC_PUKURIN>(2.5, Position<'m3', 31.5, 18.5>);
    WaitExecuteLives(ACTOR_NPC_PUKURIN);
    se_Play(10253);
    supervision_Acting(5);
    SetAnimation<object OBJECT_D56P11A3_522>(17);
    supervision_RemoveActing(1);
    WaitAnimation<object OBJECT_D56P11A3_522>();
    WaitExecuteObject(OBJECT_D56P11A3_522);
    supervision_RemoveActing(5);
    SetEffect<actor ACTOR_PLAYER_CHARMS>(EFFECT_SHOCKED, 3);
    Wait(3);
    SetEffect<actor ACTOR_NPC_SAANAITO>(EFFECT_SHOCKED, 3);
    Wait(3);
    SetEffect<actor ACTOR_NPC_CHAAREMU>(EFFECT_SHOCKED, 3);
    WaitEffect<actor ACTOR_NPC_CHAAREMU>();
    WaitExecuteLives(ACTOR_NPC_CHAAREMU);
    message_SetFace(ACTOR_PLAYER_CHARMS, FACE_SURPRISED, FACE_POS_TOP_R_CENTER);
    message_Talk({
        english=" Where'd it go?",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_CHAAREMU, FACE_SURPRISED, FACE_POS_STANDARD);
    message_Talk({
        english="""
             [CS:N]Wigglytuff[CR] just walked through
            the wall!
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2DirectionLives<actor ACTOR_NPC_CHAAREMU>(4, 10, ACTOR_NPC_SAANAITO);
    Wait(3);
    Turn2DirectionLives<actor ACTOR_PLAYER_CHARMS>(4, 10, ACTOR_NPC_CHAAREMU);
    Wait(6);
    Turn2DirectionLives<actor ACTOR_NPC_SAANAITO>(4, 10, ACTOR_NPC_CHAAREMU);
    WaitExecuteLives(ACTOR_NPC_SAANAITO);
    message_SetFace(ACTOR_NPC_CHAAREMU, FACE_STUNNED, FACE_POS_STANDARD);
    message_Talk({
        english="""
             What in the world![K] [CS:N]Wigglytuff[CR]
            disappeared!
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_SAANAITO, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english=" But--[K]if that's the case...",
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_PLAYER_CHARMS, FACE_NORMAL, FACE_POS_TOP_R_CENTER);
    message_Talk({
        english="""
             You know it![K] If that's the case,
            then that wall...
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_NPC_SAANAITO, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_Talk({
        english="""
             That wall might be an invisible...[K]
            hidden doorway!
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    se_Play(8975);
    ExecuteCommon<actor ACTOR_NPC_CHAAREMU>(CORO_JUMP_ANGRY_FUNC_SERIES, 0);
    WaitExecuteLives(ACTOR_NPC_CHAAREMU);
    message_SetFace(ACTOR_NPC_CHAAREMU, FACE_SURPRISED, FACE_POS_STANDARD);
    message_Talk({
        english="""
             What?! Could that be true?![K]
            If that's true...
        """,
    });
    message_SetFace(ACTOR_NPC_CHAAREMU, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english="""
             [CS:N]Gardevoir[CR]! [CS:Y]Lopunny[CR]![K]
            Let's find out for ourselves!
        """,
    });
    message_Close();
    bgm_PlayFadeIn(BGM_ILLUSION_STONE_CHAMBER, 0, 256);
    ResetOutputAttribute<actor ACTOR_PLAYER_CHARMS>(2);
    ResetOutputAttribute<actor ACTOR_NPC_CHAAREMU>(2);
    ResetOutputAttribute<actor ACTOR_NPC_SAANAITO>(2);
    end;
}

def 1 for actor ACTOR_NPC_PUKURIN {
    SetAnimation(2);
    Lock(5);
    MovePositionMark(1.5, Position<'m4', 31.5, 24.5>);
    SetEffect(EFFECT_LAUGHING, 3);
    Lock(6);
    SetEffect(EFFECT_NONE, 3);
    Lock(7);
    Turn2Direction(4, 10, DIR_DOWNRIGHT);
    CallCommon(CORO_LOOK_AROUND_FUNC);
    SetEffect(EFFECT_LAUGHING, 3);
    Lock(8);
    SetEffect(EFFECT_NONE, 3);
    WaitEffect();
    Lock(9);
    SetEffect(EFFECT_QUESTION_MARK, 3);
    Turn2DirectionLives(4, 10, ACTOR_NPC_CHAAREMU);
    Wait(10);
    Lock(10);
    Turn2Direction(4, 10, DIR_DOWNRIGHT);
    CallCommon(CORO_LOOK_AROUND_FUNC);
    Turn2DirectionLives(4, 10, ACTOR_NPC_CHAAREMU);
    Lock(11);
    Turn2Direction(4, 10, DIR_UPLEFT);
    Wait(50);
    Turn2Direction(4, 10, DIR_UPRIGHT);
    Wait(50);
    Turn2Direction(4, 10, DIR_UPLEFT);
    Lock(12);
    Turn2Direction(4, 10, DIR_DOWNLEFT);
    Wait(90);
    SetAnimation(5);
    SetEffect(EFFECT_APPLE_ON_HEAD, 3);
    @label_1;
    forever {
        Turn2Direction(8, 1, DIR_UP);
        Wait(20);
        switch ( $EVENT_LOCAL ) {
            case 1:
                break_loop;
                break;
            default:
                Turn2Direction(8, 1, DIR_DOWN);
                Wait(20);
                switch ( $EVENT_LOCAL ) {
                    case 1:
                        break_loop;
                        break;
                    default:
                        continue;  // may be redundant
                }
                break;
        }
    }
    @label_0;
    Turn2Direction(8, 1, DIR_UP);
    SetEffect(EFFECT_NONE, 3);
    Lock(13);
    hold;
}
