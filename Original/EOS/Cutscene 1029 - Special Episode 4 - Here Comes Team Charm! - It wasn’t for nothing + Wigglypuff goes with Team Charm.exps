    MovePositionMark<actor ACTOR_NPC_PUKURIN>(2.5, Position<'m13', 34.5, 62>);
    Wait(30);
    screen_FadeOut(1, 30);
    Wait(40);
    message_SetWaitMode(150, 60);
    message_Explanation({
        english="[CN]I'll go everywhere! ♪",
    });
    message_Explanation({
        english="[CN]YOOM...TAH!",
    });
    message_Close();
    message_SetWaitMode(-1, -1);
    screen_FadeOut(1, 30);
    Wait(20);
    end;
}

def 1 for actor ACTOR_PLAYER_CHARMS {
    SetAnimation(2);
    Lock(5);
    Wait(6);
    Turn2DirectionLives(4, 10, ACTOR_NPC_CHAAREMU);
    Lock(6);
    Wait(6);
    Turn2Direction(4, 10, DIR_UP);
    SetEffect(EFFECT_LAUGHING, 3);
    @label_1;
    forever {
        switch ( $EVENT_LOCAL ) {
            case 1:
                break_loop;
                break;
            default:
                WaitRandom(18, 21);
                switch ( $EVENT_LOCAL ) {
                    case 1:
                        break_loop;
                        break;
                    default:
                        Turn2DirectionLives(4, 10, ACTOR_NPC_SAANAITO);
                        WaitRandom(12, 30);
                        switch ( $EVENT_LOCAL ) {
                            case 1:
                                break_loop;
                                break;
                            default:
                                Turn2DirectionLives(4, 10, ACTOR_NPC_CHAAREMU);
                                WaitRandom(18, 21);
                                switch ( $EVENT_LOCAL ) {
                                    case 1:
                                        break_loop;
                                        break;
                                    default:
                                        SetEffect(EFFECT_NONE, 3);
                                        WaitEffect();
                                        SetEffect(EFFECT_JOYOUS, 3);
                                        CallCommon(CORO_JUMP_HAPPY_FUNC);
                                        Turn2DirectionLives(4, 10, ACTOR_NPC_CHAAREMU);
                                        WaitRandom(12, 30);
                                        Turn2DirectionLives(4, 10, ACTOR_NPC_SAANAITO);
                                        CallCommon(CORO_JUMP_HAPPY_FUNC);
                                        SetEffect(EFFECT_NONE, 3);
                                        WaitEffect();
                                        SetEffect(EFFECT_LAUGHING, 3);
                                        switch ( $EVENT_LOCAL ) {
                                            case 1:
                                                break_loop;
                                                break;
                                            default:
                                                continue;  // may be redundant
                                        }
                                        break;
                                }
                                break;
                        }
                        break;
                }
                break;
        }
    }
    @label_0;
    SetEffect(EFFECT_NONE, 3);
    Lock(7);
    hold;
}

