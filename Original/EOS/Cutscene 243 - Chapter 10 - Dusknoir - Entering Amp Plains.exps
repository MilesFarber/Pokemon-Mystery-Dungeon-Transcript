
def 0 {
    sound_Stop();
    back_SetGround(LEVEL_D11P11A);
    supervision_Acting(0);
    camera_SetMyself<performer 0>();
    screen_FadeIn(1, 30);
    bgm_PlayFadeIn(BGM_AMP_PLAINS, 0, 256);
    Move2PositionMark<actor ACTOR_ATTENDANT1>(1, Position<'m0', 26.5, 24.5>);
    Move2PositionMark<actor ACTOR_PLAYER>(1, Position<'m1', 30.5, 24.5>);
    WaitExecuteLives(ACTOR_PLAYER);
    WaitExecuteLives(ACTOR_ATTENDANT1);
    message_SetFace(ACTOR_ATTENDANT1, FACE_NORMAL, FACE_POS_STANDARD);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" Let's make it through this time!",
            }
        case 2:
            {
                english=" Let's make it through this time!",
            }
        default:
            {
                english=" Let's make it through this time!",
            }
    }
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2DirectionLives<actor ACTOR_ATTENDANT1>(4, 10, ACTOR_PLAYER);
    Wait(10);
    Turn2DirectionLives<actor ACTOR_PLAYER>(4, 10, ACTOR_ATTENDANT1);
    WaitExecuteLives(ACTOR_PLAYER);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     [hero], let's give it our
                    best!
                """,
            }
        case 2:
            {
                english=" [hero], let's do our best!",
            }
        default:
            {
                english=" [hero], let's try our best!",
            }
    }
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Move2PositionMark<actor ACTOR_ATTENDANT1>(1, Position<'m2', 26.5, 16.5>);
    Wait(10);
    Move2PositionMark<actor ACTOR_PLAYER>(1, Position<'m3', 30.5, 16.5>);
    Wait(20);
    main_EnterDungeon(17, 30);
    switch ( message_Menu(MENU_DUNGEON_INITIALIZE_TEAM) ) { }
    main_EnterDungeon(-1, 30);
    hold;
    end;
}
