
def 0 {
    bgm_PlayFadeIn(BGM_BRINE_CAVE, 0, 256);
    SetAnimation<actor ACTOR_PLAYER>(2);
    SetAnimation<actor ACTOR_ATTENDANT1>(2);
    SetAnimation<actor ACTOR_NPC_PERAPPU>(2);
    WaitExecuteLives(ACTOR_NPC_PERAPPU);
    Turn2DirectionLives<actor ACTOR_PLAYER>(4, 10, ACTOR_ATTENDANT1);
    Turn2DirectionLives<actor ACTOR_ATTENDANT1>(4, 10, ACTOR_PLAYER);
    WaitExecuteLives(ACTOR_ATTENDANT1);
    message_SetFace(ACTOR_ATTENDANT1, FACE_NORMAL, FACE_POS_STANDARD);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" Ready, [hero]?",
            }
        case 2:
            {
                english=" Are you ready, [hero]?",
            }
        default:
            {
                english=" Ready, [hero]?",
            }
    }
    switch ( message_SwitchMenu(0, 1) ) {
        case menu({
            english="Yes",
        }):
        default:
            @label_0;
            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
            supervision_Acting(0);
            SetPositionLives<performer 0>(0);
            camera_SetMyself<performer 0>();
            MovePositionOffset<performer 0>(1, 0, 24);
            MovePositionMark<actor ACTOR_NPC_PERAPPU>(1, Position<'m0', 35, 27.5>);
            Wait(5);
            Turn2DirectionLives<actor ACTOR_ATTENDANT1>(4, 10, ACTOR_NPC_PERAPPU);
            Turn2DirectionLives<actor ACTOR_PLAYER>(4, 10, ACTOR_NPC_PERAPPU);
            Turn2DirectionLives<actor ACTOR_NPC_PERAPPU>(4, 10, ACTOR_PLAYER);
            WaitExecuteLives(ACTOR_NPC_PERAPPU);
            message_SwitchTalk ($PARTNER_TALK_KIND) {
                case 1:
                    {
                        english=" All right! Time to roll!",
                    }
                case 2:
                    {
                        english=" OK! Let's move out!",
                    }
                default:
                    {
                        english=" OK! Let's go!",
                    }
            }
            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
            message_SetFace(ACTOR_NPC_PERAPPU, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
            message_Talk({
                english=" We'll make it through this time!",
            });
            message_Close();
            MovePositionMark<actor ACTOR_PLAYER>(1, Position<'m1', 31.5, 18.5>);
            Wait(10);
            MovePositionMark<actor ACTOR_ATTENDANT1>(1, Position<'m2', 31.5, 18.5>);
            MovePositionMark<actor ACTOR_NPC_PERAPPU>(1, Position<'m3', 31.5, 18.5>);
            screen_FadeOut(1, 30);
            main_EnterDungeon(35, 0);
            switch ( message_Menu(MENU_DUNGEON_INITIALIZE_TEAM) ) { }
            main_EnterDungeon(-1, 0);
            hold;
            end;
        case menu({
            english="Not yet",
        }):
            CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
            message_SetFace(ACTOR_ATTENDANT1, FACE_NORMAL, FACE_POS_STANDARD);
            message_SwitchTalk ($PARTNER_TALK_KIND) {
                case 1:
                    {
                        english=" Oh. All right.",
                    }
                case 2:
                    {
                        english=" Oh. OK.",
                    }
                default:
                    {
                        english=" Oh. OK.",
                    }
            }
            message_SwitchTalk ($PARTNER_TALK_KIND) {
                case 1:
                    {
                        english="""
                             We'll be on our way when
                            you're ready.
                        """,
                    }
                case 2:
                    {
                        english=" Let's go as soon as you're ready.",
                    }
                default:
                    {
                        english=" Let's leave when you're ready.",
                    }
            }
            message_Close();
            end;
    }
}
