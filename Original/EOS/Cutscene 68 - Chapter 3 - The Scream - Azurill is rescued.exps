    MovePositionMark<actor ACTOR_ATTENDANT1>(1, Position<'m2', 41, 22.5>);
    Wait(60);
    se_Play(8978);
    SetEffect<actor ACTOR_NPC_RURIRI>(EFFECT_EXCLAMATION_MARK, 3);
