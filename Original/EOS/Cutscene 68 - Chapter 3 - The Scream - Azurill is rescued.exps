                english=" We came to rescue you.",
            }
        case 2:
            {
                english=" We came to rescue you.",
            }
        default:
            {
                english=" We're here to rescue you.",
            }
    }
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     Are you all right? You're not
                    hurt, are you?
                """,
            }
        case 2:
            {
                english="""
                     Are you all right? You're not
                    hurt, are you?
                """,
            }
        default:
            {
                english="""
                     Are you OK? You're not hurt,
                    are you?
                """,
            }
    }
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    ExecuteCommon<actor ACTOR_NPC_RURIRI>(CORO_JUMP_HAPPY_FUNC_SERIES, 0);
    WaitExecuteLives(ACTOR_NPC_RURIRI);
    message_SetFace(ACTOR_NPC_RURIRI, FACE_NORMAL, FACE_POS_TOP_C_FACEL);
    message_Talk({
