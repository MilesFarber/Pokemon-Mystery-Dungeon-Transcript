def 1 for object OBJECT_D52P32A7_448 {
    SetOutputAttribute(4);
    @label_0;
    forever {
        SetAnimation(3);
        WaitAnimation();
        WaitRandom(90, 180);
        continue;  // may be redundant
    }
}
