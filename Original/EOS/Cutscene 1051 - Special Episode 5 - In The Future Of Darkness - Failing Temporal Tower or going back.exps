
def 0 {
    sound_Stop();
    message_SetFace(ACTOR_PLAYER_FUTURE, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english=" Argh...[K] We didn't do so well...",
    });
    message_Talk({
        english=" We should turn back for now.",
    });
    message_KeyWait();
    screen_FadeOutAll(1, 60);
    message_CloseEnforce();
    CallCommon(CORO_FADE_OUT_ALL_AFTER);
    back_SetGround(LEVEL_D48P11A);
    supervision_StationCommon(0);
    supervision_Acting(0);
    camera_SetMyself<performer 0>();
    SetPositionInitial<actor ACTOR_NPC_YONOWAARU_N8>();
    SetAnimation<actor ACTOR_NPC_YONOWAARU_N8>(2);
    screen_FadeIn(1, 30);
    bgm_PlayFadeIn(BGM_TEMPORAL_TOWER, 0, 256);
    Wait(30);
    message_SetFace(ACTOR_PLAYER_FUTURE, FACE_NORMAL, FACE_POS_STANDARD);
    message_Talk({
        english="""
             ... (I'm concerned about a great
            many things.)
        """,
    });
    message_Talk({
        english="""
             (The new, resourceful henchman
            who took over for [CS:N]Dusknoir[CR]...)
        """,
    });
    message_Talk({
        english="""
             (And using him as a
            final agent...)
        """,
    });
    message_Talk({
        english="""
             (I know they're planning on
            sending him back to the past...)
        """,
    });
    message_Talk({
        english="""
             (In any case, I have to
            keep going...)
        """,
    });
    message_Talk({
        english="""
             (To the place where [CS:N]Dialga[CR] is...[K]
            the pinnacle of [CS:P]Temporal Tower[CR]!)
        """,
    });
    message_Close();
    end;
}
