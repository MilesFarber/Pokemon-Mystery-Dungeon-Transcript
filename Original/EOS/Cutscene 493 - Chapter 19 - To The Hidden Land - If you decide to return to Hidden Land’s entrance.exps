    supervision_Acting(0);
    camera_SetMyself<performer 0>();
    bgm_PlayFadeIn(BGM_HIDDEN_LAND, 0, 256);
    screen_FadeIn(1, 30);
    Wait(30);
    message_SetFace(ACTOR_ATTENDANT1, FACE_NORMAL, FACE_POS_STANDARD);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     Quick! Let's go to [CS:P]Temporal
                    Tower[CR]!
                """,
            }
        case 2:
            {
                english=" Let's hurry to [CS:P]Temporal Tower[CR]!",
            }
        default:
            {
                english=" Let's hurry to [CS:P]Temporal Tower[CR]!",
            }
    }
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     Let's move when you're ready,
                    [hero]!
                """,
            }
        case 2:
            {
                english="""
                     Let's go when you're ready,
                    [hero]!
                """,
            }
        default:
            {
                english="""
                     Let's go when you're ready,
                    [hero]!
                """,
            }
