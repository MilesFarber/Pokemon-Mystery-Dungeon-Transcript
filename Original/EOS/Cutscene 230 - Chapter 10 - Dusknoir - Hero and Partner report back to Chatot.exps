
def 0 {
    sound_Stop();
    back_SetGround(LEVEL_G01P04A);
    supervision_LoadStation(LEVEL_G01P04A, 'UM11');
    supervision_Station(5);
    supervision_StationCommon(0);
    supervision_StationCommon(99);
    supervision_Acting(0);
    Wait(1);
    SetPositionInitial<actor ACTOR_NPC_PERAPPU>();
    SetAnimation<actor ACTOR_NPC_PERAPPU>(2);
    camera_SetMyself<performer 0>();
    screen_FadeIn(1, 30);
    Wait(30);
    se_Play(8968);
    SetEffect<actor ACTOR_NPC_PERAPPU>(EFFECT_SHOCKED, 3);
    message_SetFace(ACTOR_NPC_PERAPPU, FACE_SURPRISED, FACE_POS_TOP_C_FACEL);
    message_Talk({
        english="""
             What?![K] They have no plans to
            stock Perfect Apples?
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    bgm_PlayFadeIn(BGM_WIGGLYTUFFS_GUILD, 0, 256);
    Turn2Direction<actor ACTOR_NPC_PERAPPU>(4, 10, DIR_LEFT);
    WaitExecuteLives(ACTOR_NPC_PERAPPU);
    se_Play(8961);
    SetEffect<actor ACTOR_NPC_PERAPPU>(EFFECT_SWEAT_DROP, 3);
    message_SetFace(ACTOR_NPC_PERAPPU, FACE_PAIN, FACE_POS_TOP_C_FACEL);
    message_Talk({
        english="""
             Squawk! What am I supposed to
            do now?!
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_ATTENDANT1, FACE_SAD, FACE_POS_STANDARD);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english="""
                     Um...[K] We could maybe go get
                    some Perfect Apples at [CS:P]Apple Woods[CR]...
                """,
            }
        case 2:
            {
                english="""
                     Um...[K] We could go get some
                    Perfect Apples for you at [CS:P]Apple Woods[CR]...
                """,
            }
        default:
            {
                english="""
                     Um...[K] We could go get some
                    Perfect Apples for you at [CS:P]Apple Woods[CR]...
                """,
            }
    }
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2Direction<actor ACTOR_NPC_PERAPPU>(1, 10, DIR_DOWN);
    WaitExecuteLives(ACTOR_NPC_PERAPPU);
    se_Play(5122);
    SetAnimation<actor ACTOR_NPC_PERAPPU>(18);
    WaitAnimation<actor ACTOR_NPC_PERAPPU>();
    WaitExecuteLives(ACTOR_NPC_PERAPPU);
    SetAnimation<actor ACTOR_NPC_PERAPPU>(2);
    se_Play(8971);
    ExecuteCommon<actor ACTOR_NPC_PERAPPU>(CORO_JUMP_ANGRY_FUNC_SERIES, 0);
    message_SetFace(ACTOR_NPC_PERAPPU, FACE_SURPRISED, FACE_POS_TOP_C_FACEL);
    message_Talk({
        english=" What?! You're joking!",
    });
    message_Talk({
        english="""
             You've previously gone to
            [CS:P]Apple Woods[CR]...
        """,
    });
    message_Talk({
        english=" You failed utterly!",
    });
    message_Talk({
        english="""
             I just can't take that![K] I just can't
            go through all that again!
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    ExecuteCommon<actor ACTOR_NPC_PERAPPU>(CORO_HEAD_SHAKE_FUNC_SERIES, 0);
    WaitExecuteLives(ACTOR_NPC_PERAPPU);
    message_SetFace(ACTOR_NPC_PERAPPU, FACE_WORRIED, FACE_POS_TOP_C_FACEL);
    message_Talk({
        english=" ...[K]I'm sorry.",
    });
    message_Talk({
        english="""
             You two were outstanding on our
            recent expedition. I recognize everything
            that you've done for us.
        """,
    });
    message_SetFace(ACTOR_NPC_PERAPPU, FACE_PAIN, FACE_POS_TOP_C_FACEL);
    message_Talk({
        english="""
             But the incident...[K]with the
            Guildmaster and the Perfect Apples...
        """,
    });
    message_Talk({
        english="""
             It was a slightly traumatic
            incident for me.
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2Direction<actor ACTOR_NPC_PERAPPU>(4, 10, DIR_LEFT);
    WaitExecuteLives(ACTOR_NPC_PERAPPU);
    se_Play(8961);
    SetEffect<actor ACTOR_NPC_PERAPPU>(EFFECT_SWEAT_DROP, 3);
    message_SetFace(ACTOR_NPC_PERAPPU, FACE_PAIN, FACE_POS_TOP_C_FACEL);
    message_Talk({
        english="""
             Squawk![K] I suppose I'll have to
            find the Perfect Apples myself...
        """,
    });
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    Turn2Direction<actor ACTOR_NPC_PERAPPU>(4, 10, DIR_DOWN);
    WaitExecuteLives(ACTOR_NPC_PERAPPU);
    message_SetFace(ACTOR_NPC_PERAPPU, FACE_PAIN, FACE_POS_TOP_C_FACEL);
    message_Talk({
        english="""
             You two should just look over
            the Job Bulletin Board and the Outlaw Notice
            Board as usual.
        """,
    });
    message_Close();
    end;
}
