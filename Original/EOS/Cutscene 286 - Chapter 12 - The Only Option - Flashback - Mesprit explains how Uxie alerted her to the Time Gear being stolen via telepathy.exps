
def 0 {
    back_SetGround(LEVEL_D15P41A);
    supervision_StationCommon(0);
    supervision_Acting(0);
    camera_SetMyself<performer 0>();
    screen_FlushOut(1, 0, 8, 0, 0, 0);
    screen_FadeIn(1, 30);
    Wait(30);
    message_SetFace(ACTOR_NPC_EMURITTO, FACE_PAIN, FACE_POS_TOP_R_CENTER);
    message_Talk({
        english=" Don't lie to me!",
    });
    message_Talk({
        english="""
             [CS:N]Uxie[CR] used his telepathy to tell
            me what happened!
        """,
    });
    message_Talk({
        english="""
             I know that the Time Gear from
