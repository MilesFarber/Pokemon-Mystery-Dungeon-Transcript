    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
    message_SetFace(ACTOR_ATTENDANT1, FACE_NORMAL, FACE_POS_BOTTOM_R_FACEINW);
    message_SwitchTalk ($PARTNER_TALK_KIND) {
        case 1:
            {
                english=" A gap in time?",
            }
        case 2:
            {
                english=" A gap in time?",
            }
        default:
            {
                english=" A gap in time?",
            }
    }
    CallCommon(CORO_MESSAGE_CLOSE_WAIT_FUNC);
