        WaitAnimation<actor ACTOR_NPC_HERO_FIRST>();
        WaitExecuteLives(ACTOR_NPC_HERO_FIRST);
        SetAnimation<actor ACTOR_NPC_HERO_FIRST>(71);
        WaitAnimation<actor ACTOR_NPC_HERO_FIRST>();
        WaitExecuteLives(ACTOR_NPC_HERO_FIRST);
        SetAnimation<actor ACTOR_NPC_HERO_FIRST>(2);
        Wait(45);
        screen_FadeOutAll(1, 90);
        CallCommon(CORO_FADE_OUT_ALL_AFTER);
        Wait(60);
        message_Narration(30, {
            english="[CN]Filled with that sentiment...",
        });
        message_Narration(30, {
            english="[CN]They set off on a final adventure...",
        });
        message_Narration(30, {
            english="[CN]But then...",
        });
        message_Narration(30, {
            english="""
