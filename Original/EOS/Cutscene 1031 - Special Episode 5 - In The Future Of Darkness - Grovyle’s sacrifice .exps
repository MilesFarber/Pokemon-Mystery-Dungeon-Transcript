                    english=" Hey, [c_name:NPC_HERO_FIRST]!",
                }
            default:
                {
                    english=" Hey, [c_name:NPC_HERO_FIRST]!",
                }
        }
        message_SwitchTalk ($PARTNER_TALK_KIND) {
            case 1:
                {
                    english="""
                         We have to do this for [CS:Y]Grovyle[CR]'s
                        sake![K] Let's go to [CS:P]Temporal Tower[CR]!
                    """,
                }
            case 2:
                {
                    english="""
                         We have to do this for [CS:Y]Grovyle[CR]'s
                        sake![K] Let's go to [CS:P]Temporal Tower[CR]!
                    """,
